<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106059" svcinfotypenbr = "08" svcinfoqualnbr = "02" page = "2" supplyoff = "1" modify = "0">
<title>
Torque Converter Housing Disassembly and Reassembly
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106030">A/T Assembly Disassembly</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106062">A/T Assembly Reassembly</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106027">A/T Assembly Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A5106059001">
<title>
Disassembly
</title>
<s1>
<ptxt>
Remove oil reservoir lock plate (1) and lubrication tube (2).
</ptxt>
<figure>
<graphic graphicname = "IEL10C510208.swf" width = "88.000mm" height = "62.273mm" ver = "01" gw = "197" gh = "160"/>
</figure>
</s1>
<s1>
<ptxt>
Remove differential side oil seal (1) using a flat-bladed screwdriver or the like.
</ptxt>
<figure>
<graphic graphicname = "IEL10C510398.swf" width = "88.000mm" height = "53.060mm" ver = "02" gw = "174" gh = "134"/>
</figure>
</s1>
<s1>
<ptxt>
Remove pinion and counter driven gear right taper roller bearing outer race using special tools.
</ptxt>
<servicetool>
<servicetoolitem id = "L5A027">
<s-part>
(A)
</s-part>
<s-number num = "09944-96013">
09944–96013
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A028">
<s-part>
(B)
</s-part>
<s-number num = "09942-15511">
09942–15511
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A029">
<s-part>
(C)
</s-part>
<s-number num = "09921-26010">
09921–26010
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IEL10C510210.swf" width = "88.000mm" height = "46.598mm" ver = "02" gw = "162" gh = "115"/>
</figure>
</s1>
<s1>
<ptxt>
Remove differential right taper roller bearing outer race using special tools.
</ptxt>
<servicetool>
<servicetoolitem id = "L5A030">
<s-part>
(A)
</s-part>
<s-number num = "09944-96013">
09944–96013
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A031">
<s-part>
(B)
</s-part>
<s-number num = "09942-15511">
09942–15511
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A032">
<s-part>
(C)
</s-part>
<s-number num = "09921-26010">
09921–26010
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IEL10C510277.swf" width = "88.000mm" height = "46.513mm" ver = "02" gw = "142" gh = "115"/>
</figure>
</s1>
<s1>
<ptxt>
Remove torque converter housing plugs (1).
</ptxt>
<figure>
<graphic graphicname = "IEL10C510211.swf" width = "88.000mm" height = "103.310mm" ver = "01" gw = "214" gh = "276"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5106059002">
<title>
Reassembly
</title>
<s1>
<ptxt>
After applying ATF to new O-rings, fit them to housing plugs. Then tighten torque converter housing plugs to specified torque.
</ptxt>
<torque>
<torqueitem id = "T5A021">
<t-part>
Torque converter housing plug
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
7.5
</t-value1>
<t-value2>
0.76
</t-value2>
<t-value3>
5.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IEL10C510212.swf" width = "88.000mm" height = "103.310mm" ver = "01" gw = "214" gh = "276"/>
</figure>
</s1>
<s1>
<ptxt>
Using special tools, install new differential right taper roller bearing outer race.
</ptxt>
<servicetool>
<servicetoolitem id = "L5A033">
<s-part>
(A)
</s-part>
<s-number num = "09924-74510">
09924–74510
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A034">
<s-part>
(B)
</s-part>
<s-number num = "09944-88220">
09944–88220
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IEL10C510399.swf" width = "88.000mm" height = "50.506mm" ver = "02" gw = "149" gh = "127"/>
</figure>
</s1>
<s1>
<ptxt>
Using special tool, install new pinion and counter driven gear right taper roller bearing outer race.
</ptxt>
<servicetool>
<servicetoolitem id = "L5A035">
<s-part>
(A)
</s-part>
<s-number num = "09913-75510">
09913–75510
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IEL10C510400.swf" width = "88.000mm" height = "52.853mm" ver = "02" gw = "152" gh = "133"/>
</figure>
</s1>
<s1>
<ptxt>
Using special tool, install new differential side oil seal to torque converter housing evenly at specified position shown in figure.
</ptxt>
<servicetool>
<servicetoolitem id = "L5A036">
<s-part>
(A)
</s-part>
<s-number num = "09945-56510">
09945–56510
</s-number>
</servicetoolitem>
</servicetool>
<spec>
<title>
Differential side oil seal installing depth
</title>
<ptxt>
“a”: 24.5 – 25.5 mm (0.96 – 1.00 in.)
</ptxt>
</spec>
</s1>
<s1>
<ptxt>
Apply grease to oil seal lip.
</ptxt>
<materials>
<materialitem name = "ECSTAR Grease C" id = "M5A009" uid = "1545787518">
<m-part>
</m-part>
<m-desc>
Grease
</m-desc>
<m-number>
99000–25490
</m-number>
<m-name>
ECSTAR Grease C
</m-name>
</materialitem>
</materials>
<figure>
<graphic graphicname = "IFRA0B510045.swf" width = "88.000mm" height = "69.045mm" ver = "01" gw = "232" gh = "179"/>
</figure>
</s1>
<s1>
<ptxt>
Install oil reservoir lock plate (1) and lubrication tube (2) by tightening their mounting bolts and clamp bolt to specified torque.
</ptxt>
<torque>
<torqueitem id = "T5A022">
<t-part>
Oil reservoir lock plate bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
5.4
</t-value1>
<t-value2>
0.55
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
<torqueitem id = "T5A023">
<t-part>
Lubrication tube clamp bolt
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
5.4
</t-value1>
<t-value2>
0.55
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IEL10C510401.swf" width = "88.000mm" height = "64.320mm" ver = "02" gw = "202" gh = "166"/>
</figure>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
