<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9E">
<servcat sctnbr = "09" scnbr = "05">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A9504001" svcinfotypenbr = "06" svcinfoqualnbr = "04" page = "1" supplyoff = "1" modify = "0">
<title>
Power Window System Symptom Diagnosis
</title>
<diag type = "condition" id = "AENLSB0A9504001001">
<condition>
<ptxt>
All power windows cannot operate
</ptxt>
</condition>
<ps>
<ptxt>
Blown fuse
</ptxt>
</ps>
<action>
<ptxt>
Replace fuse and check for short circuit.
</ptxt>
</action>
<ps>
<ptxt>
Faulty wiring or ground
</ptxt>
</ps>
<action>
<ptxt>
Repair wiring.
</ptxt>
</action>
<ps>
<ptxt>
Faulty power window main switch 
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A9506016">Power Window Main Switch Inspection</intxref>
</ptxt>
</action>
<condition>
<ptxt>
One of the power window cannot operate
</ptxt>
</condition>
<ps>
<ptxt>
Faulty wiring or ground
</ptxt>
</ps>
<action>
<ptxt>
Repair wiring.
</ptxt>
</action>
<ps>
<ptxt>
Faulty power window regulator and/or motor
</ptxt>
</ps>
<action>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxref refid = "AENLSB0A9506011">Front Window Regulator Assembly Inspection</intxref>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxref refid = "AENLSB0A9506015">Rear Window Regulator Assembly Inspection</intxref>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Faulty power window main switch
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A9506016">Power Window Main Switch Inspection</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty power window sub switch
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A9506017">Power Window Sub Switch Inspection</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Window lock switch is pushed (lock position)
</ptxt>
</ps>
<action>
<ptxt>
Turn off window lock switch.
</ptxt>
</action>
<condition>
<ptxt>
Auto-up / auto-down function does not operate
</ptxt>
</condition>
<ps>
<ptxt>
Setting malfunction (fail-safe mode)
</ptxt>
</ps>
<action>
<ptxt>
Power window system initialization / reset. 
<intxreftitleoff1 refid = "AENLSB0A9506018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty power window main switch 
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A9506016">Power Window Main Switch Inspection</intxref>
</ptxt>
</action>
<condition>
<ptxt>
Abnormal noise
</ptxt>
</condition>
<ps>
<ptxt>
Loose window regulator mounting bolts
</ptxt>
</ps>
<action>
<ptxt>
Tighten window regulator mounting bolts.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A9506008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A9506012"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Worn or broken power window regulator sliding and rotating parts
</ptxt>
</ps>
<action>
<ptxt>
Replace window regulator.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A9506010"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A9506014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Lack of grease in window regulator assembly
</ptxt>
</ps>
<action>
<ptxt>
Lubricate.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A9506008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A9506012"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
