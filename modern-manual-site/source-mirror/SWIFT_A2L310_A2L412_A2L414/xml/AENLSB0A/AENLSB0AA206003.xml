<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "10B">
<servcat sctnbr = "10" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0AA206003" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
BCM Removal and Installation
</title>
<servinfosub id = "AENLSB0AA206003001">
<title>
Removal
</title>
<s1>
<ptxt>
Disable air bag system. 
<intxreftitleoff1 refid = "AENLSB0A8206001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
For LHD, remove steering column hole cover.
</ptxt>
<ptxt>
For RHD, remove glove box.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connectors (1) from BCM (2).
</ptxt>
<figure>
<graphic graphicname = "IFRA0BA20016.swf" width = "88.000mm" height = "61.607mm" ver = "02" gw = "192" gh = "158"/>
</figure>
</s1>
<s1>
<ptxt>
Release lock (1) by pushing it and pull BCM in arrow direction.
</ptxt>
<figure>
<graphic graphicname = "IE3J0PA20024.jpg" width = "88.000mm" height = "54.853mm" ver = "01" gw = "218" gh = "139"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AA206003002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Insert protrusions (1) at left and right to holes of J/B (2).
</ptxt>
<figure>
<graphic graphicname = "IE3J0PA20025.jpg" width = "88.000mm" height = "51.297mm" ver = "01" gw = "143" gh = "129"/>
</figure>
</item>
<item>
<ptxt>
Push BCM at upper part and fix it securely.
</ptxt>
</item>
<item>
<ptxt>
Enable air bag system. 
<intxreftitleoff1 refid = "AENLSB0A8206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
If BCM is replaced, perform 
<intxref refid = "AENLSB0AA206002">BCM Registration</intxref>
.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
