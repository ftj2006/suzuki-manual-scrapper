<title>
DTC C1071
</title>
<servinfosub id = "AENLSB0A4604035001">
<title>
DTC Detecting Condition and Trouble Area
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "3.599in"/>
<colspec colnum = "2" colname = "2" colwidth = "3.599in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
DTC detecting condition
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Trouble area
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
C1071: ESP<sup>&#174;</sup> Control Module Internal Failure
</emph>
</ptxt>
<ptxt>
ESP<sup>&#174;</sup> control module internal failure is detected.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
ESP<sup>&#174;</sup> control module power supply circuit
</ptxt>
</item>
<item>
<ptxt>
ESP<sup>&#174;</sup> control module ground circuit
</ptxt>
</item>
<item>
<ptxt>
ESP<sup>&#174;</sup> control module
</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</servinfosub>
<servinfosub id = "AENLSB0A4604035002">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A4604035003">
<testgroup id = "AENLSB0A4604035004">
<question>
Was “ESP<sup>&#174;</sup> System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A4604001">ESP&#174; System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A4604035005">
<title>
ESP&#174; control module power supply and ground circuit check
</title>
<test1>
<ptxt>
Check ESP<sup>&#174;</sup> control module power supply and ground circuits. 
<intxreftitleoff1 refid = "AENLSB0A4604051"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ESP<sup>&#174;</sup> hydraulic unit / control module assembly and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A4606005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
