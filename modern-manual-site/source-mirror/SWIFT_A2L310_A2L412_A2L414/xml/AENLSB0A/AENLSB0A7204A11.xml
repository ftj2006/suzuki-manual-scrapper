<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "7B">
<servcat sctnbr = "07" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A7204A11" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Loud rattle is heard at low engine rpm
</title>
<servinfosub id = "AENLSB0A7204004001">
<title>
Abnormal Noise from Compressor
</title>
<diag type = "condition">
<condition>
<ptxt>
Loud rattle is heard at low engine rpm
</ptxt>
</condition>
<ps>
<ptxt>
Loose compressor armature plate bolt
</ptxt>
</ps>
<action>
<ptxt>
Replace compressor if it has operated in rattling condition for a long time.
</ptxt>
<ptxt>
Retighten armature plate bolt. 
<intxreftitleoff1 refid = "AENLSB0A7206046"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
