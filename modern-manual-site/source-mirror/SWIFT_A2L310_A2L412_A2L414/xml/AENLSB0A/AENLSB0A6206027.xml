<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "6B">
<servcat sctnbr = "06" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A6206027" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Tie-Rod / Rack Boot Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A6206020">Steering Gear Case Assembly Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A6206027001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove steering gear case assembly. 
<intxreftitleoff1 refid = "AENLSB0A6206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove tie-rod end. 
<intxreftitleoff1 refid = "AENLSB0A6206022"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove band (2) and rack boot clip (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove boot (3) from tie-rod.
</ptxt>
<figure>
<graphic graphicname = "IELA0A630010.jpg" width = "88.000mm" height = "64.169mm" ver = "01" gw = "125" gh = "165"/>
</figure>
</s1>
<s1>
<ptxt>
Unbend bent positions of tie-rod lock washer (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove tie-rod (3) from rack (2) as shown.
</ptxt>
<figure>
<graphic graphicname = "IDAA0A630020.swf" width = "88.000mm" height = "55.283mm" ver = "01" gw = "202" gh = "140"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A6206027002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A6206026">Steering Rack Boot Inspection</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Install tie-rod (1) and new tie-rod lock washer (3) to rack (2), and then tighten tie-rod to specified torque.
</ptxt>
<torque>
<torqueitem id = "T6B009">
<t-part>
Tie-rod
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
88
</t-value1>
<t-value2>
9.0
</t-value2>
<t-value3>
65.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IDL10A630025.swf" width = "88.000mm" height = "54.406mm" ver = "01" gw = "145" gh = "138"/>
</figure>
</s1>
<s1>
<ptxt>
Bend lock washer (1) at 2 places as shown in figure.
</ptxt>
<figure>
<graphic graphicname = "I9P60A630029.swf" width = "88.000mm" height = "51.419mm" ver = "02" gw = "144" gh = "129"/>
</figure>
</s1>
<s1>
<ptxt>
Apply grease to section “A” of tie-rod indicated in figure. Position boot properly in grooves of steering gear case and tie-rod.
</ptxt>
<ptxt>
Check that boot is free from twist and dent.
</ptxt>
<materials>
<materialitem name = "ECSTAR Super Grease E" id = "M6B001" uid = "-539316051">
<m-part>
“A”
</m-part>
<m-desc>
Grease
</m-desc>
<m-number>
99000–25450
</m-number>
<m-name>
ECSTAR Super Grease E
</m-name>
</materialitem>
</materials>
<figure>
<graphic graphicname = "IDAA0A630021.swf" width = "88.000mm" height = "46.875mm" ver = "01" gw = "199" gh = "116"/>
</figure>
</s1>
<s1>
<ptxt>
Fasten new band (1) using special tool, and install rack boot clip (2).
</ptxt>
<servicetool>
<servicetoolitem id = "L6B006">
<s-part>
(A)
</s-part>
<s-number num = "09943-55010">
09943–55010
</s-number>
</servicetoolitem>
</servicetool>
<spec>
<title>
Boot band fastening distance
</title>
<ptxt>
“a”: 1.5 mm (0.059 in.)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IGSB0A620019.swf" width = "88.000mm" height = "61.674mm" ver = "02" gw = "189" gh = "158"/>
</figure>
</s1>
<s1>
<ptxt>
Install tie-rod end. 
<intxreftitleoff1 refid = "AENLSB0A6206022"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install steering gear case assembly. 
<intxreftitleoff1 refid = "AENLSB0A6206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
