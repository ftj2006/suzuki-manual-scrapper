<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9H">
<servcat sctnbr = "09" scnbr = "08">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9806016" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "1">
<title>
Trim Removal and Installation
</title>
<servinfosub id = "AENLSB0A9806016001">
<title>
Removal
</title>
<topic id = "AENLSB0A9806016002">
<title>
Front pillar trim
</title>
<ptxt>
Remove front pillar trim (1) pulling it in arrow direction.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A980014.jpg" width = "88.000mm" height = "67.722mm" ver = "01" gw = "216" gh = "175"/>
</figure>
</topic>
<topic id = "AENLSB0A9806016003">
<title>
Dash side trim and front side sill scuff
</title>
<ptxt>
Remove front side sill scuff (1) and then remove dash side trim (2) pulling them in arrow directions.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A980019.jpg" width = "88.000mm" height = "76.805mm" ver = "01" gw = "228" gh = "201"/>
</figure>
</topic>
<topic id = "AENLSB0A9806016004">
<title>
Rear side sill scuff
</title>
<ptxt>
Remove rear side sill scuff (1) pulling it in arrow direction.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A980020.jpg" width = "88.000mm" height = "83.960mm" ver = "01" gw = "214" gh = "221"/>
</figure>
</topic>
<topic id = "AENLSB0A9806016005">
<title>
Center pillar trim
</title>
<s1>
<ptxt>
Remove front and rear side sill scuffs (4).
</ptxt>
</s1>
<s1>
<ptxt>
Remove center pillar lower trim (1) pulling it in arrow direction.
</ptxt>
</s1>
<s1>
<ptxt>
Remove shoulder adjuster cover (5).
</ptxt>
</s1>
<s1>
<ptxt>
Remove front seat belt bolt (3). 
<intxreftitleoff1 refid = "AENLSB0A8106001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove center pillar upper trim (2) pulling it in arrow directions.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A980007.jpg" width = "88.000mm" height = "67.823mm" ver = "01" gw = "214" gh = "176"/>
</figure>
</s1>
</topic>
<topic id = "AENLSB0A9806016006">
<title>
Tail end trim
</title>
<s1>
<ptxt>
Remove clips and then remove tail end trim (1) pulling it in arrow direction.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect rear inside antenna connector (2).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A980015.jpg" width = "88.000mm" height = "92.705mm" ver = "01" gw = "214" gh = "246"/>
</figure>
</s1>
</topic>
<topic id = "AENLSB0A9806016007">
<title>
Quarter trim
</title>
<s1>
<ptxt>
Remove rear side sill scuff (1), quarter lower trim cap (5) and tail end trim (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove rear seat. 
<intxreftitleoff1 refid = "AENLSB0A9706008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove quarter lower trim (3) pulling it in arrow direction.
</ptxt>
</s1>
<s1>
<ptxt>
Remove rear seat belt bolts (6). 
<intxreftitleoff1 refid = "AENLSB0A8106006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove luggage compartment light (7). 
<intxreftitleoff1 refid = "AENLSB0A9206013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove quarter upper trim (4) pulling it in arrow direction.
</ptxt>
<figure>
<graphic graphicname = "ILSB0C980002.jpg" width = "88.000mm" height = "74.347mm" ver = "01" gw = "236" gh = "194"/>
</figure>
</s1>
</topic>
</servinfosub>
<servinfosub id = "AENLSB0A9806016008">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten front seat belt bolt to specified torque. 
<intxreftitleoff1 refid = "AENLSB0A8106001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Tighten rear side seat belt bolt to specified torque. 
<intxreftitleoff1 refid = "AENLSB0A8106006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Tighten rear seat hinge bolt to specified torque. 
<intxreftitleoff1 refid = "AENLSB0A9706008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
