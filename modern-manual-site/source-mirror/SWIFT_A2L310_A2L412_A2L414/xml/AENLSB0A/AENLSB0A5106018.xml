]>
<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106018" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Valve Body Assembly Removal and Installation
</title>
<attention4>
<list1 type = "unordered">
<item>
<ptxt>
The transaxle side oil pan may become deformed during removal. If the removed transaxle side oil pan is reused, it may cause oil leakage. Do not reuse the side oil pan. Always install a new one.
</ptxt>
</item>
<item>
<ptxt>
The transaxle side oil pan bolts are pre-coated with adhesive. If the bolts are reused, it may work loose.
</ptxt>
<ptxt>
Replace the transaxle side oil pan bolts with new ones.
</ptxt>
</item>
</list1>
</attention4>
<attention3>
<ptxt>
When valve body assembly is removed or replaced, perform 
<intxref refid = "AENLSB0A5106001">TCM Learning Value Clearance</intxref>
, 
<intxref refid = "AENLSB0A5106003">Neutral Position Calibration</intxref>
 and 
<intxref refid = "AENLSB0A5106002">TCM Learning Value Initialization</intxref>
.
</ptxt>
</attention3>
<servinfosub id = "AENLSB0A5106018001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Hoist vehicle.
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine undercover.
</ptxt>
</s1>
<s1>
<ptxt>
Remove left side engine under side cover.
</ptxt>
</s1>
<s1>
<ptxt>
Drain A/T fluid. 
<intxreftitleoff1 refid = "AENLSB0A5106005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Drain coolant. 
<intxreftitleoff1 refid = "AENLSB0A1616004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove radiator outlet hose.
</ptxt>
</s1>
<s1>
<ptxt>
Remove ATF cooler hose No.1. 
<intxreftitleoff1 refid = "AENLSB0A5106025"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove transaxle side oil pan (1).
</ptxt>
<figure>
<graphic graphicname = "IEL10C510313.swf" width = "88.000mm" height = "60.436mm" ver = "02" gw = "228" gh = "155"/>
</figure>
</s1>
<s1>
<ptxt>
Remove ATF temperature sensor clamp bolt, and then remove ATF temperature sensor (1) and ATF temperature sensor clamp (2).
</ptxt>
<figure>
<graphic graphicname = "IEL10C510314.swf" width = "88.000mm" height = "61.463mm" ver = "02" gw = "228" gh = "158"/>
</figure>
</s1>
<s1>
<ptxt>
Disconnect solenoid connectors (1) from solenoid valves.
</ptxt>
<figure>
<graphic graphicname = "IFRA0B510018.swf" width = "88.000mm" height = "81.177mm" ver = "01" gw = "170" gh = "214"/>
</figure>
</s1>
<s1>
<ptxt>
Disconnect output shaft speed sensor connector (1) from harness clamp.
</ptxt>
<figure>
<graphic graphicname = "IFRA0B510019.swf" width = "88.000mm" height = "76.176mm" ver = "01" gw = "233" gh = "199"/>
</figure>
</s1>
<s1>
<ptxt>
Remove valve body bolts, and then remove valve body assembly from transaxle case, being careful not to drop manual valve.
</ptxt>
<attention3>
<ptxt>
There are three types of bolts (bolts A (1), B (2) and C (3)) for fixing valve body assembly.
</ptxt>
</attention3>
<figure>
<graphic graphicname = "IFRA0B510020.swf" width = "88.000mm" height = "76.177mm" ver = "01" gw = "167" gh = "199"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5106018002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106019">Solenoid Valve Inspection</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106041">ATF Temperature Sensor Inspection</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106039">Input Shaft Speed Sensor Inspection</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Install manual valve rod (1) to manual valve lever (2) and then install valve body assembly (3) to transaxle case.
</ptxt>
<figure>
<graphic graphicname = "IFRA0B510021.swf" width = "88.000mm" height = "74.967mm" ver = "01" gw = "234" gh = "196"/>
</figure>
</s1>
<s1>
<ptxt>
Tighten valve body bolts in numerical order (“1” – “8”) evenly and gradually to specified torque.
</ptxt>
<spec>
<title>
Valve body bolt length
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "3" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.984in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.484in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.984in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Bolt
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Length “a”
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Pieces
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
A (1)
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
31 mm (1.22 in.)
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
2
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
B (2)
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
21 mm (0.83 in.)
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
5
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
C (3)
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
51 mm (2.01 in.)
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
1
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<torque>
<torqueitem id = "T5A008">
<t-part>
Valve body bolt*
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
10
</t-value1>
<t-value2>
1.0
</t-value2>
<t-value3>
7.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IFRA0B510022.swf" width = "88.000mm" height = "92.548mm" ver = "01" gw = "215" gh = "246"/>
</figure>
</s1>
<s1>
<ptxt>
Install solenoid harness (1), and then connect solenoid connectors (2) and output shaft speed sensor connector (3) as shown in figure.
</ptxt>
</s1>
<s1>
<ptxt>
Install ATF temperature sensor (4) and ATF temperature sensor clamp (5), and then tighten ATF temperature sensor clamp bolt (6) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T5A009">
<t-part>
ATF temperature sensor clamp bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
7.0
</t-value1>
<t-value2>
0.71
</t-value2>
<t-value3>
5.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IFRA0B510023.swf" width = "88.000mm" height = "81.177mm" ver = "01" gw = "183" gh = "214"/>
</figure>
</s1>
<s1>
<ptxt>
Apply sealant to mating surface of transaxle side oil pan (1) as shown in figure.
</ptxt>
<materials>
<materialitem name = "SUZUKI Bond No.1216B" id = "M5A006" uid = "32">
<m-part>
“A”
</m-part>
<m-desc>
Sealant
</m-desc>
<m-number>
99000–31230
</m-number>
<m-name>
SUZUKI Bond No.1216B
</m-name>
</materialitem>
</materials>
<figure>
<graphic graphicname = "IEL10C510321.swf" width = "88.000mm" height = "69.077mm" ver = "03" gw = "182" gh = "179"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
“a”:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
2.5 mm (0.098 in.)
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Tighten new transaxle side oil pan bolts to specified torque.
</ptxt>
<torque>
<torqueitem id = "T5A010">
<t-part>
Transaxle side oil pan bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IEL10C510322.swf" width = "88.000mm" height = "67.266mm" ver = "02" gw = "189" gh = "174"/>
</figure>
</s1>
<s1>
<ptxt>
Install ATF cooler hose No.1. 
<intxreftitleoff1 refid = "AENLSB0A5106025"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install radiator outlet hose.
</ptxt>
</s1>
<s1>
<ptxt>
Connect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Refill cooling system with coolant. 
<intxreftitleoff1 refid = "AENLSB0A1616005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Refill A/T assembly with ATF. 
<intxreftitleoff1 refid = "AENLSB0A5106005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check ATF level. 
<intxreftitleoff1 refid = "AENLSB0A5106004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install left side engine under side cover.
</ptxt>
</s1>
<s1>
<ptxt>
Install engine undercover.
</ptxt>
</s1>
<s1>
<ptxt>
Perform 
<intxref refid = "AENLSB0A5106001">TCM Learning Value Clearance</intxref>
.
</ptxt>
</s1>
<s1>
<ptxt>
Perform 
<intxref refid = "AENLSB0A5106003">Neutral Position Calibration</intxref>
.
</ptxt>
</s1>
<s1>
<ptxt>
Perform 
<intxref refid = "AENLSB0A5106002">TCM Learning Value Initialization</intxref>
.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
