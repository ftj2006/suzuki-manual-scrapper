C1604: Variant Nonstandard
</emph>
</ptxt>
<ptxt>
“Variant registration” is not standard.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
RBS control module
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</servinfosub>
<servinfosub id = "AENLSB0AA124038002">
<title>
DTC Confirmation Procedure
</title>
<s1>
<ptxt>
Perform “Variant Registration”. 
<intxreftitleoff1 refid = "AENLSB0AA126005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AA124038003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0AA124038004">
<testgroup id = "AENLSB0AA124038005">
<question>
Was “Adaptive Cruise Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace RBS control module and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0AA126001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0AA124001">Adaptive Cruise Control System Check:Adaptive Cruise Control</intxref>
.
</ptxt>
</action>
</testgroup>
</diag>
