<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1316012" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Oil Temperature Sensor Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1316011">Oil Temperature Sensor On-Vehicle Inspection:K14C</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1316012001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove oil cooler. 
<intxreftitleoff1 refid = "AENLSB0A1516005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect oil temperature sensor connector.
</ptxt>
</s1>
<s1>
<ptxt>
Remove oil temperature sensor (1) from cylinder block.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A134004.jpg" width = "88.000mm" height = "53.414mm" ver = "01" gw = "199" gh = "135"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1316012002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1316013">Oil Temperature Sensor Inspection:K14C</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Use new gasket.
</ptxt>
</item>
<item>
<ptxt>
Tighten oil temperature sensor (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1C103">
<t-part>
Oil temperature sensor
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
25
</t-value1>
<t-value2>
2.5
</t-value2>
<t-value3>
18.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IHSB0A134005.jpg" width = "88.000mm" height = "53.414mm" ver = "01" gw = "199" gh = "135"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
