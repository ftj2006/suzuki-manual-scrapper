<servinfosub id = "AENLSB0AAA24014004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0AAA24014005">
<testgroup id = "AENLSB0AAA24014006">
<question>
Was “Blind Spot Monitor System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0AAA24001">Blind Spot Monitor System Check:Blind Spot Monitor</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA24014007">
<title>
Blind spot monitor indicator light power supply circuit check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “L532” and door mirror connectors.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connection to “L532” and door mirror connectors.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “A1” circuit (B11D0): less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance of “A2” circuit (B11D1): less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A1” circuit and ground (B11D0): infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A2” circuit and ground (B11D1): infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A1” circuit terminal and each terminal at left side door mirror connector (B11D0): infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A2” circuit terminal and each terminal at right side door mirror connector (B11D1): infinity
</ptxt>
</item>
<item>
<ptxt>
Voltage of “A1” circuit (B11D0): approx. 0 V (When ignition is “ON”)
</ptxt>
</item>
<item>
<ptxt>
Voltage of “A2” circuit (B11D1): approx. 0 V (When ignition is “ON”)
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA24014008">
<title>
Blind spot monitor indicator light ground circuit check
</title>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance between “B1” circuit and ground (B11D0): less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “B2” circuit and ground (B11D1): less than 1 &#937;
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA24014009">
<title>
Blind spot monitor indicator light check
</title>
<test1>
<ptxt>
Check blind spot monitor indicator light. 
<intxreftitleoff1 refid = "AENLSB0AAA26003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace blind spot monitor control module (sub) and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0AAA26001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace door mirror. 
<intxreftitleoff1 refid = "AENLSB0A9506020"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
