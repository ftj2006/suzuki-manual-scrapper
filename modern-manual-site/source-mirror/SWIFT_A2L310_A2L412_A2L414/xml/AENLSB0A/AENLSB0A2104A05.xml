<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "2A">
<servcat sctnbr = "02" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A2104A05" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Abnormal noise
</title>
<diag type = "condition">
<condition>
<ptxt>
Abnormal noise
</ptxt>
</condition>
<ps>
<ptxt>
Damaged front strut assembly (shock absorber) or mountings
</ptxt>
</ps>
<action>
<ptxt>
Replace front strut assembly (shock absorber) or mountings. 
<intxreftitleoff1 refid = "AENLSB0A2206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Damaged rear shock absorber or mountings
</ptxt>
</ps>
<action>
<ptxt>
Replace rear shock absorber or mountings. 
<intxreftitleoff1 refid = "AENLSB0A2306003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Worn or sticky tie-rod ends
</ptxt>
</ps>
<action>
<ptxt>
Replace tie-rod ends. 
<intxreftitleoff1 refid = "AENLSB0A6206022"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Worn or damaged suspension arm joints
</ptxt>
</ps>
<action>
<ptxt>
Replace suspension arm. 
<intxreftitleoff1 refid = "AENLSB0A2206008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Worn or sticky tie-rod ball joints
</ptxt>
</ps>
<action>
<ptxt>
Replace tie-rod. 
<intxreftitleoff1 refid = "AENLSB0A6206027"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Worn or sticky drive shaft joints
</ptxt>
</ps>
<action>
<ptxt>
Replace drive shaft joints. 
<intxreftitleoff1 refid = "AENLSB0A3116004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Worn suspension arm front bushings
</ptxt>
</ps>
<action>
<ptxt>
Replace suspension arm front bushings. 
<intxreftitleoff1 refid = "AENLSB0A2206010"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Worn suspension arm rear bushings
</ptxt>
</ps>
<action>
<ptxt>
Replace suspension arm. 
<intxreftitleoff1 refid = "AENLSB0A2206008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Loose stabilizer bar
</ptxt>
</ps>
<action>
<ptxt>
Tighten bolts or nuts and/or replace bushings. 
<intxreftitleoff1 refid = "AENLSB0A2206013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Loose wheel nuts
</ptxt>
</ps>
<action>
<ptxt>
Tighten wheel nuts. 
<intxreftitleoff1 refid = "AENLSB0A2406001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Loose suspension bolts or nuts
</ptxt>
</ps>
<action>
<ptxt>
Tighten suspension bolts or nuts.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A2206016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A2306009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Broken or damaged wheel bearings
</ptxt>
</ps>
<action>
<ptxt>
Replace wheel hub assembly.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A3116007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A3126003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Broken coil springs
</ptxt>
</ps>
<action>
<ptxt>
Replace coil springs.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A2206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A2306005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Poorly lubricated or worn strut bearings
</ptxt>
</ps>
<action>
<ptxt>
Replace strut bearings. 
<intxreftitleoff1 refid = "AENLSB0A2206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Steering system malfunction
</ptxt>
</ps>
<action>
<ptxt>
Check and correct malfunction. 
<intxreftitleoff1 refid = "AENLSB0A6104001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Deteriorated rear axle bushings
</ptxt>
</ps>
<action>
<ptxt>
Replace rear axle. 
<intxreftitleoff1 refid = "AENLSB0A2306007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
