<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9E">
<servcat sctnbr = "09" scnbr = "05">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9506007" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Inner Rear View Mirror Removal and Installation
</title>
<servinfosub id = "AENLSB0A9506007001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove inner rear view mirror cover (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950016.jpg" width = "88.000mm" height = "61.711mm" ver = "01" gw = "214" gh = "158"/>
</figure>
</s1>
<s1>
<ptxt>
Remove screws (1) and remove inner rear view mirror (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950017.jpg" width = "88.000mm" height = "69.352mm" ver = "01" gw = "214" gh = "180"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9506007002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten inner rear view mirror screws to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9E001">
<t-part>
Inner rear view mirror screw*
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
6.0
</t-value1>
<t-value2>
0.61
</t-value2>
<t-value3>
4.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A950018.jpg" width = "88.000mm" height = "69.866mm" ver = "01" gw = "214" gh = "182"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
