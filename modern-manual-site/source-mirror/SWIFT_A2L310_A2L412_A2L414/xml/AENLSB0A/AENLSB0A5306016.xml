<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5C">
<servcat sctnbr = "05" scnbr = "03">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5306016" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Clutch Pedal Assembly Removal and Installation
</title>
<servinfosub id = "AENLSB0A5306016001" page = "2">
<title>
Removal
</title>
<s1 page = "2">
<ptxt>
Remove steering column. 
<intxreftitleoff1 refid = "AENLSB0A6206009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect CPP No.1 switch connector (if equipped).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect CPP No.2 switch connector.
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Remove push rod (5) from clutch pedal. 
<intxreftitleoff1 refid = "AENLSB0A5306011"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect harness clamp (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove clutch master cylinder bolts (2).
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Remove clutch pedal nuts (3), and then remove clutch pedal assembly (4).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A530016.swf" width = "88.000mm" height = "73.697mm" ver = "01" gw = "152" gh = "192"/>
</figure>
</s1>
<s1>
<ptxt>
Remove CPP No.1 switch, if necessary. 
<intxreftitleoff1 refid = "AENLSB0A5306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove CPP No.2 switch, if necessary. 
<intxreftitleoff1 refid = "AENLSB0A5306003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5306016002" page = "2">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten clutch pedal nut in (1) numerical order (“1” – “2”) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T5C006">
<t-part>
Clutch pedal nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
</torque>
</item>
<item>
<ptxt>
Tighten clutch master cylinder bolts (2) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T5C007">
<t-part>
Clutch master cylinder bolt
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
23
</t-value1>
<t-value2>
2.3
</t-value2>
<t-value3>
17.0
</t-value3>
</torqueitem>
</torque>
</item>
<item>
<ptxt>
Apply grease to push rod tip.
</ptxt>
<materials>
<materialitem name = "SUZUKI Silicone Grease" id = "M5C002" uid = "21">
<m-part>
“A”
</m-part>
<m-desc>
Grease
</m-desc>
<m-number>
99000–25100
</m-number>
<m-name>
SUZUKI Silicone Grease
</m-name>
</materialitem>
</materials>
<figure>
<graphic graphicname = "IGSB0A530017.swf" width = "88.000mm" height = "74.302mm" ver = "01" gw = "135" gh = "194"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
