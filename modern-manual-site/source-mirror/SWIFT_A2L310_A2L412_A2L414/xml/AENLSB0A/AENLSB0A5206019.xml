<servinfo servinfosgmlid = "AENLSB0A5206019" svcinfotypenbr = "08" svcinfoqualnbr = "02" page = "2" supplyoff = "1" modify = "0">
<title>
Transaxle Left Case Disassembly and Reassembly
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5206017">Manual Transaxle Assembly Disassembly and Reassembly</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A5206016">Manual Transaxle Assembly Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A5206019001">
<title>
Disassembly
</title>
<s1>
<ptxt>
Remove oil gutter (1), if necessary.
</ptxt>
<figure>
<graphic graphicname = "I5RW0B520036.swf" width = "88.000mm" height = "53.253mm" ver = "01" gw = "186" gh = "134"/>
</figure>
</s1>
<s1>
<ptxt>
Remove differential side oil seal using flat-bladed screwdriver or the like.
</ptxt>
</s1>
<s1>
<ptxt>
Remove differential side bearing outer race (1) and shim using special tools.
</ptxt>
<servicetool>
<servicetoolitem id = "L5B019">
<s-part>
(A)
</s-part>
<s-number num = "09942-15511">
09942–15511
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5B020">
<s-part>
(B)
</s-part>
<s-number num = "09944-96013">
09944–96013
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5B021">
<s-part>
(C)
</s-part>
<s-number num = "09921-26010">
09921–26010
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IDP70A522003.swf" width = "88.000mm" height = "53.978mm" ver = "01" gw = "192" gh = "137"/>
</figure>
</s1>
<s1>
<ptxt>
Remove countershaft left bearing outer race (1) and shim using special tools.
</ptxt>
<servicetool>
<servicetoolitem id = "L5B022">
<s-part>
(A)
</s-part>
<s-number num = "09942-15511">
09942–15511
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5B023">
<s-part>
(B)
</s-part>
<s-number num = "09944-96013">
09944–96013
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5B024">
<s-part>
(C)
</s-part>
<s-number num = "09921-26010">
09921–26010
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IDP70A522004.swf" width = "88.000mm" height = "55.896mm" ver = "01" gw = "184" gh = "142"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5206019002">
<title>
Reassembly
</title>
<s1>
<ptxt>
Install oil gutter (1), if removed.
</ptxt>
<figure>
<graphic graphicname = "I5RW0B520036.swf" width = "88.000mm" height = "53.253mm" ver = "01" gw = "186" gh = "134"/>
</figure>
</s1>
<s1>
<ptxt>
Calculate clearance “c” for selection of applicable differential side shim as follows.
</ptxt>
<s2>
<ptxt>
Install differential side bearing outer race to transaxle right case, if removed. 
<intxreftitleoff1 refid = "AENLSB0A5206018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s2>
<s2>
<ptxt>
Install differential assembly (2) to transaxle right case (1).
</ptxt>
</s2>
<s2>
<ptxt>
Install differential side bearing outer race of transaxle left case side (3) to differential assembly.
</ptxt>
</s2>
<s2>
<ptxt>
Keep pushing differential side bearing outer race with force of 34 N (3.5 kgf, 7.6 lbf) by hand and turn differential assembly 10 times or more.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A521025.swf" width = "88.000mm" height = "64.594mm" ver = "01" gw = "219" gh = "167"/>
</figure>
</s2>
<s2>
<ptxt>
Measure distance “a” from mating surface of transaxle right case (1) to differential side bearing outer race (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A521026.swf" width = "88.000mm" height = "54.133mm" ver = "01" gw = "203" gh = "137"/>
</figure>
</s2>
<s2>
<ptxt>
Measure depth “b” from mating surface of transaxle left case (1) to installation position of differential side bearing outer race.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A521027.swf" width = "88.000mm" height = "74.075mm" ver = "01" gw = "221" gh = "193"/>
</figure>
</s2>
<s2>
<ptxt>
Calculate clearance “c” by the following formula.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
<emph etype = "bold">
Clearance “c” = depth “b” – distance “a”
</emph>
</ptxt>
</item>
</list1>
<figure>
<graphic graphicname = "IGSB0A521028.swf" width = "88.000mm" height = "60.848mm" ver = "01" gw = "221" gh = "156"/>
</figure>
</s2>
