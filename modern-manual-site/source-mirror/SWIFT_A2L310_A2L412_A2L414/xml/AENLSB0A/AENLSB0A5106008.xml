<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106008" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Select Lever Assembly Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106007">Select Lever Assembly Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A5106008001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove floor console box. 
<intxreftitleoff1 refid = "AENLSB0A9806020"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect select cable (1) from select lever assembly (2) as shown in figure.
</ptxt>
<figure>
<graphic graphicname = "IFAE0A510018.swf" width = "88.000mm" height = "56.630mm" ver = "01" gw = "238" gh = "144"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
3.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Select lever bracket
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
4.
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Select lever pin
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Disconnect select lever connector and clamp.
</ptxt>
</s1>
<s1>
<ptxt>
Remove select lever nuts (1), and then remove select lever assembly (2) from floor panel.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A510018.jpg" width = "88.000mm" height = "55.107mm" ver = "01" gw = "199" gh = "140"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5106008002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten select lever nuts (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T5A007">
<t-part>
Select lever nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A510019.jpg" width = "88.000mm" height = "55.107mm" ver = "03" gw = "199" gh = "140"/>
</figure>
</item>
<item>
<ptxt>
After installing select lever assembly, adjust select cable. 
<intxreftitleoff1 refid = "AENLSB0A5106016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
After installing select lever assembly, check that ignition can be turned from “ON” to “OFF” when releasing select lever button in P range and that ignition cannot be turned from “ON” to “OFF” when releasing select lever button in N range.
</ptxt>
</item>
<item>
<ptxt>
After installing select lever assembly, check select lever operation. 
<intxreftitleoff1 refid = "AENLSB0A5106010"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
