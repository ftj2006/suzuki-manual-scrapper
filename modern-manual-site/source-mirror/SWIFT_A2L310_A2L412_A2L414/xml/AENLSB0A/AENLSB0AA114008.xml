<title>
Cruise Control System Symptom Diagnosis
</title>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
Perform cruise control system check referring to 
<intxref refid = "AENLSB0AA114001">Cruise Control System Check:Cruise Control</intxref>
 before performing this Cruise Control System Symptom Diagnosis.
</ptxt>
</item>
<item>
<ptxt>
Check each part in the order from the top of the following list.
</ptxt>
</item>
</list1>
</attention3>
<diag type = "condition" id = "AENLSB0AA114008001">
<condition>
<ptxt>
“CRUISE” or “SET” indicator does not turn ON or OFF
</ptxt>
</condition>
<ps>
<ptxt>
Lighting or blinking MIL
</ptxt>
</ps>
<action>
<ptxt>
Check DTC. 
<intxreftitleoff1 refid = "AENLSB0AA114003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty CRUISE (main) switch
</ptxt>
</ps>
<action>
<ptxt>
Check CRUISE (main) switch. 
<intxreftitleoff1 refid = "AENLSB0AA116001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
