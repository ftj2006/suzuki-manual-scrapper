<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1426021" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Intake Manifold Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1426017">Electric Throttle Body and Intake Manifold Components:K14D</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1426021001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove electric throttle body assembly from intake manifold. 
<intxreftitleoff1 refid = "AENLSB0A1426019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove EGR cooler assembly and its bracket from intake manifold. 
<intxreftitleoff1 refid = "AENLSB0A1226016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine harness bolt (1) from intake manifold (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove water pipe bracket (3) and heater shut off valve bracket (4) from intake manifold.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect the following hoses from intake manifold.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
EVAP canister purge valve hose (5)
</ptxt>
</item>
<item>
<ptxt>
PCV valve (6)
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142035.jpg" width = "88.000mm" height = "76.472mm" ver = "01" gw = "212" gh = "200"/>
</figure>
</item>
</list1>
</s1>
<s1>
<ptxt>
Disconnect connector from MAP sensor.
</ptxt>
</s1>
<s1>
<ptxt>
Remove intake manifold and its gaskets from cylinder head.
</ptxt>
</s1>
<s1>
<ptxt>
Remove MAP sensor if necessary. 
<intxreftitleoff1 refid = "AENLSB0A1326009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1426021002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Use new gaskets.
</ptxt>
</item>
<item>
<ptxt>
Check that all removed parts are back in place.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
