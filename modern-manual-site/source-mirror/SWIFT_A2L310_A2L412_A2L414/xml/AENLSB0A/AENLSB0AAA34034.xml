<servinfosub id = "AENLSB0AAA34034003">
<title>
DTC Troubleshooting
</title>
<attention3>
<ptxt>
If DTC C1001-04 is stored in sonar control module, it is not possible to clear DTC.
</ptxt>
</attention3>
<diag type = "test" id = "AENLSB0AAA34034004">
<testgroup id = "AENLSB0AAA34034005">
<question>
Was “Parking Sensor System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace sonar control module and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0AAA36002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0AAA34001">Parking Sensor System Check:Parking Sensor</intxref>
.
</ptxt>
</action>
</testgroup>
</diag>
