</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AA124020018">
<title>
Battery and charging system check
</title>
<test1>
<ptxt>
Check battery and charging system.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Battery: 
<intxreftitleoff1 refid = "AENLSB0A1A14001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Charging system: 
<intxreftitleoff1 refid = "AENLSB0A1A14003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
<item>
<ptxt>
K14D model:
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Battery: 
<intxreftitleoff1 refid = "AENLSB0A1A24001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Charging system: 
<intxreftitleoff1 refid = "AENLSB0A1A24004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
