<servinfosub id = "AENLSB0A9204011003">
<title>
DTC Confirmation Procedure
</title>
<s1>
<ptxt>
Park vehicle on level surface and set ignition “OFF”.
</ptxt>
</s1>
<s1>
<ptxt>
Run engine at idle speed for 10 sec. or more.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9204011004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A9204011005">
<testgroup id = "AENLSB0A9204011006">
<title>
DTC check
</title>
<test1>
<ptxt>
Clear DTC. 
<intxreftitleoff1 refid = "AENLSB0A9204003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Perform 
<intxref refid = "AENLSB0A9204011003">DTC Confirmation Procedure</intxref>
 and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A9204002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is DTC B1956 still detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
End. (Intermittent trouble.)
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A9204011007">
<title>
Rear vehicle height sensor power supply circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “L37” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connections to “L37” connector.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check that voltage between “A3” and “A1” is approx. 5 V.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 5.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A9204011008">
<title>
Rear vehicle height sensor ground circuit check
</title>
<test1>
<ptxt>
Check that voltage between “A3” and ground is approx. 5 V.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Repair “A1” circuit. If DTC B1956 is still detected, replace headlight auto leveling control module and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A9206015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A9204011009">
<title>
Rear vehicle height sensor power supply circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “G14” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connections to “G14” connector.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “A3” circuit: less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A3” circuit and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A3” circuit terminal and other terminal at “G14” connector: infinity
</ptxt>
</item>
<item>
<ptxt>
Voltage of “A3” circuit: approx. 0 V (When ignition is “ON”)
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace headlight auto leveling control module and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A9206015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A9204011010">
<title>
Rear vehicle height sensor signal circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “G14” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connections to “G14” connector.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “A2” circuit: less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A2” circuit and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A2” circuit terminal and other terminal at “G14” connector: infinity
</ptxt>
</item>
<item>
<ptxt>
Voltage of “A2” circuit: approx. 0 V (When ignition is “ON”)
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 6.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A9204011011">
<title>
Rear vehicle height sensor check
</title>
<test1>
<ptxt>
Check rear vehicle height sensor. 
<intxreftitleoff1 refid = "AENLSB0A9206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace headlight auto leveling control module and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A9206015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace rear vehicle height sensor. 
<intxreftitleoff1 refid = "AENLSB0A9206016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
</servinfo>
