<suzuki><manual>
<section sectnbr = "1F">
<servcat sctnbr = "01" scnbr = "06">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1616012" svcinfotypenbr = "08" svcinfoqualnbr = "02" page = "2" supplyoff = "1" modify = "0">
<title>
Radiator Cooling Fan Disassembly and Reassembly
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1616011">Radiator Cooling Fan Assembly Removal and Installation:K14C</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1616012001">
<title>
Disassembly
</title>
<s1 page = "2">
<ptxt>
Remove radiator cooling main fan (1) from radiator cooling main fan motor (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove radiator cooling sub fan (3) from radiator cooling sub fan motor (4).
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Remove radiator cooling main fan motor and radiator cooling sub fan motor from radiator cooling fan shroud (5).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A164017.swf" width = "88.000mm" height = "54.870mm" ver = "01" gw = "225" gh = "139"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1616012002" page = "2">
<title>
Reassembly
</title>
<ptxt>
Reverse disassembly procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten each bolt and nut to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1F105">
<t-part>
Radiator cooling fan motor bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
3.9
</t-value1>
<t-value2>
0.40
</t-value2>
<t-value3>
3.0
</t-value3>
</torqueitem>
<torqueitem id = "T1F106">
<t-part>
Radiator cooling fan nut
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
6.3
</t-value1>
<t-value2>
0.64
</t-value2>
<t-value3>
5.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IHSB0A164019.swf" width = "88.000mm" height = "52.919mm" ver = "01" gw = "228" gh = "133"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
