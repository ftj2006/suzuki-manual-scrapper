<suzuki><manual>
<section sectnbr = "9K">
<servcat sctnbr = "09" scnbr = "11">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9B06019" svcinfotypenbr = "08" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Rear Floor Rear Panel and Towing Rear Hook Removal and Installation
</title>
<attention3>
<ptxt>
The figure below shows condition where the following part are removed.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Back Panel: 
<intxreftitleoff1 refid = "AENLSB0A9B06018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</attention3>
<figure>
<graphic graphicname = "IGSB0A9B0113.jpg" width = "183.000mm" height = "77.357mm" ver = "01" gw = "351" gh = "203"/>
</figure>
<servinfosub id = "AENLSB0A9B06019001">
<title>
Removal
</title>
<s1>
<ptxt>
Drill out welding spots and remove rear seat hinge brackets.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9B0114.jpg" width = "183.000mm" height = "71.447mm" ver = "01" gw = "0" gh = "0"/>
</figure>
</s1>
<s1>
<ptxt>
Drill out welding spots and remove rear floor rear panel and towing rear hook.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A9B0021.jpg" width = "183.000mm" height = "150.550mm" ver = "01" gw = "465" gh = "410"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.394in"/>
<colspec colnum = "2" colname = "2" colwidth = "4.331in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MANOTE" width = "5.132mm" height = "3.048mm"/>
:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Drill out welding points to bend right and left rear corners of rear floor center panel upward.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9B06019002">
<title>
Installation
</title>
<attention3>
<ptxt>
Before conducting any weld, check installation position and condition for installation part(s). 
<intxreftitleoff1 refid = "AENLSB0A9B04008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</attention3>
<s1 page = "1">
<ptxt>
Install spare tire bracket.
</ptxt>
</s1>
<s1 page = "1">
<ptxt>
Conduct resistance spot weld and plug weld.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A9B0022.jpg" width = "183.000mm" height = "54.788mm" ver = "01" gw = "335" gh = "139"/>
</figure>
</s1>
<s1>
<ptxt>
Install towing rear hook.
</ptxt>
</s1>
<s1 page = "1">
<ptxt>
Conduct resistance spot weld and plug weld.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A9B0023.jpg" width = "88.000mm" height = "63.065mm" ver = "01" gw = "199" gh = "162"/>
</figure>
</s1>
<s1>
<ptxt>
Install rear floor under reinforcement.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A9B0024.jpg" width = "183.000mm" height = "105.992mm" ver = "01" gw = "347" gh = "284"/>
</figure>
</s1>
<s1>
<ptxt>
Install child seat anchor bracket and child seat anchor outside reinforcement.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld and plug weld.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A9B0025.jpg" width = "183.000mm" height = "191.504mm" ver = "01" gw = "490" gh = "526"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Vehicle inside
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[B]:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Vehicle outside
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Install rear floor rear panel and towing rear hook.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld and plug weld.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A9B0026.jpg" width = "183.000mm" height = "159.306mm" ver = "01" gw = "488" gh = "435"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.394in"/>
<colspec colnum = "2" colname = "2" colwidth = "5.905in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MANOTE" width = "5.132mm" height = "3.048mm"/>
:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
This symbol indicates that rear floor side member rear extension and wheel house inner rear panel are replaced at the same time.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Install rear seat hinge brackets.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct plug weld.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9B0121.jpg" width = "183.000mm" height = "71.447mm" ver = "01" gw = "254" gh = "186"/>
</figure>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
