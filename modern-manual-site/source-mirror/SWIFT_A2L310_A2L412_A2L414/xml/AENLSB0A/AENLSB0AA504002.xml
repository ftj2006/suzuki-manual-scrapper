<item>
<ptxt>
Mid inside antenna: 
<intxreftitleoff1 refid = "AENLSB0AA506006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear inside antenna: 
<intxreftitleoff1 refid = "AENLSB0AA506007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
</testgroup>
<testgroup id = "AENLSB0AA504002045">
