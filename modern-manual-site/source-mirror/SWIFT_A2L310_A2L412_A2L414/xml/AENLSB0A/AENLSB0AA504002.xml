<intxreftitleoff1 refid = "AENLSB0A5306002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AA504002028">
<title>
Shift position check
</title>
