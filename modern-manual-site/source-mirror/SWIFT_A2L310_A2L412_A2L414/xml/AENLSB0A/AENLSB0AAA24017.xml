<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "10J">
<servcat sctnbr = "10" scnbr = "10">
<configtype typenbr = "2">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0AAA24017" svcinfotypenbr = "06" svcinfoqualnbr = "02" supplyoff = "1" modify = "0">
<title>
DTC B11E2-54
</title>
<servinfosub id = "AENLSB0AAA24017001">
<title>
DTC Detecting Condition and Trouble Area
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "4.055in"/>
<colspec colnum = "2" colname = "2" colwidth = "3.138in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
DTC detecting condition
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Trouble area
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
B11E2-54: Aiming Incomplete
</emph>
</ptxt>
<ptxt>
This DTC is detected if any one of the following conditions is met.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
“Millimeter Wave Radar Aiming Adjustment” is not performed or not completed.
</ptxt>
</item>
<item>
<ptxt>
Deviation of beam axis from millimeter wave radar is detected.
</ptxt>
</item>
</list1>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
“Millimeter Wave Radar Aiming Adjustment” is not performed or not completed
</ptxt>
</item>
<item>
<ptxt>
Blind spot monitor control module installation angle
</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</servinfosub>
<servinfosub id = "AENLSB0AAA24017002">
<title>
DTC Confirmation Procedure
</title>
<s1>
<ptxt>
Set ignition “ON”.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AAA24017003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0AAA24017004">
<testgroup id = "AENLSB0AAA24017005">
<question>
Was “Blind Spot Monitor System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0AAA24001">Blind Spot Monitor System Check:Blind Spot Monitor</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA24017006">
<title>
Parameter check
</title>
<test1>
<ptxt>
Connect SUZUKI scan tool to DLC when ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check “Auto Aiming Angle (Main)” and “Auto Aiming Angle (Sub)” displayed on SUZUKI scan tool. 
<intxreftitleoff1 refid = "AENLSB0AAA24007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is each parameter between –6.99 and 6.99&#176;?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Check the following items.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Deformation and damage of blind spot monitor control module bracket and vehicle body
</ptxt>
</item>
<item>
<ptxt>
Wheel alignment
</ptxt>
</item>
</list1>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA24017007">
<title>
Millimeter wave radar aiming adjustment
</title>
<test1>
<ptxt>
Perform 
<intxref refid = "AENLSB0AAA26002">Millimeter Wave Radar Aiming Adjustment:Blind Spot Monitor</intxref>
.
</ptxt>
</test1>
<question>
Is aiming adjustment completed correctly?
</question>
<result type = "yes"/>
<action>
<ptxt>
End.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Check deformation and damage of blind spot monitor control module bracket and vehicle body.
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
