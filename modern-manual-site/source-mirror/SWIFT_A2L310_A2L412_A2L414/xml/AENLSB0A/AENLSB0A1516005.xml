<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1E">
<servcat sctnbr = "01" scnbr = "05">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1516005" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Oil Cooler Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1516004">Oil Cooler Components:K14C</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1516005001">
<title>
Removal
</title>
<s1>
<ptxt>
Drain coolant. 
<intxreftitleoff1 refid = "AENLSB0A1616004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove turbocharger. 
<intxreftitleoff1 refid = "AENLSB0A1416015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove oil cooler (1) and oil cooler gasket.
</ptxt>
<figure>
<graphic graphicname = "IFAE0A150034.swf" width = "88.000mm" height = "58.674mm" ver = "01" gw = "200" gh = "150"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1516005002">
<title>
Installation
</title>
<s1>
<ptxt>
Clean mating surface of cylinder block and oil cooler removing oil and coolant thoroughly.
</ptxt>
</s1>
<s1>
<ptxt>
Install oil cooler (1) with new gasket.
</ptxt>
</s1>
<s1>
<ptxt>
Tighten oil cooler bolts as follows.
</ptxt>
<s2>
<ptxt>
Tighten oil cooler bolts lightly until they are seated.
</ptxt>
</s2>
<s2>
<ptxt>
Tighten oil cooler bolts to specified torque in numerical order (“1” – “5”).
</ptxt>
<torque>
<torqueitem id = "T1E104">
<t-part>
Oil cooler bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
20
</t-value1>
<t-value2>
2.0
</t-value2>
<t-value3>
15.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IFAE0A150035.swf" width = "88.000mm" height = "58.674mm" ver = "01" gw = "200" gh = "150"/>
</figure>
</s2>
</s1>
<s1>
<ptxt>
Install turbocharger. 
<intxreftitleoff1 refid = "AENLSB0A1416015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Refill cooling system with coolant. 
<intxreftitleoff1 refid = "AENLSB0A1616005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check cooling system for leakage. 
<intxreftitleoff1 refid = "AENLSB0A1616003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check engine oil level. 
<intxreftitleoff1 refid = "AENLSB0A1516001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Start engine and check that there is no leakage of engine oil and coolant.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
