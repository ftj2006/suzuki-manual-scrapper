<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A5104010" svcinfotypenbr = "06" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
A/T Basic Check
</title>
<ptxt>
This check is important for troubleshooting when TCM has detected no DTC and no abnormality has been noted in 
<intxref refid = "AENLSB0A5104009">Visual Inspection</intxref>
. Follow the flow carefully.
</ptxt>
<diag type = "test" id = "AENLSB0A5104010001">
<testgroup id = "AENLSB0A5104010002">
<question>
Was “A/T Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A5104001">A/T Control System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A5104010003">
<title>
Road test
</title>
<test1>
<ptxt>
Perform 
<intxref refid = "AENLSB0A5104011">Road Test</intxref>
.
</ptxt>
</test1>
<question>
Is test result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective part.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A5104010004">
<title>
Engine brake test
</title>
<test1>
<ptxt>
Perform 
<intxref refid = "AENLSB0A5104012">Engine Brake Test</intxref>
.
</ptxt>
</test1>
<question>
Is test result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective part.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A5104010005">
<title>
Stall test
</title>
<test1>
<ptxt>
Perform 
<intxref refid = "AENLSB0A5104013">Stall Test</intxref>
.
</ptxt>
</test1>
<question>
Is test result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 5.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective part.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A5104010006">
<title>
Time-lag test
</title>
<test1>
<ptxt>
Perform 
<intxref refid = "AENLSB0A5104014">Time-Lag Test</intxref>
.
</ptxt>
</test1>
<question>
Is test result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 6.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective part.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A5104010007">
<title>
Line pressure test
</title>
<test1>
<ptxt>
Perform 
<intxref refid = "AENLSB0A5104015">Line Pressure Test</intxref>
.
</ptxt>
</test1>
<question>
Is test result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 7.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective part.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A5104010008">
<title>
A/T symptom diagnosis
</title>
<question>
Is trouble identified?
</question>
<result type = "yes"/>
<action>
<ptxt>
Refer to items in 
<intxref refid = "AENLSB0A5104017">A/T Symptom Diagnosis</intxref>
, repair or replace faulty parts.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
End.
</ptxt>
</action>
</testgroup>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
