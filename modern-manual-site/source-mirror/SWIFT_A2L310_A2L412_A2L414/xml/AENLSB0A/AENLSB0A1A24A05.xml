<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "2">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1A24A05" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Noisy ISG
</title>
<ptxt>
Trouble in charging system will show up as one or more of the following conditions.
</ptxt>
<servinfosub id = "AENLSB0A1A24002005">
<title>
Noise
</title>
<diag type = "condition">
<condition>
<ptxt>
Noisy ISG
</ptxt>
</condition>
<ps>
<ptxt>
Loose mounting bolts
</ptxt>
</ps>
<action>
<ptxt>
Tighten mounting bolts. 
<intxreftitleoff1 refid = "AENLSB0A1A26005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty rotor, stator or inverter
</ptxt>
</ps>
<action>
<ptxt>
Replace ISG. 
<intxreftitleoff1 refid = "AENLSB0A1A26005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Dirty, worn or faulty bearings
</ptxt>
</ps>
<action>
<ptxt>
Replace ISG. 
<intxreftitleoff1 refid = "AENLSB0A1A26005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
