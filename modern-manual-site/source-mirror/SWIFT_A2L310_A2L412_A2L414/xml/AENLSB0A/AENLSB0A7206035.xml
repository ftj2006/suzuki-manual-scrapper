<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "7B">
<servcat sctnbr = "07" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A7206035" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Center Ventilation Louver Removal and Installation
</title>
<servinfosub id = "AENLSB0A7206035001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove instrument panel upper garnish. 
<intxreftitleoff1 refid = "AENLSB0A9306003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Release claws (3) and then remove center ventilation louvers (1) from instrument panel upper garnish (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A721022.jpg" width = "88.000mm" height = "51.093mm" ver = "01" gw = "182" gh = "128"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A7206035002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Install center ventilation louvers facing arrows (1) upward.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A721001.jpg" width = "88.000mm" height = "83.827mm" ver = "01" gw = "171" gh = "221"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
