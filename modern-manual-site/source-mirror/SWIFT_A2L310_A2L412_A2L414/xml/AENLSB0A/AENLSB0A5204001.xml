<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5B">
<servcat sctnbr = "05" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A5204001" svcinfotypenbr = "06" svcinfoqualnbr = "04" supplyoff = "1" modify = "0">
<title>
Manual Transaxle Symptom Diagnosis
</title>
<diag type = "condition" id = "AENLSB0A5204001001">
<condition>
<ptxt>
Gears slipping out of mesh
</ptxt>
</condition>
<ps>
<ptxt>
Worn shift shaft
</ptxt>
</ps>
<action>
<ptxt>
Replace shift shaft.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Low speed gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
High speed gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
5th &#38; 6th gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Worn shift fork or synchronizer sleeve
</ptxt>
</ps>
<action>
<ptxt>
Replace shift fork (shift shaft) or synchronizer sleeve.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Low speed gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
High speed gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
5th &#38; 6th gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Low speed synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
High speed synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
5th &#38; 6th gear synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Weak or damaged gear locating spring
</ptxt>
</ps>
<action>
<ptxt>
Replace gear locating spring. 
<intxreftitleoff1 refid = "AENLSB0A5206014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Worn bearings on input shaft or countershaft
</ptxt>
</ps>
<action>
<ptxt>
Replace input shaft bearing or countershaft bearing.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Input shaft left bearing and right bearing: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Countershaft left bearing
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Inner race: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Outer race: 
<intxreftitleoff1 refid = "AENLSB0A5206019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
<item>
<ptxt>
Countershaft right bearing
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Inner race: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Outer race: 
<intxreftitleoff1 refid = "AENLSB0A5206018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
</list1>
</action>
<ps>
<ptxt>
Worn chamfered tooth on sleeve and gear
</ptxt>
</ps>
<action>
<ptxt>
Replace synchronizer sleeve and gear.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Low speed synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
High speed synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
 
</ptxt>
</item>
<item>
<ptxt>
5th &#38; 6th gear synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
 
</ptxt>
</item>
<item>
<ptxt>
Countershaft 1st gear and 2nd gear: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Input shaft 3rd gear, 4th gear, 5th gear and 6th gear: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
 
</ptxt>
</item>
</list1>
</action>
<condition>
<ptxt>
Hard shifting
</ptxt>
</condition>
<ps>
<ptxt>
Insufficient lubricant
</ptxt>
</ps>
<action>
<ptxt>
Add manual transaxle oil. 
<intxreftitleoff1 refid = "AENLSB0A5206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Improper clutch pedal free travel
</ptxt>
</ps>
<action>
<ptxt>
Replace clutch pedal arm and/or clutch master cylinder.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
 Clutch pedal arm: 
<intxreftitleoff1 refid = "AENLSB0A5306016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Clutch master cylinder: 
<intxreftitleoff1 refid = "AENLSB0A5306011"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Distorted or broken clutch disc
</ptxt>
</ps>
<action>
<ptxt>
Replace clutch disc. 
<intxreftitleoff1 refid = "AENLSB0A5306018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Damaged clutch pressure plate
</ptxt>
</ps>
<action>
<ptxt>
Replace clutch cover. 
<intxreftitleoff1 refid = "AENLSB0A5306018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Worn synchronizer ring
</ptxt>
</ps>
<action>
<list1 type = "unordered">
<item>
<ptxt>
1st gear synchronizer outer ring and 2nd gear synchronizer outer ring: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
3rd gear synchronizer outer ring, 4th gear synchronizer ring, 5th gear synchronizer ring and 6th gear synchronizer ring: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Worn chamfered tooth on sleeve and gear
</ptxt>
</ps>
<action>
<ptxt>
Replace synchronizer sleeve and gear.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Low speed synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
High speed synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
5th &#38; 6th gear synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Countershaft 1st gear and 2nd gear: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Input shaft 3rd gear, 4th gear, 5th gear and 6th gear: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Worn select lever bushing
</ptxt>
</ps>
<action>
<ptxt>
Replace select lever bushing. 
<intxreftitleoff1 refid = "AENLSB0A5206013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Distorted shift shaft
</ptxt>
</ps>
<action>
<ptxt>
Replace shift shaft.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Low speed gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
High speed gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
5th &#38; 6th gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Broken gear shift / select control cables
</ptxt>
</ps>
<action>
<ptxt>
Replace gear shift and select cable. 
<intxreftitleoff1 refid = "AENLSB0A5206005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<condition>
<ptxt>
Noise
</ptxt>
</condition>
<ps>
<ptxt>
Insufficient lubricant
</ptxt>
</ps>
<action>
<ptxt>
Add manual transaxle oil. 
<intxreftitleoff1 refid = "AENLSB0A5206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Damaged or worn bearing(s)
</ptxt>
</ps>
<action>
<ptxt>
Replace bearing.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Input shaft left bearing and right bearing: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Countershaft left bearing
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Inner race: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Outer race: 
<intxreftitleoff1 refid = "AENLSB0A5206019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
<item>
<ptxt>
Countershaft right bearing
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Inner race: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Outer race: 
<intxreftitleoff1 refid = "AENLSB0A5206018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
<item>
<ptxt>
Needle bearing
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Input shaft needle bearing: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Countershaft needle bearing: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
<item>
<ptxt>
Differential side bearing
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Inner race: 
<intxreftitleoff1 refid = "AENLSB0A5206031"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Left side outer race: 
<intxreftitleoff1 refid = "AENLSB0A5206019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Right side outer race: 
<intxreftitleoff1 refid = "AENLSB0A5206018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
</list1>
</action>
<ps>
<ptxt>
Damaged or worn gear(s)
</ptxt>
</ps>
<action>
<ptxt>
Replace gear.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Input shaft (1st and 2nd gear), input shaft 3rd gear, 4th gear, 5th gear and 6th gear: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Countershaft 1st gear, 2nd gear, 3rd gear, 4th gear, 5th gear and 6th gear: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Damaged or worn synchronizer parts
</ptxt>
</ps>
<action>
<ptxt>
Replace synchronizer parts.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Low speed synchronizer parts: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
High speed synchronizer parts: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
5th &#38; 6th gear synchronizer parts: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
