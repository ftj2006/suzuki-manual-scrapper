<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1316020" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
CMP Sensor Removal and Installation
</title>
<attention4>
<ptxt>
Reinstallation of CMP sensor may cause oil leakage.
</ptxt>
<ptxt>
Once CMP sensor is removed, replace it with new one.
</ptxt>
</attention4>
<servinfosub id = "AENLSB0A1316020001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine cover.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector from CMP sensor.
</ptxt>
</s1>
<s1>
<ptxt>
Remove CMP sensor (1) from thermostat case.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A134011.jpg" width = "88.000mm" height = "53.329mm" ver = "01" gw = "199" gh = "135"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1316020002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Apply engine oil to O-ring of CMP sensor.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
