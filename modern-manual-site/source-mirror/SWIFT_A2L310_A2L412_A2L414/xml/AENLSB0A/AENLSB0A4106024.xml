<suzuki><manual>
<section sectnbr = "4A">
<servcat sctnbr = "04" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A4106024" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Brake Booster Inspection
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A4106023">Brake Booster Removal and Installation</intxrefpoff>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Check brake booster for damage.
</ptxt>
</item>
<item>
<ptxt>
Check brake booster for operation referring to “Operation Check” under 
<intxref refid = "AENLSB0A4106022">Brake Booster Function Check</intxref>
.
</ptxt>
</item>
<item>
<ptxt>
Check boot for damage and deterioration.
</ptxt>
</item>
<item>
<ptxt>
Check push rod length.
</ptxt>
<ptxt>
If check result is not as specified, adjust distance between booster installation surface (without including packing) and the center of clevis pin hole to standard value “a” and tighten push rod nut (1) to specified torque.
</ptxt>
<spec>
<title>
Push rod length
</title>
<ptxt>
“a”: 114.5 – 115.5 mm (4.507 – 4.547 in.)
</ptxt>
</spec>
<torque>
<torqueitem id = "T4A015">
<t-part>
Push rod nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
26
</t-value1>
<t-value2>
2.7
</t-value2>
<t-value3>
19.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGRA0A410007.swf" width = "88.000mm" height = "47.825mm" ver = "01" gw = "147" gh = "119"/>
</figure>
</item>
</list1>
</servinfo>
