<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106022" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Differential Side Oil Seal Replacement
</title>
<s1>
<ptxt>
Hoist vehicle and drain ATF. 
<intxreftitleoff1 refid = "AENLSB0A5106005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove front drive shaft assembly. 
<intxreftitleoff1 refid = "AENLSB0A3116003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove differential side oil seals (1) using flat-bladed screwdriver or the like.
</ptxt>
<figure>
<graphic graphicname = "IFAE0A510034.swf" width = "88.000mm" height = "111.533mm" ver = "01" gw = "214" gh = "300"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
Right side
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[B]:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
Left side
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Apply grease to new differential side oil seal lips.
</ptxt>
<materials>
<materialitem name = "ECSTAR Grease C" id = "M5A007" uid = "1545787518">
<m-part>
</m-part>
<m-desc>
Grease
</m-desc>
<m-number>
99000–25490
</m-number>
<m-name>
ECSTAR Grease C
</m-name>
</materialitem>
</materials>
</s1>
<s1>
<ptxt>
Using special tool, install new differential side oil seals (1) at specified position as shown in figure.
</ptxt>
<servicetool>
<servicetoolitem id = "L5A006">
<s-part>
(A)
</s-part>
<s-number num = "09945-56510">
09945–56510
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A007">
<s-part>
(B)
</s-part>
<s-number num = "09925-16510">
09925–16510
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A008">
<s-part>
(C)
</s-part>
<s-number num = "09924-74510">
09924–74510
</s-number>
</servicetoolitem>
</servicetool>
<spec>
<title>
Differential side oil seal installing depth
</title>
<ptxt>
Right side “a”: 24.5 – 25.5 mm (0.96 – 1.00 in.)
</ptxt>
<ptxt>
Left side “b”: 2.6 – 3.6 mm (0.11 – 0.14 in.)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IFAE0A510035.swf" width = "88.000mm" height = "168.095mm" ver = "01" gw = "219" gh = "460"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
Right side
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[B]:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
Left side
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Install front drive shaft assembly. 
<intxreftitleoff1 refid = "AENLSB0A3116003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Replenish transaxle with proper amount of ATF. 
<intxreftitleoff1 refid = "AENLSB0A5106005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check fluid level. 
<intxreftitleoff1 refid = "AENLSB0A5106004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
