<servinfo servinfosgmlid = "AENLSB0A6306002" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Lane Departure Prevention Switch Inspection (If Equipped)
</title>
<s1>
<ptxt>
Remove driver air bag (inflator) module. 
<intxreftitleoff1 refid = "AENLSB0A8206006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect contact coil connector (1).
</ptxt>
</s1>
<s1>
<ptxt>
Check resistance between “2” and “4” terminals.
</ptxt>
<ptxt>
If check result is not as specified, replace steering wheel.
</ptxt>
<attention3>
<ptxt>
Use diode range of circuit tester when checking terminals “13” and “5”.
</ptxt>
</attention3>
<spec>
<title>
Lane departure prevention switch resistance
</title>
<ptxt>
Lane departure prevention switch (2) pulled (ON): Less than 2.5 &#937;
</ptxt>
</spec>
<figure>
<graphic graphicname = "IHSB0A630011.swf" width = "88.000mm" height = "121.417mm" ver = "01" gw = "222" gh = "328"/>
