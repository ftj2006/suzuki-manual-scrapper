</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Wire harness and connections
</ptxt>
</item>
<item>
<ptxt>
ECT sensor: 
<intxreftitleoff1 refid = "AENLSB0A1316015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
