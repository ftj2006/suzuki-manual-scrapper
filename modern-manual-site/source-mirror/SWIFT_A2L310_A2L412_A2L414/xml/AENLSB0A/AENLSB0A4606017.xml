<suzuki><manual>
<section sectnbr = "4F">
<servcat sctnbr = "04" scnbr = "06">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A4606017" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
ESP&#174; OFF Switch Removal and Installation
</title>
<servinfosub id = "AENLSB0A4606017001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove steering column hole cover. 
<intxreftitleoff1 refid = "AENLSB0A9306002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect ESP<sup>&#174;</sup> OFF switch connector.
</ptxt>
</s1>
<s1>
<ptxt>
Remove ESP<sup>&#174;</sup> OFF switch (1) from instrument main lower panel.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A460006.jpg" width = "88.000mm" height = "71.323mm" ver = "01" gw = "221" gh = "186"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A4606017002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A4606018">ESP&#174; OFF Switch Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
