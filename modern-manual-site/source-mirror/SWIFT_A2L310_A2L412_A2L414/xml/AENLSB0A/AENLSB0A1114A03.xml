<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1A">
<servcat sctnbr = "01" scnbr = "01">
<configtype typenbr = "1">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1114A03" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Engine noise – Valve noise
</title>
<ptxt>
Perform troubleshooting referring to the following points when ECM has detected no DTC and no abnormality has been found in 
<intxref refid = "AENLSB0A1114008">Visual Inspection:K14C</intxref>
 and 
<intxref refid = "AENLSB0A1114009">Engine Basic Inspection:K14C</intxref>
.
</ptxt>
<diag type = "condition">
<condition>
<paragroup>
<ptxt>
Engine noise – Valve noise
</ptxt>
<attention3>
<ptxt>
Before checking mechanical noise, check that:
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Specified spark plug is used.
</ptxt>
</item>
<item>
<ptxt>
Specified fuel is used.
</ptxt>
</item>
</list1>
</attention3>
</paragroup>
</condition>
<ps>
<ptxt>
Improper valve lash
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416054">Crankshaft Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Worn valve stem and guide
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416042">Valve and Valve Guide Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Weak or broken valve spring
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416045">Valve Spring Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Warped or bent valve
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416042">Valve and Valve Guide Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty valve rocker arm
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416040">Valve Rocker Arm Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty valve lash adjuster
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416039">Valve and Cylinder Head Removal and Installation:K14C</intxref>
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
