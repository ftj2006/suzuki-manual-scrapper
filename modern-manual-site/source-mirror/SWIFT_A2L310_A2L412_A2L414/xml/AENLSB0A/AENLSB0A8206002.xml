<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "8B">
<servcat sctnbr = "08" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A8206002" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Enabling Air Bag System
</title>
<s1>
<ptxt>
Check that removed components are installed and/or disconnected connectors are connected properly.
</ptxt>
</s1>
<s1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</s1>
<s1>
<ptxt>
Connect negative (–) cable at battery and/or install “A/B” fuse to J/B.
</ptxt>
</s1>
<s1>
<ptxt>
Set ignition “ON”.
</ptxt>
</s1>
<s1>
<ptxt>
Check if “AIR BAG” warning light turns on for about 6 seconds and then turns off.
</ptxt>
</s1>
<s1>
<ptxt>
Perform 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
 if defective.
</ptxt>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
