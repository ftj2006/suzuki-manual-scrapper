<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9B">
<servcat sctnbr = "09" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A9204A06" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Dome light or luggage compartment light does not light up
</title>
<diag type = "condition">
<condition>
<ptxt>
Dome light or luggage compartment light does not light up
</ptxt>
</condition>
<ps>
<ptxt>
Blown bulb
</ptxt>
</ps>
<action>
<ptxt>
Replace bulb.
</ptxt>
</action>
<ps>
<ptxt>
Faulty system circuit (including relays and fuses)
</ptxt>
</ps>
<action>
<ptxt>
Repair circuit and replace relay and/or fuse.
</ptxt>
</action>
<ps>
<ptxt>
Faulty door switch
</ptxt>
</ps>
<action>
<ptxt>
Refer to 
<intxref refid = "AENLSB0A9606008">Front and Rear Door Switch Inspection</intxref>
.
</ptxt>
</action>
<ps>
<ptxt>
Faulty rearend door switch
</ptxt>
</ps>
<action>
<ptxt>
Refer to 
<intxref refid = "AENLSB0A9606011">Rearend Door Latch On-Vehicle Inspection</intxref>
.
</ptxt>
</action>
<ps>
<ptxt>
Faulty BCM
</ptxt>
</ps>
<action>
<ptxt>
Refer to 
<intxref refid = "AENLSB0AA204029">Inspection of BCM and Its Circuits</intxref>
.
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
