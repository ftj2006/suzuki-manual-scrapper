<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "2">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1A24002" svcinfotypenbr = "06" svcinfoqualnbr = "04" page = "1" supplyoff = "1" modify = "0">
<title>
Generator Symptom Diagnosis
</title>
<ptxt>
Trouble in charging system will show up as one or more of the following conditions.
</ptxt>
<servinfosub id = "AENLSB0A1A24002001">
<title>
Charge Warning Light Operation Failure
</title>
<diag type = "condition" id = "AENLSB0A1A24002002">
<condition>
<ptxt>
Charge warning light does not light with ignition “ON” and engine off
</ptxt>
</condition>
<ps>
<ptxt>
Blown fuse
</ptxt>
</ps>
<action>
<ptxt>
Replace fuse and check its circuit.
</ptxt>
</action>
<ps>
<ptxt>
Faulty combination meter
</ptxt>
</ps>
<action>
<ptxt>
Replace combination meter. 
<intxreftitleoff1 refid = "AENLSB0A9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ECM
</ptxt>
</ps>
<action>
<ptxt>
Check ECM. 
<intxreftitleoff1 refid = "AENLSB0A1124088"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty CAN communication line
</ptxt>
</ps>
<action>
<ptxt>
Repair or replace CAN communication line. 
<intxreftitleoff1 refid = "AENLSB0AA824001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty wiring
</ptxt>
</ps>
<action>
<ptxt>
Repair wiring.
</ptxt>
</action>
<condition>
<ptxt>
Charge warning light does not go out with engine running (Battery requires frequent recharging)
</ptxt>
</condition>
<ps>
<ptxt>
Malfunctioning charging system
</ptxt>
</ps>
<action>
<ptxt>
Check DTC related to charging system. 
<intxreftitleoff1 refid = "AENLSB0A1124003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Loose or worn accessory drive belt
</ptxt>
</ps>
<action>
<ptxt>
Replace accessory drive belt. 
<intxreftitleoff1 refid = "AENLSB0A1A26004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty accessory drive belt tensioner and drive belt idler pulley
</ptxt>
</ps>
<action>
<ptxt>
Replace accessory drive belt tensioner and drive belt idler pulley. 
<intxreftitleoff1 refid = "AENLSB0A1A26007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty combination meter
</ptxt>
</ps>
<action>
<ptxt>
Replace combination meter. 
<intxreftitleoff1 refid = "AENLSB0A9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ECM
</ptxt>
</ps>
<action>
<ptxt>
Check ECM. 
<intxreftitleoff1 refid = "AENLSB0A1124088"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ISG
</ptxt>
</ps>
<action>
<ptxt>
Check ISG. 
<intxreftitleoff1 refid = "AENLSB0A1A24003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty auxiliary power module (lithium-ion battery)
</ptxt>
</ps>
<action>
<ptxt>
Check auxiliary power module (lithium-ion battery). 
<intxreftitleoff1 refid = "AENLSB0AAB06002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty DC/DC converter
</ptxt>
</ps>
<action>
<ptxt>
Check DC/DC converter. 
<intxreftitleoff1 refid = "AENLSB0AB106013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty wiring
</ptxt>
</ps>
<action>
<ptxt>
Repair wiring.
</ptxt>
</action>
</diag>
</servinfosub>
<servinfosub id = "AENLSB0A1A24002003">
<title>
Battery Charging Failure
</title>
<diag type = "condition" id = "AENLSB0A1A24002004">
<condition>
<ptxt>
Undercharged battery
</ptxt>
</condition>
<ps>
<ptxt>
Loose or worn accessory drive belt
</ptxt>
</ps>
<action>
<ptxt>
Replace accessory drive belt. 
<intxreftitleoff1 refid = "AENLSB0A1A26004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty accessory drive belt tensioner and drive belt idler pulley
</ptxt>
</ps>
<action>
<ptxt>
Replace accessory drive belt tensioner and drive belt idler pulley. 
<intxreftitleoff1 refid = "AENLSB0A1A26007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Loosen or corroded battery terminals
</ptxt>
</ps>
<action>
<ptxt>
Tighten battery terminals or replace battery. 
<intxreftitleoff1 refid = "AENLSB0A1A26002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ISG
</ptxt>
</ps>
<action>
<ptxt>
Check ISG. 
<intxreftitleoff1 refid = "AENLSB0A1A24003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<condition>
<ptxt>
Overcharged battery
</ptxt>
</condition>
<ps>
<ptxt>
Faulty ISG
</ptxt>
</ps>
<action>
<ptxt>
Replace ISG. 
<intxreftitleoff1 refid = "AENLSB0A1A26005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</diag>
</servinfosub>
<servinfosub id = "AENLSB0A1A24002005">
<title>
Noise
</title>
<diag type = "condition" id = "AENLSB0A1A24002006">
<condition>
<ptxt>
Noisy ISG
</ptxt>
</condition>
<ps>
<ptxt>
Loose mounting bolts
</ptxt>
</ps>
<action>
<ptxt>
Tighten mounting bolts. 
<intxreftitleoff1 refid = "AENLSB0A1A26005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty rotor, stator or inverter
</ptxt>
</ps>
<action>
<ptxt>
Replace ISG. 
<intxreftitleoff1 refid = "AENLSB0A1A26005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Dirty, worn or faulty bearings
</ptxt>
</ps>
<action>
<ptxt>
Replace ISG. 
<intxreftitleoff1 refid = "AENLSB0A1A26005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
