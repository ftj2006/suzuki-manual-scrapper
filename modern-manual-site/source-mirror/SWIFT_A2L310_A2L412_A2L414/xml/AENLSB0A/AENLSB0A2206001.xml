</sdm-condition>
<sdm-value>
36&#176; 15’
</sdm-value>
</sdm1>
<sdm1>
<sdm-condition>
Minimum value
</sdm-condition>
<sdm-value>
34&#176; 15’
</sdm-value>
</sdm1>
<sdm1>
<sdm-condition>
Maximum value
</sdm-condition>
<sdm-value>
38&#176; 15’
</sdm-value>
</sdm1>
</spec-sdm>
<spec-sdm>
<sdm-title>
Outside steering angle
</sdm-title>
