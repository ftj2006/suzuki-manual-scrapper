</sdm-title>
<sdm1>
<sdm-condition>
Front
</sdm-condition>
<sdm2>
<sdm-condition>
Standard value
</sdm-condition>
<sdm-value>
IN 0&#176; 06’
</sdm-value>
</sdm2>
<sdm2>
<sdm-condition>
Minimum value
</sdm-condition>
<sdm-value>
OUT 0&#176; 10’
</sdm-value>
</sdm2>
<sdm2>
<sdm-condition>
Maximum value
</sdm-condition>
<sdm-value>
IN 0&#176; 22’
</sdm-value>
</sdm2>
</sdm1>
</spec-sdm>
<spec-sdm>
<sdm-title>
Total toe-in (Using toe-in gauge)
</sdm-title>
<sdm-part>
“b” – “a”
</sdm-part>
<sdm1>
<sdm-condition>
Front
</sdm-condition>
<sdm2>
<sdm-condition>
Standard value
</sdm-condition>
<sdm-value>
IN 1.0 mm (IN 0.039 in.)
</sdm-value>
</sdm2>
<sdm2>
<sdm-condition>
Minimum value
</sdm-condition>
<sdm-value>
OUT 2.0 mm (OUT 0.078 in.)
</sdm-value>
</sdm2>
<sdm2>
<sdm-condition>
Maximum value
</sdm-condition>
<sdm-value>
IN 4.0 mm (IN 0.157 in.)
</sdm-value>
</sdm2>
</sdm1>
</spec-sdm>
<figure>
