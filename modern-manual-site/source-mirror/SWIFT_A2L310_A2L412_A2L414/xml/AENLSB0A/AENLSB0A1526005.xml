<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1E">
<servcat sctnbr = "01" scnbr = "05">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1526005" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Oil Cooler Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1526004">Oil Cooler Components:K14D</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1526005001">
<title>
Removal
</title>
<s1>
<ptxt>
Drain coolant. 
<intxreftitleoff1 refid = "AENLSB0A1626004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove ISG. 
<intxreftitleoff1 refid = "AENLSB0A1A26005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove oil cooler (1) and oil cooler gasket.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A152008.jpg" width = "88.000mm" height = "54.006mm" ver = "01" gw = "185" gh = "137"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1526005002">
<title>
Installation
</title>
<s1>
<ptxt>
Clean mating surface of cylinder block and oil cooler removing oil and coolant thoroughly.
</ptxt>
</s1>
<s1>
<ptxt>
Install oil cooler (1) with new gasket.
</ptxt>
</s1>
<s1>
<ptxt>
Tighten oil cooler bolts to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1E219">
<t-part>
Oil cooler bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "ILSB0A152009.jpg" width = "88.000mm" height = "54.006mm" ver = "01" gw = "185" gh = "137"/>
</figure>
</s1>
<s1>
<ptxt>
Install ISG. 
<intxreftitleoff1 refid = "AENLSB0A1A26005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Refill cooling system with coolant. 
<intxreftitleoff1 refid = "AENLSB0A1626005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check cooling system for leakage. 
<intxreftitleoff1 refid = "AENLSB0A1626003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check engine oil level. 
<intxreftitleoff refid = "AENLSB0A1526001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff>
</ptxt>
</s1>
<s1>
<ptxt>
Start engine and check that there is no leakage of engine oil and coolant.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
