<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "10E">
<servcat sctnbr = "10" scnbr = "05">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0AA506004" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Rearend Door Opener and Request Switch Removal and Installation
</title>
<servinfosub id = "AENLSB0AA506004001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove rearend door trim. 
<intxreftitleoff1 refid = "AENLSB0A9606010"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect rearend door opener and request switch connector (1) and clamps (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0AA50016.jpg" width = "88.000mm" height = "57.816mm" ver = "01" gw = "200" gh = "147"/>
</figure>
</s1>
<s1>
<ptxt>
Remove rearend door opener and request switch holder (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0AA50017.jpg" width = "88.000mm" height = "54.596mm" ver = "01" gw = "185" gh = "138"/>
</figure>
</s1>
<s1>
<ptxt>
Remove screws, and then remove rearend door opener and request switch (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0AA50018.swf" width = "88.000mm" height = "60.516mm" ver = "01" gw = "146" gh = "155"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AA506004002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0AA506008">Request Switch Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
