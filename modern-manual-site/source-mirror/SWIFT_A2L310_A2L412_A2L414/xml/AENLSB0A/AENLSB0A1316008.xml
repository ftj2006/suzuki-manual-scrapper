<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1316008" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
APP Sensor Inspection
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1316007">Accelerator Pedal Assembly (Incorporating APP Sensor) Removal and Installation:K14C</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Remove accelerator pedal assembly. 
<intxreftitleoff1 refid = "AENLSB0A1316007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check APP sensor output voltage as follows.
</ptxt>
<ptxt>
If faulty condition is found, replace accelerator pedal assembly. 
<intxreftitleoff1 refid = "AENLSB0A1316007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<s2>
<ptxt>
Arrange 3 new 1.5 V batteries (1) in series, and check that total voltage is 4.5 to 5.0 V.
</ptxt>
</s2>
<s2>
<ptxt>
Connect voltmeter (2) and batteries to APP sensor as shown in figure.
</ptxt>
<figure>
<graphic graphicname = "IE3J0P130009.swf" width = "88.000mm" height = "95.152mm" ver = "01" gw = "183" gh = "253"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
