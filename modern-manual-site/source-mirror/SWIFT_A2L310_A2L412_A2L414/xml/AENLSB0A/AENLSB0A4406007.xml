<suzuki><manual>
<section sectnbr = "4D">
<servcat sctnbr = "04" scnbr = "04">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A4406007" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Parking Brake Switch Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A4406001">Parking Brake Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A4406007001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove floor console box. 
<intxreftitleoff1 refid = "AENLSB0A9806020"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect parking brake switch connector from parking brake lever.
</ptxt>
</s1>
<s1>
<ptxt>
Remove parking brake switch from parking brake lever.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A4406007002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten parking brake screw (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T4D002">
<t-part>
Parking brake screw
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
1.5
</t-value1>
<t-value2>
0.15
</t-value2>
<t-value3>
1.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IFJA0P440011.jpg" width = "88.000mm" height = "106.459mm" ver = "01" gw = "215" gh = "285"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
