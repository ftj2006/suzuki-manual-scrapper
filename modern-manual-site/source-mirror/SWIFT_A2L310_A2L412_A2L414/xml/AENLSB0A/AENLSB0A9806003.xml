<suzuki><manual>
<section sectnbr = "9H">
<servcat sctnbr = "09" scnbr = "08">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9806003" svcinfotypenbr = "08" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Front Bumper Member Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9806001">Front Bumper Removal and Installation</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A9806003001">
<title>
Removal
</title>
<s1>
<ptxt>
For DSBS model, remove RBS control module, RBS control module bracket and RBS control module inner cover if necessary. 
<intxreftitleoff1 refid = "AENLSB0AA126001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove outside air temperature sensor. 
<intxreftitleoff1 refid = "AENLSB0AA206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine undercover (1) (if equipped) and engine under side covers (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove front bumper lower absorber (3) from front end lower cover (4) in arrow direction.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A980003.jpg" width = "183.000mm" height = "182.690mm" ver = "01" gw = "497" gh = "501"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
5.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Lock
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Remove front end lower cover (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove front end upper cover (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove horn. 
<intxreftitleoff1 refid = "AENLSB0A9306004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove front lower crossmember (3) if necessary.
</ptxt>
</s1>
<s1>
<ptxt>
Remove hood lock member films (4) if necessary.
</ptxt>
</s1>
<s1 page = "1">
<ptxt>
Remove front bumper member (5).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A980004.jpg" width = "183.000mm" height = "176.838mm" ver = "02" gw = "499" gh = "485"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.394in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MADONOT" width = "5.132mm" height = "3.048mm"/>
:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
Do not reuse.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9806003002" page = "1">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten new front lower crossmember bolts (strength class: 10.9) (1) in numerical order (“1” – “2”) to specified torque.
</ptxt>
</item>
<item>
<ptxt>
Tighten front bumper member bolts (2) in numerical order (“1” – “3”).
</ptxt>
<torque>
<torqueitem id = "T9H001">
<t-part>
Front lower crossmember bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
16
</t-value1>
<t-value2>
1.6
</t-value2>
<t-value3>
12.0
</t-value3>
</torqueitem>
</torque>
<attention3>
<ptxt>
10.9 strength bolts have a strength identification on the head of bolt as shown in figure.
</ptxt>
<ptxt>
Tightening torque for 10.9 strength bolts is higher than 6.8 strength bolts.
</ptxt>
</attention3>
<figure page = "1">
<graphic graphicname = "IHSB0A980019.jpg" width = "183.000mm" height = "108.821mm" ver = "03" gw = "483" gh = "292"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "6" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.968in"/>
<colspec colnum = "5" colname = "5" colwidth = "0.315in"/>
<colspec colnum = "6" colname = "6" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
3.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Front lower crossmember
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
4.
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Front bumper member
</ptxt>
</entry>
<entry colname = "5" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
5.
</ptxt>
</entry>
<entry colname = "6" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Strength identification
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
