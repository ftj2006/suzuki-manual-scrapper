<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1H">
<servcat sctnbr = "01" scnbr = "08">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1826003" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Ignition Coil Assembly Removal and Installation
</title>
<servinfosub id = "AENLSB0A1826003001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove air cleaner assembly. 
<intxreftitleoff1 refid = "AENLSB0A1426004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect ignition coil connectors.
</ptxt>
</s1>
<s1>
<ptxt>
Remove ignition coil bolts (1) and then pull out ignition coil assemblies (2).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A182003.jpg" width = "88.000mm" height = "70.177mm" ver = "01" gw = "199" gh = "182"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1826003002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1826004">Ignition Coil Assembly Inspection:K14D</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten ignition coil bolts to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1H203">
<t-part>
Ignition coil bolt
</t-part>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
