<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "2">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1A24A03" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Undercharged battery
</title>
<ptxt>
Trouble in charging system will show up as one or more of the following conditions.
</ptxt>
<servinfosub id = "AENLSB0A1A24002003">
<title>
Battery Charging Failure
</title>
<diag type = "condition">
<condition>
<ptxt>
Undercharged battery
</ptxt>
</condition>
<ps>
<ptxt>
Loose or worn accessory drive belt
</ptxt>
</ps>
<action>
<ptxt>
Replace accessory drive belt. 
<intxreftitleoff1 refid = "AENLSB0A1A26004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty accessory drive belt tensioner and drive belt idler pulley
</ptxt>
</ps>
<action>
<ptxt>
Replace accessory drive belt tensioner and drive belt idler pulley. 
<intxreftitleoff1 refid = "AENLSB0A1A26007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Loosen or corroded battery terminals
</ptxt>
</ps>
<action>
<ptxt>
Tighten battery terminals or replace battery. 
<intxreftitleoff1 refid = "AENLSB0A1A26002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ISG
</ptxt>
</ps>
<action>
<ptxt>
Check ISG. 
<intxreftitleoff1 refid = "AENLSB0A1A24003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
