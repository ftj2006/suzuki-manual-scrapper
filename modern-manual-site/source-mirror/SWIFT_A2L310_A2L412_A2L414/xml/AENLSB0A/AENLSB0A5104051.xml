<servinfosub id = "AENLSB0A5104051002">
<title>
Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A5104051003">
<testgroup id = "AENLSB0A5104051004">
<title>
Main power supply circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF” and disconnect connector from TCM.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connection to TCM connector.
</ptxt>
</test1>
<test1>
<ptxt>
If connection is OK, check that voltage between “A1” circuit and ground is battery voltage.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A5104051005">
<title>
Ignition power supply circuit check
</title>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check that voltage between “A2” and “B1” circuit is battery voltage.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
TCM power and ground circuit are in good condition.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A5104051006">
<title>
TCM ground circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Check that resistance between “B1” circuit and ground is less than 1 &#937;.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Repair or replace “A2” circuit.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace “B1” circuit.
</ptxt>
</action>
</testgroup>
</diag>
