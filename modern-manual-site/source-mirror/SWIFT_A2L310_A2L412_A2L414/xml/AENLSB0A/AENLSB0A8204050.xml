<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "8B">
<servcat sctnbr = "08" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A8204050" svcinfotypenbr = "06" svcinfoqualnbr = "02" supplyoff = "1" modify = "0">
<title>
DTC B1095-01 / B1095-95 / B1096-01 / B1096-95
</title>
<servinfosub id = "AENLSB0A8204050001">
<title>
DTC Detecting Condition and Trouble Area
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "5.188in"/>
<colspec colnum = "2" colname = "2" colwidth = "2.016in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
DTC detection condition
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Trouble area
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
B1095-01: Side Rear Impact Sensor No Response (Driver Side)
</emph>
</ptxt>
<ptxt>
Driver rear side-impact G sensor has communicated with no response.
</ptxt>
</entry>
<entry colname = "2" morerows = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
Driver and/or passenger rear side-impact G sensor circuit
</ptxt>
</item>
<item>
<ptxt>
Driver and/or passenger rear side-impact G sensor
</ptxt>
</item>
<item>
<ptxt>
SDM
</ptxt>
</item>
</list1>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
B1095-95: Side Rear Impact Sensor Communication Data Inconsistent (Driver Side)
</emph>
</ptxt>
<ptxt>
Driver rear side-impact G sensor has communicated with inconsistent ID code.
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
B1096-01: Side Rear Impact Sensor No Response (Passenger Side)
</emph>
</ptxt>
<ptxt>
Passenger rear side-impact G sensor has communicated with no response.
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
B1096-95: Side Rear Impact Sensor Communication Data Inconsistent (Passenger Side)
</emph>
</ptxt>
<ptxt>
Passenger rear side-impact G sensor has communicated with inconsistent ID code.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</servinfosub>
<servinfosub id = "AENLSB0A8204050002">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A8204050003">
<testgroup id = "AENLSB0A8204050004">
<question>
Was “Air Bag Diagnostic System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204050005">
<title>
DTC check
</title>
<test1>
<ptxt>
Check if any of the following DTCs is detected. 
<intxreftitleoff1 refid = "AENLSB0A8204005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
B1095-14, B1095-15 or B1095-87 (DTC B1095-01 or DTC B1095-95)
</ptxt>
</item>
<item>
<ptxt>
B1096-14, B1096-15 or B1096-87 (DTC B1096-01 or DTC B1096-95)
</ptxt>
</item>
</list1>
</test1>
<question>
Is relevant DTC detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to applicable DTC troubleshooting.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204050006">
<title>
Rear side-impact G sensor check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Replace rear side-impact G sensor. 
<intxreftitleoff1 refid = "AENLSB0A8206028"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for DTC. 
<intxreftitleoff1 refid = "AENLSB0A8204005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is DTC detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace SDM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
End.
</ptxt>
</action>
</testgroup>
</diag>
<attention3>
<ptxt>
Upon completion of inspection and repair work, perform the following items.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Reconnect all air bag system components and check that all components are properly mounted.
</ptxt>
</item>
<item>
<ptxt>
Clear DTCs, referring to 
<intxref refid = "AENLSB0A8204006">DTC Clearance</intxref>
 if any DTC is detected.
</ptxt>
</item>
<item>
<ptxt>
Repeat 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
 to check that the trouble has been solved.
</ptxt>
</item>
</list1>
</attention3>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
