<servinfosub id = "AENLSB0A5104030001">
<title>
DTC Detecting Condition and Trouble Area
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "3.595in"/>
<colspec colnum = "2" colname = "2" colwidth = "3.595in"/>
