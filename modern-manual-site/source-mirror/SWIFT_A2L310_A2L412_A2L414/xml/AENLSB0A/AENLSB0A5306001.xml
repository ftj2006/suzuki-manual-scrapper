<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5C">
<servcat sctnbr = "05" scnbr = "03">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5306001" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
CPP No.1 Switch Removal and Installation
</title>
<servinfosub id = "AENLSB0A5306001001">
<title>
Removal
</title>
<s1>
<ptxt>
For LHD, remove steering column. 
<intxreftitleoff1 refid = "AENLSB0A6206009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector of CPP No.1 switch (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove CPP No.1 switch from clutch pedal bracket.
</ptxt>
<figure>
<graphic graphicname = "IFRA0A532001.jpg" width = "88.000mm" height = "71.969mm" ver = "01" gw = "91" gh = "187"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5306001002">
<title>
Installation
</title>
<s1>
<ptxt>
Install CPP No.1 switch to clutch pedal bracket.
</ptxt>
</s1>
<s1>
<ptxt>
Adjust switch position. 
<intxreftitleoff1 refid = "AENLSB0A5306002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Connect connector to CPP No.1 switch securely.
</ptxt>
</s1>
<s1>
<ptxt>
For LHD, install steering column. 
<intxreftitleoff1 refid = "AENLSB0A6206009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
