<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph>
B1093-14: Side Impact Sensor Circuit Shorted to Ground (Driver Side)
</emph>
</ptxt>
<ptxt>
<emph>
8-channel air bag system:
</emph>
</ptxt>
<ptxt>
Driver front side-impact G sensor circuit has been shorted to ground.
</ptxt>
<ptxt>
<emph>
10-channel air bag system:
</emph>
</ptxt>
<ptxt>
Driver front side-impact pressure sensor circuit has been shorted to ground.
</ptxt>
</entry>
<entry colname = "2" morerows = "5" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
8-channel air bag system:
</emph>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Driver and/or passenger front side-impact G sensor circuit
</ptxt>
</item>
<item>
<ptxt>
Driver and/or passenger front side-impact G sensor
</ptxt>
</item>
<item>
<ptxt>
SDM
</ptxt>
</item>
</list1>
<ptxt>
<emph etype = "bold">
10-channel air bag system:
</emph>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
