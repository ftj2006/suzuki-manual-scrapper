<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1326005" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
ECM Learning Procedure of Engine Torque
</title>
<s1>
<ptxt>
Check that the following conditions are satisfied when performing this procedure.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
DTC is not detected in ECM.
</ptxt>
</item>
<item>
<ptxt>
Vehicle is stationary.
</ptxt>
</item>
<item>
<ptxt>
Engine is stopped.
</ptxt>
</item>
<item>
<ptxt>
Engine coolant temperature between 6 &#176;C (43 &#176;F) and 100 &#176;C (212 &#176;F).
</ptxt>
</item>
<item>
<ptxt>
Intake air temperature is higher than 6 &#176;C (43 &#176;F).
</ptxt>
</item>
<item>
<ptxt>
Accelerator pedal is released.
</ptxt>
</item>
<item>
<ptxt>
Battery voltage is higher than 10 V.
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Start engine.
</ptxt>
</s1>
<s1>
<ptxt>
Warm up engine at idle speed to normal operating temperature.
</ptxt>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
