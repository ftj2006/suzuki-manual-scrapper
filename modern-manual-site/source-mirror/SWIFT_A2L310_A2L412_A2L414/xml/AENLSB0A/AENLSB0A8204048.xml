<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "8B">
<servcat sctnbr = "08" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A8204048" svcinfotypenbr = "06" svcinfoqualnbr = "02" supplyoff = "1" modify = "0">
<title>
DTC B1093-01 / B1093-95 / B1094-01 / B1094-95
</title>
<servinfosub id = "AENLSB0A8204048001">
<title>
DTC Detecting Condition and Trouble Area
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "4.981in"/>
<colspec colnum = "2" colname = "2" colwidth = "2.223in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
DTC detection condition
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Trouble area
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
<emph etype = "bold">
B1093-01: Side Impact Sensor No Response (Driver Side)
</emph>
</ptxt>
<ptxt>
<emph etype = "bold">
8-channel air bag system:
</emph>
</ptxt>
<ptxt>
Driver front side-impact G sensor has communicated with no response.
</ptxt>
<ptxt>
<emph etype = "bold">
10-channel air bag system:
</emph>
</ptxt>
<ptxt>
Driver front side-impact pressure sensor has communicated with no response.
</ptxt>
</entry>
<entry colname = "2" morerows = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
8-channel air bag system:
</emph>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Driver and/or passenger front side-impact G sensor circuit
</ptxt>
</item>
<item>
<ptxt>
Driver and/or passenger front side-impact G sensor
</ptxt>
</item>
<item>
<ptxt>
SDM
</ptxt>
</item>
</list1>
<ptxt>
<emph etype = "bold">
10-channel air bag system:
</emph>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Driver and/or passenger front side-impact pressure sensor circuit
</ptxt>
</item>
<item>
<ptxt>
Driver and/or passenger front side-impact pressure sensor
</ptxt>
</item>
<item>
<ptxt>
SDM
</ptxt>
</item>
</list1>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
<emph etype = "bold">
B1093-95: Side Impact Sensor Communication Data Inconsistent (Driver Side)
</emph>
</ptxt>
<ptxt>
<emph etype = "bold">
8-channel air bag system:
</emph>
</ptxt>
<ptxt>
Driver front side-impact G sensor has communicated with inconsistent ID code.
</ptxt>
<ptxt>
<emph etype = "bold">
10-channel air bag system:
</emph>
</ptxt>
<ptxt>
Driver front side-impact pressure sensor has communicated with inconsistent ID code.
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
<emph etype = "bold">
B1094-01: Side Impact Sensor No Response (Passenger Side)
</emph>
</ptxt>
<ptxt>
<emph etype = "bold">
8-channel air bag system:
</emph>
</ptxt>
<ptxt>
Passenger front side-impact G sensor has communicated with no response.
</ptxt>
<ptxt>
<emph etype = "bold">
10-channel air bag system:
</emph>
</ptxt>
<ptxt>
Passenger front side-impact pressure sensor has communicated with no response.
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
<emph etype = "bold">
B1094-95: Side Impact Sensor Communication Data Inconsistent (Passenger Side)
</emph>
</ptxt>
<ptxt>
<emph etype = "bold">
8-channel air bag system:
</emph>
</ptxt>
<ptxt>
Passenger front side-impact G sensor has communicated with inconsistent ID code.
</ptxt>
<ptxt>
<emph etype = "bold">
10-channel air bag system:
</emph>
</ptxt>
<ptxt>
Passenger front side-impact pressure sensor has communicated with inconsistent ID code.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</servinfosub>
<servinfosub id = "AENLSB0A8204048002">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A8204048003">
<testgroup id = "AENLSB0A8204048004">
<question>
Was “Air Bag Diagnostic System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204048005">
<title>
DTC check
</title>
<test1>
<ptxt>
Check if any of the following DTCs is detected. 
<intxreftitleoff1 refid = "AENLSB0A8204005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
B1093-14, B1093-15 or B1093-87 (DTC B1093-01 or DTC B1093-95)
</ptxt>
</item>
<item>
<ptxt>
B1094-14, B1094-15 or B1094-87 (DTC B1094-01 or DTC B1094-95)
</ptxt>
</item>
</list1>
</test1>
<question>
Is relevant DTC detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to applicable DTC diagnosis flow.
</ptxt>
</action>
<result type = "no"/>
<action>
<list1 type = "unordered">
<item>
<ptxt>
8-channel air bag system: Go to Step 3.
</ptxt>
</item>
<item>
<ptxt>
10-channel air bag system: Go to Step 4.
</ptxt>
</item>
</list1>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204048006">
<title>
Front side-impact G sensor check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Replace front side-impact G sensor. 
<intxreftitleoff1 refid = "AENLSB0A8206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check DTC. 
<intxreftitleoff1 refid = "AENLSB0A8204005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is DTC detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace SDM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
End.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204048007">
<title>
Front side-impact pressure sensor check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Replace front side-impact pressure sensor. 
<intxreftitleoff1 refid = "AENLSB0A8206026"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for DTC. 
<intxreftitleoff1 refid = "AENLSB0A8204005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is DTC detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace SDM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
End.
</ptxt>
</action>
</testgroup>
</diag>
<attention3>
<ptxt>
Upon completion of inspection and repair work, perform the following items.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Reconnect all air bag system components and check that all components are properly mounted.
</ptxt>
</item>
<item>
<ptxt>
Clear DTCs, referring to 
<intxref refid = "AENLSB0A8204006">DTC Clearance</intxref>
 if any DTC is detected.
</ptxt>
</item>
<item>
<ptxt>
Repeat 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
 to check that the trouble has been solved.
</ptxt>
</item>
</list1>
</attention3>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
