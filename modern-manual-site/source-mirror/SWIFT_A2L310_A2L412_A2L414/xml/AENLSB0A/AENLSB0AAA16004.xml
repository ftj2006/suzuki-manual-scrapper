<suzuki><manual>
<section sectnbr = "10J">
<servcat sctnbr = "10" scnbr = "10">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0AAA16004" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Dual Sensor Brake Support OFF Switch and Lane Departure Warning OFF Switch Removal and Installation
</title>
<servinfosub id = "AENLSB0AAA16004001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove steering column hole cover. 
<intxreftitleoff1 refid = "AENLSB0A9306002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect dual sensor brake support OFF switch and lane departure warning OFF switch connector.
</ptxt>
</s1>
<s1>
<ptxt>
Remove dual sensor brake support OFF switch and lane departure warning OFF switch (1) from switch bezel.
</ptxt>
<figure>
<graphic graphicname = "ILSB0AAA1010.jpg" width = "88.000mm" height = "84.376mm" ver = "01" gw = "214" gh = "223"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AAA16004002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0AAA16005">Dual Sensor Brake Support OFF Switch and Lane Departure Warning OFF Switch Inspection:Dual Sensor Brake Support</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
