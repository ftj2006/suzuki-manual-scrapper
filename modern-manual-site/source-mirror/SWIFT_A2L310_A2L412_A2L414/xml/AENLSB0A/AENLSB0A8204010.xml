<servinfosub id = "AENLSB0A8204010002">
<title>
Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A8204010003">
<testgroup id = "AENLSB0A8204010004">
<title>
Warning light check
</title>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<question>
Do other indicator lights come ON?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204010005">
<title>
DTC check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Connect scan tool to DLC.
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for DTC. 
<intxreftitleoff1 refid = "AENLSB0A8204005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is DTC U0073-88 detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to “Troubleshooting for Communication Bus Off”.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0AA814004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0AA824004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204010006">
<title>
Fuse check
</title>
<question>
Is “MTR” fuse for combination meter in good condition?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace “MTR” fuse and check for short circuit to ground.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204010007">
<title>
CAN communication circuit check
</title>
<test1>
<ptxt>
Check CAN communication circuit between SDM and combination meter.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 5.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204010008">
<title>
Combination meter power supply circuit check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Remove combination meter. 
<intxreftitleoff1 refid = "AENLSB0A9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to “G241” connector.
</ptxt>
</test1>
<test1>
<ptxt>
If connection is OK, set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Measure voltage between “G241-3” terminal and ground.
</ptxt>
<servicetool>
<servicetoolitem id = "L8B005">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IGSB0A822012.swf" width = "90.000mm" height = "48.095mm" ver = "01" gw = "214" gh = "120"/>
</testfigure>
</test1>
<question>
Is it 10 – 14 V?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 6.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204010009">
<title>
Combination meter ground circuit check
</title>
<test1>
<ptxt>
Measure resistance between “G241-5” terminal and ground.
</ptxt>
<servicetool>
<servicetoolitem id = "L8B006">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IGSB0A822013.swf" width = "90.000mm" height = "45.724mm" ver = "01" gw = "214" gh = "113"/>
</testfigure>
</test1>
<question>
Is resistance less than 1 &#937;?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace combination meter and recheck “AIR BAG” warning light operation. 
<intxreftitleoff1 refid = "AENLSB0A9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair defective wire harness.
</ptxt>
</action>
</testgroup>
</diag>
<attention3>
<ptxt>
Upon completion of inspection and repair work, perform the following items.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Reconnect all air bag system components and check that all components are properly mounted.
</ptxt>
</item>
<item>
<ptxt>
Repeat 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
 to check that the trouble has been solved.
</ptxt>
</item>
</list1>
</attention3>
