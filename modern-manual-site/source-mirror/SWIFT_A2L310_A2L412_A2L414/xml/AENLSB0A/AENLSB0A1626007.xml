<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1F">
<servcat sctnbr = "01" scnbr = "06">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1626007" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Thermostat Heater Removal and Installation
</title>
<servinfosub id = "AENLSB0A1626007001">
<title>
Removal
</title>
<s1>
<ptxt>
Drain coolant. 
<intxreftitleoff1 refid = "AENLSB0A1626004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect thermostat heater connector.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect radiator inlet hose (1) from thermostat heater (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove thermostat heater.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A162014.jpg" width = "88.000mm" height = "50.789mm" ver = "01" gw = "185" gh = "127"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1626007002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1626008">Thermostat Heater Inspection:K14D</intxrefpoff>
</ptxt>
<attention4>
<ptxt>
Reinstallation of thermostat heater may cause coolant leakage.
</ptxt>
<ptxt>
Once the thermostat heater is removed, replace it with a new one.
</ptxt>
</attention4>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Fit gasket (1) to thermostat heater (2).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A162037.jpg" width = "88.000mm" height = "68.738mm" ver = "01" gw = "185" gh = "178"/>
</figure>
</item>
<item>
<ptxt>
Tighten thermostat heater bolts (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1F210">
<t-part>
Thermostat heater bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "ILSB0A162015.jpg" width = "88.000mm" height = "50.789mm" ver = "01" gw = "185" gh = "127"/>
</figure>
</item>
<item>
<ptxt>
Refill cooling system with coolant. 
<intxreftitleoff1 refid = "AENLSB0A1626005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Check cooling system for leakage. 
<intxreftitleoff1 refid = "AENLSB0A1626003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
