<suzuki><manual>
<section sectnbr = "9B">
<servcat sctnbr = "09" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9206023" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Headlight Leveling Switch Removal and Installation (Headlight Manual Leveling Model)
</title>
<servinfosub id = "AENLSB0A9206023001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove steering column hole cover. 
<intxreftitleoff1 refid = "AENLSB0A9306002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect headlight leveling switch connector.
</ptxt>
</s1>
<s1>
<ptxt>
Remove headlight leveling switch (1) from instrument panel switch bezel while holding claws (2) pressed in arrow directions.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A920056.jpg" width = "88.000mm" height = "70.505mm" ver = "01" gw = "207" gh = "183"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9206023002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9206024">Headlight Leveling Switch Inspection (Headlight Manual Leveling Model)</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
