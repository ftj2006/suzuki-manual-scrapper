<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "2A">
<servcat sctnbr = "02" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A2104A04" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Shimmy, shake or vibration
</title>
<diag type = "condition">
<condition>
<ptxt>
Shimmy, shake or vibration
</ptxt>
</condition>
<ps>
<ptxt>
Wheel out of balance
</ptxt>
</ps>
<action>
<ptxt>
Balance wheel(s) or replace tire(s) and/or wheel(s).
</ptxt>
</action>
<ps>
<ptxt>
Loose wheel bearings
</ptxt>
</ps>
<action>
<ptxt>
Replace wheel hub assembly.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A3116007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A3126003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Worn tie-rod ends
</ptxt>
</ps>
<action>
<ptxt>
Replace tie-rod ends. 
<intxreftitleoff1 refid = "AENLSB0A6206022"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Worn suspension arm joints
</ptxt>
</ps>
<action>
<ptxt>
Replace suspension arm. 
<intxreftitleoff1 refid = "AENLSB0A2206008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Excessive tire or wheel run-out
</ptxt>
</ps>
<action>
<ptxt>
Replace wheel and/or tire. 
<intxreftitleoff1 refid = "AENLSB0A2406001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Blister or bump on tire
</ptxt>
</ps>
<action>
<ptxt>
Replace tire. 
<intxreftitleoff1 refid = "AENLSB0A2406001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Excessive radial runout of tire / wheel assembly
</ptxt>
</ps>
<action>
<ptxt>
Replace tire or wheel. 
<intxreftitleoff1 refid = "AENLSB0A2406001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Disturbed wheel alignment
</ptxt>
</ps>
<action>
<ptxt>
Check and adjust wheel alignment. 
<intxreftitleoff1 refid = "AENLSB0A2206001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Loose or worn steering linkage
</ptxt>
</ps>
<action>
<ptxt>
Check steering system.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Steering wheel: 
<intxreftitleoff1 refid = "AENLSB0A6304034"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Steering shaft joint: 
<intxreftitleoff1 refid = "AENLSB0A6206010"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Pinion shaft: 
<intxreftitleoff1 refid = "AENLSB0A6206029"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Tie-rod end: 
<intxreftitleoff1 refid = "AENLSB0A6206023"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Loose steering gear case bolts
</ptxt>
</ps>
<action>
<ptxt>
Tighten steering gear case bolts. 
<intxreftitleoff1 refid = "AENLSB0A6206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
