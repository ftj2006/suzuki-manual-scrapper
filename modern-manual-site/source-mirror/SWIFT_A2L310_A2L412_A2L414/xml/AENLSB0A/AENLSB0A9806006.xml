<servinfo servinfosgmlid = "AENLSB0A9806006" svcinfotypenbr = "08" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Cowl Top Garnish Removal and Installation
</title>
<servinfosub id = "AENLSB0A9806006001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove windshield wiper arms. 
<intxreftitleoff1 refid = "AENLSB0A9406003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove cowl top side garnishes (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove washer hose and then remove cowl top garnish (1). 
<intxreftitleoff1 refid = "AENLSB0A9403001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove washer nozzle from cowl top garnish if necessary. 
<intxreftitleoff1 refid = "AENLSB0A9406007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove the following parts from cowl upper panel (4).
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
ECM (K14C model): 
<intxreftitleoff1 refid = "AENLSB0A1316001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
ECM (K14D model): 
<intxreftitleoff1 refid = "AENLSB0A1326001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Windshield wiper motor and wiper motor harness: 
<intxreftitleoff1 refid = "AENLSB0A9406003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Disconnect engine harness clamps.
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Remove cowl upper panel.
</ptxt>
