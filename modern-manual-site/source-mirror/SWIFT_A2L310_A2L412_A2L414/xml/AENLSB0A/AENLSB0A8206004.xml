<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "8B">
<servcat sctnbr = "08" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A8206004" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
SDM Removal and Installation
</title>
<attention1>
<ptxt>
If the SDM is handled roughly when performing the service operations described below, there is a risk of personal injury due to accidental activation of the air bag system.
</ptxt>
<ptxt>
Read 
<intxref refid = "AENLSB0A8200001">Precautions for Air Bag System Service</intxref>
 before starting the operations described below and follow all of the instructions provided.
</ptxt>
</attention1>
<servinfosub id = "AENLSB0A8206004001">
<title>
Removal
</title>
<s1>
<ptxt>
Disable air bag system. 
<intxreftitleoff1 refid = "AENLSB0A8206001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove floor console side covers. 
<intxreftitleoff1 refid = "AENLSB0A9806020"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Turn over floor carpet.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect SDM connectors (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove SDM (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A821045.jpg" width = "88.000mm" height = "51.556mm" ver = "01" gw = "185" gh = "130"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A8206004002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A8206005">SDM Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Check that none of the following faulty conditions exists.
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Bend, scratch, deformation on mating surface of vehicle body where SDM is mounted
</ptxt>
</item>
<item>
<ptxt>
Foreign material or rust on mating surface of vehicle body where SDM is mounted
</ptxt>
</item>
</list2>
<item>
<ptxt>
Tighten SDM bolts (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T8B001">
<t-part>
SDM bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
9.0
</t-value1>
<t-value2>
0.92
</t-value2>
<t-value3>
7.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A821046.jpg" width = "88.000mm" height = "53.667mm" ver = "01" gw = "189" gh = "136"/>
</figure>
</item>
<item>
<ptxt>
Enable air bag system. 
<intxreftitleoff1 refid = "AENLSB0A8206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
