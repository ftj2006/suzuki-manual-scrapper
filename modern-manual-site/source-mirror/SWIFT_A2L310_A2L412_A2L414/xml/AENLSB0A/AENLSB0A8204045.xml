<servinfosub id = "AENLSB0A8204045003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A8204045004">
<testgroup id = "AENLSB0A8204045005">
<question>
Was “Air Bag Diagnostic System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204045006">
<title>
Seat belt pretensioner check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to “L275” or “L276” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “L275” or “L276” connector. 
<intxreftitleoff1 refid = "AENLSB0A8206014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Connect “STEERING WHEEL” harness (1) of special tool (C), (A) and (B) to “L275” or “L276” connector.
</ptxt>
<servicetool>
<servicetoolitem id = "L8B085">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
<servicetoolitem id = "L8B086">
<s-part>
(B)
</s-part>
<s-number num = "09932-78310">
09932–78310
</s-number>
</servicetoolitem>
<servicetoolitem id = "L8B087">
<s-part>
(C)
</s-part>
<s-number num = "09932-75011">
09932–75011
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IHSB0A822012.swf" width = "90.000mm" height = "53.370mm" ver = "01" gw = "197" gh = "135"/>
</testfigure>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for DTC. 
<intxreftitleoff1 refid = "AENLSB0A8204005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is DTC B1071-1B or DTC B1072-1B detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace rear seat belt pretensioner. 
<intxreftitleoff1 refid = "AENLSB0A8106007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204045007">
<title>
Rear seat belt pretensioner circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to “G12” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “G12” connector. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Release shorting bar in SDM connector. 
<intxreftitleoff1 refid = "AENLSB0A8206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance between “L276-1” and “G12-20” terminals (DTC B1071-1B): 1 &#937; or less
</ptxt>
</item>
<item>
<ptxt>
Resistance between “L276-2” and “G12-21” terminals (DTC B1071-1B): 1 &#937; or less
</ptxt>
</item>
<item>
<ptxt>
Resistance between “L275-1” and “G12-4” terminals (DTC B1072-1B): 1 &#937; or less
</ptxt>
</item>
<item>
<ptxt>
Resistance between “L275-2” and “G12-3” terminals (DTC B1072-1B): 1 &#937; or less
</ptxt>
<servicetool>
<servicetoolitem id = "L8B088">
<s-part>
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace SDM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204045008">
<title>
Instrument panel harness circuit check
</title>
<test1>
<ptxt>
Check for proper connection to “G343” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “G343” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Release shorting bar in SDM connector. 
<intxreftitleoff1 refid = "AENLSB0A8206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “A5” and “A6” circuits (DTC B1071-1B): 1 &#937; or less
</ptxt>
</item>
<item>
<ptxt>
Resistance of “A7” and “A8” circuits (DTC B1072-1B): 1 &#937; or less
</ptxt>
<servicetool>
<servicetoolitem id = "L8B089">
<s-part>
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace floor harness.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace instrument panel harness.
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
<attention3>
<ptxt>
Upon completion of inspection and repair work, perform the following items.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Reconnect all air bag system components and check that all components are properly mounted.
</ptxt>
</item>
<item>
<ptxt>
Clear DTCs, referring to 
<intxref refid = "AENLSB0A8204006">DTC Clearance</intxref>
 if any DTC is detected.
</ptxt>
</item>
<item>
<ptxt>
Repeat 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
 to check that the trouble has been solved.
</ptxt>
</item>
</list1>
</attention3>
</servinfo>
