<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "10A">
<servcat sctnbr = "10" scnbr = "01">
<configtype typenbr = "1">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0AA114A04" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Cruise control system cannot be canceled
</title>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
Perform cruise control system check referring to 
<intxref refid = "AENLSB0AA114001">Cruise Control System Check:Cruise Control</intxref>
 before performing this Cruise Control System Symptom Diagnosis.
</ptxt>
</item>
<item>
<ptxt>
Check each part in the order from the top of the following list.
</ptxt>
</item>
</list1>
</attention3>
<diag type = "condition">
<condition>
<ptxt>
Cruise control system cannot be canceled
</ptxt>
</condition>
<ps>
<ptxt>
Faulty CANCEL switch
</ptxt>
</ps>
<action>
<ptxt>
Check CANCEL switch. 
<intxreftitleoff1 refid = "AENLSB0AA116001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty brake light switch
</ptxt>
</ps>
<action>
<ptxt>
Check brake light switch. 
<intxreftitleoff1 refid = "AENLSB0AA116005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty CPP switch (M/T model)
</ptxt>
</ps>
<action>
<ptxt>
Check CPP switch. 
<intxreftitleoff1 refid = "AENLSB0AA116003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty wiring or grounding
</ptxt>
</ps>
<action>
<ptxt>
Repair wiring.
</ptxt>
</action>
<ps>
<ptxt>
Faulty ECM
</ptxt>
</ps>
<action>
<ptxt>
Replace ECM after checking that none of above parts is faulty.
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
