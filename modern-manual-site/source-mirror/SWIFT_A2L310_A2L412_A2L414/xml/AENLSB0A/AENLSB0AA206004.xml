<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "10B">
<servcat sctnbr = "10" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0AA206004" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Outside Air Temperature Sensor Removal and Installation (If Equipped)
</title>
<servinfosub id = "AENLSB0AA206004001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove front bumper. 
<intxreftitleoff1 refid = "AENLSB0A9806001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector (1) from outside air temperature sensor.
</ptxt>
</s1>
<s1>
<ptxt>
Remove outside air temperature sensor (2) from front end lower cover.
</ptxt>
<figure>
<graphic graphicname = "ILSB0AA20009.swf" width = "88.000mm" height = "65.095mm" ver = "01" gw = "205" gh = "168"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AA206004002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0AA206005">Outside Air Temperature Sensor Inspection (If Equipped)</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
