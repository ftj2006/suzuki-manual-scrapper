<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1A16004" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Water Pump / Generator Drive Belt Removal and Installation
</title>
<servinfosub id = "AENLSB0A1A16004001" page = "2">
<title>
Removal
</title>
<s1>
<ptxt>
Hoist vehicle and remove right side engine under side cover.
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Remove compressor drive belt before removing water pump / generator drive belt (1). 
<intxreftitleoff1 refid = "AENLSB0A7206042"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Loosen generator bolt (2), pivot bolt (3) and adjuster bolt (4), and then remove water pump / generator drive belt.
</ptxt>
<figure>
<graphic graphicname = "IFAE0A1A0009.jpg" width = "88.000mm" height = "62.981mm" ver = "01" gw = "199" gh = "162"/>
</figure>
</s1>
<s1>
<ptxt>
Remove water pump / generator drive belt idler pulley if necessary. 
<intxreftitleoff1 refid = "AENLSB0A1A16006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1A16004002" page = "2">
<title>
Installation
</title>
<s1>
<ptxt>
Install water pump / generator drive belt idler pulley, if removed. 
<intxreftitleoff1 refid = "AENLSB0A1A16006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Install water pump / generator drive belt (1) as shown in figure.
</ptxt>
<figure>
<graphic graphicname = "IFAE0A1A0010.jpg" width = "88.000mm" height = "62.811mm" ver = "01" gw = "199" gh = "162"/>
</figure>
</s1>
<s1 page = "2">
<ptxt>
Adjust belt tension. 
<intxreftitleoff1 refid = "AENLSB0A1A16003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install compressor drive belt. 
<intxreftitleoff1 refid = "AENLSB0A7206042"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<attention3>
<ptxt>
Check that drive belt is installed in grooves of each pulley correctly.
</ptxt>
</attention3>
</s1>
<s1>
<ptxt>
Install right side engine under side cover.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
