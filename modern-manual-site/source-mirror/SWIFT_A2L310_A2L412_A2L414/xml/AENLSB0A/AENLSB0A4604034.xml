<suzuki><manual>
<section sectnbr = "4F">
<servcat sctnbr = "04" scnbr = "06">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A4604034" svcinfotypenbr = "06" svcinfoqualnbr = "02" supplyoff = "1" modify = "0">
<title>
DTC C1069
</title>
<servinfosub id = "AENLSB0A4604034001">
<title>
DTC Detecting Condition and Trouble Area
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "3.937in"/>
<colspec colnum = "2" colname = "2" colwidth = "3.256in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
DTC detecting condition
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Trouble area
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
C1069: Steering Angle Sensor Specification Unregistered
</emph>
</ptxt>
<ptxt>
Steering angle sensor detects unconfirmed failure.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
ESP<sup>&#174;</sup> control module
</ptxt>
</item>
<item>
<ptxt>
Lighting and turn signal switch
</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</servinfosub>
<servinfosub id = "AENLSB0A4604034002">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A4604034003">
<testgroup id = "AENLSB0A4604034004">
<title>
DTC check
</title>
<test1>
<ptxt>
Replace lighting and turn signal switch. 
<intxreftitleoff1 refid = "AENLSB0A9206019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Perform 
<intxref refid = "AENLSB0A4604005">DTC Check</intxref>
.
</ptxt>
</test1>
<question>
Is DTC C1069 detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ESP<sup>&#174;</sup> hydraulic unit / control module assembly and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A4606005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
End.
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
