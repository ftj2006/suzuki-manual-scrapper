<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1E">
<servcat sctnbr = "01" scnbr = "05">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1516007" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Oil Pan and Oil Pump Strainer Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1516006">Oil Pan and Oil Pump Strainer Components:K14C</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1516007001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove oil level gauge.
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Hoist vehicle and remove engine undercover and right side engine under side cover.
</ptxt>
</s1>
<s1>
<ptxt>
Drain engine oil. 
<intxreftitleoff1 refid = "AENLSB0A1516001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
With hoses connected, detach A/C compressor from cylinder block. 
<intxreftitleoff1 refid = "AENLSB0A7206043"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<attention4>
<ptxt>
When A/C compressor is detached, the A/C hoses could be damaged receiving weight of the compressor.
</ptxt>
<ptxt>
Suspend the removed A/C compressor to the vehicle body while the compressor is detached.
</ptxt>
</attention4>
</s1>
<s1>
<ptxt>
Remove exhaust pipe. 
<intxreftitleoff1 refid = "AENLSB0A1B16004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
For M/T model, remove engine rear torque rod bracket. 
<intxreftitleoff1 refid = "AENLSB0A1416024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove oil filter. 
<intxreftitleoff1 refid = "AENLSB0A1516001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Remove transaxle bolts (1).
</ptxt>
<figure>
<graphic graphicname = "I8C50B150007.swf" width = "88.000mm" height = "46.039mm" ver = "01" gw = "227" gh = "114"/>
</figure>
</s1>
<s1 page = "2">
<ptxt>
Remove oil pan bolts No. 1 (1) and No. 2 (2).
</ptxt>
<figure>
<graphic graphicname = "IFAE0A150037.swf" width = "88.000mm" height = "55.998mm" ver = "01" gw = "190" gh = "142"/>
</figure>
</s1>
<s1>
<ptxt>
Using a large flat-bladed screwdriver (heavy duty type) or the like, open oil pan gradually and carefully from the lug portions and remove it from cylinder block.
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Remove oil pump strainer (1) with O-ring (2).
</ptxt>
<figure>
<graphic graphicname = "IFAE0A150038.swf" width = "88.000mm" height = "60.571mm" ver = "01" gw = "199" gh = "155"/>
</figure>
</s1>
<s1 page = "2">
<ptxt>
Remove oil pan baffle plate (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove stud bolt (2) from cylinder block, if necessary.
</ptxt>
<figure>
<graphic graphicname = "IFAE0A150016.swf" width = "88.000mm" height = "48.922mm" ver = "01" gw = "177" gh = "122"/>
</figure>
</s1>
<s1>
<ptxt>
Remove oil filter stand (1) from oil pan using special tool and wrenches, if necessary.
</ptxt>
<servicetool>
<servicetoolitem id = "L1E106">
<s-part>
(A)
</s-part>
<s-number num = "09915-47350">
09915–47350
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IFFA0B152003.swf" width = "88.000mm" height = "53.808mm" ver = "02" gw = "201" gh = "136"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1516007002">
<title>
Installation
</title>
<s1>
<ptxt>
Clean sealing surface between oil pan and cylinder block.
</ptxt>
<ptxt>
Remove oil, old sealant and dust from sealing surface.
</ptxt>
</s1>
<s1>
<ptxt>
Install oil filter stand (1) to oil pan, if removed, and tighten it with special tool to specified torque.
</ptxt>
<servicetool>
<servicetoolitem id = "L1E107">
<s-part>
(A)
</s-part>
<s-number num = "09915-47350">
09915–47350
</s-number>
</servicetoolitem>
</servicetool>
<torque>
<torqueitem id = "T1E105">
<t-part>
Oil filter stand
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
18
</t-value1>
<t-value2>
1.8
</t-value2>
<t-value3>
13.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IFFA0B152005.swf" width = "88.000mm" height = "53.808mm" ver = "02" gw = "184" gh = "136"/>
</figure>
</s1>
<s1>
<ptxt>
Install oil pan baffle plate stud bolt (1) if removed, and tighten it to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1E106">
<t-part>
Oil pan baffle plate stud bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
</s1>
<s1>
<ptxt>
Install oil pan baffle plate (2), and then tighten oil pan baffle plate bolts (3) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1E107">
<t-part>
Oil pan baffle plate bolt
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "I9P60A151002.swf" width = "88.000mm" height = "50.955mm" ver = "01" gw = "177" gh = "128"/>
</figure>
</s1>
<s1>
<ptxt>
Apply engine oil to new O-ring (1), and install it to oil pump strainer (2).
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Install oil pump strainer with O-ring to oil pump, and then tighten oil pump strainer bolt (3) first and oil pan baffle plate nut (4) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1E108">
<t-part>
Oil pump strainer bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
<torqueitem id = "T1E109">
<t-part>
Oil pan baffle plate nut
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IFAE0A150039.swf" width = "88.000mm" height = "65.315mm" ver = "01" gw = "199" gh = "169"/>
</figure>
</s1>
<s1>
<ptxt>
Check that dowel pins (1) are installed in oil pan and cylinder block.
</ptxt>
<figure>
<graphic graphicname = "I9P60A151004.jpg" width = "88.000mm" height = "67.299mm" ver = "01" gw = "207" gh = "174"/>
</figure>
</s1>
<s1>
<ptxt>
Clean mating surfaces of oil pan and cylinder block.
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Apply sealant to oil pan mating surface as shown in figure.
</ptxt>
<materials>
<materialitem name = "SUZUKI Bond No.1217G" id = "M1E102" uid = "-491504098">
<m-part>
“A”
</m-part>
<m-desc>
Sealant
</m-desc>
<m-number>
99000–31260
</m-number>
<m-name>
SUZUKI Bond No.1217G
</m-name>
</materialitem>
</materials>
<spec>
<title>
Sealant amount for oil pan
</title>
<ptxt>
Width “a”: 3 mm (0.12 in.)
</ptxt>
<ptxt>
Height “b”: 2 mm (0.08 in.)
</ptxt>
</spec>
<figure>
<graphic graphicname = "I8C50A150019.swf" width = "88.000mm" height = "65.544mm" ver = "01" gw = "178" gh = "169"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
1.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
O-ring
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Within 2 minutes after applying sealant, install oil pan to cylinder block and then tighten oil pan bolts No.1 (1) and oil pan bolt No.2 (2) in numerical order (“1” – “17”) evenly and gradually to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1E110">
<t-part>
Oil pan bolt No.1
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
<torqueitem id = "T1E111">
<t-part>
Oil pan bolt No.2
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IHSB0A154002.swf" width = "88.000mm" height = "60.391mm" ver = "02" gw = "238" gh = "155"/>
</figure>
</s1>
<s1>
<ptxt>
Tighten transaxle bolts (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1E112">
<t-part>
Transaxle to engine bolt (M/T model)
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
55
</t-value1>
<t-value2>
5.6
</t-value2>
<t-value3>
40.5
</t-value3>
</torqueitem>
<torqueitem id = "T1E113">
<t-part>
Transaxle to engine bolt (A/T model)
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
54
</t-value1>
<t-value2>
5.5
</t-value2>
<t-value3>
40.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "I8C50B150010.swf" width = "88.000mm" height = "46.039mm" ver = "01" gw = "227" gh = "114"/>
</figure>
</s1>
<s1>
<ptxt>
Install oil filter. 
<intxreftitleoff1 refid = "AENLSB0A1516001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
For M/T model, install engine rear torque rod bracket. 
<intxreftitleoff1 refid = "AENLSB0A1416024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install exhaust pipe. 
<intxreftitleoff1 refid = "AENLSB0A1B16004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install A/C compressor to engine assembly. 
<intxreftitleoff1 refid = "AENLSB0A7206043"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install drain plug and refill engine with engine oil. 
<intxreftitleoff1 refid = "AENLSB0A1516001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install engine undercover and right side engine under side cover.
</ptxt>
</s1>
<s1>
<ptxt>
Install oil level gauge.
</ptxt>
</s1>
<s1>
<ptxt>
Check that there is no leakage of engine oil and exhaust gas.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
