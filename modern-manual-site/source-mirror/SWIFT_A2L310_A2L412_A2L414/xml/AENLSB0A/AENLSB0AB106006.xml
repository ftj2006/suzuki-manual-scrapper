<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "11A">
<servcat sctnbr = "11" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0AB106006" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Brake Stroke Sensor On-Vehicle Inspection
</title>
<s1>
<ptxt>
Set ignition “OFF”, connect SUZUKI scan tool to DLC.
</ptxt>
<servicetool>
<servicetoolitem id = "L11A003">
<s-part>
</s-part>
<s-number num = "NNNNN-00035">
SUZUKI scan tool (Suzuki SDT-II)
</s-number>
</servicetoolitem>
</servicetool>
</s1>
<s1>
<ptxt>
Set ignition “ON” and select “Data List” mode of ECM.
</ptxt>
</s1>
<s1>
<ptxt>
Check that “Brake Stroke” and “Brake Stroke Sensor Voltage” parameters displayed on SUZUKI scan tool varies according to depressed amount of brake pedal.
</ptxt>
<ptxt>
If check result is not as specified, check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Brake stroke sensor circuits
</ptxt>
</item>
<item>
<ptxt>
Brake stroke sensor: 
<intxreftitleoff1 refid = "AENLSB0AB106008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<spec>
<title>
Brake stroke sensor specification
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "3" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "1.299in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.083in"/>
<colspec colnum = "3" colname = "3" colwidth = "1.083in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Brake pedal depressed amount
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Brake stroke
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Brake stroke sensor voltage
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
Released
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
0%
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
0.40 to 1.56 V
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
Fully depressed
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
80 to 100%
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
1.6 to 1.8 V
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</item>
</list1>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
