<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1A">
<servcat sctnbr = "01" scnbr = "01">
<configtype typenbr = "2">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1124A15" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Improper engine idling or engine fails to idle
</title>
<ptxt>
Perform troubleshooting referring to the following points when ECM has detected no DTC and no abnormality has been found in 
<intxref refid = "AENLSB0A1124008">Visual Inspection:K14D</intxref>
 and 
<intxref refid = "AENLSB0A1124009">Engine Basic Inspection:K14D</intxref>
.
</ptxt>
<diag type = "condition">
<condition>
<ptxt>
Improper engine idling or engine fails to idle
</ptxt>
</condition>
<ps>
<ptxt>
Faulty spark plug
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1826002">Spark Plug Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ignition coil assembly
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1826004">Ignition Coil Assembly Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Fuel pressure out of specification
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1724009">Fuel Low-Pressure Basic Check:K14D</intxref>
 and 
<intxref refid = "AENLSB0A1724010">Fuel High-Pressure Basic Check:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Leaky manifold, throttle body or cylinder head gasket
</ptxt>
</ps>
<action>
<ptxt>
Check air intake system.
</ptxt>
</action>
<ps>
<ptxt>
Faulty evaporative emission control system
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1226002">EVAP Canister Purge Valve Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty fuel injector
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1724003">Fuel Injector Circuit Check:K14D</intxref>
 or 
<intxref refid = "AENLSB0A1726014">Fuel Injector Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Poor performance of ECT sensor, MAP sensor or MAF sensor
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1326016">ECT Sensor Inspection:K14D</intxref>
, 
<intxref refid = "AENLSB0A1326010">MAP Sensor Inspection:K14D</intxref>
 or 
<intxref refid = "AENLSB0A1326029">MAF Sensor with IAT Sensor-1 Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty electric throttle body assembly
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1326003">Electric Throttle Body Assembly On-Vehicle Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty APP sensor
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1326008">APP Sensor Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ECM
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1124088">Inspection of ECM and Its Circuits:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Loose connection or disconnection of vacuum hoses
</ptxt>
</ps>
<action>
<ptxt>
Check connection of vacuum hoses.
</ptxt>
</action>
<ps>
<ptxt>
Malfunctioning PCV valve
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1226007">PCV Valve On-Vehicle Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Engine overheating
</ptxt>
</ps>
<action>
<ptxt>
Condition “Engine overheating”
</ptxt>
</action>
<ps>
<ptxt>
Low compression
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1424001">Compression Check:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ISG and/or its circuit
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1A24004">Generator Test:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
VVT system out of order
</ptxt>
</ps>
<action>
<list1 type = "unordered">
<item>
<ptxt>
VVT actuator
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Intake VVT actuator
</ptxt>
</item>
<list3 type = "unordered">
<item>
<ptxt>
Motor part: 
<intxref refid = "AENLSB0A1326040">Intake VVT Actuator On-Vehicle Inspection:K14D</intxref>
</ptxt>
</item>
<item>
<ptxt>
Sprocket part: 
<intxref refid = "AENLSB0A1426037">Camshaft and VVT Actuator Inspection:K14D</intxref>
</ptxt>
</item>
</list3>
<item>
<ptxt>
Exhaust VVT actuator: 
<intxref refid = "AENLSB0A1426037">Camshaft and VVT Actuator Inspection:K14D</intxref>
</ptxt>
</item>
</list2>
<item>
<ptxt>
Valve timing: 
<intxref refid = "AENLSB0A1426034">Timing Chain and Chain Tensioner Inspection:K14D</intxref>
</ptxt>
</item>
<item>
<ptxt>
Exhaust OCV oil circuit: 
<intxref refid = "AENLSB0A1426028">Timing Chain Cover Inspection:K14D</intxref>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Faulty oil pressure and temperature sensor
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1326011">Oil Pressure and Temperature Sensor On-Vehicle Inspection:K14D</intxref>
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
