<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9E">
<servcat sctnbr = "09" scnbr = "05">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A9504003" svcinfotypenbr = "06" svcinfoqualnbr = "04" supplyoff = "1" modify = "0">
<title>
Rear Defogger and Mirror Heater System Symptom Diagnosis (If Equipped)
</title>
<diag type = "condition" id = "AENLSB0A9504003001">
<condition>
<ptxt>
Rear defogger cannot operate
</ptxt>
</condition>
<ps>
<ptxt>
Faulty system circuits (including relays and fuses)
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A9501003">Rear Defogger and Door Mirror Heater System Description (If Equipped)</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty rear defogger switch
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A9506006">Rear Defogger Switch Inspection</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty rear defogger
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A9506005">Rear Defogger Inspection</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty BCM
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0AA204029">Inspection of BCM and Its Circuits</intxref>
</ptxt>
</action>
<condition>
<ptxt>
All mirror heaters do not operate
</ptxt>
</condition>
<ps>
<ptxt>
Blown fuse
</ptxt>
</ps>
<action>
<ptxt>
Replace fuse and check for short circuit.
</ptxt>
</action>
<ps>
<ptxt>
Faulty rear defogger switch
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A9506006">Rear Defogger Switch Inspection</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty wiring or ground
</ptxt>
</ps>
<action>
<ptxt>
Repair wiring.
</ptxt>
</action>
<ps>
<ptxt>
Faulty BCM
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0AA204029">Inspection of BCM and Its Circuits</intxref>
</ptxt>
</action>
<condition>
<ptxt>
One of the door mirror heaters does not operate
</ptxt>
</condition>
<ps>
<ptxt>
Faulty mirror heater
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A9506019">Power Door Mirror and Mirror Heater On-Vehicle Inspection (If Equipped)</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty wiring or ground
</ptxt>
</ps>
<action>
<ptxt>
Repair wiring.
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
