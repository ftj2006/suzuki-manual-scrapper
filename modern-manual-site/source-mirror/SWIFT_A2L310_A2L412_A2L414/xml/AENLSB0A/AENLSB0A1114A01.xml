<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1A">
<servcat sctnbr = "01" scnbr = "01">
<configtype typenbr = "1">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1114A01" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Hard starting (Engine can be cranked)
</title>
<ptxt>
Perform troubleshooting referring to the following points when ECM has detected no DTC and no abnormality has been found in 
<intxref refid = "AENLSB0A1114008">Visual Inspection:K14C</intxref>
 and 
<intxref refid = "AENLSB0A1114009">Engine Basic Inspection:K14C</intxref>
.
</ptxt>
<diag type = "condition">
<condition>
<ptxt>
Hard starting (Engine can be cranked)
</ptxt>
</condition>
<ps>
<ptxt>
Faulty spark plug
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1816002">Spark Plug Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ignition coil
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1816004">Ignition Coil Assembly Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Dirty or clogged fuel hoses or pipes
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1714007">Low-Pressure Fuel Supply Circuit Check:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Malfunctioning fuel pump
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1714004">Fuel Pump and Its Circuit Check:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Malfunctioning high pressure fuel pump
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1714008">High-Pressure Fuel Supply Circuit Check:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Air drawn in through intake manifold gasket or throttle body gasket
</ptxt>
</ps>
<action>
<ptxt>
Check air intake system.
</ptxt>
</action>
<ps>
<ptxt>
Faulty electric throttle body assembly
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1316003">Electric Throttle Body Assembly On-Vehicle Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty APP sensor
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1316008">APP Sensor Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ECT sensor, MAP sensor or MAF sensor
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1316016">ECT Sensor Inspection:K14C</intxref>
, 
<intxref refid = "AENLSB0A1316010">MAP Sensor Inspection:K14C</intxref>
 or 
<intxref refid = "AENLSB0A1316027">MAF Sensor with IAT Sensor-1 Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ECM
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1114082">Inspection of ECM and Its Circuits:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Low compression
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1414001">Compression Check:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Poor spark plug tightening or faulty gasket
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1816001">Spark Plug Removal and Installation:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Compression leakage from valve seat
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416042">Valve and Valve Guide Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Sticky valve stem
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416042">Valve and Valve Guide Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Weak or damaged valve springs
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416045">Valve Spring Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Compression leakage at cylinder head gasket
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416043">Cylinder Head Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Sticky or damaged piston ring
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416049">Cylinder, Piston and Piston Ring Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Worn piston, piston ring or cylinder
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416049">Cylinder, Piston and Piston Ring Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Malfunctioning PCV valve
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1216007">PCV Valve On-Vehicle Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
VVT system out of order
</ptxt>
</ps>
<action>
<list1 type = "unordered">
<item>
<ptxt>
VVT actuator: 
<intxref refid = "AENLSB0A1416037">Camshaft and VVT Actuator Inspection:K14C</intxref>
</ptxt>
</item>
<item>
<ptxt>
Valve timing: 
<intxref refid = "AENLSB0A1416034">Timing Chain and Chain Tensioner Inspection:K14C</intxref>
</ptxt>
</item>
<item>
<ptxt>
OCV oil circuit: 
<intxref refid = "AENLSB0A1416028">Timing Chain Cover Inspection:K14C</intxref>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Faulty valve rocker arm
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416040">Valve Rocker Arm Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty valve lash adjuster
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416039">Valve and Cylinder Head Removal and Installation:K14C</intxref>
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
