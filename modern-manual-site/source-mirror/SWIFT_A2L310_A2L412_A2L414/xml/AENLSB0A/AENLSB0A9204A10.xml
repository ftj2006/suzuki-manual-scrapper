<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9B">
<servcat sctnbr = "09" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A9204A10" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Brake light(s) does not light up
</title>
<diag type = "condition">
<condition>
<ptxt>
Brake light(s) does not light up
</ptxt>
</condition>
<ps>
<ptxt>
Faulty system circuit (including relays and fuses)
</ptxt>
</ps>
<action>
<ptxt>
Repair circuit and replace relay and/or fuse.
</ptxt>
</action>
<ps>
<ptxt>
Faulty brake light switch
</ptxt>
</ps>
<action>
<ptxt>
Refer to 
<intxref refid = "AENLSB0A4106012">Brake Light Switch Inspection</intxref>
.
</ptxt>
</action>
<ps>
<ptxt>
Faulty rear combination light
</ptxt>
</ps>
<action>
<ptxt>
If the above are all normal, replace rear combination light.
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
