<suzuki><manual>
<section sectnbr = "1G">
<servcat sctnbr = "01" scnbr = "07">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1726009" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
High Pressure Fuel Pump On-Vehicle Inspection
</title>
<s1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect high pressure fuel pump connector.
</ptxt>
</s1>
<s1>
<ptxt>
Check resistance between terminals of high pressure fuel pump solenoid.
</ptxt>
<ptxt>
If check result is not as specified, replace high pressure fuel pump. 
<intxreftitleoff1 refid = "AENLSB0A1726010"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<spec>
<title>
High pressure fuel pump solenoid resistance
</title>
<ptxt>
0.49 – 0.59 &#937; at 20 &#176;C (68 &#176;F)
</ptxt>
</spec>
<figure>
<graphic graphicname = "ILSB0A172017.jpg" width = "88.000mm" height = "69.924mm" ver = "01" gw = "199" gh = "182"/>
</figure>
</s1>
<s1>
<ptxt>
Connect high pressure fuel pump connector.
</ptxt>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
