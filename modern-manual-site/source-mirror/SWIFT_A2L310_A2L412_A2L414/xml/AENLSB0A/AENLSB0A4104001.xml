<suzuki><manual>
<section sectnbr = "4A">
<servcat sctnbr = "04" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A4104001" svcinfotypenbr = "06" svcinfoqualnbr = "04" supplyoff = "1" modify = "0">
<title>
Brake Symptom Diagnosis
</title>
<diag type = "condition" id = "AENLSB0A4104001001">
<condition>
<ptxt>
Not enough braking force
</ptxt>
</condition>
<ps>
<ptxt>
Brake fluid leakage from brake lines
</ptxt>
</ps>
<action>
<ptxt>
Locate leaking point and repair. 
<intxreftitleoff1 refid = "AENLSB0A4106015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Brake disc or pads stained with fluid, grease or other oil
</ptxt>
</ps>
<action>
<ptxt>
Clean or replace.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front brake disc: 
<intxreftitleoff1 refid = "AENLSB0A4206005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Front brake pad: 
<intxreftitleoff1 refid = "AENLSB0A4206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear brake disc: 
<intxreftitleoff1 refid = "AENLSB0A4306005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear brake pad: 
<intxreftitleoff1 refid = "AENLSB0A4306003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Overheated brakes
</ptxt>
</ps>
<action>
<ptxt>
Determine cause and repair.
</ptxt>
</action>
<ps>
<ptxt>
Badly worn brake pad
</ptxt>
</ps>
<action>
<ptxt>
Replace.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front brake pad: 
<intxreftitleoff1 refid = "AENLSB0A4206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear brake pad: 
<intxreftitleoff1 refid = "AENLSB0A4306003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Malfunctioning brake caliper assembly
</ptxt>
</ps>
<action>
<ptxt>
Repair or replace.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A4206007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A4306007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Air in system
</ptxt>
</ps>
<action>
<ptxt>
Bleed brake system. 
<intxreftitleoff1 refid = "AENLSB0A4106004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Brake booster internal failure
</ptxt>
</ps>
<action>
<ptxt>
Replace brake booster. 
<intxreftitleoff1 refid = "AENLSB0A4106023"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Inadequate negative pressure for brake booster
</ptxt>
</ps>
<action>
<ptxt>
Check engine condition and vacuum pipe / hose.
</ptxt>
</action>
<ps>
<ptxt>
Malfunctioning ESP<sup>&#174;</sup>
</ptxt>
</ps>
<action>
<ptxt>
Check system and replace if necessary. 
<intxreftitleoff1 refid = "AENLSB0A4604001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<condition>
<ptxt>
Vehicle pulls to one side (Brakes not working uniformly)
</ptxt>
</condition>
<ps>
<ptxt>
Pad and/or disc are wet with water or stained with oil in some brakes
</ptxt>
</ps>
<action>
<ptxt>
Clean or replace.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front brake disc: 
<intxreftitleoff1 refid = "AENLSB0A4206005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Front brake pad: 
<intxreftitleoff1 refid = "AENLSB0A4206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear brake disc: 
<intxreftitleoff1 refid = "AENLSB0A4306005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear brake pad: 
<intxreftitleoff1 refid = "AENLSB0A4306003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Disc is out of round in some brakes
</ptxt>
</ps>
<action>
<ptxt>
Replace.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front brake disc: 
<intxreftitleoff1 refid = "AENLSB0A4206005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear brake disc: 
<intxreftitleoff1 refid = "AENLSB0A4306005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Tires are inflated unequally
</ptxt>
</ps>
<action>
<ptxt>
Inflate equally.
</ptxt>
</action>
<ps>
<ptxt>
Disturbed front wheel alignment
</ptxt>
</ps>
<action>
<ptxt>
Adjust as specified. 
<intxreftitleoff1 refid = "AENLSB0A2206001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Unmatched tires on the same axle
</ptxt>
</ps>
<action>
<ptxt>
Tires with approximately the same amount of tread should be used on the same axle.
</ptxt>
</action>
<ps>
<ptxt>
Restricted brake pipes or hoses
</ptxt>
</ps>
<action>
<ptxt>
Check for damage and replace pipes and/or hoses if necessary. 
<intxreftitleoff1 refid = "AENLSB0A4106015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Malfunctioning brake caliper assembly
</ptxt>
</ps>
<action>
<ptxt>
Check for stuck or sluggish pistons and proper lubrication of caliper slide pin.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A4206009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A4306009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Loose suspension parts
</ptxt>
</ps>
<action>
<ptxt>
Check all suspension mountings. 
<intxreftitleoff1 refid = "AENLSB0A2106001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Loose brake calipers
</ptxt>
</ps>
<action>
<ptxt>
Check and tighten bolts to specified torque.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A4206007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A4306007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<condition>
<ptxt>
Noise (High pitched squeak without brake applied)
</ptxt>
</condition>
<ps>
<ptxt>
Contact of wear indicator to brake disc
</ptxt>
</ps>
<action>
<ptxt>
Replace brake pad.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A4206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A4306003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<condition>
<ptxt>
Excessive pedal travel (Pedal stroke too large)
</ptxt>
</condition>
<ps>
<ptxt>
Brake fluid leakage
</ptxt>
</ps>
<action>
<ptxt>
Locate leaking point and repair. 
<intxreftitleoff1 refid = "AENLSB0A4106015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Air in system (soft / spongy pedal)
</ptxt>
</ps>
<action>
<ptxt>
Bleed brake system. 
<intxreftitleoff1 refid = "AENLSB0A4106004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Badly worn brake pad
</ptxt>
</ps>
<action>
<ptxt>
Replace.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front brake pad: 
<intxreftitleoff1 refid = "AENLSB0A4206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear brake pad: 
<intxreftitleoff1 refid = "AENLSB0A4306003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<condition>
<ptxt>
Brake locked
</ptxt>
</condition>
<ps>
<ptxt>
Malfunctioning ESP<sup>&#174;</sup>
</ptxt>
</ps>
<action>
<ptxt>
Check system and replace if necessary. 
<intxreftitleoff1 refid = "AENLSB0A4604001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<condition>
<ptxt>
Dragging brakes (A very light drag is present in all brakes immediately after pedal is released)
</ptxt>
</condition>
<ps>
<ptxt>
Master cylinder pistons not returning correctly
</ptxt>
</ps>
<action>
<ptxt>
Replace brake master cylinder. 
<intxreftitleoff1 refid = "AENLSB0A4106018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Restricted brake pipes or hoses
</ptxt>
</ps>
<action>
<ptxt>
Check for damage and replace pipes and/or hoses if necessary. 
<intxreftitleoff1 refid = "AENLSB0A4106015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Incorrect parking brake adjustment on rear brakes
</ptxt>
</ps>
<action>
<ptxt>
Check and adjust to correct specifications. 
<intxreftitleoff1 refid = "AENLSB0A4406002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Sluggish parking brake cables or linkage
</ptxt>
</ps>
<action>
<ptxt>
Repair or replace. 
<intxreftitleoff1 refid = "AENLSB0A4406004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Brake caliper piston sticking
</ptxt>
</ps>
<action>
<ptxt>
Repair if necessary.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front brake caliper piston: 
<intxreftitleoff1 refid = "AENLSB0A4206008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear brake caliper piston: 
<intxreftitleoff1 refid = "AENLSB0A4306008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Badly worn piston seal in brake caliper
</ptxt>
</ps>
<action>
<ptxt>
Replace piston seal.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A4206008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A4306008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Improper brake pedal free height
</ptxt>
</ps>
<action>
<ptxt>
Check brake pedal free height. 
<intxreftitleoff1 refid = "AENLSB0A4106007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<condition>
<ptxt>
Pedal pulsation (Pedal pulsates when depressed for braking)
</ptxt>
</condition>
<ps>
<ptxt>
Damaged or loose front and/or rear wheel bearings
</ptxt>
</ps>
<action>
<ptxt>
Replace front wheel hub assembly and/or rear wheel hub assembly.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A3116007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A3126003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Distorted steering knuckle or rear wheel hub assembly
</ptxt>
</ps>
<action>
<ptxt>
Replace.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Knuckle: 
<intxreftitleoff1 refid = "AENLSB0A3116007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear wheel hub assembly: 
<intxreftitleoff1 refid = "AENLSB0A3126003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Excessive disc lateral runout
</ptxt>
</ps>
<action>
<ptxt>
Check per instructions. If not as specified, replace or machine disc.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A4206006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A4306006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<condition>
<ptxt>
Braking noise
</ptxt>
</condition>
<ps>
<ptxt>
Glazed brake pad
</ptxt>
</ps>
<action>
<ptxt>
Repair or replace brake pad.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front brake pad: 
<intxreftitleoff1 refid = "AENLSB0A4206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear brake pad: 
<intxreftitleoff1 refid = "AENLSB0A4306003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Loose front and/or rear wheel bearings
</ptxt>
</ps>
<action>
<ptxt>
Replace front wheel hub assembly and/or rear wheel hub assembly.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A3116007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A3126003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Contact of wear indicator to brake disc
</ptxt>
</ps>
<action>
<ptxt>
Replace brake pads.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A4206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A4306003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
