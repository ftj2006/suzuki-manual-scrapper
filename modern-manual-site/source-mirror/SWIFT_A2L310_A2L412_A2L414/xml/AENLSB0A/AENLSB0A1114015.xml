<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P0016: Crankshaft Position – Camshaft Position Correlation (Bank1 SensorA)
</emph>
</ptxt>
<ptxt>
Difference between camshaft position and crankshaft position is out of specified range.
</ptxt>
<ptxt>
(3 D/C detection logic)
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
CMP sensor and signal rotor
</ptxt>
</item>
<item>
<ptxt>
CKP sensor and sensor plate
</ptxt>
</item>
<item>
<ptxt>
Timing chain
</ptxt>
</item>
<item>
<ptxt>
Timing chain tensioner
</ptxt>
</item>
<item>
<ptxt>
Timing chain tensioner adjuster
</ptxt>
</item>
<item>
<ptxt>
VVT actuator
</ptxt>
</item>
<item>
<ptxt>
ECM
</ptxt>
</item>
</list1>
