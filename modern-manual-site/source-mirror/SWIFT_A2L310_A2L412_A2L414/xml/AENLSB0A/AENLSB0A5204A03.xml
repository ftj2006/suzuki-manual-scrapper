<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5B">
<servcat sctnbr = "05" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A5204A03" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Noise
</title>
<diag type = "condition">
<condition>
<ptxt>
Noise
</ptxt>
</condition>
<ps>
<ptxt>
Insufficient lubricant
</ptxt>
</ps>
<action>
<ptxt>
Add manual transaxle oil. 
<intxreftitleoff1 refid = "AENLSB0A5206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Damaged or worn bearing(s)
</ptxt>
</ps>
<action>
<ptxt>
Replace bearing.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Input shaft left bearing and right bearing: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Countershaft left bearing
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Inner race: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Outer race: 
<intxreftitleoff1 refid = "AENLSB0A5206019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
<item>
<ptxt>
Countershaft right bearing
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Inner race: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Outer race: 
<intxreftitleoff1 refid = "AENLSB0A5206018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
<item>
<ptxt>
Needle bearing
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Input shaft needle bearing: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Countershaft needle bearing: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
<item>
<ptxt>
Differential side bearing
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Inner race: 
<intxreftitleoff1 refid = "AENLSB0A5206031"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Left side outer race: 
<intxreftitleoff1 refid = "AENLSB0A5206019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Right side outer race: 
<intxreftitleoff1 refid = "AENLSB0A5206018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
</list1>
</action>
<ps>
<ptxt>
Damaged or worn gear(s)
</ptxt>
</ps>
<action>
<ptxt>
Replace gear.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Input shaft (1st and 2nd gear), input shaft 3rd gear, 4th gear, 5th gear and 6th gear: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Countershaft 1st gear, 2nd gear, 3rd gear, 4th gear, 5th gear and 6th gear: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Damaged or worn synchronizer parts
</ptxt>
</ps>
<action>
<ptxt>
Replace synchronizer parts.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Low speed synchronizer parts: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
High speed synchronizer parts: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
5th &#38; 6th gear synchronizer parts: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
