<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5B">
<servcat sctnbr = "05" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5206018" svcinfotypenbr = "08" svcinfoqualnbr = "02" page = "2" supplyoff = "1" modify = "0">
<title>
Transaxle Right Case Disassembly and Reassembly
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5206017">Manual Transaxle Assembly Disassembly and Reassembly</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A5206016">Manual Transaxle Assembly Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A5206018001">
<title>
Disassembly
</title>
<s1>
<ptxt>
Remove differential side oil seal from transaxle right case, if necessary. 
<intxreftitleoff1 refid = "AENLSB0A5206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove differential side bearing outer race (1) using brass bar (2), if necessary.
</ptxt>
<figure>
<graphic graphicname = "IAY301520029.swf" width = "88.000mm" height = "70.092mm" ver = "02" gw = "206" gh = "182"/>
</figure>
</s1>
<s1>
<ptxt>
Remove clutch operating cylinder assembly, if necessary. 
<intxreftitleoff1 refid = "AENLSB0A5306013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove input shaft oil seal using special tool, if necessary.
</ptxt>
<servicetool>
<servicetoolitem id = "L5B011">
<s-part>
(A)
</s-part>
<s-number num = "09913-75830">
09913–75830
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "I5RW0A520026.swf" width = "88.000mm" height = "47.005mm" ver = "01" gw = "190" gh = "117"/>
</figure>
</s1>
<s1>
<ptxt>
Break countershaft oil channel (1) with flat-bladed screwdriver or the like and remove it, if necessary.
</ptxt>
<figure>
<graphic graphicname = "IAY301520030.swf" width = "88.000mm" height = "51.720mm" ver = "01" gw = "186" gh = "130"/>
</figure>
</s1>
<s1>
<ptxt>
Remove countershaft right bearing outer race using special tools, if necessary.
</ptxt>
<servicetool>
<servicetoolitem id = "L5B012">
<s-part>
(A)
</s-part>
<s-number num = "09942-15511">
09942–15511
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5B013">
<s-part>
(B)
</s-part>
<s-number num = "09944-96013">
09944–96013
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5B014">
<s-part>
(C)
</s-part>
<s-number num = "09921-26010">
09921–26010
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IDP70A522002.swf" width = "88.000mm" height = "58.472mm" ver = "01" gw = "192" gh = "149"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5206018002">
<title>
Reassembly
</title>
<s1>
<ptxt>
Install new input shaft oil seal (1) facing its spring side downward, if removed. Use special tool and hammer for installation and apply grease to oil seal lip.
</ptxt>
<materials>
<materialitem name = "ECSTAR Grease A" id = "M5B008" uid = "1545785286">
<m-part>
“A”
</m-part>
<m-desc>
Grease
</m-desc>
<m-number>
99000–25480
</m-number>
<m-name>
ECSTAR Grease A
</m-name>
</materialitem>
</materials>
<servicetool>
<servicetoolitem id = "L5B015">
<s-part>
(A)
</s-part>
<s-number num = "09913-75830">
09913–75830
</s-number>
</servicetoolitem>
</servicetool>
<spec>
<title>
Distance from case surface to input shaft oil seal
</title>
<ptxt>
“a”: 1.0 – 2.0 mm (0.04 – 0.07 in.)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IHSB0A523024.jpg" width = "88.000mm" height = "65.045mm" ver = "01" gw = "214" gh = "168"/>
</figure>
</s1>
<s1>
<ptxt>
Install new countershaft oil channel and countershaft right bearing outer race using special tool, if removed.
</ptxt>
<servicetool>
<servicetoolitem id = "L5B016">
<s-part>
(A)
</s-part>
<s-number num = "09913-85210">
09913–85210
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IAY301520032.swf" width = "88.000mm" height = "55.223mm" ver = "01" gw = "190" gh = "140"/>
</figure>
</s1>
<s1>
<ptxt>
Install differential side bearing outer race using special tools and hammer, if removed.
</ptxt>
<servicetool>
<servicetoolitem id = "L5B017">
<s-part>
(A)
</s-part>
<s-number num = "09924-74510">
09924–74510
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5B018">
<s-part>
(B)
</s-part>
<s-number num = "09925-14520">
09925–14520
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "I5RW0A520030.swf" width = "88.000mm" height = "48.631mm" ver = "01" gw = "182" gh = "121"/>
</figure>
</s1>
<s1>
<ptxt>
Install new differential side oil seal to right case, if removed. 
<intxreftitleoff1 refid = "AENLSB0A5206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install clutch operating cylinder assembly, if removed. 
<intxreftitleoff1 refid = "AENLSB0A5306013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
