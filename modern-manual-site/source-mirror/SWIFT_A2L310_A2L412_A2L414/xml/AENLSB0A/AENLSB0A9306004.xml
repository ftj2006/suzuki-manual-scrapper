<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9C">
<servcat sctnbr = "09" scnbr = "03">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9306004" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Horn Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9306005">Horn On-Vehicle Inspection</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A9306004001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove front bumper, front end upper cover and front end lower cover. 
<intxreftitleoff1 refid = "AENLSB0A9806001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect horn connector.
</ptxt>
</s1>
<s1>
<ptxt>
Remove horn (1) from front bumper upper member.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A930030.jpg" width = "88.000mm" height = "76.104mm" ver = "01" gw = "214" gh = "199"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9306004002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten horn bolt to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9C002">
<t-part>
Horn bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
21
</t-value1>
<t-value2>
2.1
</t-value2>
<t-value3>
15.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A930031.jpg" width = "88.000mm" height = "76.104mm" ver = "01" gw = "214" gh = "199"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
