<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1A">
<servcat sctnbr = "01" scnbr = "01">
<configtype typenbr = "2">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1124A01" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Hard starting (Engine can be cranked)
</title>
<ptxt>
Perform troubleshooting referring to the following points when ECM has detected no DTC and no abnormality has been found in 
<intxref refid = "AENLSB0A1124008">Visual Inspection:K14D</intxref>
 and 
<intxref refid = "AENLSB0A1124009">Engine Basic Inspection:K14D</intxref>
.
</ptxt>
<diag type = "condition">
<condition>
<ptxt>
Hard starting (Engine can be cranked)
</ptxt>
</condition>
<ps>
<ptxt>
Faulty spark plug
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1826002">Spark Plug Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ignition coil
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1826004">Ignition Coil Assembly Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Dirty or clogged fuel hoses or pipes
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1724007">Low-Pressure Fuel Supply Circuit Check:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Malfunctioning fuel pump
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1724004">Fuel Pump and Its Circuit Check:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Malfunctioning high pressure fuel pump
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1724008">High-Pressure Fuel Supply Circuit Check:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Air drawn in through intake manifold gasket or throttle body gasket
</ptxt>
</ps>
<action>
<ptxt>
Check air intake system.
</ptxt>
</action>
<ps>
<ptxt>
Faulty electric throttle body assembly
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1326003">Electric Throttle Body Assembly On-Vehicle Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty APP sensor
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1326008">APP Sensor Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ECT sensor, MAP sensor or MAF sensor
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1326016">ECT Sensor Inspection:K14D</intxref>
, 
<intxref refid = "AENLSB0A1326010">MAP Sensor Inspection:K14D</intxref>
 or 
<intxref refid = "AENLSB0A1326029">MAF Sensor with IAT Sensor-1 Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ECM
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1124088">Inspection of ECM and Its Circuits:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Low compression
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1424001">Compression Check:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Poor spark plug tightening or faulty gasket
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1826001">Spark Plug Removal and Installation:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Compression leakage from valve seat
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1426042">Valve and Valve Guide Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Sticky valve stem
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1426042">Valve and Valve Guide Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Weak or damaged valve springs
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1426045">Valve Spring Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Compression leakage at cylinder head gasket
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1426043">Cylinder Head Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Sticky or damaged piston ring
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1426049">Cylinder, Piston and Piston Ring Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Worn piston, piston ring or cylinder
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1426049">Cylinder, Piston and Piston Ring Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Malfunctioning PCV valve
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1226007">PCV Valve On-Vehicle Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
VVT system out of order
</ptxt>
</ps>
<action>
<list1 type = "unordered">
<item>
<ptxt>
VVT actuator
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Intake VVT actuator
</ptxt>
</item>
<list3 type = "unordered">
<item>
<ptxt>
Motor part: 
<intxref refid = "AENLSB0A1326040">Intake VVT Actuator On-Vehicle Inspection:K14D</intxref>
</ptxt>
</item>
<item>
<ptxt>
Sprocket part: 
<intxref refid = "AENLSB0A1426037">Camshaft and VVT Actuator Inspection:K14D</intxref>
</ptxt>
</item>
</list3>
<item>
<ptxt>
Exhaust VVT actuator: 
<intxref refid = "AENLSB0A1426037">Camshaft and VVT Actuator Inspection:K14D</intxref>
</ptxt>
</item>
</list2>
<item>
<ptxt>
Valve timing: 
<intxref refid = "AENLSB0A1426034">Timing Chain and Chain Tensioner Inspection:K14D</intxref>
</ptxt>
</item>
<item>
<ptxt>
Exhaust OCV oil circuit: 
<intxref refid = "AENLSB0A1426028">Timing Chain Cover Inspection:K14D</intxref>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Faulty valve rocker arm
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1426040">Valve Rocker Arm Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty valve lash adjuster
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1426039">Valve and Cylinder Head Removal and Installation:K14D</intxref>
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
