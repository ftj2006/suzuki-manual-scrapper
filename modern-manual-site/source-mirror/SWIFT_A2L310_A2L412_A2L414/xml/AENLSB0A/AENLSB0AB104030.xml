</table>
</servinfosub>
<servinfosub id = "AENLSB0AB104030002">
<title>
DTC Confirmation Procedure
</title>
<s1>
<ptxt>
Run engine at idle speed for 10 sec.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AB104030003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0AB104030004">
<testgroup id = "AENLSB0AB104030005">
<title>
DC/DC converter check
</title>
<test1>
<ptxt>
Check DC/DC converter for proper installation referring to 
<intxref refid = "AENLSB0AB106012">DC/DC Converter Removal and Installation</intxref>
.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective parts, then go to Step 2.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AB104030006">
<title>
DTC recheck
</title>
<test1>
<ptxt>
Clear DTC. 
<intxreftitleoff1 refid = "AENLSB0AB104005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Perform “DTC Confirmation Procedure”, and check DTC. 
<intxreftitleoff1 refid = "AENLSB0AB104004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is DTC P0A94, P0CA2, P1C05, P1C0B, P1C1B, P1C1C, P1C1D, P1C1E, P1C1F, P1C20, P1C21 or P1C23 still detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace DC/DC converter and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0AB106012"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Intermittent trouble.
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
</servinfo>
