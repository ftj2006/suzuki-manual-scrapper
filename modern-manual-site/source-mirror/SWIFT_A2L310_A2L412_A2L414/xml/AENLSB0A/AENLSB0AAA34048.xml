<servinfosub id = "AENLSB0AAA34048002">
<title>
DTC Confirmation Procedure
</title>
<s1>
<ptxt>
Set ignition “ON”.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AAA34048003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0AAA34048004">
<testgroup id = "AENLSB0AAA34048005">
<question>
Was “Parking Sensor System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0AAA34001">Parking Sensor System Check:Parking Sensor</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA34048006">
<title>
DTC check
</title>
<test1>
<ptxt>
Check DTC in combination meter.
</ptxt>
</test1>
<question>
Is there any DTC(s) detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace combination meter and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace sonar control module and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0AAA36002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
