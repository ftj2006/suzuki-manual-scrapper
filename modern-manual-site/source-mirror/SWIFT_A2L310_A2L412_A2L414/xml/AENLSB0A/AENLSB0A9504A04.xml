<suzuki><manual>
<section sectnbr = "9E">
<servcat sctnbr = "09" scnbr = "05">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A9504A04" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Abnormal noise
</title>
<diag type = "condition">
<condition>
<ptxt>
Abnormal noise
</ptxt>
</condition>
<ps>
<ptxt>
Loose window regulator mounting bolts
</ptxt>
</ps>
<action>
<ptxt>
Tighten window regulator mounting bolts.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A9506008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A9506012"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Worn or broken power window regulator sliding and rotating parts
</ptxt>
</ps>
<action>
<ptxt>
Replace window regulator.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A9506010"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A9506014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Lack of grease in window regulator assembly
</ptxt>
</ps>
<action>
<ptxt>
Lubricate.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A9506008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A9506012"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
</diag>
</servinfo>
</servinfotype>
