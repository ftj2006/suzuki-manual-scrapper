<suzuki><manual>
<section sectnbr = "9H">
<servcat sctnbr = "09" scnbr = "08">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9806017" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Floor Carpet Removal and Installation
</title>
<servinfosub id = "AENLSB0A9806017001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove seats.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front seat: 
<intxreftitleoff1 refid = "AENLSB0A9706002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear seat: 
<intxreftitleoff1 refid = "AENLSB0A9706008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Remove the following scuffs and trims. 
<intxreftitleoff1 refid = "AENLSB0A9806016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front side sill scuffs
</ptxt>
</item>
<item>
<ptxt>
Rear side sill scuffs
</ptxt>
</item>
<item>
<ptxt>
Dash side trims
</ptxt>
</item>
<item>
<ptxt>
Center pillar lower trims
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Remove floor console box. 
<intxreftitleoff1 refid = "AENLSB0A9806020"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove steering joint cover. 
<intxreftitleoff1 refid = "AENLSB0A6206009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Unhook slit (2) of floor carpet (1) from hook on clamp (3) at all clamps and remove floor carpet.
</ptxt>
</s1>
<s1>
<ptxt>
For ISG model, remove auxiliary power module (lithium-ion battery). 
<intxreftitleoff1 refid = "AENLSB0AAB06001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<figure>
<graphic graphicname = "IHSB0A980016.jpg" width = "88.000mm" height = "87.426mm" ver = "01" gw = "233" gh = "231"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[a]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Vehicle forward
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[b]:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
LHD only
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9806017002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten mounting bolts of each seat to specified torque.
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Front seat: 
<intxreftitleoff1 refid = "AENLSB0A9706002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear seat: 
<intxreftitleoff1 refid = "AENLSB0A9706008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
<item>
<ptxt>
For installation of auxiliary power module (Lithium-ion battery), refer to 
<intxref refid = "AENLSB0AAB06001">Auxiliary Power Module (Lithium-Ion Battery) Removal and Installation</intxref>
.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
