<servinfosub id = "AENLSB0AA504028003">
<title>
DTC Confirmation Procedure
</title>
<s1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</s1>
<s1>
<ptxt>
Set ignition “ACC”.
</ptxt>
</s1>
<s1>
<ptxt>
Set ignition “ON”.
</ptxt>
</s1>
<s1>
<ptxt>
Repeat Step 1) – 3) several times.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AA504028004">
<title>
DTC Troubleshooting
</title>
<attention3>
<ptxt>
This DTC might be detected when battery is run down or the voltage is very low.
</ptxt>
</attention3>
<diag type = "test" id = "AENLSB0AA504028005">
<testgroup id = "AENLSB0AA504028006">
<title>
Parameter check
</title>
<test1>
<ptxt>
Connect SUZUKI scan tool to DLC when ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check “Accessory Relay” and “ACC Switch” displayed on SUZUKI scan tool. 
<intxreftitleoff1 refid = "AENLSB0AA204007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
End. (Intermittent trouble.)
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AA504028007">
<title>
Relay power supply circuit check
</title>
<test1>
<ptxt>
Check that voltage between “A1” circuit terminal and “F1” circuit terminal at J/B connector is battery voltage.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AA504028008">
<title>
Relay power supply circuit check
</title>
<test1>
<ptxt>
Check that voltage between “A1” circuit terminal at J/B connector and ground is battery voltage.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Repair or replace “F1” circuit.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace “A1” circuit and “IGN” fuse.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AA504028009">
<title>
Fuse check
</title>
<test1>
<ptxt>
Check “ACC” fuse.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 5.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace “B1” circuit, and then replace “ACC” fuse.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AA504028010">
<title>
ACC relay check
</title>
<test1>
<ptxt>
Set ignition “ACC” or “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check that voltage between terminal “1” of “ACC” fuse and ground is battery voltage.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace BCM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0AA206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace J/B and recheck DTC.
</ptxt>
</action>
</testgroup>
</diag>
