<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106060" svcinfotypenbr = "08" svcinfoqualnbr = "02" page = "2" supplyoff = "1" modify = "0">
<title>
Transaxle Case Disassembly and Reassembly
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106030">A/T Assembly Disassembly</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106062">A/T Assembly Reassembly</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106027">A/T Assembly Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A5106060001">
<title>
Disassembly
</title>
<s1>
<ptxt>
Remove differential side oil seal (1) using a flat-bladed screwdriver or the like.
</ptxt>
<figure>
<graphic graphicname = "IEL10C510402.swf" width = "88.000mm" height = "59.824mm" ver = "02" gw = "209" gh = "153"/>
</figure>
</s1>
<s1>
<ptxt>
Remove pinion and counter driven gear left taper roller bearing outer race (1) and shim using special tools.
</ptxt>
<servicetool>
<servicetoolitem id = "L5A037">
<s-part>
(A)
</s-part>
<s-number num = "09944-96013">
09944–96013
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A038">
<s-part>
(B)
</s-part>
<s-number num = "09942-15511">
09942–15511
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A039">
<s-part>
(C)
</s-part>
<s-number num = "09921-26010">
09921–26010
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IEL10C510171.swf" width = "88.000mm" height = "58.623mm" ver = "03" gw = "197" gh = "150"/>
</figure>
</s1>
<s1>
<ptxt>
Remove differential side left taper roller bearing (1) and shim using special tools.
</ptxt>
<servicetool>
<servicetoolitem id = "L5A040">
<s-part>
(A)
</s-part>
<s-number num = "09913-75520">
09913–75520
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A041">
<s-part>
(B)
</s-part>
<s-number num = "09913-65135">
09913–65135
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IEL10C510172.swf" width = "88.000mm" height = "72.152mm" ver = "02" gw = "213" gh = "188"/>
</figure>
</s1>
<s1>
<ptxt>
Remove transaxle case plugs (1).
</ptxt>
<figure>
<graphic graphicname = "IEL10C510217.swf" width = "88.000mm" height = "102.623mm" ver = "01" gw = "173" gh = "274"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5106060002">
<title>
Reassembly
</title>
<s1>
<ptxt>
After applying ATF to new O-rings, fit them to transaxle case plugs. Then install plugs to transaxle case.
</ptxt>
<torque>
<torqueitem id = "T5A024">
<t-part>
Transaxle case plug
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
7.5
</t-value1>
<t-value2>
0.76
</t-value2>
<t-value3>
5.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IEL10C510218.swf" width = "88.000mm" height = "102.623mm" ver = "01" gw = "175" gh = "274"/>
</figure>
</s1>
<s1>
<ptxt>
Using special tools, assemble shim and differential side left bearing.
</ptxt>
<attention3>
<ptxt>
Use shim with the same thickness as removed one.
</ptxt>
</attention3>
<servicetool>
<servicetoolitem id = "L5A042">
<s-part>
(A)
</s-part>
<s-number num = "09925-86010">
09925–86010
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A043">
<s-part>
(B)
</s-part>
<s-number num = "09925-14520">
09925–14520
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IGSB0A510048.swf" width = "88.000mm" height = "58.620mm" ver = "01" gw = "202" gh = "150"/>
</figure>
</s1>
<s1>
<ptxt>
Using special tools, install shim and pinion and counter driven gear left bearing outer race.
</ptxt>
<attention3>
<ptxt>
Use shim with the same thickness as removed one.
</ptxt>
</attention3>
<servicetool>
<servicetoolitem id = "L5A044">
<s-part>
(A)
</s-part>
<s-number num = "09924-74510">
09924–74510
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A045">
<s-part>
(B)
</s-part>
<s-number num = "09944-68210">
09944–68210
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IEL10C510219.swf" width = "88.000mm" height = "55.904mm" ver = "02" gw = "197" gh = "142"/>
</figure>
</s1>
<s1>
<ptxt>
Using special tools, install new differential side oil seal to transaxle case evenly at specified position shown in figure.
</ptxt>
<servicetool>
<servicetoolitem id = "L5A046">
<s-part>
(A)
</s-part>
<s-number num = "09924-74510">
09924–74510
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A047">
<s-part>
(B)
</s-part>
<s-number num = "09925-16510">
09925–16510
</s-number>
</servicetoolitem>
</servicetool>
<spec>
<title>
Differential side oil seal installing depth
</title>
<ptxt>
“a”: 2.6 – 3.6 mm (0.11 – 0.14 in.)
</ptxt>
</spec>
</s1>
<s1>
<ptxt>
Apply grease to oil seal lip.
</ptxt>
<materials>
<materialitem name = "ECSTAR Grease C" id = "M5A010" uid = "1545787518">
<m-part>
</m-part>
<m-desc>
Grease
</m-desc>
<m-number>
99000–25490
</m-number>
<m-name>
ECSTAR Grease C
</m-name>
</materialitem>
</materials>
<figure>
<graphic graphicname = "IEL10C510220.swf" width = "88.000mm" height = "75.653mm" ver = "01" gw = "226" gh = "198"/>
</figure>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
