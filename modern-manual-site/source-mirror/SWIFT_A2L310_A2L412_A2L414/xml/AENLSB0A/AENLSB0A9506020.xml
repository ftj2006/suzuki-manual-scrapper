<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9E">
<servcat sctnbr = "09" scnbr = "05">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9506020" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Door Mirror Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9506019">Power Door Mirror and Mirror Heater On-Vehicle Inspection (If Equipped)</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A9506020001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove front door trim. 
<intxreftitleoff1 refid = "AENLSB0A9506009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect power door mirror connector.
</ptxt>
</s1>
<s1>
<ptxt>
Remove door mirror bolts (1) and remove door mirror assembly (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950053.jpg" width = "88.000mm" height = "62.642mm" ver = "01" gw = "214" gh = "161"/>
</figure>
</s1>
<s1>
<ptxt>
Detach mirror (1) from actuator pivots (2) using a flat-bladed screwdriver or the like.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect heater wires (6), if equipped.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect blind spot indicator connector (7), if equipped.
</ptxt>
</s1>
<s1>
<ptxt>
Remove mirror visor cover (3) and door mirror turn signal light (4), if necessary.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A950007.jpg" width = "88.000mm" height = "61.626mm" ver = "01" gw = "225" gh = "158"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "3.071in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
5.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Door mirror turn signal light connector
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9506020002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Fit mirror (1) to actuator pivots (2) securely.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A950008.jpg" width = "88.000mm" height = "61.626mm" ver = "01" gw = "223" gh = "158"/>
</figure>
</item>
<item>
<ptxt>
Pass mirror harness (3) through door sash hole, insert locating projection (1) into another sash hole and fix claw (2) securely.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950056.jpg" width = "88.000mm" height = "61.626mm" ver = "01" gw = "214" gh = "158"/>
</figure>
</item>
<item>
<ptxt>
Tighten door mirror bolts in numerical order (“1” – “3”) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9E006">
<t-part>
Door mirror bolt*
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A950057.jpg" width = "88.000mm" height = "62.642mm" ver = "01" gw = "214" gh = "161"/>
</figure>
</item>
<item>
<ptxt>
Check operation of door mirror after installation.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
