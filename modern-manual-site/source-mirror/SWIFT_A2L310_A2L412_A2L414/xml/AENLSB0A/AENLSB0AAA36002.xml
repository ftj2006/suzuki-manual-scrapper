<suzuki><manual>
<section sectnbr = "10J">
<servcat sctnbr = "10" scnbr = "10">
<configtype typenbr = "3">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0AAA36002" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Sonar Control Module Removal and Installation
</title>
<servinfosub id = "AENLSB0AAA36002001">
<title>
Removal
</title>
<s1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</s1>
<s1>
<ptxt>
Remove left side quarter lower trim. 
<intxreftitleoff1 refid = "AENLSB0A9806016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect sonar control module connector (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove screws (2), and then remove sonar control module (3).
</ptxt>
<figure>
<graphic graphicname = "ILSB0AAA3013.jpg" width = "88.000mm" height = "50.958mm" ver = "01" gw = "181" gh = "128"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AAA36002002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
