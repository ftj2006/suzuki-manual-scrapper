<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1316018" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
HO2S-1 and HO2S-2 Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1316017">HO2S-1 and HO2S-2 On-Vehicle Inspection:K14C</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1316018001">
<title>
Removal
</title>
<attention2>
<ptxt>
Touching exhaust system components when they are still hot may cause burns.
</ptxt>
<ptxt>
Check that the exhaust system has cooled down before removing the HO2S.
</ptxt>
</attention2>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine cover.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector of HO2S-1 or HO2S-2 and release its wire harness from clamps.
</ptxt>
</s1>
<s1>
<ptxt>
Remove reservoir (1).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A134008.jpg" width = "88.000mm" height = "56.461mm" ver = "01" gw = "199" gh = "144"/>
</figure>
</s1>
<s1>
<ptxt>
Remove HO2S-1 (1) from catalytic converter.
</ptxt>
</s1>
<s1>
<ptxt>
Hoist vehicle and remove engine undercover.
</ptxt>
</s1>
<s1>
<ptxt>
Remove HO2S-2 (2) from catalytic converter.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A134009.jpg" width = "88.000mm" height = "55.699mm" ver = "01" gw = "199" gh = "141"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1316018002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten HO2S-1 (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1C105">
<t-part>
HO2S-1
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
45
</t-value1>
<t-value2>
4.6
</t-value2>
<t-value3>
33.5
</t-value3>
</torqueitem>
</torque>
</item>
<item>
<ptxt>
Tighten HO2S-2 (2) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1C106">
<t-part>
HO2S-2
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
45
</t-value1>
<t-value2>
4.6
</t-value2>
<t-value3>
33.5
</t-value3>
</torqueitem>
</torque>
</item>
<item>
<ptxt>
Fix each HO2S harness with clamps (3) at yellow mark.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A134010.jpg" width = "88.000mm" height = "55.699mm" ver = "01" gw = "199" gh = "141"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
“a”:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
1.5 mm (0.06 in.)
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</item>
<item>
<ptxt>
After installation, check exhaust leakage from sensor with engine running.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
