<servinfosub id = "AENLSB0A8204053002">
<title>
Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A8204053003">
<testgroup id = "AENLSB0A8204053004">
<title>
Battery voltage check
</title>
<test1>
<ptxt>
Check battery voltage.
</ptxt>
</test1>
<question>
Is voltage 10 – 14 V?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Check charging system and repair it.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0A1A14003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0A1A24004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204053005">
<title>
SDM connection check
</title>
<test1>
<ptxt>
Check for proper connection to SDM connector.
</ptxt>
</test1>
<question>
Is it connected securely?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Check for intermittent trouble. 
<intxreftitleoff1 refid = "AENLSB0A0006002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<ptxt>
If OK, substitute a known-good SDM and recheck connection. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204053006">
<title>
Fuse check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Check “A/B” fuse.
</ptxt>
</test1>
<question>
Is “A/B” fuse in good condition?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace instrument panel harness and then replace “A/B” fuse.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204053007">
<title>
SDM power supply circuit check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “G12” connector. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Measure voltage between “G12-5” terminal and ground.
</ptxt>
<servicetool>
<servicetoolitem id = "L8B0118">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IGSB0A822068.swf" width = "90.000mm" height = "49.664mm" ver = "01" gw = "188" gh = "124"/>
</testfigure>
</test1>
<question>
Is voltage 10 – 14 V?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 5.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace instrument panel harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204053008">
<title>
Ground circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Measure resistance between “G12-14” terminal and ground.
</ptxt>
<servicetool>
<servicetoolitem id = "L8B0119">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IGSB0A822067.swf" width = "90.000mm" height = "49.599mm" ver = "01" gw = "187" gh = "124"/>
</testfigure>
</test1>
<question>
Is resistance 1 &#937; or less?
</question>
<result type = "yes"/>
<action>
<ptxt>
SDM power supply circuit and ground circuit are in good condition.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace instrument panel harness.
</ptxt>
</action>
</testgroup>
</diag>
