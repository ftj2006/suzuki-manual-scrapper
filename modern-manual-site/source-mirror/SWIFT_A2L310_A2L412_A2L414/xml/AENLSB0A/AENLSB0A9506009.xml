]>
<suzuki><manual>
<section sectnbr = "9E">
<servcat sctnbr = "09" scnbr = "05">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9506009" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Front Door Glass Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9506008">Front Door Window Glass Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A9506009001">
<title>
Removal
</title>
<s1>
<ptxt>
Lower front door glass fully.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove inside handle cap (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove sash bracket inner garnish (4) and side door cap (5).
</ptxt>
</s1>
<s1>
<ptxt>
Remove screws (2) and clips, remove door trim (3) by pulling it in arrow direction.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950020.jpg" width = "88.000mm" height = "86.410mm" ver = "02" gw = "178" gh = "228"/>
</figure>
</s1>
<s1>
<ptxt>
Disconnect connectors of door harness.
</ptxt>
</s1>
<s1>
<ptxt>
Remove front door outer weather-strip (1) by moving it in arrow directions in numerical order (“1” – “2”) as shown in figure.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950021.jpg" width = "88.000mm" height = "86.063mm" ver = "01" gw = "215" gh = "227"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" valign = "top" align = "right">
<ptxt>
2.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" valign = "top" align = "left">
<ptxt>
Claw
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" valign = "top" align = "right">
<ptxt>
3.
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" valign = "top" align = "left">
<ptxt>
Front door outer panel
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Remove front door inner weather-strip (1) by pulling it in arrow direction in numerical order (“1” – “2”) as shown in figure.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950022.jpg" width = "88.000mm" height = "75.833mm" ver = "01" gw = "189" gh = "198"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
2.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Front door inner panel
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Remove door trim bracket (1) and door sealing cover (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950023.jpg" width = "88.000mm" height = "74.241mm" ver = "01" gw = "178" gh = "194"/>
</figure>
</s1>
<s1>
<ptxt>
Connect power window main switch connector.
</ptxt>
</s1>
<s1>
<ptxt>
Connect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Lower front door glass to about 30 mm (1.18 in.) from the lower edge of window.
</ptxt>
</s1>
<s1>
<ptxt>
Remove bolts (1) and remove front door glass (2) by moving it in arrow directions in numerical order (“1” – “2”) as shown in figure.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950024.jpg" width = "88.000mm" height = "72.125mm" ver = "01" gw = "188" gh = "188"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
“a”:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
About 30 mm (1.18 in.)
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9506009002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten front door glass bolts to specified torque in numerical order (“1” – “2”) as shown in figure.
</ptxt>
<torque>
<torqueitem id = "T9E002">
<t-part>
Front door glass bolt*
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
5.5
</t-value1>
<t-value2>
0.56
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A950025.jpg" width = "88.000mm" height = "72.125mm" ver = "01" gw = "188" gh = "188"/>
</figure>
</item>
<item>
<ptxt>
If glass run is deformed, replace it with new one.
</ptxt>
</item>
<item>
<ptxt>
Fix door sealing cover (1) with butyl tape (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950026.jpg" width = "88.000mm" height = "74.242mm" ver = "01" gw = "178" gh = "194"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
