<servinfosub id = "AENLSB0A8204016003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A8204016004">
<testgroup id = "AENLSB0A8204016005">
<question>
Was “Air Bag Diagnostic System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204016006">
<title>
“PASSENGER AIR BAG OFF” / “PASSENGER AIR BAG ON” indicator light circuit check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to “G153” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “G153” connector. 
<intxreftitleoff1 refid = "AENLSB0A8206032"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Measure voltage between “G153-9” terminal and ground.
</ptxt>
<servicetool>
<servicetoolitem id = "L8B008">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IGSB0A822017.swf" width = "90.000mm" height = "26.586mm" ver = "01" gw = "165" gh = "59"/>
</testfigure>
</test1>
<question>
Is measured voltage 10 – 14 V?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace instrument panel harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204016007">
<title>
“PASSENGER AIR BAG OFF” / “PASSENGER AIR BAG ON” indicator light circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to “G12” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “G12” connector. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance between “G12-16” and “G153-10” terminals (DTC B1007-01): 1 &#937; or less
</ptxt>
</item>
<item>
<ptxt>
Resistance between “G12-17” and “G153-3” terminals (DTC B1008-01): 1 &#937; or less
</ptxt>
<servicetool>
<servicetoolitem id = "L8B009">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IGSB0A822018.swf" width = "90.000mm" height = "55.107mm" ver = "01" gw = "197" gh = "140"/>
</testfigure>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace instrument panel harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204016008">
<title>
“PASSENGER AIR BAG OFF” / “PASSENGER AIR BAG ON” indicator light circuit check
</title>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance between “G153-10” terminal and ground (DTC B1007-01): infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “G153-3” terminal and ground (DTC B1008-01): infinity
</ptxt>
<servicetool>
<servicetoolitem id = "L8B010">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IGSB0A822019.swf" width = "90.000mm" height = "27.161mm" ver = "01" gw = "167" gh = "60"/>
</testfigure>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace SDM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 5.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204016009">
<title>
Passenger air bag deactivation indicator check
</title>
<test1>
<ptxt>
Check passenger air bag deactivation indicator. 
<intxreftitleoff1 refid = "AENLSB0A8206033"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace SDM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace hazard warning switch. 
<intxreftitleoff1 refid = "AENLSB0A9206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
<attention3>
<ptxt>
Upon completion of inspection and repair work, perform the following items.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Reconnect all air bag system components and check that all components are properly mounted.
</ptxt>
</item>
<item>
<ptxt>
Clear DTCs, referring to 
<intxref refid = "AENLSB0A8204006">DTC Clearance</intxref>
 if any DTC is detected.
</ptxt>
</item>
<item>
<ptxt>
Repeat 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
 to check that the trouble has been solved.
</ptxt>
</item>
</list1>
</attention3>
</servinfosub>
