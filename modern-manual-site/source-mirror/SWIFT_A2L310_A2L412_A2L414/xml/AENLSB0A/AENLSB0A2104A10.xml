<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "2A">
<servcat sctnbr = "02" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A2104A10" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Cupped tires
</title>
<diag type = "condition">
<condition>
<ptxt>
Cupped tires
</ptxt>
</condition>
<ps>
<ptxt>
Disturbed wheel alignment
</ptxt>
</ps>
<action>
<ptxt>
Check and adjust wheel alignment. 
<intxreftitleoff1 refid = "AENLSB0A2206001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty front strut assembly 
</ptxt>
</ps>
<action>
<ptxt>
Replace front strut assembly. 
<intxreftitleoff1 refid = "AENLSB0A2206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Worn wheel bearings
</ptxt>
</ps>
<action>
<ptxt>
Replace wheel hub assembly.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A3116007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A3126003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Excessive tire or wheel run-out
</ptxt>
</ps>
<action>
<ptxt>
Replace tire and/or wheel. 
<intxreftitleoff1 refid = "AENLSB0A2406001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Worn suspension arm joints
</ptxt>
</ps>
<action>
<ptxt>
Replace suspension arm. 
<intxreftitleoff1 refid = "AENLSB0A2206008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Wheel out of balance
</ptxt>
</ps>
<action>
<ptxt>
Adjust balance or replace tire.
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
