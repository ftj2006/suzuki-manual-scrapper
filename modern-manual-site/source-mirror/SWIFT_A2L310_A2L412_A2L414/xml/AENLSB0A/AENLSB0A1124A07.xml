<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1A">
<servcat sctnbr = "01" scnbr = "01">
<configtype typenbr = "2">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1124A07" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Engine overheating
</title>
<ptxt>
Perform troubleshooting referring to the following points when ECM has detected no DTC and no abnormality has been found in 
<intxref refid = "AENLSB0A1124008">Visual Inspection:K14D</intxref>
 and 
<intxref refid = "AENLSB0A1124009">Engine Basic Inspection:K14D</intxref>
.
</ptxt>
<diag type = "condition">
<condition>
<ptxt>
Engine overheating
</ptxt>
</condition>
<ps>
<ptxt>
Inoperative thermostat
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1626008">Thermostat Heater Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Poor water pump performance
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1626016">Water Pump Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Clogged or leaky radiator
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1626013">Radiator On-Vehicle Inspection and Cleaning:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Improper engine oil grade
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A0206004">Engine Oil and Filter Change</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Clogged oil filter or oil strainer
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1524001">Oil Pressure Check:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Poor oil pump performance
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1524001">Oil Pressure Check:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty radiator cooling fan control system
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1624002">Radiator Cooling Fan System Check:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Dragging brakes
</ptxt>
</ps>
<action>
<ptxt>
Condition “Dragging brakes” in 
<intxref refid = "AENLSB0A4104001">Brake Symptom Diagnosis</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Slipping clutch
</ptxt>
</ps>
<action>
<ptxt>
Condition “Slipping” in 
<intxref refid = "AENLSB0A5304001">Clutch System Symptom Diagnosis</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Blown cylinder head gasket
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1426043">Cylinder Head Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Air mixed in cooling system
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1626005">Cooling System Refilling:K14D</intxref>
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
