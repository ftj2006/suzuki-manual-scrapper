<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5B">
<servcat sctnbr = "05" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5206014" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Gear Shift and Select Shaft Assembly Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5206016">Manual Transaxle Assembly Components</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A5206013">Gear Shift and Select Shaft Assembly Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A5206014001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove battery and battery tray.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0A1A16002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0A1A26002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Disconnect gear shift and gear select control cables from transaxle. 
<intxreftitleoff1 refid = "AENLSB0A5206005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove left side engine under side cover.
</ptxt>
</s1>
<s1>
<ptxt>
Remove neutral position switch (1), if equipped. 
<intxreftitleoff1 refid = "AENLSB0A5206009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine harness MT bracket (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove gear shift interlock bolt (3) and gear shift locating spring (4).
</ptxt>
</s1>
<s1>
<ptxt>
Remove gear shift &#38; select shaft assembly (5) by removing bolts (6).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A523018.jpg" width = "88.000mm" height = "55.699mm" ver = "01" gw = "214" gh = "141"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5206014002">
<title>
Installation
</title>
<attention4>
<ptxt>
The fastener is pre-coated with friction stabilizer.
</ptxt>
<ptxt>
If the fastener is reused, it may work loose. Replace the fastener pre-coated with friction stabilizer with a new one.
</ptxt>
</attention4>
<s1>
<ptxt>
Install gear shift and select shaft assembly to transaxle left case as follows.
</ptxt>
<s2>
<ptxt>
Clean mating surfaces of gear shift and select shaft assembly and left case.
</ptxt>
</s2>
<s2>
<ptxt>
Apply specified amount of sealant to left case (1) as shown in figure.
</ptxt>
<materials>
<materialitem name = "SUZUKI Bond No.1217G" id = "M5B004" uid = "-491504098">
<m-part>
“A”
</m-part>
<m-desc>
Sealant
</m-desc>
<m-number>
99000–31260
</m-number>
<m-name>
SUZUKI Bond No.1217G
</m-name>
</materialitem>
</materials>
<spec>
<title>
Sealant amount for transaxle left case
</title>
<ptxt>
“a”: 1.5 mm (0.059 in.)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IFAE0A520014.jpg" width = "88.000mm" height = "55.974mm" ver = "01" gw = "197" gh = "142"/>
</figure>
</s2>
<s2>
<ptxt>
Install gear shift and select shaft assembly to left case.
</ptxt>
</s2>
</s1>
<s1>
<ptxt>
Tighten guide case No.1 bolts (1) and new guide case No.2 bolts (2) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T5B008">
<t-part>
Guide case No.1 bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
23
</t-value1>
<t-value2>
2.3
</t-value2>
<t-value3>
17.0
</t-value3>
</torqueitem>
<torqueitem id = "T5B009">
<t-part>
Guide case No.2 bolt
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
23
</t-value1>
<t-value2>
2.3
</t-value2>
<t-value3>
17.0
</t-value3>
</torqueitem>
</torque>
</s1>
<s1>
<ptxt>
Apply sealant to thread of gear shift interlock bolt (3) and gear shift locating spring (4), and then tighten them to specified torque.
</ptxt>
<materials>
<materialitem name = "SUZUKI Bond No.1217G" id = "M5B005" uid = "-491504098">
<m-part>
“A”
</m-part>
<m-desc>
Sealant
</m-desc>
<m-number>
99000–31260
</m-number>
<m-name>
SUZUKI Bond No.1217G
</m-name>
</materialitem>
</materials>
<torque>
<torqueitem id = "T5B010">
<t-part>
Gear shift interlock bolt
</t-part>
<t-part1>
c
</t-part1>
<t-value1>
23
</t-value1>
<t-value2>
2.3
</t-value2>
<t-value3>
17.0
</t-value3>
</torqueitem>
<torqueitem id = "T5B011">
<t-part>
Gear shift locating spring
</t-part>
<t-part1>
d
</t-part1>
<t-value1>
28
</t-value1>
<t-value2>
2.9
</t-value2>
<t-value3>
21.0
</t-value3>
</torqueitem>
</torque>
</s1>
<s1>
<ptxt>
Install engine harness MT bracket (5).
</ptxt>
</s1>
<s1>
<ptxt>
Tighten new neutral position switch (6) to specified torque, if equipped.
</ptxt>
<torque>
<torqueitem id = "T5B012">
<t-part>
Neutral position switch
</t-part>
<t-part1>
e
</t-part1>
<t-value1>
23
</t-value1>
<t-value2>
2.3
</t-value2>
<t-value3>
17.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IKSB0A523002.jpg" width = "88.000mm" height = "55.699mm" ver = "01" gw = "214" gh = "141"/>
</figure>
</s1>
<s1>
<ptxt>
Connect gear shift and gear select control cables to transaxle.
</ptxt>
</s1>
<s1>
<ptxt>
Install left side engine under side cover.
</ptxt>
</s1>
<s1>
<ptxt>
Install battery tray and battery.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0A1A16002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0A1A26002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
