<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1426025" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Engine Assembly Removal and Installation
</title>
<servinfosub id = "AENLSB0A1426025001">
<title>
Removal
</title>
<s1>
<ptxt>
Relieve fuel pressure. 
<intxreftitleoff1 refid = "AENLSB0A1726003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect steering lower shaft from pinion shaft. 
<intxreftitleoff1 refid = "AENLSB0A6206019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery and battery tray. 
<intxreftitleoff1 refid = "AENLSB0A1A26002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect ECM connectors and related clamps. 
<intxreftitleoff1 refid = "AENLSB0A1326001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Hoist vehicle and remove engine undercover and engine under side covers.
</ptxt>
</s1>
<s1>
<ptxt>
Drain the following oils.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Engine oil: 
<intxreftitleoff1 refid = "AENLSB0A1526001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Manual transaxle oil: 
<intxreftitleoff1 refid = "AENLSB0A5206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Drain coolant. 
<intxreftitleoff1 refid = "AENLSB0A1626004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove air cleaner assembly and air cleaner suction hose. 
<intxreftitleoff1 refid = "AENLSB0A1426004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect clutch fluid pipe from clutch pipe joint. 
<intxreftitleoff1 refid = "AENLSB0A5306009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect the gear shift and select control cables. 
<intxreftitleoff1 refid = "AENLSB0A5206005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect the following connectors and cable including the related clamps.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Connectors (1) in main fuse box
</ptxt>
</item>
<item>
<ptxt>
Connector (2) in individual circuit fuse box No.1
</ptxt>
</item>
<item>
<ptxt>
Battery ground cable (3)
</ptxt>
</item>
<item>
<ptxt>
Electric load current sensor connector (4)
</ptxt>
</item>
<item>
<ptxt>
Engine harness connector (5)
</ptxt>
<figure>
<graphic graphicname = "IHSB0A144049.swf" width = "88.000mm" height = "64.013mm" ver = "01" gw = "224" gh = "165"/>
</figure>
<figure>
<graphic graphicname = "ILSB0A142046.swf" width = "88.000mm" height = "38.933mm" ver = "01" gw = "158" gh = "94"/>
</figure>
</item>
</list1>
</s1>
<s1>
<ptxt>
Remove intercooler outlet pipe. 
<intxreftitleoff1 refid = "AENLSB0A1426019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect the following hoses.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Vacuum hose (1)
</ptxt>
</item>
<item>
<ptxt>
Fuel feed hose (2)
</ptxt>
</item>
<item>
<ptxt>
EVAP canister purge valve hose (3)
</ptxt>
</item>
<item>
<ptxt>
Heater inlet hose (4)
</ptxt>
</item>
<item>
<ptxt>
Heater outlet hose (5)
</ptxt>
</item>
<item>
<ptxt>
Degassing tank outlet hose (6)
</ptxt>
</item>
<item>
<ptxt>
Degassing tank hose (7)
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142047.jpg" width = "88.000mm" height = "49.095mm" ver = "01" gw = "185" gh = "123"/>
</figure>
<figure>
<graphic graphicname = "ILSB0A142048.jpg" width = "88.000mm" height = "52.059mm" ver = "01" gw = "185" gh = "131"/>
</figure>
</item>
</list1>
</s1>
<s1>
<ptxt>
Remove radiator assembly with intercooler. 
<intxreftitleoff1 refid = "AENLSB0A1626014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
With hoses connected, detach A/C compressor from cylinder block, and disconnect magnet clutch lead wire connector. 
<intxreftitleoff1 refid = "AENLSB0A7206043"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<attention4>
<ptxt>
When compressor is detached, the A/C hoses could be damaged receiving weight of the compressor.
</ptxt>
<ptxt>
Suspend the removed compressor to the vehicle body while the compressor is detached.
</ptxt>
</attention4>
</s1>
<s1>
<ptxt>
Remove stabilizer bar joints from stabilizer bar. 
<intxreftitleoff1 refid = "AENLSB0A2206012"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect tie-rod end from steering knuckle at each of right and left sides. 
<intxreftitleoff1 refid = "AENLSB0A6206022"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect suspension arm joint from steering knuckle at each of right and left sides. 
<intxreftitleoff1 refid = "AENLSB0A2206008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect right and left drive shaft joints from steering knuckle. 
<intxreftitleoff1 refid = "AENLSB0A3116003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove exhaust pipe and center pipe. 
<intxreftitleoff1 refid = "AENLSB0A1B26004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery 24V cable as follows.
</ptxt>
<s2>
<ptxt>
Remove “48V–” terminal (1), “48V+” terminal (2) and “12V+” terminal (3).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142049.swf" width = "88.000mm" height = "68.274mm" ver = "01" gw = "193" gh = "177"/>
</figure>
</s2>
<s2>
<ptxt>
Remove left side main floor undercover. 
<intxreftitleoff1 refid = "AENLSB0A9806008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s2>
<s2>
<ptxt>
Remove grommet (1) and pull out engine harness (2) to underbody.
</ptxt>
</s2>
<s2>
<ptxt>
Disconnect clamps (3).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142050.swf" width = "88.000mm" height = "46.630mm" ver = "01" gw = "201" gh = "116"/>
</figure>
</s2>
</s1>
<s1>
<ptxt>
Support front suspension frame (1), transaxle case (2) and oil pan (3) using jack.
</ptxt>
</s1>
<s1>
<ptxt>
Remove front suspension frame bolts (4).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A144053.jpg" width = "88.000mm" height = "62.919mm" ver = "01" gw = "231" gh = "162"/>
</figure>
</s1>
<s1>
<ptxt>
Remove engine right mounting bolt (1) and nuts (2).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142051.jpg" width = "88.000mm" height = "54.514mm" ver = "01" gw = "185" gh = "138"/>
</figure>
</s1>
<s1>
<ptxt>
Remove engine left mounting bolt (1) and nuts (2).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142052.jpg" width = "88.000mm" height = "50.365mm" ver = "01" gw = "185" gh = "126"/>
</figure>
</s1>
<s1>
<ptxt>
Before removing engine, check that all hoses, electric wires and cables are disconnected from engine.
</ptxt>
</s1>
<s1>
<ptxt>
Lower engine assembly with transaxle, front suspension frame, drive shafts, steering gear case all together.
</ptxt>
<attention4>
<ptxt>
The compressor may be damaged if it hits against or interferes with other parts.
</ptxt>
<ptxt>
Suspend the removed compressor in a place where no damage will be caused during removal of the engine assembly.
</ptxt>
</attention4>
</s1>
<s1>
<ptxt>
Install an engine hook with bolt and nut (1) as shown, and using this hook and another hook (2) on transaxle, lift engine with transaxle and suspension frame assembled, if necessary.
</ptxt>
<servicetool>
<servicetoolitem id = "L1D250">
<s-part>
(A)
</s-part>
<s-number num = "09910-66830">
09910–66830
</s-number>
<ptxt>
</ptxt>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "ILSB0A142053.swf" width = "88.000mm" height = "62.325mm" ver = "01" gw = "201" gh = "160"/>
</figure>
<figure>
<graphic graphicname = "ILSB0A142054.swf" width = "88.000mm" height = "53.015mm" ver = "01" gw = "157" gh = "134"/>
</figure>
</s1>
<s1>
<ptxt>
Remove front drive shaft assemblies, if necessary. 
<intxreftitleoff1 refid = "AENLSB0A3116003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove front suspension frame, if necessary. 
<intxreftitleoff1 refid = "AENLSB0A2206013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install an engine hook (1) (11851-77EA0) with bolt and nut (1) on oil pump assembly, and special tool (engine hook) on cylinder head (3) as shown, and then using these hooks lift engine assembly.
</ptxt>
<servicetool>
<servicetoolitem id = "L1D251">
<s-part>
(A)
</s-part>
<s-number num = "09910-66830">
09910–66830
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "ILSB0A142053.swf" width = "88.000mm" height = "62.325mm" ver = "01" gw = "201" gh = "160"/>
</figure>
<figure>
<graphic graphicname = "ILSB0A142055.swf" width = "88.000mm" height = "60.473mm" ver = "01" gw = "115" gh = "155"/>
</figure>
</s1>
<s1>
<ptxt>
Remove the following components from engine assembly, if necessary.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Engine harness
</ptxt>
</item>
<item>
<ptxt>
Transaxle: 
<intxreftitleoff1 refid = "AENLSB0A5206012"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Clutch cover and disc: 
<intxreftitleoff1 refid = "AENLSB0A5306018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Flywheel: 
<intxreftitleoff1 refid = "AENLSB0A1426030"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1426025002">
<title>
Installation
</title>
<s1>
<ptxt>
Install the following components to engine, if removed.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Flywheel: 
<intxreftitleoff1 refid = "AENLSB0A1426030"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Clutch cover and disc: 
<intxreftitleoff1 refid = "AENLSB0A5306018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Transaxle: 
<intxreftitleoff1 refid = "AENLSB0A5206012"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Engine harness
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Install front suspension frame, if removed. 
<intxreftitleoff1 refid = "AENLSB0A2206013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install front drive shaft assemblies, if removed. 
<intxreftitleoff1 refid = "AENLSB0A3116003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Lift up engine assembly with transaxle, front suspension frame, drive shafts and steering gear case all together.
</ptxt>
<attention4>
<ptxt>
The compressor may be damaged if it hits against or interferes with other parts.
</ptxt>
<ptxt>
Suspend the removed compressor in a place where no damage will be caused during installation of the engine assembly.
</ptxt>
</attention4>
</s1>
<s1>
<ptxt>
Tighten engine left mounting nuts (1) and bolt (2) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1D250">
<t-part>
Engine left mounting nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
55
</t-value1>
<t-value2>
5.6
</t-value2>
<t-value3>
40.5
</t-value3>
</torqueitem>
<torqueitem id = "T1D251">
<t-part>
Engine left mounting bolt
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
55
</t-value1>
<t-value2>
5.6
</t-value2>
<t-value3>
40.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "ILSB0A142056.jpg" width = "88.000mm" height = "50.365mm" ver = "01" gw = "185" gh = "126"/>
</figure>
</s1>
<s1>
<ptxt>
Tighten new engine right mounting nuts (1) and new bolt (2) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1D252">
<t-part>
Engine right mounting nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
80
</t-value1>
<t-value2>
8.2
</t-value2>
<t-value3>
59.0
</t-value3>
</torqueitem>
<torqueitem id = "T1D253">
<t-part>
Engine right mounting bolt
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
80
</t-value1>
<t-value2>
8.2
</t-value2>
<t-value3>
59.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "ILSB0A142057.jpg" width = "88.000mm" height = "54.514mm" ver = "01" gw = "185" gh = "138"/>
</figure>
</s1>
<s1>
<ptxt>
Tighten front suspension frame bolts to specified torque. 
<intxreftitleoff1 refid = "AENLSB0A2206013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove jack.
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Install exhaust pipe and center pipe. 
<intxreftitleoff1 refid = "AENLSB0A1B26004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Connect right and left drive shaft joints to steering knuckle. 
<intxreftitleoff1 refid = "AENLSB0A3116003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Connect suspension arm joint to steering knuckle at each of right and left sides. 
<intxreftitleoff1 refid = "AENLSB0A2206008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Connect tie-rod end to steering knuckle at each of right and left sides. 
<intxreftitleoff1 refid = "AENLSB0A6206022"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install stabilizer bar joints to stabilizer bar. 
<intxreftitleoff1 refid = "AENLSB0A2206012"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install 24V cable as follows.
</ptxt>
<s2>
<ptxt>
Put 24V cable (1) to floor panel and connect clamp.
</ptxt>
</s2>
<s2>
<ptxt>
Insert end of 24V cable into floor hole.
</ptxt>
</s2>
<s2>
<ptxt>
Fit grommet (2) directing arrow mark (3) to vehicle backward.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142058.swf" width = "88.000mm" height = "69.910mm" ver = "01" gw = "202" gh = "182"/>
</figure>
</s2>
<s2>
<ptxt>
Install left side main floor undercover. 
<intxreftitleoff1 refid = "AENLSB0A9806008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s2>
<s2>
<ptxt>
Install “48V–” terminal (1), “48V+” terminal (2) and “12V+” terminal (3).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142049.swf" width = "88.000mm" height = "68.274mm" ver = "01" gw = "193" gh = "177"/>
</figure>
</s2>
</s1>
<s1>
<ptxt>
Connect clutch fluid pipe to clutch pipe joint. 
<intxreftitleoff1 refid = "AENLSB0A5306009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Connect the gear shift and select control cables. 
<intxreftitleoff1 refid = "AENLSB0A5206005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install compressor to cylinder block and oil pan. 
<intxreftitleoff1 refid = "AENLSB0A7206043"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install radiator assembly with intercooler. 
<intxreftitleoff1 refid = "AENLSB0A1626014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Install all other removed electric wires, connectors and hoses to original positions.
</ptxt>
</s1>
<s1>
<ptxt>
Install intercooler outlet pipe. 
<intxreftitleoff1 refid = "AENLSB0A1426019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Install air cleaner assembly and air cleaner suction hose. 
<intxreftitleoff1 refid = "AENLSB0A1426004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Check that all removed parts are back in their places. Reinstall any necessary parts which have not been reinstalled.
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Refill engine and transaxle with oil or fluid.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Engine oil: 
<intxreftitleoff1 refid = "AENLSB0A1526001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Manual transaxle oil: 
<intxreftitleoff1 refid = "AENLSB0A5206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Connect ECM connectors and related clamps. 
<intxreftitleoff1 refid = "AENLSB0A1326001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install battery and battery tray. 
<intxreftitleoff1 refid = "AENLSB0A1A26002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Connect steering lower shaft to pinion shaft. 
<intxreftitleoff1 refid = "AENLSB0A6206019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Refill cooling system with coolant. 
<intxreftitleoff1 refid = "AENLSB0A1626005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check front wheel alignment. 
