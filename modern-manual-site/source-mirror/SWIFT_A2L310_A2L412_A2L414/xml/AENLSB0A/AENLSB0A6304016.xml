</ptxt>
</servinfosub>
<servinfosub id = "AENLSB0A6304016004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A6304016005">
<testgroup id = "AENLSB0A6304016006">
<question>
Was “P/S System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A6304001">P/S System Check</intxref>
 and recheck DTC.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A6304016007">
<title>
P/S control module power supply and ground circuit check
</title>
<test1>
<ptxt>
Check P/S control module power supply and ground circuits. 
<intxreftitleoff1 refid = "AENLSB0A6304032"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A6304016008">
<title>
P/S control module power supply voltage check
</title>
<test1>
<ptxt>
Measure battery voltage with engine running at 3,000 rpm.
</ptxt>
</test1>
<question>
Is voltage between 9 V and 15 V?
</question>
<result type = "yes"/>
<action>
<ptxt>
Substitute a known-good steering column assembly and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A6206009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Check charging system.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxref refid = "AENLSB0A1A14003">Generator Test:K14C</intxref>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxref refid = "AENLSB0A1A24004">Generator Test:K14D</intxref>
</ptxt>
</item>
</list1>
</action>
</testgroup>
