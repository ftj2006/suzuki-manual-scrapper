<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106046" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
B1 Brake Piston Removal and Installation
</title>
<servinfosub id = "AENLSB0A5106046001">
<title>
Removal
</title>
<ptxt>
Refer to Step 19) under 
<intxref refid = "AENLSB0A5106030">A/T Assembly Disassembly</intxref>
.
</ptxt>
</servinfosub>
<servinfosub id = "AENLSB0A5106046002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Apply ATF to new O-rings, B1 brake piston cover and B1 brake piston. 
<intxreftitleoff1 refid = "AENLSB0A5106045"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Adjust B1 brake piston rod. 
<intxreftitleoff1 refid = "AENLSB0A5106047"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
