<servinfosub id = "AENLSB0A8204025003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A8204025004">
<testgroup id = "AENLSB0A8204025005">
<question>
Was “Air Bag Diagnostic System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204025006">
<title>
Driver air bag (inflator) module check 
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to “G346” or “G347” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “G346” or “G347” connector. 
<intxreftitleoff1 refid = "AENLSB0A6206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Connect special tools as follows.
</ptxt>
<ptxt>
<emph etype = "bold">
2P connector with 2 pins:
</emph>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Connect “BASE OF COLUMN” harness (1) of special tools (A) and (B) to “G347” connector.
</ptxt>
</item>
</list1>
<ptxt>
<emph etype = "bold">
4P connector with 2 pins:
</emph>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Connect “BASE OF COLUMN” harness of special tools (A) and (C) to “G346” connector.
</ptxt>
<servicetool>
<servicetoolitem id = "L8B024">
<s-part>
(A)
</s-part>
<s-number num = "09932-75011">
09932–75011
</s-number>
</servicetoolitem>
<servicetoolitem id = "L8B025">
<s-part>
(B)
</s-part>
<s-number num = "09932-78340">
09932–78340
</s-number>
</servicetoolitem>
<servicetoolitem id = "L8B026">
<s-part>
(C)
</s-part>
<s-number num = "09932-77320">
09932–77320
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IGSB0A822028.swf" width = "90.000mm" height = "63.681mm" ver = "01" gw = "204" gh = "164"/>
</testfigure>
</item>
</list1>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for DTC. 
<intxreftitleoff1 refid = "AENLSB0A8204005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is DTC B1060-1B detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204025007">
<title>
Driver air bag (inflator) module circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to “G12” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “G12” connector. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Release shorting bar in SDM connector. 
<intxreftitleoff1 refid = "AENLSB0A8206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance between “G12-11” and “G347-2” or “G346-1” terminals: 1 &#937; or less
</ptxt>
</item>
<item>
<ptxt>
Resistance between “G12-10” and “G347-1” or “G346-2” terminals: 1 &#937; or less
</ptxt>
<servicetool>
<servicetoolitem id = "L8B027">
<s-part>
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace SDM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace instrument panel harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204025008">
<title>
Contact coil circuit check
</title>
<test1>
<ptxt>
Check contact coil circuit. 
<intxreftitleoff1 refid = "AENLSB0A8204054"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace driver air bag (inflator) module. 
<intxreftitleoff1 refid = "AENLSB0A8206006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace contact coil assembly. 
<intxreftitleoff1 refid = "AENLSB0A6206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
<attention3>
<ptxt>
Upon completion of inspection and repair work, perform the following items.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Reconnect all air bag system components and check that all components are properly mounted.
</ptxt>
</item>
<item>
<ptxt>
Clear DTCs, referring to 
<intxref refid = "AENLSB0A8204006">DTC Clearance</intxref>
 if any DTC is detected.
</ptxt>
</item>
<item>
<ptxt>
Repeat 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
 to check that the trouble has been solved.
</ptxt>
</item>
</list1>
</attention3>
</servinfosub>
