<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0AA126003" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Cruise Control Switch Inspection
</title>
<s1 page = "2">
<ptxt>
Remove driver air bag (inflator) module. 
<intxreftitleoff1 refid = "AENLSB0A8206006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Disconnect cruise control switch connector (1) from contact coil.
</ptxt>
</s1>
<s1>
<ptxt>
Check resistance between the following terminals under each condition below.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Non-lane departure prevention model: between “S62-5” and “S62-6”
</ptxt>
</item>
<item>
<ptxt>
Lane departure prevention model: between “S63-7” and “S63-8”
</ptxt>
<attention3>
<ptxt>
Use diode range of circuit tester when checking the following terminals.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Non-lane departure prevention model: “9” and “3”
</ptxt>
</item>
<item>
<ptxt>
Lane departure prevention model: “13” and “5”
</ptxt>
</item>
</list1>
</attention3>
</item>
</list1>
</s1>
<s1>
<ptxt>
If check result is not as specified, replace steering wheel.
</ptxt>
<spec>
<title>
Cruise control switch resistance
</title>
<ptxt>
All switches released (OFF): 3,623 – 3,697 &#937;
</ptxt>
<ptxt>
CRUISE (main) switch (2) pressed (ON): Less than 2.5 &#937;
</ptxt>
<ptxt>
CANCEL switch (3) pressed (ON): 99 – 101 &#937;
</ptxt>
<ptxt>
LIMIT switch (4) pressed (ON): 208 – 212 &#937;
</ptxt>
<ptxt>
SET/– switch (5) pressed (ON): 386 – 394 &#937;
</ptxt>
<ptxt>
RES/+ switch (6) pressed (ON): 772 – 788 &#937;
</ptxt>
<ptxt>
Distance switch (7) pressed (ON): 1,445 – 1,475 &#937;
</ptxt>
</spec>
