<servinfo servinfosgmlid = "AENKSB0A9B06020" svcinfotypenbr = "08" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Rear Floor No.1 Crossmember Removal and Installation (4WD Model)
</title>
<attention3>
<ptxt>
The figure below shows condition where the following parts are removed.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Back Panel: 
<intxreftitleoff1 refid = "AENKSB0A9B06018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear Floor Rear Panel: 
<intxreftitleoff1 refid = "AENKSB0A9B06019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</attention3>
<figure>
<graphic graphicname = "IGSB0A9B0122.jpg" width = "183.000mm" height = "74.809mm" ver = "01" gw = "358" gh = "196"/>
</figure>
<servinfosub id = "AENKSB0A9B06020001">
<title>
Removal
</title>
<s1>
<ptxt>
Drill out welding spots and remove rear floor No.1 crossmember.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9B0123.jpg" width = "183.000mm" height = "116.361mm" ver = "02" gw = "454" gh = "313"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENKSB0A9B06020002">
<title>
Installation
</title>
<attention3>
<ptxt>
Before conducting any weld, check installation position and condition for installation part(s). 
<intxreftitleoff1 refid = "AENKSB0A9B04008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</attention3>
<s1>
<ptxt>
Install rear floor No.1 crossmember.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld or plug weld.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9B0124.jpg" width = "183.000mm" height = "116.361mm" ver = "02" gw = "454" gh = "313"/>
</figure>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
