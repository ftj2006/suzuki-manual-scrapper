<servinfosub id = "AENKSB0A1124020004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENKSB0A1124020005">
<testgroup id = "AENKSB0A1124020006">
<question>
Was “Engine and Emission Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENKSB0A1124001">Engine and Emission Control System Check:K12C</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1124020007">
<title>
IAT sensor signal circuit and ground circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”, disconnect “C02” and “E02” connectors of ECM and MAF and IAT sensor connector.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connection to “C02” and “E02” connectors and MAF and IAT sensor connector.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “B1” and “C1” circuits: less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between each of “B1” and “C1” circuits and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “B1” circuit terminal and other terminal at MAF and IAT sensor connector: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “C1” circuit terminal and other terminal at MAF and IAT sensor connector: infinity
</ptxt>
</item>
<item>
<ptxt>
Voltage of “B1” and “C1” circuits: approx. 0 V (When ignition is “ON”)
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1124020008">
<title>
IAT sensor check
</title>
<test1>
<ptxt>
Check IAT sensor. 
<intxreftitleoff1 refid = "AENKSB0A1326028"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck DTC. 
<intxreftitleoff1 refid = "AENKSB0A1326001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace MAF and IAT sensor. 
<intxreftitleoff1 refid = "AENKSB0A1326027"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
