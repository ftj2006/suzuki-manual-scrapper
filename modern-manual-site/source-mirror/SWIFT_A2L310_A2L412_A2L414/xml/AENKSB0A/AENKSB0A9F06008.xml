<servinfo servinfosgmlid = "AENKSB0A9F06008" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
USB and AUX Socket Removal and Installation (If Equipped)
</title>
<servinfosub id = "AENKSB0A9F06008001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove audio/navigation unit. 
<intxreftitleoff1 refid = "AENKSB0A9F06001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect USB and AUX socket connectors (1), and then remove USB and AUX socket (2) from instrument main lower panel (3) while releasing locks (4).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9F0014.jpg" width = "88.000mm" height = "77.973mm" ver = "01" gw = "217" gh = "205"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENKSB0A9F06008002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENKSB0A9F06009">USB and AUX Socket Inspection (If Equipped)</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
