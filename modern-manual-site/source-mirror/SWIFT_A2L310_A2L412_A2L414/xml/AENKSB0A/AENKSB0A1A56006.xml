<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "5">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENKSB0A1A56006" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Water Pump / Generator Belt Adjusting Arm and Generator Bracket Removal and Installation
</title>
<servinfosub id = "AENKSB0A1A56006001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine undercover and right side engine under side cover. 
<intxreftitleoff1 refid = "AENKSB0A9806003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove water pump / generator drive belt. 
<intxreftitleoff1 refid = "AENKSB0A1A56004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove water pump pulley. 
<intxreftitleoff1 refid = "AENKSB0A1636015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove generator bolt (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove water pump / generator drive belt adjusting arm (2).
</ptxt>
<figure>
<graphic graphicname = "IFRA0A1A1014.jpg" width = "88.000mm" height = "58.155mm" ver = "01" gw = "191" gh = "148"/>
</figure>
</s1>
<s1>
<ptxt>
Remove generator. 
<intxreftitleoff1 refid = "AENKSB0A1A56005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove generator bracket (1).
</ptxt>
<figure>
<graphic graphicname = "IFRA0A1A1015.jpg" width = "88.000mm" height = "59.679mm" ver = "02" gw = "199" gh = "153"/>
</figure>
</s1>
</servinfosub>
<c-change/>
<servinfosub id = "AENKSB0A1A56006002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten generator bracket bolts in numerical order (“1” – “4”) evenly and gradually to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1J561">
<t-part>
Generator bracket bolt*
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
25
</t-value1>
<t-value2>
2.5
</t-value2>
<t-value3>
18.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IFRA0A1A1016.jpg" width = "88.000mm" height = "59.679mm" ver = "02" gw = "199" gh = "153"/>
</figure>
</item>
<item>
<ptxt>
Install water pump / generator drive belt adjusting arm in the following procedure.
</ptxt>
</item>
<list2 type = "ordered">
<item>
<ptxt>
Position the water pump / generator drive belt adjusting arm (1).
</ptxt>
</item>
<item>
<ptxt>
Loosely tighten generator bolt (2).
</ptxt>
</item>
<item>
<ptxt>
Tighten water pump nuts (3) to specified torque. 
<intxreftitleoff1 refid = "AENKSB0A1636015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<figure>
<graphic graphicname = "IFRA0A1A1017.jpg" width = "88.000mm" height = "59.679mm" ver = "01" gw = "195" gh = "153"/>
</figure>
</item>
</list2>
<item>
<ptxt>
Adjust belt tension. 
<intxreftitleoff1 refid = "AENKSB0A1A56003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
