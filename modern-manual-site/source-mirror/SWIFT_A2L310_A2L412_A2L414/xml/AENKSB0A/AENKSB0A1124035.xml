<servinfosub id = "AENKSB0A1124035004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENKSB0A1124035005">
<testgroup id = "AENKSB0A1124035006">
<question>
Was “Engine and Emission Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENKSB0A1124001">Engine and Emission Control System Check:K12C</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1124035007">
<title>
CKP sensor power supply circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”, disconnect CKP sensor connector.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connection to CKP sensor connector.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check that voltage between “C1” and “C3” is battery voltage.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1124035008">
<title>
CKP sensor ground circuit check
</title>
<test1>
<ptxt>
Check that voltage between “C1” and ground is battery voltage.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Repair “C3” circuit.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair “C1” circuit.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1124035009">
<title>
CKP sensor signal circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”, disconnect “C02” and “E02” connectors from ECM.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connection to “C02” and “E02” connectors.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “C2” circuit: less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “C2” circuit and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “C2” circuit terminal and other terminal at CKP sensor connector: infinity
</ptxt>
</item>
<item>
<ptxt>
Voltage of “C2” circuit: approx. 0 V (When ignition is “ON”)
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 5.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1124035010">
<title>
CKP sensor and sensor plate check
</title>
<test1>
<ptxt>
Check CKP sensor and sensor plate.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
CKP sensor: 
<intxreftitleoff1 refid = "AENKSB0A1326022"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Sensor plate: 
<intxreftitleoff1 refid = "AENKSB0A1426044"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck DTC. 
<intxreftitleoff1 refid = "AENKSB0A1326001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective parts.
</ptxt>
</action>
</testgroup>
</diag>
