<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1A">
<servcat sctnbr = "01" scnbr = "01">
<configtype typenbr = "4">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENKSB0A1144012" svcinfotypenbr = "06" svcinfoqualnbr = "03" supplyoff = "1" modify = "0">
<title>
MIL Remains ON after Engine Starts
</title>
<attention3>
<ptxt>
For type distinction of OBD system, refer to “Discrimination for OBD System” under 
<intxref refid = "AENKSB0A5101003">OBD System Description</intxref>
. 
</ptxt>
</attention3>
<servinfosub id = "AENKSB0A1144012001">
<title>
Troubleshooting
</title>
<diag type = "test" id = "AENKSB0A1144012002">
<testgroup id = "AENKSB0A1144012003">
<title>
DTC check
</title>
<test1>
<ptxt>
Start engine and recheck DTC of ECM and TCM (type A-A/T model in Section 5A) while engine running.
</ptxt>
</test1>
<question>
Is there any DTC(s)?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to troubleshooting for applicable MIL operation.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Substitute a known-good combination meter and recheck DTC. 
<intxreftitleoff1 refid = "AENKSB0A9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<ptxt>
If MIL still remains ON, replace ECM and recheck MIL operation. 
<intxreftitleoff1 refid = "AENKSB0A1346001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
