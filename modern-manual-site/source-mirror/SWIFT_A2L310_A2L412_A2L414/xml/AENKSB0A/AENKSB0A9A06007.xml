<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9J">
<servcat sctnbr = "09" scnbr = "10">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENKSB0A9A06007" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "1">
<title>
Front Door Assembly Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENKSB0A9A06006">Front Door Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENKSB0A9A06007001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove front door trim. 
<intxreftitleoff1 refid = "AENKSB0A9506009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect door harness connectors from door.
</ptxt>
</s1>
<s1>
<ptxt>
Remove door open stopper bolt (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9A0009.swf" width = "88.000mm" height = "70.945mm" ver = "01" gw = "193" gh = "185"/>
</figure>
</s1>
<s1>
<ptxt>
Support door panel (1) using a jack (2) with rags (3) and a piece of wood (4) placed between jack and door panel as shown in figure.
</ptxt>
<figure>
<graphic graphicname = "I2RH019A0003.swf" width = "88.000mm" height = "48.545mm" ver = "01" gw = "144" gh = "121"/>
</figure>
</s1>
<s1>
<ptxt>
Remove bolts (2) in numerical order (“1” – “2”) and remove front door (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9A0010.swf" width = "88.000mm" height = "64.886mm" ver = "01" gw = "185" gh = "167"/>
</figure>
</s1>
<s1>
<ptxt>
Remove door hinge after removing front fender if necessary. 
<intxreftitleoff1 refid = "AENKSB0A9A06005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENKSB0A9A06007002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
When replacing door, coat inside of replacement door with anti-corrosion wax for proper anti-corrosion treatment. 
<intxreftitleoff1 refid = "AENKSB0A9C06003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Apply sealant “A” to mounting face of door hinge (1) and apply grease “B” to rotating part of door hinge.
</ptxt>
<materials>
<materialitem name = "SUZUKI Bond No.1215" id = "M9J001" uid = "27">
<m-part>
“A”
</m-part>
<m-desc>
Sealant
</m-desc>
<m-number>
99000–31110
</m-number>
<m-name>
SUZUKI Bond No.1215
</m-name>
</materialitem>
<materialitem name = "ECSTAR Grease A" id = "M9J002" uid = "1545785286">
<m-part>
“B”
</m-part>
<m-desc>
Grease
</m-desc>
<m-number>
99000–25480
</m-number>
<m-name>
ECSTAR Grease A
</m-name>
</materialitem>
</materials>
<figure>
<graphic graphicname = "IGSB0A9A0011.jpg" width = "88.000mm" height = "76.104mm" ver = "01" gw = "214" gh = "199"/>
</figure>
</item>
<item>
<ptxt>
Tighten front door hinge bolts (2) to specified torques in numerical order (“1” – “2”).
</ptxt>
<torque>
<torqueitem id = "T9J002">
<t-part>
Front door hinge bolt*
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
23
</t-value1>
<t-value2>
2.3
</t-value2>
<t-value3>
17.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A9A0012.swf" width = "88.000mm" height = "64.886mm" ver = "01" gw = "198" gh = "167"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
1.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Front door
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</item>
<item>
<ptxt>
When door open stopper (1) is installed, face proper matching mark (2) upward.
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Right side front door: Mark “R” faces upward
</ptxt>
</item>
<item>
<ptxt>
Left side front door: Mark “L” faces upward
</ptxt>
</item>
</list2>
<item>
<ptxt>
Tighten door open stopper bolt to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9J003">
<t-part>
Door open stopper bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
21
</t-value1>
<t-value2>
2.1
</t-value2>
<t-value3>
15.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A9A0013.swf" width = "88.000mm" height = "71.083mm" ver = "01" gw = "193" gh = "185"/>
</figure>
</item>
</list1>
<list1 type = "unordered">
<item>
<ptxt>
Adjust door striker position. 
<intxreftitleoff1 refid = "AENKSB0A9606002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
After installation, open and close the door to check if it can be closed smoothly and securely.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
