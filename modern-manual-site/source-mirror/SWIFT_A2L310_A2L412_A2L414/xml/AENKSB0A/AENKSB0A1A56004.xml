<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "5">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENKSB0A1A56004" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Water Pump / Generator Drive Belt Removal and Installation
</title>
<servinfosub id = "AENKSB0A1A56004001" page = "2">
<title>
Removal
</title>
<s1>
<ptxt>
Remove engine undercover and right side engine under side cover. 
<intxreftitleoff1 refid = "AENKSB0A9806003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Remove compressor drive belt.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Manual A/C model: 
<intxreftitleoff1 refid = "AENKSB0A7226032"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Auto A/C model: 
<intxreftitleoff1 refid = "AENKSB0A7236042"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1 page = "2">
<ptxt>
Loosen generator bolt (2) and generator pivot bolt (3).
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Loosen generator adjusting bolt (4), and then remove water pump / generator drive belt (1).
</ptxt>
<figure>
<graphic graphicname = "IFRA0A1A1009.jpg" width = "88.000mm" height = "62.835mm" ver = "01" gw = "199" gh = "162"/>
</figure>
</s1>
</servinfosub>
<c-change/>
<servinfosub id = "AENKSB0A1A56004002" page = "2">
<title>
Installation
</title>
<s1 page = "2">
<ptxt>
Install water pump / generator drive belt (1) to water pump pulley (2), crankshaft pulley (3) and generator pulley (4).
</ptxt>
<attention3>
<ptxt>
Check that drive belt is installed in grooves of each pulley correctly.
</ptxt>
</attention3>
<figure>
<graphic graphicname = "IFRA0A1A1010.jpg" width = "88.000mm" height = "61.033mm" ver = "01" gw = "202" gh = "156"/>
</figure>
</s1>
<s1 page = "2">
<ptxt>
Adjust belt tension. 
<intxreftitleoff1 refid = "AENKSB0A1A56003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install compressor drive belt.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Manual A/C model: 
<intxreftitleoff1 refid = "AENKSB0A7226032"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Auto A/C model: 
<intxreftitleoff1 refid = "AENKSB0A7236042"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Install engine undercover and right side engine under side cover. 
<intxreftitleoff1 refid = "AENKSB0A9806003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
