<servinfosub id = "AENKSB0A1134053003">
<title>
DTC Confirmation Procedure
</title>
<attention3>
<ptxt>
Check that the following conditions are met in this “DTC Confirmation Procedure”.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Battery voltage &#62; 10 V
</ptxt>
</item>
<item>
<ptxt>
ECT &#62; 5 &#176;C (41 &#176;F)
</ptxt>
</item>
<item>
<ptxt>
IAT &#62; 5 &#176;C (41 &#176;F)
</ptxt>
</item>
</list1>
</attention3>
<s1>
<ptxt>
Set ignition “ON” for 10 sec.
</ptxt>
</s1>
<s1>
<ptxt>
Keep accelerator pedal at fully depressed position for 2 sec.
</ptxt>
</s1>
<s1>
<ptxt>
Keep accelerator pedal or released position for 2 sec.
</ptxt>
</s1>
<s1>
<ptxt>
Repeat Step 2) – 3) 3 times.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENKSB0A1134053004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENKSB0A1134053005">
<testgroup id = "AENKSB0A1134053006">
<question>
Was “Engine and Emission Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENKSB0A1134001">Engine and Emission Control System Check:K12M</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1134053007">
<title>
Electric throttle control system calibration
</title>
<test1>
<ptxt>
Perform electric throttle control system calibration. 
<intxreftitleoff1 refid = "AENKSB0A1336004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Clear DTC. 
<intxreftitleoff1 refid = "AENKSB0A1134004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Perform “DTC Confirmation Procedure” and check DTC.
</ptxt>
</test1>
<question>
Is DTC P2176 still detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
End.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1134053008">
<title>
Wire harness check
</title>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
“B1”, “B2” and “B4” circuits: Refer to Step 2 – 4 under 
<intxref refid = "AENKSB0A1134021">DTC P0122 / P0123:K12M</intxref>
.
</ptxt>
</item>
<item>
<ptxt>
“B3” circuit: Refer to Step 4 under 
<intxref refid = "AENKSB0A1134029">DTC P0222 / P0223:K12M</intxref>
.
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1134053009">
<title>
TP sensor check
</title>
<test1>
<ptxt>
Check TP sensor referring to “TP Sensor Performance Check” under 
<intxref refid = "AENKSB0A1336003">Electric Throttle Body Assembly On-Vehicle Inspection:K12M</intxref>
.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck DTC. 
<intxreftitleoff1 refid = "AENKSB0A1336001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace electric throttle body assembly. 
<intxreftitleoff1 refid = "AENKSB0A1436007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
