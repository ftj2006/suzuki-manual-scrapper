<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Vehicle inside
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[B]:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Vehicle outside
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Install new B-pillar outer panel to vehicle body and cut in stacked condition.
</ptxt>
</s1>
<s1>
<ptxt>
Repair the position of B-pillar outer panel where foamed material had been filled. 
<intxreftitleoff1 refid = "AENKSB0A9B06024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install B-pillar outer panel to vehicle body.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct plug weld or resistance spot weld.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct continuous weld.
</ptxt>
</s1>
<s1>
<ptxt>
Bend in 2 metal tabs (arrow) of B-pillar outer panel.
</ptxt>
</s1>
<s1 page = "1">
<ptxt>
Apply anti-corrosion wax to back side of continuous weld part.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9B0096.jpg" width = "183.000mm" height = "242.569mm" ver = "03" gw = "455" gh = "671"/>
