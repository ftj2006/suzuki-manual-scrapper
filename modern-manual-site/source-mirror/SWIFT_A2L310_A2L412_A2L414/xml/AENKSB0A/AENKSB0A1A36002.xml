]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "3">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENKSB0A1A36002" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Battery Removal and Installation
</title>
<servinfosub id = "AENKSB0A1A36002001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable (1) at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect positive (+) cable (2) at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery band (3).
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery (4).
</ptxt>
<figure page = "2">
<graphic graphicname = "IGSB0A1A3001.jpg" width = "88.000mm" height = "59.523mm" ver = "01" gw = "199" gh = "152"/>
</figure>
</s1>
<s1>
<ptxt>
Disconnect harness clamps from battery tray, if necessary.
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery tray (1), if necessary.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A1A3002.jpg" width = "88.000mm" height = "55.445mm" ver = "01" gw = "199" gh = "141"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENKSB0A1A36002002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten new battery tray bolts (1) and new nut (2) to specified torque.
</ptxt>
<attention4>
<ptxt>
The battery tray bolts and nut are pre-coated. If these bolts and nut are reused, they may work loose.
</ptxt>
<ptxt>
Replace the battery tray bolts and nut with new ones whenever they are removed.
</ptxt>
</attention4>
<torque>
<torqueitem id = "T1J327">
<t-part>
Battery tray bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
<torqueitem id = "T1J328">
<t-part>
Battery tray nut
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A1A3003.jpg" width = "88.000mm" height = "56.187mm" ver = "01" gw = "199" gh = "143"/>
</figure>
</item>
</list1>
<list1 type = "unordered">
<item>
<ptxt>
Tighten battery band nuts (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1J329">
<t-part>
Battery band nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
3.3
</t-value1>
<t-value2>
0.34
</t-value2>
<t-value3>
2.5
</t-value3>
</torqueitem>
</torque>
</item>
<item>
<ptxt>
Tighten positive (+) cable nut (2) and negative (–) cable nut (3) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1J330">
<t-part>
Positive (+) cable nut
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
5.0
</t-value1>
<t-value2>
0.51
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
<torqueitem id = "T1J331">
<t-part>
Negative (–) cable nut
</t-part>
<t-part1>
c
</t-part1>
<t-value1>
5.0
</t-value1>
<t-value2>
0.51
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A1A3004.jpg" width = "88.000mm" height = "81.041mm" ver = "02" gw = "209" gh = "213"/>
</figure>
</item>
<item>
<ptxt>
Initialize electrical devices if necessary.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
