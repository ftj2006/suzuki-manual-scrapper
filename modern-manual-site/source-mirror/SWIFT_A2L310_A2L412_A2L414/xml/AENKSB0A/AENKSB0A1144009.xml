<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1A">
<servcat sctnbr = "01" scnbr = "01">
<configtype typenbr = "4">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENKSB0A1144009" svcinfotypenbr = "06" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Engine Basic Inspection
</title>
<ptxt>
This check is very important for troubleshooting when ECM has detected no DTC and no abnormality has been found in 
<intxref refid = "AENKSB0A1144008">Visual Inspection:K14C</intxref>
.
</ptxt>
<ptxt>
Follow the flow carefully.
</ptxt>
<diag type = "test" id = "AENKSB0A1144009001">
<testgroup id = "AENKSB0A1144009002">
<question>
Was “Engine and Emission Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENKSB0A1144001">Engine and Emission Control System Check:K14C</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1144009003">
<title>
Check battery voltage
</title>
<question>
Is it 12 V or more?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Charge or replace battery.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1144009004">
<question>
Is engine cranked?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENKSB0A1944001">Cranking System Symptom Diagnosis:K14C</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1144009005">
<question>
Does engine start?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 5.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 7.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1144009006">
<title>
Check idle speed
</title>
<test1>
<ptxt>
Check engine idle speed. 
<intxreftitleoff1 refid = "AENKSB0A1146001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 6.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENKSB0A1144010">Engine Symptom Diagnosis:K14C</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1144009007">
<title>
Check ignition system
</title>
<test1>
<ptxt>
Check ignition system. 
<intxreftitleoff1 refid = "AENKSB0A1844001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENKSB0A1144010">Engine Symptom Diagnosis:K14C</intxref>
.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective parts.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1144009008">
<title>
Check immobilizer system
</title>
<test1>
<ptxt>
Check immobilizer control system. 
<intxreftitleoff1 refid = "AENKSB0AA324001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 8.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Immobilizer control system malfunction.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1144009009">
<title>
Check low fuel pressure circuit
</title>
<test1>
<ptxt>
Check low fuel pressure circuit. 
<intxreftitleoff1 refid = "AENKSB0A1744007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 9.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective parts.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1144009010">
<title>
Check high fuel pressure circuit
</title>
<test1>
<ptxt>
Check high fuel pressure circuit. 
<intxreftitleoff1 refid = "AENKSB0A1744008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?.
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 10.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective parts.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENKSB0A1144009011">
<title>
Check fuel injector circuit
</title>
<test1>
<ptxt>
Check fuel injector circuit. 
<intxreftitleoff1 refid = "AENKSB0A1744003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENKSB0A1144010">Engine Symptom Diagnosis:K14C</intxref>
.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENKSB0A1744003">Fuel Injector Circuit Check:K14C</intxref>
.
</ptxt>
</action>
</testgroup>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
