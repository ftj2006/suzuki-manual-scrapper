<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENKSB0A1A26002" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Battery Removal and Installation
</title>
<servinfosub id = "AENKSB0A1A26002001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable (1) at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect positive (+) cable (2) at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery band (3).
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery (4).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A1A2002.jpg" width = "88.000mm" height = "58.422mm" ver = "01" gw = "199" gh = "149"/>
</figure>
</s1>
<s1>
<ptxt>
Remove battery tray (1), if necessary.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A1A2004.jpg" width = "88.000mm" height = "56.631mm" ver = "01" gw = "199" gh = "144"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENKSB0A1A26002002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten battery band bolt (3), new battery tray bolts (1) and new battery tray nut (2) to specified torque.
</ptxt>
<attention4>
<ptxt>
The battery tray bolts and nut are pre-coated. If these bolts and nut are reused, they may work loose.
</ptxt>
<ptxt>
Replace the battery tray bolts and nut with new ones whenever they are removed.
</ptxt>
</attention4>
<torque>
<torqueitem id = "T1J216">
<t-part>
Battery tray bolt 
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
<torqueitem id = "T1J217">
<t-part>
Battery tray nut
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
<torqueitem id = "T1J218">
<t-part>
Battery band bolt
</t-part>
<t-part1>
c
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
</torque>
</item>
<item>
<ptxt>
Tighten positive (+) cable nut (4) and negative (–) cable nut (5) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1J219">
<t-part>
Positive (+) cable nut
</t-part>
<t-part1>
d
</t-part1>
<t-value1>
5.0
</t-value1>
<t-value2>
0.51
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
<torqueitem id = "T1J220">
<t-part>
Negative (–) cable nut
</t-part>
<t-part1>
e
</t-part1>
<t-value1>
5.0
</t-value1>
<t-value2>
0.51
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A1A2005.jpg" width = "88.000mm" height = "56.631mm" ver = "01" gw = "199" gh = "144"/>
</figure>
<figure>
<graphic graphicname = "IGSB0A1A2006.jpg" width = "88.000mm" height = "87.983mm" ver = "02" gw = "210" gh = "233"/>
</figure>
</item>
<item>
<ptxt>
Initialize electrical devices if necessary.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
