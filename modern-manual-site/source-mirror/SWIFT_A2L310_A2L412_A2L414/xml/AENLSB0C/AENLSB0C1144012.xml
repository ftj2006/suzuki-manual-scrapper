<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1A">
<servcat sctnbr = "01" scnbr = "01">
<configtype typenbr = "4">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0C1144012" svcinfotypenbr = "06" svcinfoqualnbr = "03" supplyoff = "1" modify = "0">
<title>
MIL Remains ON after Engine Starts
</title>
<servinfosub id = "AENLSB0C1144012001">
<title>
Troubleshooting
</title>
<diag type = "test" id = "AENLSB0C1144012002">
<testgroup id = "AENLSB0C1144012003">
<title>
DTC check
</title>
<test1>
<ptxt>
Start engine and recheck DTC of ECM and TCM (CVT model) while engine running.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
ECM: 
<intxreftitleoff1 refid = "AENLSB0C1144003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
TCM: 
<intxreftitleoff1 refid = "AENLSB0C5504012"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</test1>
<question>
Is there any DTC(s)?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to troubleshooting for applicable MIL operation.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Substitute a known-good combination meter and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0C9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<ptxt>
If MIL still remains ON, replace ECM and recheck MIL operation. 
<intxreftitleoff1 refid = "AENLSB0C1346001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
