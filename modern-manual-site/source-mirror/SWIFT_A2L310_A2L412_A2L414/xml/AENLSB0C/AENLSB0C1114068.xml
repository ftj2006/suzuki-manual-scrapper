<servinfosub id = "AENLSB0C1114068001">
<title>
DTC Detecting Condition and Trouble Area
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "4.331in"/>
<colspec colnum = "2" colname = "2" colwidth = "2.862in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
DTC detecting condition
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
Trouble area
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "top" align = "left">
<ptxt>
<emph etype = "bold">
P2195: O2 Sensor Signal Biased / Stuck Lean (Bank1 Sensor1)
</emph>
</ptxt>
<ptxt>
Output voltage of HO2S-1 circuit is lower than 0.4 V for 25 sec. even if output voltage of HO2S-2 circuit is higher than 0.6 V.
</ptxt>
<ptxt>
(3 D/C detection logic)
</ptxt>
</entry>
<entry colname = "2" morerows = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
HO2S-1 and/or its circuit
</ptxt>
</item>
<item>
<ptxt>
ECM
</ptxt>
</item>
</list1>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "top" align = "left">
<ptxt>
<emph etype = "bold">
P2196: O2 Sensor Signal Biased / Stuck Rich (Bank1 Sensor1)
</emph>
</ptxt>
<ptxt>
Output voltage of HO2S-1 circuit is higher than 0.55 V for 25 sec. even if output voltage of HO2S-2 circuit is lower than 0.25 V.
</ptxt>
<ptxt>
(3 D/C detection logic)
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</servinfosub>
