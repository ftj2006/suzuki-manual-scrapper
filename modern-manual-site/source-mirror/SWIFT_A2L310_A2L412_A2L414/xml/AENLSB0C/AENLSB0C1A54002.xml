<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "5">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0C1A54002" svcinfotypenbr = "06" svcinfoqualnbr = "04" page = "1" supplyoff = "1" modify = "0">
<title>
Generator Symptom Diagnosis
</title>
<ptxt>
Trouble in charging system will show up as one or more of the following conditions.
</ptxt>
<servinfosub id = "AENLSB0C1A54002001" page = "1">
<title>
Charge Warning Light Operation
</title>
<diag type = "condition" id = "AENLSB0C1A54002002">
<condition>
<ptxt>
Charge warning light does not light with ignition “ON” and engine off
</ptxt>
</condition>
<ps>
<ptxt>
Blown fuse
</ptxt>
</ps>
<action>
<ptxt>
Replace fuse.
</ptxt>
</action>
<ps>
<ptxt>
Faulty combination meter
</ptxt>
</ps>
<action>
<ptxt>
Replace combination meter. 
<intxreftitleoff1 refid = "AENLSB0C9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ECM
</ptxt>
</ps>
<action>
<ptxt>
Check ECM. 
<intxreftitleoff1 refid = "AENLSB0C1144064"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty CAN communication line
</ptxt>
</ps>
<action>
<ptxt>
Repair or replace CAN communication line. 
<intxreftitleoff1 refid = "AENLSB0CA824002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty wiring
</ptxt>
</ps>
<action>
<ptxt>
Repair wiring.
</ptxt>
</action>
<ps>
<ptxt>
Faulty IC regulator or field coil
</ptxt>
</ps>
<action>
<ptxt>
Repair or replace generator. 
<intxreftitleoff1 refid = "AENLSB0C1A56008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<condition>
<ptxt>
Charge warning light does not go out with engine running (Battery requires frequent recharging)
</ptxt>
</condition>
<ps>
<ptxt>
Loose or worn drive belt
</ptxt>
</ps>
<action>
<ptxt>
Adjust or replace drive belt. 
<intxreftitleoff1 refid = "AENLSB0C1A56003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty combination meter
</ptxt>
</ps>
<action>
<ptxt>
Replace combination meter. 
<intxreftitleoff1 refid = "AENLSB0C9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty ECM
</ptxt>
</ps>
<action>
<ptxt>
Check ECM. 
<intxreftitleoff1 refid = "AENLSB0C1144064"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty IC regulator or generator
</ptxt>
</ps>
<action>
<ptxt>
Repair or replace generator. 
<intxreftitleoff1 refid = "AENLSB0C1A56008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty wiring
</ptxt>
</ps>
<action>
<ptxt>
Repair wiring.
</ptxt>
</action>
</diag>
</servinfosub>
<servinfosub id = "AENLSB0C1A54002003">
<title>
Battery Charge Failure
</title>
<diag type = "condition" id = "AENLSB0C1A54002004">
<condition>
<ptxt>
Undercharged battery
</ptxt>
</condition>
<ps>
<ptxt>
Loose or worn drive belt
</ptxt>
</ps>
<action>
<ptxt>
Adjust or replace drive belt. 
<intxreftitleoff1 refid = "AENLSB0C1A56003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Loose or corroded battery terminal
</ptxt>
</ps>
<action>
<ptxt>
Tighten battery terminal or replace battery. 
<intxreftitleoff1 refid = "AENLSB0C1A56002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty rectifier, rotor and/or IC regulator
</ptxt>
</ps>
<action>
<ptxt>
Repair or replace generator. 
<intxreftitleoff1 refid = "AENLSB0C1A56008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<condition>
<ptxt>
Overcharged battery
</ptxt>
</condition>
<ps>
<ptxt>
Faulty IC regulator
</ptxt>
</ps>
<action>
<ptxt>
Repair or replace generator. 
<intxreftitleoff1 refid = "AENLSB0C1A56008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</diag>
</servinfosub>
<servinfosub id = "AENLSB0C1A54002005">
<title>
Noise
</title>
<diag type = "condition" id = "AENLSB0C1A54002006">
<condition>
<ptxt>
Noisy generator
</ptxt>
</condition>
<ps>
<ptxt>
Loose mounting bolts
</ptxt>
</ps>
<action>
<ptxt>
Tighten mounting bolts. 
<intxreftitleoff1 refid = "AENLSB0C1A56005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Dirty, worn and/or faulty bearings
</ptxt>
</ps>
<action>
<ptxt>
Repair or replace generator. 
<intxreftitleoff1 refid = "AENLSB0C1A56008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty rotor, diode and/or stator
</ptxt>
</ps>
<action>
<ptxt>
Repair or replace generator. 
<intxreftitleoff1 refid = "AENLSB0C1A56008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
