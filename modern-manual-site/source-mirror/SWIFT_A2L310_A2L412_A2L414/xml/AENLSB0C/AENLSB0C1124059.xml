<servinfosub id = "AENLSB0C1124059003">
<title>
DTC Confirmation Procedure
</title>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
Troubleshoot first unexpected DTCs previously detected in “DTC Confirmation Procedure”.
</ptxt>
</item>
<item>
<ptxt>
Check that the following DTCs are not detected in this “DTC Confirmation Procedure”.
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
TP sensor (P0122, P0123, P0222 and P0223)
</ptxt>
</item>
</list2>
</list1>
</attention3>
<s1>
<ptxt>
Start engine.
</ptxt>
</s1>
<s1>
<ptxt>
Keep accelerator pedal in fully depressed position for a moment.
</ptxt>
</s1>
<s1>
<ptxt>
Keep accelerator pedal in released position for 2 sec.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0C1124059004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0C1124059005">
<testgroup id = "AENLSB0C1124059006">
<question>
Was “Engine and Emission Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0C1124001">Engine and Emission Control System Check:K12C</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0C1124059007">
<title>
Wire harness check
</title>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
“B2” circuit: Refer to Step 2 – 4 under 
<intxref refid = "AENLSB0C1124023">DTC P0122 / P0123:K12C</intxref>
.
</ptxt>
</item>
<item>
<ptxt>
“B3” circuit: Refer to Step 2 – 4 under 
<intxref refid = "AENLSB0C1124032">DTC P0222 / P0223:K12C</intxref>
.
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0C1124059008">
<title>
TP sensor check
</title>
<test1>
<ptxt>
Check TP sensor referring to “Throttle Position (TP) Sensor Performance Check” under 
<intxref refid = "AENLSB0C1326003">Electric Throttle Body Assembly On-Vehicle Inspection:K12C</intxref>
.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0C1326001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace electric throttle body assembly. 
<intxreftitleoff1 refid = "AENLSB0C1426007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
