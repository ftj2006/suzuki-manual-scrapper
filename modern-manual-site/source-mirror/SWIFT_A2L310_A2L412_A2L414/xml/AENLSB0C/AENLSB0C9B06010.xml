</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front fender: 
<intxreftitleoff1 refid = "AENLSB0C9A06005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Hood lock member: 
<intxreftitleoff1 refid = "AENLSB0C9B06001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Front fender bracket, front fender upper front bracket, front fender lower bracket and front fender lower bracket extension: 
<intxreftitleoff1 refid = "AENLSB0C9B06002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Cowl side outer member: 
<intxreftitleoff1 refid = "AENLSB0C9B06003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Dash side front panel: 
<intxreftitleoff1 refid = "AENLSB0C9B06004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Fender apron panel: 
<intxreftitleoff1 refid = "AENLSB0C9B06009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
