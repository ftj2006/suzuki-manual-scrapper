</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MANOTE" width = "5.132mm" height = "3.048mm"/>
3.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
RHD driver side only
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Repair foamed material. 
<intxreftitleoff1 refid = "AENLSB0C9B06026"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install front door hinge retainer.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld or plug weld.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9B0072.jpg" width = "183.000mm" height = "105.991mm" ver = "02" gw = "410" gh = "284"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
