<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9O">
<servcat sctnbr = "09" scnbr = "15">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0C9F06001" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Audio / Navigation Unit Removal and Installation (If Equipped)
</title>
<servinfosub id = "AENLSB0C9F06001001">
<title>
Removal
</title>
<topic id = "AENLSB0C9F06001002">
<title>
Without audio / navigation unit
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove instrument panel center ornament. 
<intxreftitleoff1 refid = "AENLSB0C9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove tuner pocket assembly (1) from instrument panel by removing 2 mounting screws (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove instrument panel center garnish (4), instrument panel center garnish cap (5), and then remove radio hole cover (8), tuner bracket (6), tuner pocket (7) and tuner bracket bushing (3), if necessary.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A9F0006.jpg" width = "88.000mm" height = "153.371mm" ver = "01" gw = "220" gh = "418"/>
</figure>
</s1>
</topic>
<topic id = "AENLSB0C9F06001003">
<title>
With audio / navigation unit
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove instrument panel center ornament. 
<intxreftitleoff1 refid = "AENLSB0C9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove audio or navigation unit (1) from instrument panel by removing 2 mounting screws (2).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect audio unit or navigation unit connectors.
</ptxt>
</s1>
<s1>
<ptxt>
Remove instrument panel center garnish cap (4), and then remove tuner bracket (5) and tuner bracket bushing (3) from audio / navigation unit, if necessary.
</ptxt>
<figure>
<graphic graphicname = "ILSB0B9F0002.jpg" width = "88.000mm" height = "142.694mm" ver = "01" gw = "220" gh = "388"/>
</figure>
</s1>
</topic>
</servinfosub>
<servinfosub id = "AENLSB0C9F06001004">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
