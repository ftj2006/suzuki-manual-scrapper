<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1K">
<servcat sctnbr = "01" scnbr = "11">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0C1B26002" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "1">
<title>
Exhaust Manifold Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0C1B26001">Exhaust System Components:K12C</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0C1B26002001" page = "2">
<title>
Removal
</title>
<attention4>
<ptxt>
Applying a shock to the exhaust manifold may cause damage to the three-way catalytic converter inside the exhaust manifold.
</ptxt>
<ptxt>
Handle the exhaust manifold carefully. Be careful not to drop it or hit it against something.
</ptxt>
</attention4>
<s1 page = "2">
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove HO2S-1 and HO2S-2 clamps.
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Disconnect HO2S-1 and HO2S-2 connectors and then detach from HO2S bracket.
</ptxt>
</s1>
<s1>
<ptxt>
Remove HO2S-1 (1) and HO2S-2 (2), if necessary.
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Remove exhaust manifold cover (3) from exhaust manifold.
</ptxt>
<figure page = "2">
<graphic graphicname = "IGSB0A1B2003.jpg" width = "88.000mm" height = "58.917mm" ver = "01" gw = "199" gh = "150"/>
</figure>
</s1>
<s1>
<ptxt>
Remove engine undercover.
</ptxt>
</s1>
<s1>
<ptxt>
Remove EGR pipe (1) and gaskets (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A1B2004.jpg" width = "88.000mm" height = "57.054mm" ver = "01" gw = "199" gh = "145"/>
</figure>
</s1>
<s1 page = "2">
<ptxt>
Remove exhaust pipe (1) from exhaust manifold.
</ptxt>
<figure page = "2">
<graphic graphicname = "IGSB0A1B2005.jpg" width = "88.000mm" height = "59.078mm" ver = "01" gw = "199" gh = "151"/>
</figure>
</s1>
<s1 page = "2">
<ptxt>
Remove exhaust manifold stiffener No.1 (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove exhaust manifold stiffener No.2 (2).
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Remove exhaust manifold (3) and its gasket from cylinder head.
</ptxt>
<figure page = "2">
<graphic graphicname = "IFRA0B1B2004.jpg" width = "88.000mm" height = "49.561mm" ver = "01" gw = "198" gh = "124"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0C1B26002002" page = "2">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0C1B26003">Exhaust Manifold Inspection:K12C</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Use new gasket and seal ring.
</ptxt>
</item>
<item>
<ptxt>
Tighten exhaust manifold bolts (1) and nuts (2) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1K205">
<t-part>
Exhaust manifold bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
60
</t-value1>
<t-value2>
6.1
</t-value2>
<t-value3>
44.5
</t-value3>
</torqueitem>
<torqueitem id = "T1K206">
<t-part>
Exhaust manifold nut
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
60
</t-value1>
<t-value2>
6.1
</t-value2>
<t-value3>
44.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A1B2006.jpg" width = "88.000mm" height = "52.313mm" ver = "01" gw = "199" gh = "132"/>
</figure>
</item>
<item>
<ptxt>
Install HO2S-1 and HO2S-2, if removed. 
<intxreftitleoff1 refid = "AENLSB0C1326018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Install exhaust manifold stiffeners as follows.
</ptxt>
</item>
<list2 type = "ordered">
<item>
<ptxt>
Install exhaust manifold stiffener No.1 (1) and No.2 (2), then tighten exhaust manifold stiffener No.1 nut (3), No.2 bolt (4), No.1 bolts (5) and (6) temporarily.
</ptxt>
</item>
<item>
<ptxt>
Fully tighten all bolts and nut in numerical order (“1” – “4”) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1K207">
<t-part>
Stiffener to manifold nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
27
</t-value1>
<t-value2>
2.8
</t-value2>
<t-value3>
20.0
</t-value3>
</torqueitem>
</torque>
<torque>
<torqueitem id = "T1K208">
<t-part>
Stiffener to manifold bolt 
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
27
</t-value1>
<t-value2>
2.8
</t-value2>
<t-value3>
20.0
</t-value3>
</torqueitem>
</torque>
<torque>
<torqueitem id = "T1K209">
<t-part>
Stiffener to manifold bolt 
</t-part>
<t-part1>
c
</t-part1>
<t-value1>
27
</t-value1>
<t-value2>
2.8
</t-value2>
<t-value3>
20.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGJA0A1B2003.jpg" width = "88.000mm" height = "52.084mm" ver = "02" gw = "199" gh = "131"/>
</figure>
</item>
</list2>
<item>
<ptxt>
Install EGR pipe according to the following procedure.
</ptxt>
</item>
<list2 type = "ordered">
<item>
<ptxt>
Remove EGR valve. 
<intxreftitleoff1 refid = "AENLSB0C1226011"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Install EGR valve and EGR pipe. 
<intxreftitleoff1 refid = "AENLSB0C1226011"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
<item>
<ptxt>
Tighten exhaust pipe bolts (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1K210">
<t-part>
Exhaust pipe bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
43
</t-value1>
<t-value2>
4.4
</t-value2>
<t-value3>
32.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A1B2007.jpg" width = "88.000mm" height = "55.784mm" ver = "01" gw = "199" gh = "142"/>
</figure>
</item>
<item>
<ptxt>
Clamp HO2S-2 lead wire. 
<intxreftitleoff1 refid = "AENLSB0C1326018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Run engine and check for exhaust gas leakage.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
