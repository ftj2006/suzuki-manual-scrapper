]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "5">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0C1A56002" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Battery Removal and Installation
</title>
<servinfosub id = "AENLSB0C1A56002001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable (1) at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect positive (+) cable (2) at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery band (3).
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery cover (4) and battery (5).
</ptxt>
<figure page = "2">
<graphic graphicname = "IGSB0A1A5001.jpg" width = "88.000mm" height = "55.699mm" ver = "01" gw = "214" gh = "141"/>
</figure>
</s1>
<s1>
<ptxt>
Disconnect harness clamps from battery tray, if necessary.
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery tray (1), if necessary.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A1A5002.jpg" width = "88.000mm" height = "55.699mm" ver = "01" gw = "214" gh = "141"/>
</figure>
</s1>
</servinfosub>
<p-change/>
<servinfosub id = "AENLSB0C1A56002002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten new battery tray bolts (1) and nut (2) to specified torque.
</ptxt>
<attention4>
<ptxt>
The battery tray bolts and nut are pre-coated. If these bolts and nut are reused, they may work loose.
</ptxt>
<ptxt>
Replace the battery tray bolts and nut with new ones whenever they are removed.
</ptxt>
</attention4>
<torque>
<torqueitem id = "T1J555">
<t-part>
Battery tray bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
<torqueitem id = "T1J556">
<t-part>
Battery tray nut
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A1A5003.jpg" width = "88.000mm" height = "55.699mm" ver = "01" gw = "214" gh = "141"/>
</figure>
</item>
</list1>
<list1 type = "unordered">
<item>
<ptxt>
Tighten battery band nuts (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1J557">
<t-part>
Battery band nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
3.3
</t-value1>
<t-value2>
0.34
</t-value2>
<t-value3>
2.5
</t-value3>
</torqueitem>
</torque>
</item>
<item>
<ptxt>
Tighten positive (+) cable nut (2) and negative (–) cable nut (3) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1J558">
<t-part>
Positive (+) cable nut
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
5.0
</t-value1>
<t-value2>
0.51
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
<torqueitem id = "T1J559">
<t-part>
Negative (–) cable nut
</t-part>
<t-part1>
c
</t-part1>
<t-value1>
5.0
</t-value1>
<t-value2>
0.51
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A1A5004.jpg" width = "88.000mm" height = "86.507mm" ver = "02" gw = "219" gh = "229"/>
</figure>
</item>
<item>
<ptxt>
Initialize electrical devices if necessary.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
