<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1A">
<servcat sctnbr = "01" scnbr = "01">
<configtype typenbr = "3">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLJA0A1134012" svcinfotypenbr = "06" svcinfoqualnbr = "03" supplyoff = "1" modify = "0">
<title>
MIL Remains ON after Engine Starts
</title>
<servinfosub id = "AENLJA0A1134012001">
<title>
Troubleshooting
</title>
<diag type = "test" id = "AENLJA0A1134012002">
<testgroup id = "AENLJA0A1134012003">
<title>
DTC check
</title>
<test1>
<ptxt>
Start engine and recheck DTC of ECM while engine running.
</ptxt>
</test1>
<question>
Is there any DTC(s)?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to troubleshooting for applicable DTC.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace combination meter and recheck MIL operation. 
<intxreftitleoff1 refid = "AENLJA0A9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<ptxt>
If MIL still remains ON, replace ECM and recheck MIL operation. 
<intxreftitleoff1 refid = "AENLJA0A1336001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
