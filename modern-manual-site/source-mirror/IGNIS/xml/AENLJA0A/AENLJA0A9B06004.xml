<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLJA0A9B06004" svcinfotypenbr = "08" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Apron Side Member Outer Panel and Apron Side Member Removal and Installation
</title>
<attention3>
<ptxt>
The figure below shows condition where the following parts are removed.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front fender: 
<intxreftitleoff1 refid = "AENLJA0A9A06005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Hood lock member, apron side member upper extension and forward sensor bracket: 
<intxreftitleoff1 refid = "AENLJA0A9B06001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Front fender lower bracket and front fender upper front bracket: 
<intxreftitleoff1 refid = "AENLJA0A9B06002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Cowl side outer member: 
<intxreftitleoff1 refid = "AENLJA0A9B06005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Dash side front panel: 
<intxreftitleoff1 refid = "AENLJA0A9B06006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Apron front member, apron front extension, fender apron panel, relay box bracket, suspension upper bracket and cowl upper lower reinforcement: 
<intxreftitleoff1 refid = "AENLJA0A9B06008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</attention3>
<figure>
<graphic graphicname = "IFJA0P9B0052.jpg" width = "88.000mm" height = "58.409mm" ver = "01" gw = "226" gh = "149"/>
</figure>
<servinfosub id = "AENLJA0A9B06004001">
<title>
General Notes
</title>
<list1 type = "unordered">
<item>
<ptxt>
Welding method and number of welding points are the same on both sides. This repair instruction shows procedure for left side.
</ptxt>
</item>
<item>
<ptxt>
Dash lower side extension is to be reused.
</ptxt>
</item>
</list1>
<ptxt>
</ptxt>
</servinfosub>
<servinfosub id = "AENLJA0A9B06004002">
<title>
Removal
</title>
<s1>
<ptxt>
Drill out welding spots and remove dash lower side extension.
</ptxt>
<figure>
<graphic graphicname = "IFJA0P9B0053.jpg" width = "183.000mm" height = "176.133mm" ver = "01" gw = "352" gh = "483"/>
</figure>
</s1>
<s1>
<ptxt>
Drill out welding spots and remove apron side member outer panel and apron side member.
</ptxt>
<figure>
<graphic graphicname = "IFJA0P9B0054.jpg" width = "183.000mm" height = "168.924mm" ver = "01" gw = "498" gh = "462"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLJA0A9B06004003">
<title>
Installation
</title>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
Before conducting any weld, check installation position and condition for installation part(s).
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Front body: 
<intxreftitleoff1 refid = "AENLJA0A9B04004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Underbody: 
<intxreftitleoff1 refid = "AENLJA0A9B04009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
<item>
<ptxt>
Perform repair while taking into consideration installation of parts that affect appearance. 
<intxreftitleoff1 refid = "AENLJA0A9B04003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</attention3>
<s1>
<ptxt>
Install apron side member.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld or plug weld.
</ptxt>
<figure>
<graphic graphicname = "IGJA0A9B0019.jpg" width = "183.000mm" height = "127.369mm" ver = "02" gw = "496" gh = "345"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Vehicle left side
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[B]:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Vehicle right side
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Install apron side member outer panel and apron side member.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct plug weld.
</ptxt>
<figure>
<graphic graphicname = "IFJA0P9B0056.jpg" width = "183.000mm" height = "168.924mm" ver = "01" gw = "498" gh = "462"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.438in"/>
<colspec colnum = "2" colname = "2" colwidth = "3.971in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MANOTE" width = "5.132mm" height = "3.048mm"/>
:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
This symbol indicates that the weld is conducted when fender apron panel is installed.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Install dash lower side extension.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct plug weld.
</ptxt>
<figure>
<graphic graphicname = "IFJA0P9B0057.jpg" width = "183.000mm" height = "176.133mm" ver = "01" gw = "352" gh = "483"/>
</figure>
</s1>
