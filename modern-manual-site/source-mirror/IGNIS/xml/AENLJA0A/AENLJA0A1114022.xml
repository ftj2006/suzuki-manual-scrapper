<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P0130: O2 Sensor Circuit (Sensor 1)
</emph>
</ptxt>
<ptxt>
Any of the following conditions is met.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
HO2S-1 signal voltage is between 0.06 V and 0.42 V even if HO2S-2 signal voltage is higher than 0.6 V for 15 sec.
</ptxt>
</item>
<item>
<ptxt>
HO2S-1 signal voltage is between 0.5 V and 1.27 V even if HO2S-2 signal voltage is lower than 0.1 V for 15 sec.
</ptxt>
</item>
</list1>
<ptxt>
(3 D/C detection logic)
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
HO2S-1 and/or its circuit
</ptxt>
</item>
<item>
<ptxt>
HO2S-2 and/or its circuit
</ptxt>
</item>
<item>
<ptxt>
HO2S-1 heater and/or its circuit
</ptxt>
</item>
<item>
<ptxt>
HO2S-2 heater and/or its circuit
</ptxt>
</item>
<item>
<ptxt>
ECM
</ptxt>
</item>
</list1>
</entry>
</row>
