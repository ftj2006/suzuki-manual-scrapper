<servinfosub id = "AENLJA0A1134084003">
<title>
DTC Confirmation Procedure
</title>
<attention3>
<ptxt>
Check that the following condition is met in this “DTC Confirmation Procedure”.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
8.5 V &#60; battery voltage &#60; 16 V
</ptxt>
</item>
</list1>
</attention3>
<s1>
<ptxt>
Warm up engine to normal operating temperature.
</ptxt>
</s1>
<s1>
<ptxt>
Run engine at idle speed for 10 sec.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLJA0A1134084004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLJA0A1134084005">
<testgroup id = "AENLJA0A1134084006">
<question>
Was “Engine and Emission Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLJA0A1134001">Engine and Emission Control System Check:K12D</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLJA0A1134084007">
<title>
Variable oil pump valve power supply circuit and drive circuit check
</title>
<test1>
<ptxt>
Check “A1” and “A2” circuits according to Step 2 – 3 under 
<intxref refid = "AENLJA0A1134083">DTC P0524:K12D</intxref>
.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLJA0A1134084008">
<title>
Variable oil pump valve check
</title>
<test1>
<ptxt>
Check variable oil pump valve. 
<intxreftitleoff1 refid = "AENLJA0A1536009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck DTC. 
<intxreftitleoff1 refid = "AENLJA0A1336001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace oil pump assembly. 
<intxreftitleoff1 refid = "AENLJA0A1536007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
