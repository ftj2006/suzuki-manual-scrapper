<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "4">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLJA0A1A46002" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Battery Removal and Installation
</title>
<servinfosub id = "AENLJA0A1A46002001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable (1) at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect positive (+) cable (2) at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery band (3).
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery (4).
</ptxt>
<figure>
<graphic graphicname = "IGJA0A1A3001.jpg" width = "88.000mm" height = "56.885mm" ver = "01" gw = "199" gh = "145"/>
</figure>
</s1>
<s1>
<ptxt>
If necessary, remove battery tray (1) as follows.
</ptxt>
<s2>
<ptxt>
Disconnect harness clamps from battery tray.
</ptxt>
</s2>
<s2>
<ptxt>
Remove battery tray.
</ptxt>
</s2>
<figure>
<graphic graphicname = "IGJA0A1A3002.jpg" width = "88.000mm" height = "58.239mm" ver = "01" gw = "199" gh = "149"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLJA0A1A46002004">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten new battery tray bolts (1) and battery tray nut (2) to specified torque.
</ptxt>
<attention4>
<ptxt>
The battery tray bolt and nut are pre-coated with adhesive. If these bolt and nut are reused, they may work loose.
</ptxt>
<ptxt>
Replace the battery tray bolt and nut with new ones whenever they are removed.
</ptxt>
</attention4>
<torque>
<torqueitem id = "T1J436">
<t-part>
Battery tray bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
15
</t-value1>
<t-value2>
1.5
</t-value2>
<t-value3>
11.0
</t-value3>
</torqueitem>
<torqueitem id = "T1J437">
<t-part>
Battery tray nut
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
15
</t-value1>
<t-value2>
1.5
</t-value2>
<t-value3>
11.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGJA0A1A3006.jpg" width = "88.000mm" height = "58.239mm" ver = "01" gw = "199" gh = "149"/>
</figure>
</item>
<item>
<ptxt>
Install battery (1) and battery band (2) as shown in figure, and then tighten battery band bolt (3) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1J438">
<t-part>
Battery band bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGJA0A1A3003.jpg" width = "88.000mm" height = "74.164mm" ver = "01" gw = "169" gh = "194"/>
</figure>
<figure>
<graphic graphicname = "IGJA0A1A3004.jpg" width = "88.000mm" height = "61.312mm" ver = "02" gw = "163" gh = "157"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[a]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Battery side
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
