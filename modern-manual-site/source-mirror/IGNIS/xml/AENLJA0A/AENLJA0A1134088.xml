<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P26A6: Engine Coolant Bypass Valve “A” Position Sensor Circuit Low
</emph>
</ptxt>
<ptxt>
Output voltage of coolant control valve position sensor signal circuit is lower than 0.04 V.
</ptxt>
<ptxt>
(1 D/C detection logic)
</ptxt>
</entry>
<entry colname = "2" morerows = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
Coolant control valve and/or its circuit
</ptxt>
</item>
<item>
<ptxt>
ECM
</ptxt>
</item>
</list1>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P26A7: Engine Coolant Bypass Valve “A” Position Sensor Circuit High
</emph>
</ptxt>
<ptxt>
Output voltage of coolant control valve position sensor signal circuit is higher than 4.87 V.
</ptxt>
<ptxt>
(1 D/C detection logic)
</ptxt>
</entry>
</row>
