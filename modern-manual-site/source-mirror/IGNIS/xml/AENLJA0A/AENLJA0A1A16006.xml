<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLJA0A1A16006" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Generator Removal and Installation
</title>
<servinfosub id = "AENLJA0A1A16006001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove water pump / generator drive belt. 
<intxreftitleoff1 refid = "AENLJA0A1A16004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove belt tensioner arm. 
<intxreftitleoff1 refid = "AENLJA0A1A16005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove exhaust No.1 pipe and exhaust center pipe. 
<intxreftitleoff1 refid = "AENLJA0A1B16001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect “B” terminal wire (1) and connector (2) from generator (3).
</ptxt>
<figure>
<graphic graphicname = "IGJA0A1A1014.jpg" width = "88.000mm" height = "56.546mm" ver = "01" gw = "204" gh = "144"/>
</figure>
</s1>
<s1>
<ptxt>
Remove generator (1).
</ptxt>
<figure>
<graphic graphicname = "IGJA0A1A1015.jpg" width = "88.000mm" height = "59.256mm" ver = "01" gw = "199" gh = "151"/>
</figure>
</s1>
<s1>
<ptxt>
Take out generator (1) through a space above the suspension frame (2).
</ptxt>
<figure>
<graphic graphicname = "IGJA0A1A1016.jpg" width = "88.000mm" height = "76.250mm" ver = "01" gw = "228" gh = "200"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[f]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Vehicle forward
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
<c-change/>
<servinfosub id = "AENLJA0A1A16006002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten generator upper bolt and lower bolt as follows.
</ptxt>
</item>
<list2 type = "ordered">
<item>
<ptxt>
Set generator (1) and tighten generator upper and lower bolts temporarily.
</ptxt>
</item>
<item>
<ptxt>
Tighten generator lower bolt (2) to 30 N&#183;m (3.1 kgf-m, 22.5 lbf-ft) and check that bush (3) is in contact with generator bracket, and then loosen the bolt.
</ptxt>
</item>
<item>
<ptxt>
Tighten generator upper bolt (4) and lower bolt to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1J105">
<t-part>
Generator lower bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
48
</t-value1>
<t-value2>
4.9
</t-value2>
<t-value3>
35.5
</t-value3>
</torqueitem>
<torqueitem id = "T1J106">
<t-part>
Generator upper bolt
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
30
</t-value1>
<t-value2>
3.1
</t-value2>
<t-value3>
22.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGJA0A1A1017.jpg" width = "88.000mm" height = "97.105mm" ver = "01" gw = "199" gh = "259"/>
</figure>
</item>
</list2>
<item>
<ptxt>
Connect wire (1) to generator as shown in figure, and tighten “B” terminal nut (2) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1J107">
<t-part>
“B” terminal nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
7.9
</t-value1>
<t-value2>
0.81
</t-value2>
<t-value3>
6.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGJA0A1A1018.jpg" width = "88.000mm" height = "56.964mm" ver = "02" gw = "195" gh = "145"/>
</figure>
</item>
<item>
<ptxt>
Install belt tensioner arm. 
<intxreftitleoff1 refid = "AENLJA0A1A16005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
