<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLJA0A1A16004" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Water Pump / Generator Drive Belt Removal and Installation
</title>
<servinfosub id = "AENLJA0A1A16004001" page = "2">
<title>
Removal
</title>
<s1 page = "2">
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Hoist vehicle and remove right front fender lining. 
<intxreftitleoff1 refid = "AENLJA0A9A06004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
For A/C model, remove A/C compressor drive belt.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Manual A/C model: 
<intxreftitleoff1 refid = "AENLJA0A7226032"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Auto A/C model: 
<intxreftitleoff1 refid = "AENLJA0A7236041"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1 page = "2">
<ptxt>
Loosen tension pulley bolt (1).
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Loosen generator belt adjusting bolt (2), and then remove water pump / generator drive belt (3).
</ptxt>
<figure>
<graphic graphicname = "IGJA0A1A1007.jpg" width = "88.000mm" height = "57.054mm" ver = "01" gw = "199" gh = "145"/>
</figure>
</s1>
</servinfosub>
<c-change/>
<servinfosub id = "AENLJA0A1A16004002" page = "2">
<title>
Installation
</title>
<s1 page = "2">
<ptxt>
Install water pump / generator drive belt (1) to water pump pulley (2), crankshaft pulley (3) belt tensioner pulley (4) and generator pulley (5).
</ptxt>
<attention3>
<ptxt>
Check that drive belt is installed in grooves of each pulley correctly.
</ptxt>
</attention3>
<figure>
<graphic graphicname = "IGJA0A1A1008.jpg" width = "88.000mm" height = "60.610mm" ver = "01" gw = "199" gh = "155"/>
</figure>
</s1>
<s1 page = "2">
<ptxt>
Adjust belt tension. 
<intxreftitleoff1 refid = "AENLJA0A1A16003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
For A/C model, install A/C compressor drive belt.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Manual A/C model: 
<intxreftitleoff1 refid = "AENLJA0A7226032"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Auto A/C model: 
<intxreftitleoff1 refid = "AENLJA0A7236041"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Install right front fender lining. 
<intxreftitleoff1 refid = "AENLJA0A9A06004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Connect negative (–) cable at battery.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
