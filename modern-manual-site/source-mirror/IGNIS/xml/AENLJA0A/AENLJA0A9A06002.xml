]>
<suzuki><manual>
<section sectnbr = "9J">
<servcat sctnbr = "09" scnbr = "10">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLJA0A9A06002" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Hood Inspection and Adjustment
</title>
<servinfosub id = "AENLJA0A9A06002001">
<title>
Inspection
</title>
<ptxt>
<intxrefpoff refid = "AENLJA0A9A06001">Hood Removal and Installation</intxrefpoff>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Check that hood opens and closes smoothly and properly. Lubricate hood hinge if necessary.
</ptxt>
</item>
<item>
<ptxt>
Check that hood stops in secondary latched position properly when hood lock is released.
</ptxt>
</item>
<item>
<ptxt>
Check that hood closes completely in fully latched position.
</ptxt>
</item>
</list1>
</servinfosub>
<servinfosub id = "AENLJA0A9A06002002">
<title>
Adjustment
</title>
<topic id = "AENLJA0A9A06002003">
<title>
Horizontal adjustment of hood
</title>
<ptxt>
Loosen hood hinge bolts and adjust installation position of hood. 
<intxreftitleoff1 refid = "AENLJA0A9B04003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</topic>
<topic id = "AENLJA0A9A06002004">
<title>
Vertical adjustment of hood
</title>
<ptxt>
Turn hood cushion (1) if clearance between hood and front fender is uneven.
</ptxt>
<figure>
<graphic graphicname = "IFJA0P9A0002.jpg" width = "88.000mm" height = "62.237mm" ver = "01" gw = "199" gh = "160"/>
</figure>
</topic>
<topic id = "AENLJA0A9A06002005">
<title>
Hood lock position adjustment
</title>
<s1>
<ptxt>
Remove front bumper and radiator grille. 
<intxreftitleoff1 refid = "AENLJA0A9806001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Loosen hood latch bolt (1), and set hood latch (2) in lowest position.
</ptxt>
</s1>
<s1>
<ptxt>
Tighten hood latch bolts to specified torque in numerical order (“1” – “3”).
</ptxt>
<torque>
<torqueitem id = "T9J001">
<t-part>
Hood latch bolt*
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
10
</t-value1>
<t-value2>
1.0
</t-value2>
<t-value3>
7.5
</t-value3>
</torqueitem>
</torque>
<figure>
<title>
LHD
</title>
<graphic graphicname = "ILJA0A9A0001.jpg" width = "88.000mm" height = "55.475mm" ver = "02" gw = "237" gh = "141"/>
</figure>
<figure>
<title>
RHD
</title>
<graphic graphicname = "ILJA0A9A0002.jpg" width = "88.000mm" height = "48.900mm" ver = "02" gw = "220" gh = "122"/>
</figure>
</s1>
<s1>
<ptxt>
Check that hood is locked smoothly and securely.
</ptxt>
</s1>
</topic>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
