<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLJA0A1A16005" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Belt Tensioner Arm and Belt Tensioner Pulley Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLJA0A1A16006">Generator Removal and Installation:K12M</intxrefpoff>
</ptxt>
<servinfosub id = "AENLJA0A1A16005001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Hoist vehicle and remove right front fender lining. 
<intxreftitleoff1 refid = "AENLJA0A9A06004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Loosen tension pulley bolt (1), and then loosen generator belt adjuster bolt (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove belt tensioner arm (3) with belt tensioner pulley (4).
</ptxt>
<figure>
<graphic graphicname = "IGJA0A1A1009.jpg" width = "88.000mm" height = "59.848mm" ver = "01" gw = "199" gh = "153"/>
</figure>
</s1>
<s1>
<ptxt>
Remove generator belt adjuster bolt (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove tension pulley bolt (2), and then remove tension pulley (3) and generator belt adjuster (4).
</ptxt>
<figure>
<graphic graphicname = "IGJA0A1A1010.jpg" width = "88.000mm" height = "61.203mm" ver = "01" gw = "167" gh = "157"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLJA0A1A16005002">
<title>
Installation
</title>
<s1>
<ptxt>
Install tension pulley (1) to belt tensioner arm (2) so that cutout in tension pulley is aligned with slot in belt tensioner arm.
</ptxt>
<figure>
<graphic graphicname = "IGJA0A1A1011.jpg" width = "88.000mm" height = "63.573mm" ver = "01" gw = "120" gh = "164"/>
</figure>
</s1>
<s1>
<ptxt>
Install generator belt adjuster (1) and tighten tension pulley bolt (2) temporarily.
</ptxt>
</s1>
<s1>
<ptxt>
Install generator belt adjuster bolt (3).
</ptxt>
<figure>
<graphic graphicname = "IGJA0A1A1012.jpg" width = "88.000mm" height = "65.267mm" ver = "01" gw = "171" gh = "168"/>
</figure>
</s1>
<s1>
<ptxt>
Install belt tensioner arm (1) with belt tensioner pulley (2) as shown in figure.
</ptxt>
</s1>
<s1>
<ptxt>
Tighten belt tensioner arm bolts to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1J104">
<t-part>
Belt tensioner arm bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
25
</t-value1>
<t-value2>
2.5
</t-value2>
<t-value3>
18.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGJA0A1A1013.jpg" width = "88.000mm" height = "59.848mm" ver = "01" gw = "200" gh = "153"/>
</figure>
</s1>
<s1>
<ptxt>
Adjust belt tension. 
<intxreftitleoff1 refid = "AENLJA0A1A16003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install right front fender lining. 
<intxreftitleoff1 refid = "AENLJA0A9A06004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Connect negative (–) cable at battery.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
