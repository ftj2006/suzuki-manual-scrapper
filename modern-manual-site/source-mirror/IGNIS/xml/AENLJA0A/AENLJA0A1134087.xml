<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P2681: Engine Coolant Bypass Valve “A” Control Circuit/Open
</emph>
</ptxt>
<ptxt>
Coolant control valve drive circuit is open.
</ptxt>
<ptxt>
(1 D/C detection logic)
</ptxt>
</entry>
<entry colname = "2" morerows = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
Coolant control valve and/or its circuit
</ptxt>
</item>
<item>
<ptxt>
ECM
</ptxt>
</item>
</list1>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P2682: Engine Coolant Bypass Valve “A” Control Circuit Low
</emph>
</ptxt>
<ptxt>
Coolant control valve drive circuit is shorted to ground.
</ptxt>
<ptxt>
(1 D/C detection logic)
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P2683: Engine Coolant Bypass Valve “A” Control Circuit High
</emph>
</ptxt>
<ptxt>
Coolant control valve drive circuit is shorted to power supply.
</ptxt>
<ptxt>
(1 D/C detection logic)
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P26B1: Engine Coolant Bypass Valve “A” Stuck Closed
</emph>
</ptxt>
<ptxt>
Coolant control valve opening is stuck.
</ptxt>
<ptxt>
(1 D/C detection logic)
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
