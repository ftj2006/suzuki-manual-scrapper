<servinfosub id = "AENLJA0A1114043003">
<title>
DTC Confirmation Procedure
</title>
<s1>
<ptxt>
Set ignition “ON” for 10 sec.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLJA0A1114043004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLJA0A1114043005">
<testgroup id = "AENLJA0A1114043006">
<title>
DTC recheck
</title>
<test1>
<ptxt>
Clear DTC. 
<intxreftitleoff1 refid = "AENLJA0A1114004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Perform “DTC Confirmation Procedure”, and check DTC.
</ptxt>
</test1>
<question>
Is DTC P0602 still detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Check for intermittent trouble. 
<intxreftitleoff1 refid = "AENLJA0A0006002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLJA0A1114043007">
<title>
ECM reprogramming check
</title>
<question>
Was reprogramming of ECM executed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Execute reprogramming of ECM correctly again.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLJA0A1114043008">
<title>
ECM power and ground circuit check
</title>
<test1>
<ptxt>
Check ECM power and ground circuit. 
<intxreftitleoff1 refid = "AENLJA0A1114065"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck DTC. 
<intxreftitleoff1 refid = "AENLJA0A1316001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
</diag>
