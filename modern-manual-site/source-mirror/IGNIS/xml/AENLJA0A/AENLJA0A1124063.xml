<suzuki><manual>
<section sectnbr = "1A">
<servcat sctnbr = "01" scnbr = "01">
<configtype typenbr = "2">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLJA0A1124063" svcinfotypenbr = "06" svcinfoqualnbr = "02" supplyoff = "1" modify = "0">
<title>
DTC P2226 / P2227 / P2228 / P2229
</title>
<attention3>
<ptxt>
There are two types of OBD system on ECM depending on the vehicle specification.
</ptxt>
<ptxt>
For identification, refer to “Discrimination for OBD System” under 
<intxref refid = "AENLJA0A1121003">OBD System Description:K12C</intxref>
.
</ptxt>
</attention3>
<servinfosub id = "AENLJA0A1124063001">
<title>
DTC Detecting Condition and Trouble Area
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "4.092in"/>
<colspec colnum = "2" colname = "2" colwidth = "3.105in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
DTC detecting condition
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
Trouble area
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "top" align = "left">
<ptxt>
<emph>
P2226: Barometric Pressure Sensor “A” Circuit
</emph>
</ptxt>
<ptxt>
Barometric pressure sensor and/or its circuit malfunction (open, short to power supply or short to ground) is detected.
</ptxt>
<ptxt>
(3 D/C detection logic (type A))
</ptxt>
<ptxt>
(2 D/C detection logic (type B))
</ptxt>
</entry>
<entry colname = "2" morerows = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Barometric pressure sensor in ECM
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "top" align = "left">
<ptxt>
<emph etype = "bold">
P2227: Barometric Pressure Circuit Range / Performance
</emph>
</ptxt>
<ptxt>
This DTC is detected if any one of the following conditions is met.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Sensor signal is out of specified range
</ptxt>
</item>
<item>
<ptxt>
Difference between actual and expected ambient pressure is more than the specified value and the fluctuation of ambient pressure is more than the specified value.
</ptxt>
</item>
</list1>
<ptxt>
(3 D/C detection logic (type A))
</ptxt>
<ptxt>
(2 D/C detection logic (type B))
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "top" align = "left">
<ptxt>
<emph>
P2228: Barometric Pressure Sensor “A” Circuit Low
</emph>
</ptxt>
<ptxt>
Output voltage of barometric pressure sensor signal is lower than specified value for specified time.
</ptxt>
<ptxt>
(3 D/C detection logic (type A))
</ptxt>
<ptxt>
(2 D/C detection logic (type B))
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "top" align = "left">
<ptxt>
<emph>
P2229: Barometric Pressure Sensor “A” Circuit High
</emph>
</ptxt>
<ptxt>
Output voltage of barometric pressure sensor signal is higher than specified value for specified time.
</ptxt>
<ptxt>
(3 D/C detection logic (type A))
</ptxt>
<ptxt>
(2 D/C detection logic (type B))
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</servinfosub>
<servinfosub id = "AENLJA0A1124063002">
<title>
DTC Confirmation Procedure
</title>
<topic id = "AENLJA0A1124063003">
<title>
P2226
</title>
<s1>
<ptxt>
Set ignition “ON” for 10 sec.
</ptxt>
</s1>
</topic>
<topic id = "AENLJA0A1124063004">
<title>
P2227
</title>
<s1>
<ptxt>
Run engine at idle speed for 1 min.
</ptxt>
</s1>
</topic>
<topic id = "AENLJA0A1124063005">
<title>
P2228 / P2229
</title>
<s1>
<ptxt>
Set ignition “ON” for 10 sec.
</ptxt>
</s1>
</topic>
</servinfosub>
<servinfosub id = "AENLJA0A1124063006">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLJA0A1124063007">
<testgroup id = "AENLJA0A1124063008">
<question>
Was “Engine and Emission Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLJA0A1124001">Engine and Emission Control System Check:K12C</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLJA0A1124063009">
<title>
ECM power supply and ground circuit check
</title>
<test1>
<ptxt>
Check ECM power supply and ground circuits. 
<intxreftitleoff1 refid = "AENLJA0A1124077"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck DTC. 
<intxreftitleoff1 refid = "AENLJA0A1326001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair ECM power supply and ground circuits.
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
