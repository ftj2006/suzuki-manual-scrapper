<servinfosub id = "AENLJA0A1114042003">
<title>
DTC Confirmation Procedure
</title>
<topic id = "AENLJA0A1114042004">
<title>
P0560
</title>
<s1>
<ptxt>
Set ignition “ON” for 1 min.
</ptxt>
</s1>
</topic>
<topic id = "AENLJA0A1114042005">
<title>
P0562 / P0563
</title>
<s1>
<ptxt>
Run engine at 2,500 rpm or more for 1 min.
</ptxt>
</s1>
</topic>
</servinfosub>
<servinfosub id = "AENLJA0A1114042006">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLJA0A1114042007">
<testgroup id = "AENLJA0A1114042008">
<question>
Was “Engine and Emission Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLJA0A1114001">Engine and Emission Control System Check:K12M</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLJA0A1114042009">
<title>
ECM power supply and ground circuit check
</title>
<test1>
<ptxt>
Check ECM power supply and ground circuits. 
<intxreftitleoff1 refid = "AENLJA0A1114065"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair ECM power supply and/or ground circuit.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLJA0A1114042010">
<title>
Charging system check
</title>
<test1>
<ptxt>
Check that charging system is working properly. 
<intxreftitleoff1 refid = "AENLJA0A1A14003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck DTC. 
<intxreftitleoff1 refid = "AENLJA0A1316001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective parts.
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
