]>
<suzuki><manual>
<section sectnbr = "9O">
<servcat sctnbr = "09" scnbr = "15">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLJA0A9F06009" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
USB and AUX Socket Removal and Installation (If Equipped)
</title>
<servinfosub id = "AENLJA0A9F06009001">
<title>
Removal
</title>
<s1>
<ptxt>
For manual A/C model, remove HVAC control unit. 
<intxreftitleoff1 refid = "AENLJA0A7216010"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
For automatic A/C model, remove auto A/C panel. 
<intxreftitleoff1 refid = "AENLJA0A7236010"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect USB and AUX socket connectors, and then remove USB and AUX socket (2) while releasing locks (1).
</ptxt>
<figure>
<graphic graphicname = "IGJA0A9F0022.jpg" width = "88.000mm" height = "97.012mm" ver = "01" gw = "225" gh = "258"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLJA0A9F06009002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLJA0A9F06010">USB and AUX Socket Inspection (If Equipped)</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
