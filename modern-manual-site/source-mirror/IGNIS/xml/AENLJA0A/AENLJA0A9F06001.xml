<suzuki><manual>
<section sectnbr = "9O">
<servcat sctnbr = "09" scnbr = "15">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLJA0A9F06001" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Audio / Navigation Unit Removal and Installation (If Equipped)
</title>
<servinfosub id = "AENLJA0A9F06001001">
<title>
Removal
</title>
<topic id = "AENLJA0A9F06001002">
<title>
Without audio / navigation unit
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove instrument panel center garnish. 
<intxreftitleoff1 refid = "AENLJA0A9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove instrument panel center garnish base. 
<intxreftitleoff1 refid = "AENLJA0A9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove radio hole cover (1) from instrument panel by removing 2 mounting screws (2).
</ptxt>
<figure>
<graphic graphicname = "IGJA0A9F0013.jpg" width = "88.000mm" height = "55.700mm" ver = "01" gw = "199" gh = "141"/>
</figure>
</s1>
<s1>
<ptxt>
Remove tuner brackets (1) by removing screws (2), if necessary.
</ptxt>
<figure>
<graphic graphicname = "IGJA0A9F0014.jpg" width = "88.000mm" height = "58.947mm" ver = "01" gw = "215" gh = "151"/>
</figure>
</s1>
</topic>
<topic id = "AENLJA0A9F06001003">
<title>
With audio / navigation unit
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove screw cover (1).
</ptxt>
<figure>
<graphic graphicname = "IGJA0A9F0015.jpg" width = "88.000mm" height = "55.276mm" ver = "01" gw = "199" gh = "140"/>
</figure>
</s1>
<s1>
<ptxt>
Remove audio unit or navigation unit (1) from instrument panel by removing 2 mounting screws (2).
</ptxt>
<figure>
<graphic graphicname = "IGJA0A9F0016.jpg" width = "88.000mm" height = "56.377mm" ver = "01" gw = "199" gh = "143"/>
</figure>
</s1>
<s1>
<ptxt>
Remove tuner brackets (1) by removing screws (2), if necessary.
</ptxt>
<figure>
<graphic graphicname = "IGJA0A9F0017.jpg" width = "88.000mm" height = "72.503mm" ver = "01" gw = "227" gh = "189"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Audio unit
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[B]:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Navigation unit
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</topic>
</servinfosub>
<servinfosub id = "AENLJA0A9F06001004">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
