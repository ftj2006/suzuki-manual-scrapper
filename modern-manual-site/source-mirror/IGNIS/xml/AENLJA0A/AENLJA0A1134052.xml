<servinfosub id = "AENLJA0A1134052003">
<title>
DTC Confirmation Procedure
</title>
<s1>
<ptxt>
Set ignition “ON” for 1 min. or more.
</ptxt>
</s1>
<s1>
<ptxt>
Start engine, if possible.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLJA0A1134052004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLJA0A1134052005">
<testgroup id = "AENLJA0A1134052006">
<title>
DTC recheck
</title>
<test1>
<ptxt>
Clear DTC. 
<intxreftitleoff1 refid = "AENLJA0A1134004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Perform “DTC Confirmation Procedure” and check DTC.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Check for intermittent trouble. 
<intxreftitleoff1 refid = "AENLJA0A0006002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLJA0A1134052007">
<title>
ECM power supply and ground circuit check
</title>
<test1>
<ptxt>
Check ECM power supply circuit and ECM ground circuit. 
<intxreftitleoff1 refid = "AENLJA0A1134077"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLJA0A1134052008">
<title>
Sensor power supply circuit check
</title>
<test1>
<ptxt>
Check sensor power supply circuits according to Step 8 under 
<intxref refid = "AENLJA0A1134077">ECM Power Supply and Ground Circuit Check:K12D</intxref>
.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck DTC. 
<intxreftitleoff1 refid = "AENLJA0A1336001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
</diag>
