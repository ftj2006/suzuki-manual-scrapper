<servinfosub id = "AENLJA0A1114063003">
<title>
DTC Confirmation Procedure
</title>
<s1>
<ptxt>
Set ignition “ON”.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLJA0A1114063004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLJA0A1114063005">
<testgroup id = "AENLJA0A1114063006">
<title>
DTC recheck
</title>
<test1>
<ptxt>
Clear DTC. 
<intxreftitleoff1 refid = "AENLJA0A1114004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Perform “DTC Confirmation Procedure” and check DTC.
</ptxt>
</test1>
<question>
Is DTC U2021 still detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Check for intermittent trouble. 
<intxreftitleoff1 refid = "AENLJA0A0006002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLJA0A1114063007">
<title>
ECM power supply and ground circuit check
</title>
<test1>
<ptxt>
Check ECM power supply and ground circuits. 
<intxreftitleoff1 refid = "AENLJA0A1114065"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck DTC. 
<intxreftitleoff1 refid = "AENLJA0A1316001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair ECM power supply and ground circuits.
</ptxt>
</action>
</testgroup>
</diag>
