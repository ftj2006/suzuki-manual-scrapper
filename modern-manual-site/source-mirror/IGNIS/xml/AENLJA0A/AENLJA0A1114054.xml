<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1A">
<servcat sctnbr = "01" scnbr = "01">
<configtype typenbr = "1">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLJA0A1114054" svcinfotypenbr = "06" svcinfoqualnbr = "02" supplyoff = "1" modify = "0">
<title>
DTC P2227 / P2228 / P2229
</title>
<servinfosub id = "AENLJA0A1114054001">
<title>
DTC Detecting Condition and Trouble Area
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "4.567in"/>
<colspec colnum = "2" colname = "2" colwidth = "2.631in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
DTC detecting condition
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
Trouble area
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "top" align = "left">
<ptxt>
<emph>
P2227: Barometric Pressure Sensor “A” Circuit Range / Performance
</emph>
</ptxt>
<ptxt>
This DTC is detected if any one of the following conditions is met.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
BARO sensor signal is out of specified range for 2 sec.
</ptxt>
</item>
<item>
<ptxt>
Variation of BARO sensor signal is out of specified range for 20 sec. at engine running condition.
</ptxt>
</item>
</list1>
<ptxt>
(3 D/C detection logic)
</ptxt>
</entry>
<entry colname = "2" morerows = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Barometric pressure sensor in ECM
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "top" align = "left">
<ptxt>
<emph>
P2228: Barometric Pressure Sensor “A” Circuit Low
</emph>
</ptxt>
<ptxt>
Barometric pressure sensor signal voltage is lower than specified value for specified time.
</ptxt>
<ptxt>
(3 D/C detection logic)
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "top" align = "left">
<ptxt>
<emph>
P2229: Barometric Pressure Sensor “A” Circuit High
</emph>
</ptxt>
<ptxt>
Barometric pressure sensor signal voltage is higher than specified value for specified time.
</ptxt>
<ptxt>
(3 D/C detection logic)
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</servinfosub>
<servinfosub id = "AENLJA0A1114054002">
<title>
DTC Confirmation Procedure
</title>
<topic id = "AENLJA0A1114054003">
<title>
P2227
</title>
<s1>
<ptxt>
Run engine at idle speed for 1 min.
</ptxt>
</s1>
</topic>
<topic id = "AENLJA0A1114054004">
<title>
P2228 / P2229
</title>
<s1>
<ptxt>
Set ignition “ON” for 1 min.
</ptxt>
</s1>
</topic>
</servinfosub>
<servinfosub id = "AENLJA0A1114054005">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLJA0A1114054006">
<testgroup id = "AENLJA0A1114054007">
<question>
Was “Engine and Emission Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLJA0A1114001">Engine and Emission Control System Check:K12M</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLJA0A1114054008">
<title>
ECM power supply and ground circuit check
</title>
<test1>
<ptxt>
Check ECM power supply and ground circuits. 
<intxreftitleoff1 refid = "AENLJA0A1114065"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck DTC. 
<intxreftitleoff1 refid = "AENLJA0A1316001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair ECM power supply and ground circuits.
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
