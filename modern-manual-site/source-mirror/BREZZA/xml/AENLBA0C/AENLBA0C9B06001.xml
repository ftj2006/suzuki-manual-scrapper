<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9K">
<servcat sctnbr = "09" scnbr = "11">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLBA0C9B06001" svcinfotypenbr = "08" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Hood Lock Member and Lamp Support Brace Removal and Installation
</title>
<attention3>
<ptxt>
The figure below shows condition where the following parts are removed.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front fender 
<intxreftitleoff1 refid = "AENLBA0C9A06005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</attention3>
<figure>
<graphic graphicname = "ILBA0A9B0005.jpg" width = "183.000mm" height = "101.172mm" ver = "01" gw = "452" gh = "270"/>
</figure>
<p-change/>
<servinfosub id = "AENLBA0C9B06001001">
<title>
General Notes
</title>
<ptxt>
Welding method and number of welding points are the same on both sides. This repair instruction shows procedure for left side.
</ptxt>
</servinfosub>
<servinfosub id = "AENLBA0C9B06001002">
<title>
Removal
</title>
<s1>
<ptxt>
Unscrew 4 bolts.
</ptxt>
</s1>
<s1>
<ptxt>
Remove hood lock member.
</ptxt>
<figure>
<graphic graphicname = "ILBA0A9B0006.jpg" width = "183.000mm" height = "120.928mm" ver = "01" gw = "404" gh = "326"/>
</figure>
</s1>
<p-change/>
<s1>
<ptxt>
Drill out welding spots and remove lamp support brace.
</ptxt>
<figure>
<graphic graphicname = "IFBA0A9B0019.jpg" width = "183.000mm" height = "196.435mm" ver = "01" gw = "470" gh = "540"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.394in"/>
<colspec colnum = "2" colname = "2" colwidth = "6.299in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MANOTE" width = "5.132mm" height = "3.048mm"/>
:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
This symbol indicates that lamp support brace and apron side front No.1 reinforcement are replaced at the same time.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLBA0C9B06001003">
<title>
Installation
</title>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
Before conducting any weld, check installation position and condition for installation part(s). 
<intxreftitleoff1 refid = "AENLBA0C9B04004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Proceed repair while taking into consideration installation of parts that affect appearance. 
<intxreftitleoff1 refid = "AENLBA0C9B04003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</attention3>
<p-change/>
<s1>
<ptxt>
Install lamp support brace.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld or plug weld.
</ptxt>
<figure>
<graphic graphicname = "IFBA0A9B0020.jpg" width = "183.000mm" height = "196.435mm" ver = "01" gw = "470" gh = "540"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.394in"/>
<colspec colnum = "2" colname = "2" colwidth = "6.299in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MANOTE" width = "5.132mm" height = "3.048mm"/>
:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
This symbol indicates that lamp support brace and apron side front No.1 reinforcement are replaced at the same time.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Install hood lock member.
</ptxt>
</s1>
<s1>
<ptxt>
Tighten 4 bolts to specified torque.
</ptxt>
<p-change/>
<figure>
<graphic graphicname = "ILBA0A9B0007.jpg" width = "183.000mm" height = "120.928mm" ver = "01" gw = "404" gh = "326"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.472in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MATORQUE-A" width = "8.011mm" height = "3.048mm"/>
:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
10 N&#183;m (1.0 kgf-m, 7.5 lbf-ft)
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
