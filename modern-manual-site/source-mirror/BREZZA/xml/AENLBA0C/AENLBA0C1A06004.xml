<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLBA0C1A06004" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "1">
<title>
Water Pump / Generator Drive Belt Removal and Installation
</title>
<servinfosub id = "AENLBA0C1A06004001" page = "2">
<title>
Removal
</title>
<s1>
<ptxt>
Remove right side engine under side cover.
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Remove compressor drive belt. 
<intxreftitleoff1 refid = "AENLBA0C7226040"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Loosen tensioner pulley bolt (2) and generator adjusting bolt (3).
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Remove water pump / generator drive belt (1).
</ptxt>
<figure>
<graphic graphicname = "ILBA0C1A0003.jpg" width = "88.000mm" height = "56.969mm" ver = "01" gw = "199" gh = "145"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLBA0C1A06004002" page = "2">
<title>
Installation
</title>
<s1 page = "2">
<ptxt>
Install water pump / generator drive belt (1) to water pump pulley (2), crankshaft pulley (3), belt tensioner pulley (4) and generator pulley (5).
</ptxt>
<attention3>
<ptxt>
Check that drive belt is installed in grooves of each pulley correctly.
</ptxt>
</attention3>
<figure>
<graphic graphicname = "ILBA0C1A0004.jpg" width = "88.000mm" height = "56.969mm" ver = "01" gw = "199" gh = "145"/>
</figure>
</s1>
<s1 page = "2">
<ptxt>
Adjust belt tension. 
<intxreftitleoff1 refid = "AENLBA0C1A06003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install compressor drive belt. 
<intxreftitleoff1 refid = "AENLBA0C7226040"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install right side engine under side cover.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
