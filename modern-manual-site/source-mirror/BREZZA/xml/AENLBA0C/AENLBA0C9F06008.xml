<suzuki><manual>
<section sectnbr = "9O">
<servcat sctnbr = "09" scnbr = "15">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLBA0C9F06008" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "1">
<title>
GPS Antenna Removal and Installation
</title>
<servinfosub id = "AENLBA0C9F06008001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove navigation unit. 
<intxreftitleoff1 refid = "AENLBA0C9F06001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove combination meter cluster panel. 
<intxreftitleoff1 refid = "AENLBA0C9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove screw (1), clips and then remove GPS antenna (2).
</ptxt>
<figure>
<graphic graphicname = "IFBA0A9F0014.jpg" width = "88.000mm" height = "66.722mm" ver = "01" gw = "217" gh = "173"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLBA0C9F06008002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
