<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLBA0C9B06023" svcinfotypenbr = "08" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Roof Panel Removal and Installation
</title>
<attention3>
<ptxt>
The figure below shows condition where the following parts are removed.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front fender 
<intxreftitleoff1 refid = "AENLBA0C9A06005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Fuel filler door panel 
<intxreftitleoff1 refid = "AENLBA0C9806017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</attention3>
<figure>
<graphic graphicname = "IFBA0A9B0163.jpg" width = "183.000mm" height = "124.940mm" ver = "01" gw = "430" gh = "338"/>
</figure>
<servinfosub id = "AENLBA0C9B06023001">
<title>
General Notes
</title>
<ptxt>
Roof carrier brackets are to be reused.
</ptxt>
</servinfosub>
<servinfosub id = "AENLBA0C9B06023002">
<title>
Removal
</title>
<s1>
<ptxt>
Drill out welding spots and remove 4 roof carrier brackets (roof carrier bracket model) or roof rail bracket (roof rail model) and roof panel.
</ptxt>
</s1>
<figure>
<graphic graphicname = "IJBA0A9B0019.jpg" width = "183.000mm" height = "163.490mm" ver = "01" gw = "461" gh = "447"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.313in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.772in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.394in"/>
<colspec colnum = "4" colname = "4" colwidth = "4.462in"/>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Roof carrier bracket model
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MANOTE" width = "5.132mm" height = "3.048mm"/>
1:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
When heating around sealer application portion to detach body sealer, be sure that temperature of said portion does not reach 170 &#176;C (338 &#176;F).
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[B]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Roof rail model
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MANOTE" width = "5.132mm" height = "3.048mm"/>
2:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
When heating around adhesive application portion to detach adhesive, be sure that temperature of said portion does not reach 170 &#176;C (338 &#176;F).
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</servinfosub>
<servinfosub id = "AENLBA0C9B06023003">
<title>
Installation
</title>
<attention3>
<ptxt>
Before conducting any weld, check installation position and condition for installation part(s).
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Rear end door: 
<intxreftitleoff1 refid = "AENLBA0C9B04005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Windshield: 
<intxreftitleoff1 refid = "AENLBA0C9B04008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</attention3>
<s1>
<ptxt>
Conduct tack welding to roof panel No.1 member, roof panel No.2 member, roof panel No.3 member and roof panel No.4 member.
</ptxt>
</s1>
<s1>
<ptxt>
Apply body sealer.
</ptxt>
<figure>
<graphic graphicname = "IFBA0A9B0099.jpg" width = "183.000mm" height = "101.912mm" ver = "01" gw = "405" gh = "272"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
1.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Applied part of body sealer.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Install roof panel and 4 roof carrier brackets (roof carrier bracket model) or roof rail bracket (roof rail model).
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld and plug weld.
</ptxt>
<figure>
<graphic graphicname = "IJBA0A9B0017.jpg" width = "183.000mm" height = "164.872mm" ver = "03" gw = "467" gh = "451"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.394in"/>
<colspec colnum = "2" colname = "2" colwidth = "2.756in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "2.756in"/>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MANOTE" width = "5.132mm" height = "3.048mm"/>
:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Conduct resistance spot weld as three panel thickness.
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[B]:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Roof rail model
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Roof carrier bracket model
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
1.
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Press line
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
