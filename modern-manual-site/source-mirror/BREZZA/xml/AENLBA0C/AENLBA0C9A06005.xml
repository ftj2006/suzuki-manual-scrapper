<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9J">
<servcat sctnbr = "09" scnbr = "10">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLBA0C9A06005" svcinfotypenbr = "08" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Front Fender Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLBA0C9A06004">Front Fender Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLBA0C9A06005001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove front bumper and front bumper holder. 
<intxreftitleoff1 refid = "AENLBA0C9806001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove cowl top side garnish. 
<intxreftitleoff1 refid = "AENLBA0C9806006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove headlight unit. 
<intxreftitleoff1 refid = "AENLBA0C9206001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove side sill guard. 
<intxreftitleoff1 refid = "AENLBA0C9806009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove front fender lining. 
<intxreftitleoff1 refid = "AENLBA0C9A06004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove front fender and front fender rear pad.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLBA0C9A06005002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Adjust front fender panel clearance. 
<intxreftitleoff1 refid = "AENLBA0C9B04003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
If paint on front fender bolts is peeled off, apply paint again to prevent rust.
</ptxt>
</item>
<item>
<ptxt>
Perform headlight aiming after installation. 
<intxreftitleoff1 refid = "AENLBA0C9206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
