<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9J">
<servcat sctnbr = "09" scnbr = "10">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLBA0C9A06002" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "1">
<title>
Hood Inspection and Adjustment
</title>
<servinfosub id = "AENLBA0C9A06002001">
<title>
Inspection
</title>
<ptxt>
<intxrefpoff refid = "AENLBA0C9A06001">Hood Removal and Installation</intxrefpoff>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Check that hood opens and closes smoothly and properly. Lubricate it if necessary.
</ptxt>
</item>
<item>
<ptxt>
Check that hood stops in secondary latched position properly when hood lock is released.
</ptxt>
</item>
<item>
<ptxt>
Check that hood closes completely in fully latched position.
</ptxt>
</item>
<item>
<ptxt>
Adjust hood lock position if necessary.
</ptxt>
</item>
</list1>
</servinfosub>
<servinfosub id = "AENLBA0C9A06002002">
<title>
Adjustment
</title>
<topic id = "AENLBA0C9A06002003">
<title>
Horizontal adjustment of hood
</title>
<ptxt>
Loosen hood hinge bolts and adjust installation position of hood. 
<intxreftitleoff1 refid = "AENLBA0C9B04003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</topic>
<topic id = "AENLBA0C9A06002004">
<title>
Vertical adjustment of hood
</title>
<ptxt>
Turn hood cushion (1) if clearance between hood and front fender is uneven.
</ptxt>
<figure>
<graphic graphicname = "ILBA0C9A0001.swf" width = "88.000mm" height = "43.770mm" ver = "03" gw = "224" gh = "108"/>
</figure>
</topic>
<topic id = "AENLBA0C9A06002005">
<title>
Hood lock position adjustment
</title>
<s1>
<ptxt>
Remove front bumper. 
<intxreftitleoff1 refid = "AENLBA0C9806001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Loosen hood latch bolts (1) and adjust height of hood latch (2).
</ptxt>
</s1>
<s1>
<ptxt>
Tighten hood latch bolts to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9J002">
<t-part>
Hood latch bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
10
</t-value1>
<t-value2>
1.0
</t-value2>
<t-value3>
7.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IFBA0A9A0003.jpg" width = "88.000mm" height = "47.783mm" ver = "01" gw = "217" gh = "119"/>
</figure>
</s1>
<s1>
<ptxt>
Check that hood is locked smoothly and securely.
</ptxt>
</s1>
</topic>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
