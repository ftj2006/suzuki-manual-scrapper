</tgroup>
</table>
</callout>
</figure>
</s1>
<p-change/>
<s1>
<ptxt>
Install radiator support member bracket and radiator support member plate.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld or plug weld.
</ptxt>
<figure>
<graphic graphicname = "IFBA0A9B0052.jpg" width = "88.000mm" height = "121.491mm" ver = "01" gw = "216" gh = "328"/>
</figure>
</s1>
<s1>
<ptxt>
Install front bumper member plate.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld or plug weld.
</ptxt>
<figure>
<graphic graphicname = "ILBA0A9B0009.jpg" width = "88.000mm" height = "86.864mm" ver = "01" gw = "212" gh = "230"/>
</figure>
</s1>
