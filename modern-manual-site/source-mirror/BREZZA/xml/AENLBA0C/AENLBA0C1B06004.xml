<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1K">
<servcat sctnbr = "01" scnbr = "11">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLBA0C1B06004" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Exhaust Pipe and Muffler Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLBA0C1B06001">Exhaust System Components</intxrefpoff>
</ptxt>
<attention2>
<ptxt>
Touching a hot exhaust system component will cause a burn.
</ptxt>
<ptxt>
Do not perform any service work on the exhaust system until the exhaust system is cool.
</ptxt>
</attention2>
<servinfosub id = "AENLBA0C1B06004001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove exhaust No.1 pipe (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove seal rings (2) from exhaust No.1 pipe and exhaust manifold (3).
</ptxt>
<figure>
<graphic graphicname = "ILBA0A1B0002.jpg" width = "88.000mm" height = "64.038mm" ver = "01" gw = "229" gh = "165"/>
</figure>
</s1>
<s1>
<ptxt>
Remove exhaust center pipe (1) from muffle (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove exhaust center pipe from mounting No.1 (3) and No.2 (4).
</ptxt>
<figure>
<graphic graphicname = "ILBA0A1B0003.jpg" width = "88.000mm" height = "65.091mm" ver = "01" gw = "230" gh = "168"/>
</figure>
<figure>
<graphic graphicname = "ILBA0A1B0004.jpg" width = "88.000mm" height = "70.676mm" ver = "01" gw = "229" gh = "184"/>
</figure>
</s1>
<s1>
<ptxt>
Remove gasket from exhaust center pipe.
</ptxt>
</s1>
<s1>
<ptxt>
Remove muffler (1) from mounting No.3 (2).
</ptxt>
<figure>
<graphic graphicname = "ILBA0A1B0005.jpg" width = "88.000mm" height = "49.016mm" ver = "01" gw = "229" gh = "122"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLBA0C1B06004002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Use new gasket and seal rings.
</ptxt>
</item>
</list1>
</servinfosub>
<list1 type = "unordered">
<item>
<ptxt>
Install mounting No.2 (1) positioning its cavity (2) longitudinally.
</ptxt>
<figure>
<graphic graphicname = "ILBA0A1B0006.jpg" width = "88.000mm" height = "65.266mm" ver = "01" gw = "223" gh = "168"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[f]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Forward
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</item>
<item>
<ptxt>
Tighten bolts and nuts to specified torque when reassembling. 
<intxreftitleoff1 refid = "AENLBA0C1B06001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Run engine and check for exhaust gas leakage.
</ptxt>
</item>
</list1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
