<title>
Front Speaker and Rear Speaker Removal and Installation
</title>
<servinfosub id = "AENLBA0C9F06002001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove door trim.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLBA0C9506012"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLBA0C9506016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Remove 3 screws and remove front or rear speaker (1).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect speaker connector.
</ptxt>
</s1>
<figure>
<graphic graphicname = "IFBA0A9F0006.jpg" width = "88.000mm" height = "74.095mm" ver = "01" gw = "186" gh = "194"/>
</figure>
</servinfosub>
<servinfosub id = "AENLBA0C9F06002002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
