<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9J">
<servcat sctnbr = "09" scnbr = "10">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLBA0C9A06001" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Hood Removal and Installation
</title>
<servinfosub id = "AENLBA0C9A06001001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove 4 hood hinge bolts (1) to detach hood (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove hood hinge after removing front fender, if necessary. 
<intxreftitleoff1 refid = "AENLBA0C9A06005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLBA0C9A06001002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLBA0C9A06002">Hood Inspection and Adjustment</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Apply sealant “A” to contact face of hood hinge.
</ptxt>
<materials>
<materialitem name = "SUZUKI Bond No.1215" id = "M9J001" uid = "27">
<m-part>
“A”
</m-part>
<m-desc>
Sealant
</m-desc>
<m-number>
99000–31110
</m-number>
<m-name>
SUZUKI Bond No.1215
</m-name>
</materialitem>
</materials>
</item>
<item>
<ptxt>
Adjust hood lock position if necessary. 
<intxreftitleoff1 refid = "AENLBA0C9A06002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Tighten hood hinge bolts to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9J001">
<t-part>
Hood hinge bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
10
</t-value1>
<t-value2>
1.0
</t-value2>
<t-value3>
7.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IHAD0A9A0004.jpg" width = "88.000mm" height = "85.466mm" ver = "01" gw = "220" gh = "226"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
