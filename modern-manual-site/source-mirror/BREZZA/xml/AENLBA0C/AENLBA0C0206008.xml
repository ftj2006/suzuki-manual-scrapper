<title>
Air Cleaner Filter Inspection
</title>
<list1 type = "ordered">
<item>
<ptxt>
Remove air cleaner filter. 
<intxreftitleoff1 refid = "AENLBA0C1406002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Check that filter is not excessively dirty, damaged or oily. Clean filter with compressed air from air outlet side of filter.
</ptxt>
<figure page = "2">
<graphic graphicname = "IHSE0A020001.swf" width = "88.000mm" height = "61.177mm" ver = "01" gw = "174" gh = "157"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.425in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.572in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.358in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.061in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Air outlet (throttle) side
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[B]:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Air inlet (flesh air) side
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</item>
<item>
<ptxt>
Install air cleaner filter. 
<intxreftitleoff1 refid = "AENLBA0C1406002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
