<suzuki><manual>
<section sectnbr = "9O">
<servcat sctnbr = "09" scnbr = "15">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLBA0C9F06009" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "1">
<title>
USB and AUX Socket Removal and Installation
</title>
<servinfosub id = "AENLBA0C9F06009001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove auto A/C panel. 
<intxreftitleoff1 refid = "AENLBA0C7226009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Remove HVAC control module. 
<intxreftitleoff1 refid = "AENLBA0C7226010"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Remove USB and AUX socket (3) from instrument panel lower cover by releasing locks (1) and then disconnect USB and AUX socket connector (2).
</ptxt>
<figure page = "2">
<graphic graphicname = "IJBA0A9F0007.jpg" width = "88.000mm" height = "64.133mm" ver = "01" gw = "228" gh = "165"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLBA0C9F06009002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
