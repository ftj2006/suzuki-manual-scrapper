<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLBA0C1A06002" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Battery Removal and Installation
</title>
<servinfosub id = "AENLBA0C1A06002001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable (1) at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect positive (+) cable (2) at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery band (3).
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery cover (4) and battery (5).
</ptxt>
<figure page = "2">
<graphic graphicname = "ILBA0A1A2001.jpg" width = "88.000mm" height = "70.834mm" ver = "01" gw = "216" gh = "184"/>
</figure>
</s1>
<s1>
<ptxt>
Disconnect harness clamps from battery tray, if necessary.
</ptxt>
</s1>
<s1>
<ptxt>
Remove battery tray (1), if necessary.
</ptxt>
<figure>
<graphic graphicname = "ILBA0A1A0002.jpg" width = "88.000mm" height = "57.000mm" ver = "01" gw = "238" gh = "145"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLBA0C1A06002002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten new battery tray bolts (1) to specified torque.
</ptxt>
<attention4>
<ptxt>
The battery tray bolts are pre-coated. If these bolts are reused, they may work loose.
</ptxt>
<ptxt>
Replace the battery tray bolts with new ones whenever they are removed.
</ptxt>
</attention4>
<torque>
<torqueitem id = "T1J001">
<t-part>
Battery tray bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
23
</t-value1>
<t-value2>
2.3
</t-value2>
<t-value3>
17.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "ILBA0A1A0003.jpg" width = "88.000mm" height = "57.000mm" ver = "01" gw = "238" gh = "145"/>
</figure>
</item>
</list1>
<list1 type = "unordered">
<item>
<ptxt>
Tighten battery band nuts (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1J002">
<t-part>
Battery band nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
3.3
</t-value1>
<t-value2>
0.34
</t-value2>
<t-value3>
2.5
</t-value3>
</torqueitem>
</torque>
</item>
<item>
<ptxt>
Tighten positive (+) cable nut (2) and negative (–) cable nut (3) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1J003">
<t-part>
Positive (+) cable nut
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
5.0
</t-value1>
<t-value2>
0.51
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
<torqueitem id = "T1J004">
<t-part>
Negative (–) cable nut
</t-part>
<t-part1>
c
</t-part1>
<t-value1>
5.0
</t-value1>
<t-value2>
0.51
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "ILBA0A1A2002.jpg" width = "88.000mm" height = "96.510mm" ver = "01" gw = "216" gh = "257"/>
</figure>
</item>
<item>
<ptxt>
Initialize electrical devices if necessary.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
