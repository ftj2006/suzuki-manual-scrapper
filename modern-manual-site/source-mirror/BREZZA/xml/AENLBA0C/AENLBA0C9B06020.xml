<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLBA0C9B06020" svcinfotypenbr = "08" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Rear Floor Rear Panel (Partial), Rear Floor Side Extension and Towing Rear Hook Removal and Installation
</title>
<attention3>
<ptxt>
The figure below shows condition where the following parts are removed.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front fender 
<intxreftitleoff1 refid = "AENLBA0C9A06005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Back Panel 
<intxreftitleoff1 refid = "AENLBA0C9B06019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</attention3>
<figure>
<graphic graphicname = "IFBA0A9B0160.jpg" width = "183.000mm" height = "114.882mm" ver = "01" gw = "468" gh = "309"/>
</figure>
<servinfosub id = "AENLBA0C9B06020001">
<title>
Removal
</title>
<s1>
<ptxt>
Mark at the shown position and cut rear floor panel.
</ptxt>
<attention2>
<ptxt>
Do not damage underneath parts of rear floor panel when cutting rear floor panel.
</ptxt>
</attention2>
</s1>
<s1>
<ptxt>
Drill out welding spots and remove rear floor rear panel, rear floor side extension and towing rear hook.
</ptxt>
<figure>
<graphic graphicname = "IJBA0A9B0015.jpg" width = "183.000mm" height = "146.038mm" ver = "01" gw = "451" gh = "397"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.394in"/>
<colspec colnum = "2" colname = "2" colwidth = "5.443in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MANOTE" width = "5.132mm" height = "3.048mm"/>
:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
This symbol indicates that rear floor panel (partial) and rear floor side rear member are replaced at the same time.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLBA0C9B06020002">
<title>
Installation
</title>
<attention3>
<ptxt>
Before conducting any weld, check installation position and condition for installation part(s). 
<intxreftitleoff1 refid = "AENLBA0C9B04009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</attention3>
<s1 page = "1">
<ptxt>
Install spare tire bracket and tool box bracket.
</ptxt>
</s1>
<s1 page = "1">
<ptxt>
Conduct resistance spot weld.
</ptxt>
<figure>
<graphic graphicname = "IFBA0A9B0137.jpg" width = "183.000mm" height = "69.394mm" ver = "01" gw = "291" gh = "180"/>
</figure>
</s1>
<s1 page = "1">
<ptxt>
Install rear floor rear panel, rear floor side extension and towing rear hook.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld and plug weld.
</ptxt>
<figure>
<graphic graphicname = "IJBA0A9B0016.jpg" width = "183.000mm" height = "145.262mm" ver = "01" gw = "423" gh = "395"/>
</figure>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
