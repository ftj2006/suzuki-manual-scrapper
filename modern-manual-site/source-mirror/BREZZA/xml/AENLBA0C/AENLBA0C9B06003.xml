<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9K">
<servcat sctnbr = "09" scnbr = "11">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLBA0C9B06003" svcinfotypenbr = "08" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Apron Side Member Removal and Installation
</title>
<attention3>
<ptxt>
The figure below shows condition where the following parts are removed.
</ptxt>
</attention3>
<figure>
<graphic graphicname = "IFBA0A9B0144.jpg" width = "183.000mm" height = "120.063mm" ver = "01" gw = "432" gh = "324"/>
</figure>
<servinfosub id = "AENLBA0C9B06003001">
<title>
General Notes
</title>
<ptxt>
Welding method and number of welding points are the same on both sides. This repair instruction shows procedure for left side.
</ptxt>
</servinfosub>
<p-change/>
<servinfosub id = "AENLBA0C9B06003002">
<title>
Removal
</title>
<s1>
<ptxt>
Drill out welding spots and remove apron side rear reinforcement.
</ptxt>
<figure>
<graphic graphicname = "IFBA0A9B0108.jpg" width = "88.000mm" height = "69.100mm" ver = "02" gw = "232" gh = "179"/>
</figure>
</s1>
<s1>
<ptxt>
Drill out welding spots and remove apron side member.
</ptxt>
<figure page = "1">
<graphic graphicname = "IFBA0A9B0169.jpg" width = "183.000mm" height = "144.764mm" ver = "01" gw = "433" gh = "394"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.370in"/>
<colspec colnum = "2" colname = "2" colwidth = "3.201in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MANOTE" width = "5.132mm" height = "3.048mm"/>
1.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Grind welding spots and continuous weld using belt sander, if necessary.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLBA0C9B06003003">
<title>
Installation
</title>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
Before conducting any weld, check installation position and condition for installation part(s).
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Front body: 
<intxreftitleoff1 refid = "AENLBA0C9B04004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Underbody: 
<intxreftitleoff1 refid = "AENLBA0C9B04009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
<item>
<ptxt>
Proceed repair while taking into consideration installation of parts that affect appearance. 
<intxreftitleoff1 refid = "AENLBA0C9B04003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</attention3>
<s1>
<ptxt>
Install apron side member.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld, plug weld and continuous weld.
</ptxt>
<figure>
<graphic graphicname = "IFBA0A9B0170.jpg" width = "183.000mm" height = "143.651mm" ver = "01" gw = "320" gh = "391"/>
</figure>
</s1>
<p-change/>
<s1>
<ptxt>
Install apron side rear reinforcement.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct plug weld.
</ptxt>
<figure>
<graphic graphicname = "IFBA0A9B0111.jpg" width = "88.000mm" height = "59.703mm" ver = "02" gw = "192" gh = "153"/>
</figure>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
