<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1J">
<servcat sctnbr = "01" scnbr = "10">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLBA0C1A06006" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Generator Removal and Installation
</title>
<servinfosub id = "AENLBA0C1A06006001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove right side engine under side cover.
</ptxt>
</s1>
<s1>
<ptxt>
Remove water pump / generator drive belt. 
<intxreftitleoff1 refid = "AENLBA0C1A06004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove belt tensioner arm. 
<intxreftitleoff1 refid = "AENLBA0C1A06005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
 Remove exhaust pipe. 
<intxreftitleoff1 refid = "AENLBA0C1B06004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove nut (1) and disconnect “B” terminal wire (2), and then disconnect generator connector (3) from generator (4).
</ptxt>
</s1>
<s1>
<ptxt>
Remove generator upper bolt (5) and lower bolt (6).
</ptxt>
</s1>
<s1>
<ptxt>
Remove generator from engine assembly.
</ptxt>
<figure>
<graphic graphicname = "IJHA0A1A0011.jpg" width = "88.000mm" height = "54.260mm" ver = "01" gw = "199" gh = "137"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLBA0C1A06006002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten generator upper bolt (1) and lower bolt (2) as follows.
</ptxt>
</item>
<list2 type = "ordered">
<item>
<ptxt>
Put generator (3) on cylinder block and tighten generator upper bolt and lower bolt temporarily.
</ptxt>
</item>
<item>
<ptxt>
Tighten generator lower bolt to 30 N&#183;m (3.1 kgf-m, 22.5 lbf-ft) and check that bushing (4) in generator is in contact with generator bracket, and then loosen the bolt.
</ptxt>
</item>
<item>
<ptxt>
Tighten generator upper bolt and lower bolt to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1J007">
<t-part>
Generator upper bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
30
</t-value1>
<t-value2>
3.1
</t-value2>
<t-value3>
22.5
</t-value3>
</torqueitem>
<torqueitem id = "T1J008">
<t-part>
Generator lower bolt
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
48
</t-value1>
<t-value2>
4.9
</t-value2>
<t-value3>
35.5
</t-value3>
</torqueitem>
</torque>
</item>
</list2>
</list1>
<list1 type = "unordered">
<item>
<ptxt>
Insert lugs (5) of “B” terminal wire (6) into groove (7) and then tighten “B” terminal nut (8) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1J009">
<t-part>
“B” terminal nut
</t-part>
<t-part1>
c
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
<figure page = "2">
<graphic graphicname = "IJHA0A1A0012.jpg" width = "88.000mm" height = "72.979mm" ver = "01" gw = "199" gh = "190"/>
</figure>
</item>
</list1>
<list1 type = "unordered">
<item>
<ptxt>
Adjust belt tension. 
<intxreftitleoff1 refid = "AENLBA0C1A06003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
