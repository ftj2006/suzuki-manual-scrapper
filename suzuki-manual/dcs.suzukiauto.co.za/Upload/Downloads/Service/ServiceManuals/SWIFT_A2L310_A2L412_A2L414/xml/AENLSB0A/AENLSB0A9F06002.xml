<suzuki><manual>
<section sectnbr = "9O">
<servcat sctnbr = "09" scnbr = "15">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9F06002" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Front Speaker and Rear Speaker Removal and Installation
</title>
<servinfosub id = "AENLSB0A9F06002001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove door trim.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front: 
<intxreftitleoff1 refid = "AENLSB0A9506009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Rear: 
<intxreftitleoff1 refid = "AENLSB0A9506013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Remove 3 screws and remove front or rear speaker (1).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect speaker connector.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9F0005.jpg" width = "88.000mm" height = "76.104mm" ver = "01" gw = "214" gh = "199"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9F06002002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
