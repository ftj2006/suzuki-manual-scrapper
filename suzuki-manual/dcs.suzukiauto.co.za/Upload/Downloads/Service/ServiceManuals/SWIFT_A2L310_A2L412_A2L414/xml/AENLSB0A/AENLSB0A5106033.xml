]>
<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106033" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Oil Pump Assembly Inspection
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106032">Oil Pump Assembly Disassembly and Reassembly</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Check oil pump for smooth rotation by using 2 flat-bladed screwdrivers or the like.
</ptxt>
<ptxt>
If any abnormality is found, replace oil pump assembly.
</ptxt>
<figure>
<graphic graphicname = "IEL10C510371.swf" width = "88.000mm" height = "56.903mm" ver = "02" gw = "212" gh = "145"/>
</figure>
</s1>
<s1>
<ptxt>
Remove oil seal. 
<intxreftitleoff1 refid = "AENLSB0A5106032"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Measure bore of oil pump bushing.
</ptxt>
<ptxt>
If check result is not as specified, replace oil pump assembly.
</ptxt>
<spec>
<title>
Oil pump bushing bore “a”
</title>
<ptxt>
Standard: 38.115 – 38.138 mm (1.5006 – 1.5014 in.)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IEL10C510372.swf" width = "88.000mm" height = "46.389mm" ver = "02" gw = "185" gh = "115"/>
</figure>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
