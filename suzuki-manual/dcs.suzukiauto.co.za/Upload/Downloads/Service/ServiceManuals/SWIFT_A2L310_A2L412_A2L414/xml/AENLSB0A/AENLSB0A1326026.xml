<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1326026" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Knock Sensor Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1326025">Knock Sensor On-Vehicle Inspection:K14D</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1326026001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove intake manifold. 
<intxreftitleoff1 refid = "AENLSB0A1426021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect knock sensor connector.
</ptxt>
</s1>
<s1>
<ptxt>
Remove knock sensor (1) from cylinder block.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A132025.jpg" width = "88.000mm" height = "53.837mm" ver = "02" gw = "185" gh = "119"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1326026002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Install knock sensor (1) as shown in figure.
</ptxt>
</item>
<item>
<ptxt>
Tighten knock sensor bolt (2) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1C215">
<t-part>
Knock sensor bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
23
</t-value1>
<t-value2>
2.3
</t-value2>
<t-value3>
17.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "ILSB0A132026.jpg" width = "88.000mm" height = "55.107mm" ver = "02" gw = "185" gh = "132"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
“a”:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
10&#176;
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
