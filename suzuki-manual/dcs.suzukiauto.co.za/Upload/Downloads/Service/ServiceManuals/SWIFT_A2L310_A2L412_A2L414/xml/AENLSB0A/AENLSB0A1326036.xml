<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1326036" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
WGV-VSV Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1326035">WGV-VSV On-Vehicle Inspection:K14D</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1326036001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect WGV-VSV connector.
</ptxt>
</s1>
<s1>
<ptxt>
Remove WGV-VSV bracket bolt (1).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect vacuum hoses (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove WGV-VSV (3) from bracket.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A132019.jpg" width = "88.000mm" height = "51.212mm" ver = "01" gw = "185" gh = "129"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1326036002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1326037">WGV-VSV Inspection:K14D</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
