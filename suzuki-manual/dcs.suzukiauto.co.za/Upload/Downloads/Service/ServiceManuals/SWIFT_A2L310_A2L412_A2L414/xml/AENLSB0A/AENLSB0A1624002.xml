<servinfosub id = "AENLSB0A1624002002">
<title>
Troubleshooting
</title>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
For details of engine cooling fan operation, refer to 
<intxref refid = "AENLSB0A1621003">Cooling Fan Operation Description:K14D</intxref>
.
</ptxt>
</item>
<item>
<ptxt>
Before beginning troubleshooting, read 
<intxref refid = "AENLSB0A1000005">Precautions for Engine (K14D)</intxref>
.
</ptxt>
</item>
<item>
<ptxt>
When measuring circuit voltage, resistance and/or pulse signal of ECM, refer to 
<intxref refid = "AENLSB0A1124088">Inspection of ECM and Its Circuits:K14D</intxref>
.
</ptxt>
</item>
</list1>
</attention3>
</servinfosub>
<diag type = "test" id = "AENLSB0A1624002003">
<testgroup id = "AENLSB0A1624002004">
<title>
DTC check
</title>
<test1>
<ptxt>
Set ignition “OFF” and connect SUZUKI scan tool to DLC.
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “ON” and check DTC.
</ptxt>
</test1>
<question>
Is there DTC(s)?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to applicable DTC flow and recheck DTC.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1624002005">
<title>
Radiator cooling fan low mode control check
</title>
<test1>
<ptxt>
Check radiator cooling fan control for low mode. 
<intxreftitleoff1 refid = "AENLSB0A1626009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 6.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1624002006">
<title>
Radiator cooling fan mid and high mode control check
</title>
<test1>
<ptxt>
Check radiator cooling fan control for mid and high mode. 
<intxreftitleoff1 refid = "AENLSB0A1626009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Radiator cooling fan control system is in good condition.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1624002007">
<title>
Radiator cooling fan relay No.3 power supply circuit (switch side) check
</title>
<test1>
<ptxt>
Set ignition “OFF” and remove radiator cooling fan relay No.3 from individual circuit fuse box No.1.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to radiator cooling fan relay No.3 at each terminal.
</ptxt>
</test1>
<test1>
<ptxt>
If OK, measure voltage between “A3” circuit and ground.
</ptxt>
</test1>
<question>
Is it 10 – 14 V?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 5.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair “A3” circuit.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1624002008">
<title>
Radiator cooling fan relay No.2 ground circuit check
</title>
<test1>
<ptxt>
Remove radiator cooling fan relay No.2 from individual circuit fuse box No.1.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to radiator cooling fan relay No.2 at each terminal.
</ptxt>
</test1>
<test1>
<ptxt>
If OK, measure resistance between “C1” circuit and ground. 
</ptxt>
</test1>
<question>
Is resistance 3 &#937; or less?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 6.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair “C1” circuit.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1624002009">
<title>
Radiator cooling fan relay No.1 power supply circuit (switch side) check
</title>
<test1>
<ptxt>
Set ignition “OFF” and remove radiator cooling fan relay No.1 from individual circuit fuse box No.1.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to radiator cooling fan relay No.1 at each terminal.
</ptxt>
</test1>
<test1>
<ptxt>
If OK, measure voltage between “A1” circuit and ground.
</ptxt>
</test1>
<question>
Is it 10 – 14 V?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 7.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair “A1” circuit.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1624002010">
<title>
Radiator cooling fan relay No.1, No.2 and No.3 check
</title>
<test1>
<ptxt>
Check radiator cooling fan relay No.1, No.2 and No.3. 
<intxreftitleoff1 refid = "AENLSB0A1626010"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 8.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace faulty radiator cooling fan relay.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1624002011">
<title>
Radiator cooling main fan motor drive circuit check
</title>
<test1>
<ptxt>
Disconnect radiator cooling main fan motor connector.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to radiator cooling main fan motor at each terminal.
</ptxt>
</test1>
<test1>
<ptxt>
If OK, check the following points. 
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “B1” circuit: less than 3 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “B1” circuit and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Voltage of “B1” circuit: 0 – 1 V (When ignition is “ON”)
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 9.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair “B1” circuit.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1624002012">
<title>
Radiator cooling fan relay No.2 power supply circuit (switch side) check
</title>
<test1>
<ptxt>
Check the following points. 
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “A2” circuit: less than 3 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A2” circuit and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Voltage of “A2” circuit: 0 – 1 V (When ignition is “ON”)
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 10.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair “A2” circuit.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1624002013">
<title>
Radiator cooling sub fan motor drive circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF” and disconnect radiator cooling sub fan motor connector.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to radiator cooling sub fan motor at each terminal.
</ptxt>
</test1>
<test1>
<ptxt>
If OK, check the following points. 
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “B2” circuit: less than 3 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “B2” circuit and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Voltage of “B2” circuit: 0 – 1 V (When ignition is “ON”)
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 11.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair “B2” circuit.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1624002014">
<title>
Radiator cooling sub fan motor ground circuit check
</title>
<test1>
<ptxt>
Measure resistance between “C2” circuit and ground.
</ptxt>
</test1>
<question>
Is resistance 3 &#937; or less?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 12.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair “C2” circuit.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1624002015">
<title>
Radiator cooling main fan motor and sub fan motor check
</title>
<test1>
<ptxt>
Check radiator cooling main fan motor and sub fan motor. 
<intxreftitleoff1 refid = "AENLSB0A1626009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck radiator cooling fan system.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace radiator cooling main fan motor or sub fan motor.
</ptxt>
</action>
</testgroup>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
