<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9E">
<servcat sctnbr = "09" scnbr = "05">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9506019" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Power Door Mirror and Mirror Heater On-Vehicle Inspection (If Equipped)
</title>
<servinfosub id = "AENLSB0A9506019001">
<title>
Power Door Mirror Motor
</title>
<s1>
<ptxt>
Remove front door trim. 
<intxreftitleoff1 refid = "AENLSB0A9506009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect power door mirror connector (1).
</ptxt>
</s1>
<s1>
<ptxt>
Check battery terminals to power door mirror connector as shown in the following table and check operation of power door mirror motor.
</ptxt>
<ptxt>
If check result is not as specified in the following operation, replace power door mirror.
</ptxt>
<figure>
<title>
Power door mirror motor operation
</title>
<graphic graphicname = "ILSB0A950006.swf" width = "88.000mm" height = "51.261mm" ver = "01" gw = "211" gh = "129"/>
</figure>
<figure>
<graphic graphicname = "IGSB0A950051.jpg" width = "88.000mm" height = "62.642mm" ver = "01" gw = "214" gh = "161"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9506019002">
<title>
Mirror Heater (If Equipped)
</title>
<s1>
<ptxt>
Remove front door trim. 
<intxreftitleoff1 refid = "AENLSB0A9506009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect power door mirror connector (1).
</ptxt>
</s1>
<s1>
<ptxt>
Check resistance between terminal “1” and terminal “7” of power door mirror connector.
</ptxt>
<ptxt>
If check result is not as specified, replace power door mirror.
</ptxt>
<spec>
<title>
Mirror heater resistance
</title>
<ptxt>
Approx. 11.7 &#937; (25 &#176;C) (77 &#176;F)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IGSB0A950052.jpg" width = "88.000mm" height = "62.642mm" ver = "01" gw = "214" gh = "161"/>
</figure>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
