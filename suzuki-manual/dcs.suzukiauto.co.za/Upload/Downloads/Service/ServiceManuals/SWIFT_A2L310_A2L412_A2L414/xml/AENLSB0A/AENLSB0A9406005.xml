<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9D">
<servcat sctnbr = "09" scnbr = "04">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9406005" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Rear Wiper Removal and Installation
</title>
<servinfosub id = "AENLSB0A9406005001">
<title>
Removal
</title>
<s1>
<ptxt>
Open rear wiper arm cover (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove rear wiper arm nut (2) and rear wiper arm with blade assembly (3), rear wiper pivot cap (4).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A940018.jpg" width = "88.000mm" height = "53.385mm" ver = "01" gw = "152" gh = "135"/>
</figure>
</s1>
<s1>
<ptxt>
Remove rearend door trim. 
<intxreftitleoff1 refid = "AENLSB0A9606010"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector (1) from rear wiper motor.
</ptxt>
</s1>
<s1>
<ptxt>
Remove rear wiper motor bolt (2) and remove rear wiper motor (3).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A940019.jpg" width = "88.000mm" height = "53.752mm" ver = "01" gw = "214" gh = "136"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9406005002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9406006">Rear Wiper Motor Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten rear wiper motor bolts in numerical order (“1” – “3”) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9D004">
<t-part>
Rear wiper motor bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
8.3
</t-value1>
<t-value2>
0.85
</t-value2>
<t-value3>
6.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A940020.jpg" width = "88.000mm" height = "53.752mm" ver = "02" gw = "214" gh = "136"/>
</figure>
</item>
<item>
<ptxt>
Install rear wiper pivot cap (1) facing matchmark (2) upward as shown.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A940021.jpg" width = "88.000mm" height = "67.637mm" ver = "01" gw = "214" gh = "175"/>
</figure>
</item>
<item>
<ptxt>
Install rear wiper arms with wiper blades (1) at specified position as shown in figure, and then tighten rear wiper nut to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9D005">
<t-part>
Rear wiper arm nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
7.9
</t-value1>
<t-value2>
0.81
</t-value2>
<t-value3>
6.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A940022.swf" width = "88.000mm" height = "70.813mm" ver = "01" gw = "213" gh = "184"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "3.071in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Align tip of rear wiper blade with rear defogger line (2)
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
