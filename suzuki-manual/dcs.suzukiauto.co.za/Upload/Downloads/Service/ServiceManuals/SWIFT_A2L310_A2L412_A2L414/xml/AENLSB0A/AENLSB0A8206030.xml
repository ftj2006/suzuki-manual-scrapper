<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "8B">
<servcat sctnbr = "08" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A8206030" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Passenger Air Bag Deactivation Switch Removal and Installation (If Equipped)
</title>
<servinfosub id = "AENLSB0A8206030001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove glove box.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect passenger air bag deactivation switch connector.
</ptxt>
</s1>
<s1>
<ptxt>
Remove passenger air bag deactivation switch (1) while releasing the locks (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A822114.jpg" width = "88.000mm" height = "68.171mm" ver = "01" gw = "200" gh = "177"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A8206030002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A8206031">Passenger Air Bag Deactivation Switch Inspection (If Equipped)</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Install passenger air bag deactivation switch (1) aligning its projection (2) with cutout (3) of instrument panel.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A822115.jpg" width = "88.000mm" height = "55.361mm" ver = "01" gw = "185" gh = "140"/>
</figure>
</s1>
<s1>
<ptxt>
Connect passenger air bag deactivation switch connector.
</ptxt>
</s1>
<s1>
<ptxt>
Install glove box.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
