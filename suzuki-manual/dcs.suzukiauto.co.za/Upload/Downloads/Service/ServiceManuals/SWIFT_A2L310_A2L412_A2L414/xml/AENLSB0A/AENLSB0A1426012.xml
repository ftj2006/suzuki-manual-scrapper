<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1426012" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Air Bypass Valve Inspection
</title>
<s1>
<ptxt>
Remove turbocharger. 
<intxreftitleoff1 refid = "AENLSB0A1426015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check ABV as follows.
</ptxt>
<ptxt>
If faulty condition is found, replace turbocharger. 
<intxreftitleoff1 refid = "AENLSB0A1426015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<s2>
<ptxt>
Connect battery (1) and ohmmeter to ABV as shown in figure.
</ptxt>
</s2>
<s2>
<ptxt>
Check that ABV resistance varies as specified.
</ptxt>
<spec>
<title>
ABV resistance
</title>
<ptxt>
–40 &#176;C (–4 &#176;F): 9.1 to 10.1 k&#937;
</ptxt>
<ptxt>
25 &#176;C (68 &#176;F): 12.0 to 13.3 k&#937;
</ptxt>
</spec>
<figure>
<graphic graphicname = "IKFA0B144065.jpg" width = "88.000mm" height = "52.717mm" ver = "01" gw = "195" gh = "133"/>
</figure>
</s2>
</s1>
</servinfo>
</servinfotype>
</configtype>
