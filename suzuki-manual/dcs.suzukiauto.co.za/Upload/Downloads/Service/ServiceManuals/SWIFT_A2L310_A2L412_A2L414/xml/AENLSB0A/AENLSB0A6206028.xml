<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "6B">
<servcat sctnbr = "06" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A6206028" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Steering Rack Plunger Removal and Installation
</title>
<servinfosub id = "AENLSB0A6206028001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove steering gear case assembly. 
<intxreftitleoff1 refid = "AENLSB0A6206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove steering rack boots. 
<intxreftitleoff1 refid = "AENLSB0A6206027"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Loosen steering rack damper screw lock nut (1) and remove steering rack damper screw (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove steering rack plunger spring (3) and steering rack plunger (4).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A620020.swf" width = "88.000mm" height = "88.674mm" ver = "01" gw = "217" gh = "235"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A6206028002">
<title>
Installation
</title>
<s1>
<ptxt>
Apply grease “A” to sliding surface of steering rack plunger (1) and steering gear case (2) that contacts steering rack plunger.
</ptxt>
</s1>
<s1>
<ptxt>
Apply grease “A” to both end surfaces of steering rack plunger spring (3).
</ptxt>
<materials>
<materialitem name = "ECSTAR Super Grease E" id = "M6B002" uid = "-539316051">
<m-part>
“A”
</m-part>
<m-desc>
Grease
</m-desc>
<m-number>
99000–25450
</m-number>
<m-name>
ECSTAR Super Grease E
</m-name>
</materialitem>
</materials>
</s1>
<s1>
<ptxt>
Install steering rack plunger and steering rack plunger spring.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A620021.swf" width = "88.000mm" height = "77.577mm" ver = "01" gw = "180" gh = "203"/>
</figure>
</s1>
<s1>
<ptxt>
Adjust pinion shaft rotation torque referring to 
<intxref refid = "AENLSB0A6206030">Pinion Shaft Rotation Torque Adjustment</intxref>
.
</ptxt>
</s1>
<s1>
<ptxt>
Recheck pinion shaft rotation torque is as specified. 
<intxreftitleoff1 refid = "AENLSB0A6206029"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check that length “a” on right steering rack is equal to that on left steering rack. If they are not equal, adjust them.
</ptxt>
<figure>
<graphic graphicname = "IDL10A630029.swf" width = "88.000mm" height = "48.164mm" ver = "01" gw = "205" gh = "120"/>
</figure>
</s1>
<s1>
<ptxt>
Install steering rack boots. 
<intxreftitleoff1 refid = "AENLSB0A6206027"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install steering gear case assembly. 
<intxreftitleoff1 refid = "AENLSB0A6206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
