<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1426023" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Cylinder Head Cover Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1426022">Cylinder Head Cover Components:K14D</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1426023001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove air cleaner assembly and air cleaner outlet hose. 
<intxreftitleoff1 refid = "AENLSB0A1426004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove ignition coil assemblies. 
<intxreftitleoff1 refid = "AENLSB0A1826003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect engine harness clamps.
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine harness bracket bolts (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove oil level gauge (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove GPF pressure sensor bracket (3) from cylinder head cover.
</ptxt>
</s1>
<s1>
<ptxt>
Remove turbocharger cover bolts (4).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect west gate control hose No.2 (5) from cylinder head cover.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142037.jpg" width = "88.000mm" height = "47.910mm" ver = "01" gw = "185" gh = "119"/>
</figure>
</s1>
<s1>
<ptxt>
Disconnect intake VVT actuator connector (1), oil pressure and temperature sensor connector (2) and variable oil pump valve connector (3).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect ISG connector (4). 
<intxreftitleoff1 refid = "AENLSB0A1A26005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect compressor connector (5). 
<intxreftitleoff1 refid = "AENLSB0A7206043"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142038.jpg" width = "88.000mm" height = "71.024mm" ver = "01" gw = "171" gh = "185"/>
</figure>
</s1>
<s1>
<ptxt>
Loosen cylinder head cover bolts No.1 (1) and No.2 (2) in numerical order (“1” – “14”) evenly and gradually.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142039.jpg" width = "88.000mm" height = "50.796mm" ver = "01" gw = "194" gh = "127"/>
</figure>
</s1>
<s1>
<ptxt>
Remove cylinder head cover with cylinder head cover gasket.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1426023002">
<title>
Installation
</title>
<s1>
<ptxt>
Remove oil, old sealant and dust from sealing surfaces on cylinder head and cover.
</ptxt>
</s1>
<s1>
<ptxt>
Install new gasket (2) to cylinder head cover (1).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142040.jpg" width = "88.000mm" height = "44.324mm" ver = "01" gw = "185" gh = "109"/>
</figure>
</s1>
<s1>
<ptxt>
Apply sealant to the mating surface as shown.
</ptxt>
<materials>
<materialitem name = "SUZUKI Bond No.1207F" id = "M1D206" uid = "41">
<m-part>
“A”
</m-part>
<m-desc>
Sealant
</m-desc>
<m-number>
99000–31250
</m-number>
<m-name>
SUZUKI Bond No.1207F
</m-name>
</materialitem>
</materials>
<spec>
<title>
Sealant width on sealing surface
</title>
<ptxt>
“a”: 4.0 mm (0.16 in.)
</ptxt>
</spec>
<figure>
<graphic graphicname = "ILSB0A142041.jpg" width = "88.000mm" height = "56.392mm" ver = "02" gw = "196" gh = "144"/>
</figure>
</s1>
<s1>
<ptxt>
Install cylinder head cover to cylinder head.
</ptxt>
<attention3>
<ptxt>
When installing cylinder head cover, use care so that cylinder head cover gasket will not get out of place or fall off.
</ptxt>
</attention3>
</s1>
<s1>
<ptxt>
Tighten cylinder head cover bolts No.1 and No.2 according to the following procedure.
</ptxt>
<s2>
<ptxt>
Temporarily tighten cylinder head cover bolts No.1 (1) to position the cylinder head cover.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142042.jpg" width = "88.000mm" height = "48.766mm" ver = "01" gw = "185" gh = "122"/>
</figure>
</s2>
<s2>
<ptxt>
Tighten cylinder head cover bolts No.1 and No.2 to 5.0 N&#183;m (0.51 kgf-m, 4.0 lbf-ft) in numerical order (“1” – “14”) evenly and gradually.
</ptxt>
</s2>
<s2>
<ptxt>
Retighten cylinder head cover bolts No.2 to 10 N&#183;m (1.0 kgf-m, 7.5 lbf-ft) and cylinder head cover bolts No.1 to 7.5 N&#183;m (0.76 kgf-m, 5.5 lbf-ft) in the same manner as in Step b).
</ptxt>
<torque>
<torqueitem id = "T1D248">
<t-part>
Cylinder head cover bolt No.1*
</t-part>
<t-part1>
a
</t-part1>
<t-note>
5.0 N&#183;m &#8594; 7.5 N&#183;m (0.51 kgf-m &#8594; 0.76 kgf-m, 4.0 lbf-ft &#8594; 5.5 lbf-ft)
</t-note>
</torqueitem>
<torqueitem id = "T1D249">
<t-part>
Cylinder head cover bolt No.2*
</t-part>
<t-part1>
b
</t-part1>
<t-note>
5.0 N&#183;m &#8594; 10 N&#183;m (0.51 kgf-m &#8594; 1.0 kgf-m, 4.0 lbf-ft &#8594; 7.5 lbf-ft)
</t-note>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "ILSB0A142043.jpg" width = "88.000mm" height = "50.796mm" ver = "01" gw = "199" gh = "127"/>
</figure>
</s2>
</s1>
<s1>
<ptxt>
Connect compressor connector (1). 
<intxreftitleoff1 refid = "AENLSB0A7206043"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Connect ISG connector (2). 
<intxreftitleoff1 refid = "AENLSB0A1A26005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Connect intake VVT actuator connector (3), oil pressure and temperature sensor connector (4) and variable oil pump valve connector (5).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142044.jpg" width = "88.000mm" height = "71.024mm" ver = "01" gw = "171" gh = "185"/>
</figure>
</s1>
<s1>
<ptxt>
Install engine harness bracket bolts (1).
</ptxt>
</s1>
<s1>
<ptxt>
Connect engine harness clamps.
</ptxt>
</s1>
<s1>
<ptxt>
Install oil level gauge (2).
</ptxt>
</s1>
<s1>
<ptxt>
Install GPF pressure sensor bracket (3) from cylinder head cover.
</ptxt>
</s1>
<s1>
<ptxt>
Install turbocharger cover bolts (4).
</ptxt>
</s1>
<s1>
<ptxt>
Connect west gate control hose No.2 (5) to cylinder head cover.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142037.jpg" width = "88.000mm" height = "47.910mm" ver = "01" gw = "185" gh = "119"/>
</figure>
</s1>
<s1>
<ptxt>
Install ignition coil assemblies. 
<intxreftitleoff1 refid = "AENLSB0A1826003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install air cleaner outlet hose and air cleaner assembly. 
<intxreftitleoff1 refid = "AENLSB0A1426004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Connect negative (–) cable at battery.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
