<suzuki><manual>
<section sectnbr = "7B">
<servcat sctnbr = "07" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A7206011" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Blower Motor Removal and Installation
</title>
<servinfosub id = "AENLSB0A7206011001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove glove box.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector and clamp from blower motor (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove screws (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove blower motor from HVAC unit.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A721009.jpg" width = "88.000mm" height = "53.329mm" ver = "01" gw = "185" gh = "135"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A7206011002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A7206012">Blower Motor Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
