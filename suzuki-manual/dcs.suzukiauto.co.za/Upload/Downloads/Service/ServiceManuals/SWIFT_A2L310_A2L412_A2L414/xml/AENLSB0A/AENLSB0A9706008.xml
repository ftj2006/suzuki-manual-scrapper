<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9G">
<servcat sctnbr = "09" scnbr = "07">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9706008" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Rear Seat Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9706007">Rear Seat Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A9706008001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove lower anchor bezel, and remove seat cushion assembly. 
<intxreftitleoff1 refid = "AENLSB0A9706007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove center seat belt bolt. 
<intxreftitleoff1 refid = "AENLSB0A8106008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Insert flat-bladed screwdriver (6) in groove of rear seat hinge cover (4), release lock and pull it up as shown in figure. Apply the same procedure to the other side.
</ptxt>
</s1>
<s1>
<ptxt>
Remove rear seat hinge bolts (5) and rear seat hinge bracket (3).
</ptxt>
</s1>
<s1>
<ptxt>
Remove seatback assembly (L) (2) and then remove seatback assembly (R) (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A970012.jpg" width = "88.000mm" height = "78.693mm" ver = "01" gw = "204" gh = "207"/>
</figure>
</s1>
<s1>
<ptxt>
Disassemble and repair seat if necessary. 
<intxreftitleoff1 refid = "AENLSB0A9706007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9706008002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten rear seat hinge bolt to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9G005">
<t-part>
Rear seat hinge bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
43
</t-value1>
<t-value2>
4.4
</t-value2>
<t-value3>
32.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A970013.jpg" width = "88.000mm" height = "36.880mm" ver = "01" gw = "199" gh = "88"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
