<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1416013" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Check Valve Removal and Installation
</title>
<servinfosub id = "AENLSB0A1416013001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove check valve (1).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A144023.jpg" width = "88.000mm" height = "56.123mm" ver = "01" gw = "199" gh = "143"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1416013002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1416014">Check Valve Inspection:K14C</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Connect orange side [a] of check valve (1) to air bypass valve control hose No.3 (2).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A144024.jpg" width = "88.000mm" height = "62.301mm" ver = "01" gw = "199" gh = "160"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
