<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1I">
<servcat sctnbr = "01" scnbr = "09">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1916002" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "1" supplyoff = "1" modify = "0">
<title>
Starting Motor Removal and Installation
</title>
<servinfosub id = "AENLSB0A1916002001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove battery and battery tray. 
<intxreftitleoff1 refid = "AENLSB0A1A16002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
For A/T model, disconnect TCM connector (1), and harness clamps (2).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A194002.swf" width = "88.000mm" height = "52.603mm" ver = "01" gw = "208" gh = "133"/>
</figure>
</s1>
<s1>
<ptxt>
For A/T model, disconnect select cable from transaxle. 
<intxreftitleoff1 refid = "AENLSB0A5106015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove starting motor mounting bolt (upper side) (1).
</ptxt>
</s1>
<s1>
<ptxt>
Hoist vehicle and remove engine undercover.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect magnetic switch lead wire (2) and starting motor cable (3) from starting motor.
</ptxt>
</s1>
<s1>
<ptxt>
Remove starting motor mounting bolt (lower side) (4).
</ptxt>
</s1>
<s1>
<ptxt>
Remove starting motor (5).
</ptxt>
<figure>
<graphic graphicname = "I9P60A191003.swf" width = "183.000mm" height = "81.650mm" ver = "02" gw = "397" gh = "214"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1916002002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1916007">Starting Motor Inspection:K14C</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten starting motor cable nut (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1I101">
<t-part>
Starting motor cable nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IFRA0A191003.swf" width = "183.000mm" height = "74.241mm" ver = "01" gw = "299" gh = "193"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
