<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "7B">
<servcat sctnbr = "07" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A7204A16" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Large rattling noise is heard at idle or sudden acceleration
</title>
<servinfosub id = "AENLSB0A7204004009">
<title>
Abnormal Noise from Crankshaft Pulley
</title>
<diag type = "condition">
<condition>
<ptxt>
Large rattling noise is heard at idle or sudden acceleration
</ptxt>
</condition>
<ps>
<ptxt>
Loosen crankshaft pulley bolt
</ptxt>
</ps>
<action>
<ptxt>
Retighten bolt.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0A1416026"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0A1426026"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
