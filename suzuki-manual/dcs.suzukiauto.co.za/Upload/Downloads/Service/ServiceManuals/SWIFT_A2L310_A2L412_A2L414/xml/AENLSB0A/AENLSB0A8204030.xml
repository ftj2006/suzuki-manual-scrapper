<servinfosub id = "AENLSB0A8204030003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A8204030004">
<testgroup id = "AENLSB0A8204030005">
<question>
Was “Air Bag Diagnostic System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204030006">
<title>
Seat belt pretensioner circuit check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection and disconnect connector as follows.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
“L283” or “L285” connector: 
<intxreftitleoff1 refid = "AENLSB0A8206011"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
“L05” connector: 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</test1>
<test1>
<ptxt>
Release shorting bar in SDM connector. 
<intxreftitleoff1 refid = "AENLSB0A8206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance between each of “A1” and “A2” circuits and ground (DTC B1064-14): infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between each of “A3” and “A4” circuits and ground (DTC B1065-14): infinity
</ptxt>
<servicetool>
<servicetoolitem id = "L8B042">
<s-part>
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace SDM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace floor harness.
</ptxt>
</action>
</testgroup>
</diag>
<attention3>
<ptxt>
Upon completion of inspection and repair work, perform the following items.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Reconnect all air bag system components and check that all components are properly mounted.
</ptxt>
</item>
<item>
<ptxt>
Clear DTCs, referring to 
<intxref refid = "AENLSB0A8204006">DTC Clearance</intxref>
 if any DTC is detected.
</ptxt>
</item>
<item>
<ptxt>
Repeat 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
 to check that the trouble has been solved.
</ptxt>
</item>
</list1>
</attention3>
