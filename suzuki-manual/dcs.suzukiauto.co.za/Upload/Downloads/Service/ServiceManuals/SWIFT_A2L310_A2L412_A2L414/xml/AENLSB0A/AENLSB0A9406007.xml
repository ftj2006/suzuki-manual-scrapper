<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9D">
<servcat sctnbr = "09" scnbr = "04">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9406007" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Washer Nozzle Removal and Installation
</title>
<servinfosub id = "AENLSB0A9406007001" page = "2">
<title>
Front
</title>
<topic id = "AENLSB0A9406007002">
<title>
Removal
</title>
<s1>
<ptxt>
Remove cowl top side garnish and cowl top center garnish. 
<intxreftitleoff1 refid = "AENLSB0A9806006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Release lock (1) and remove front washer nozzle (2).
</ptxt>
<figure page = "2">
<graphic graphicname = "IGSA0P940027.jpg" width = "88.000mm" height = "87.091mm" ver = "01" gw = "228" gh = "230"/>
</figure>
</s1>
</topic>
<topic id = "AENLSB0A9406007003">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure.
</ptxt>
</topic>
</servinfosub>
<servinfosub id = "AENLSB0A9406007004">
<title>
Rear (Rearend Door Type)
</title>
<topic id = "AENLSB0A9406007005">
<title>
Removal
</title>
<s1 page = "2">
<ptxt>
Remove high mount stop light. 
<intxreftitleoff1 refid = "AENLSB0A9206011"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Open rearend door and remove cap (1) from rearend door inner panel.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A940006.jpg" width = "88.000mm" height = "72.953mm" ver = "01" gw = "237" gh = "190"/>
</figure>
</s1>
<s1>
<ptxt>
Disconnect washer hose (1) from plastic hose.
</ptxt>
<figure page = "2">
<graphic graphicname = "IHSB0A940002.jpg" width = "88.000mm" height = "58.239mm" ver = "01" gw = "228" gh = "149"/>
</figure>
</s1>
<s1>
<ptxt>
Release lock (1) inserting two small flat-bladed screwdrivers wrapped with protective tape and remove washer nozzle (2).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A940003.jpg" width = "88.000mm" height = "68.708mm" ver = "01" gw = "228" gh = "178"/>
</figure>
</s1>
</topic>
<topic id = "AENLSB0A9406007006">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9206011">High Mount Stop Light Removal and Installation</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</topic>
</servinfosub>
<servinfosub id = "AENLSB0A9406007007">
<title>
Rear (Spoiler Type)
</title>
<topic id = "AENLSB0A9406007008">
<title>
Removal
</title>
<s1>
<ptxt>
Remove high mount stop light. 
<intxreftitleoff1 refid = "AENLSB0A9206011"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove adhesive sealer (1).
</ptxt>
<figure>
<graphic graphicname = "IGSA0P940026.jpg" width = "88.000mm" height = "58.239mm" ver = "01" gw = "228" gh = "149"/>
</figure>
</s1>
<s1>
<ptxt>
Open rearend door and remove cap (1) from rearend door inner panel.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A940006.jpg" width = "88.000mm" height = "72.953mm" ver = "01" gw = "237" gh = "190"/>
</figure>
</s1>
<s1>
<ptxt>
Disconnect washer hose (1) from plastic hose.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A940004.jpg" width = "88.000mm" height = "58.239mm" ver = "01" gw = "228" gh = "149"/>
</figure>
</s1>
<s1>
<ptxt>
Release lock (1) inserting small flat-bladed screwdriver wrapped with protective tape, push washer nozzle end by finger and remove the nozzle (2).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A940005.jpg" width = "88.000mm" height = "79.318mm" ver = "01" gw = "225" gh = "208"/>
</figure>
</s1>
</topic>
<topic id = "AENLSB0A9406007009">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Pass washer nozzle hose (1) as shown in figure.
</ptxt>
<figure>
<graphic graphicname = "IGSA0P940029.jpg" width = "88.000mm" height = "58.239mm" ver = "01" gw = "228" gh = "149"/>
</figure>
</item>
<item>
<ptxt>
Open rearend door, insert washer hose into the door panel positioning L-joint (1) upward.
</ptxt>
<figure page = "2">
<graphic graphicname = "IHSB0A940007.jpg" width = "88.000mm" height = "65.436mm" ver = "01" gw = "212" gh = "169"/>
</figure>
</item>
<item>
<ptxt>
For installation of high mount stop light, refer to 
<intxref refid = "AENLSB0A9206011">High Mount Stop Light Removal and Installation</intxref>
.
</ptxt>
</item>
</list1>
</topic>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
