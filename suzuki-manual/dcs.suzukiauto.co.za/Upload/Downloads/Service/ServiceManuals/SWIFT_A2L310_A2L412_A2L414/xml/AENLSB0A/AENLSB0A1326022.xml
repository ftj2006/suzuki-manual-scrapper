<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1326022" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
CMP Sensor Removal and Installation
</title>
<attention4>
<ptxt>
Reinstallation of CMP sensor may cause oil leakage.
</ptxt>
<ptxt>
Once CMP sensor is removed, replace it with new one.
</ptxt>
</attention4>
<servinfosub id = "AENLSB0A1326022001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove air cleaner assembly and air cleaner suction hose. 
<intxreftitleoff1 refid = "AENLSB0A1426004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector from intake CMP sensor or exhaust CMP sensor.
</ptxt>
</s1>
<s1>
<ptxt>
Remove intake CMP sensor (1) or exhaust CMP sensor (2).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A132007.jpg" width = "88.000mm" height = "57.985mm" ver = "01" gw = "185" gh = "148"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1326022002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Apply engine oil to O-ring of CMP sensor.
</ptxt>
</item>
<item>
<ptxt>
Tighten intake CMP sensor bolt (1) and exhaust CMP sensor bolt (2) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1C213">
<t-part>
Intake CMP sensor bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
<torqueitem id = "T1C214">
<t-part>
Exhaust CMP sensor bolt
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "ILSB0A132008.jpg" width = "88.000mm" height = "57.985mm" ver = "01" gw = "185" gh = "148"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
