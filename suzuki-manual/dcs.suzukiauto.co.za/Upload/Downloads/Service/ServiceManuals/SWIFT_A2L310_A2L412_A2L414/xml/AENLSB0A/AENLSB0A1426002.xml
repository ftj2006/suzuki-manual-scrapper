<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1426002" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Air Cleaner Filter Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1426001">Air Cleaner Components:K14D</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1426002001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect waste gate control hose No.3 (1) from air cleaner cap (2).
</ptxt>
</s1>
<s1>
<ptxt>
Unhook air cleaner case clamps (3).
</ptxt>
</s1>
<s1>
<ptxt>
Open air cleaner cap, and then remove air cleaner filter.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142003.swf" width = "88.000mm" height = "52.432mm" ver = "01" gw = "173" gh = "132"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1426002002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1426003">Air Cleaner Filter Inspection and Cleaning:K14D</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Install air cleaner filter to air cleaner case.
</ptxt>
</s1>
<s1>
<ptxt>
Fit tabs (1) of the cap with the case lower side hooks, and join air cleaner housing cap (2) with air cleaner case (3).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142004.swf" width = "88.000mm" height = "49.713mm" ver = "01" gw = "198" gh = "124"/>
</figure>
</s1>
<s1>
<ptxt>
Hook air cleaner case clamps.
</ptxt>
</s1>
<s1>
<ptxt>
Connect waste gate control hose No.3.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
