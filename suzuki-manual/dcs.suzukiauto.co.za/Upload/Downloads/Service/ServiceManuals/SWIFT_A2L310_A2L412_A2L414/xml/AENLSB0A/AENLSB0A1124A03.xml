<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1A">
<servcat sctnbr = "01" scnbr = "01">
<configtype typenbr = "2">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1124A03" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Engine noise – Valve noise
</title>
<ptxt>
Perform troubleshooting referring to the following points when ECM has detected no DTC and no abnormality has been found in 
<intxref refid = "AENLSB0A1124008">Visual Inspection:K14D</intxref>
 and 
<intxref refid = "AENLSB0A1124009">Engine Basic Inspection:K14D</intxref>
.
</ptxt>
<diag type = "condition">
<condition>
<paragroup>
<ptxt>
Engine noise – Valve noise
</ptxt>
<attention3>
<ptxt>
Before checking mechanical noise, check that:
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Specified spark plug is used.
</ptxt>
</item>
<item>
<ptxt>
Specified fuel is used.
</ptxt>
</item>
</list1>
</attention3>
</paragroup>
</condition>
<ps>
<ptxt>
Worn valve stem and guide
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1426042">Valve and Valve Guide Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Weak or broken valve spring
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1426045">Valve Spring Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Warped or bent valve
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1426042">Valve and Valve Guide Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty valve rocker arm
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1426040">Valve Rocker Arm Inspection:K14D</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty valve lash adjuster
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1426039">Valve and Cylinder Head Removal and Installation:K14D</intxref>
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
