<suzuki><manual>
<section sectnbr = "9B">
<servcat sctnbr = "09" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9206013" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Luggage Compartment Light Removal and Installation
</title>
<servinfosub id = "AENLSB0A9206013001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove luggage compartment light (1) pulling it in arrow direction while releasing lock (2).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector from luggage compartment light.
</ptxt>
</s1>
<s1>
<ptxt>
Remove bulb (3), if necessary.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A920036.jpg" width = "88.000mm" height = "52.397mm" ver = "01" gw = "201" gh = "132"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9206013002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
