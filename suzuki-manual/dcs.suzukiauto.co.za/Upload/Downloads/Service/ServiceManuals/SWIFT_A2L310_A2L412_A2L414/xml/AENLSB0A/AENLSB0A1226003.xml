<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1B">
<servcat sctnbr = "01" scnbr = "02">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1226003" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
EVAP Canister Removal and Installation
</title>
<servinfosub id = "AENLSB0A1226003001">
<title>
Removal
</title>
<s1>
<ptxt>
Hoist vehicle.
</ptxt>
</s1>
<s1>
<ptxt>
Remove parking brake cable clamp nuts (1).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect purge pipe (3) from pipe (2). 
<intxreftitleoff1 refid = "AENLSB0A1726002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<figure>
<graphic graphicname = "IGSB0A121004.jpg" width = "88.000mm" height = "64.107mm" ver = "01" gw = "228" gh = "165"/>
</figure>
</s1>
<s1>
<ptxt>
Detach EVAP canister (1) from fuel tank in arrow direction (“1” – “2”) and move it downward.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect air suction pipe (2) and fuel EVAP hose (3) and remove EVAP canister. 
<intxreftitleoff1 refid = "AENLSB0A1726002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect purge pipe (4) from EVAP canister.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A121005.jpg" width = "88.000mm" height = "64.107mm" ver = "02" gw = "228" gh = "165"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1226003002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1226004">EVAP Canister Inspection:K14D</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Install clamps to specified position on fuel EVAP hose. 
<intxreftitleoff1 refid = "AENLSB0A1726002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Connect quick joint securely. 
<intxreftitleoff1 refid = "AENLSB0A1726002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Tighten parking brake cable clamp nuts to specified torque. 
<intxreftitleoff1 refid = "AENLSB0A4406001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
