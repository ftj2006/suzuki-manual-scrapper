<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1G">
<servcat sctnbr = "01" scnbr = "07">
<configtype typenbr = "1">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1714001" svcinfotypenbr = "06" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Fuel System Inspection
</title>
<diag type = "test" id = "AENLSB0A1714001001">
<testgroup id = "AENLSB0A1714001002">
<title>
Fuel pump inspection
</title>
<test1>
<ptxt>
Remove fuel filler cap and set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check that fuel pump operating sound can be heard from fuel filler port for about 2 seconds.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Check fuel pump circuit. 
<intxreftitleoff1 refid = "AENLSB0A1714004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1714001003">
<title>
Fuel low pressure check
</title>
<test1>
<ptxt>
Check fuel pressure. 
<intxreftitleoff1 refid = "AENLSB0A1714007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair defective part.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1714001004">
<title>
Fuel high pressure check
</title>
<test1>
<ptxt>
Check fuel pressure. 
<intxreftitleoff1 refid = "AENLSB0A1714008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
End.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair defective part.
</ptxt>
</action>
</testgroup>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
