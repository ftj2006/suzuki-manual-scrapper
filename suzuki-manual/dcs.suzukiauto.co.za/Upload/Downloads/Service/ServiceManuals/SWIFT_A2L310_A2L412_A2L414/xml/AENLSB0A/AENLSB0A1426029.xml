<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1426029" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Exhaust OCV Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1426026">Timing Chain Cover Components:K14D</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1426029001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect exhaust OCV connector.
</ptxt>
</s1>
<s1>
<ptxt>
Remove exhaust OCV (1) from oil pump assembly.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142060.jpg" width = "88.000mm" height = "49.519mm" ver = "01" gw = "185" gh = "124"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1426029002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1326038">Exhaust OCV Inspection:K14D</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Apply engine oil to O-ring and carefully insert exhaust OCV to timing chain cover.
</ptxt>
</item>
<item>
<ptxt>
Tighten exhaust OCV bolt (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1D254">
<t-part>
Exhaust OCV bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "ILSB0A142061.jpg" width = "88.000mm" height = "49.519mm" ver = "01" gw = "185" gh = "124"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
