<servinfosub id = "AENLSB0A8204054002">
<title>
Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A8204054003">
<testgroup id = "AENLSB0A8204054004">
<title>
Driver air bag (inflator) module circuit check
</title>
<test1>
<ptxt>
Remove driver air bag (inflator) module from steering wheel. 
<intxreftitleoff1 refid = "AENLSB0A8206006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “G12” connector. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Release shorting bar in SDM connector. 
<intxreftitleoff1 refid = "AENLSB0A8206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Check the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance between “G12-10” and “G12-11” terminals: infinity
</ptxt>
<servicetool>
<servicetoolitem id = "L8B0120">
<s-part>
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Check for defective wire harness. If check result is OK, replace contact coil assembly. 
<intxreftitleoff1 refid = "AENLSB0A6206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204054005">
<title>
Contact coil circuit (driver air bag (inflator) module circuit) check
</title>
<test1>
<ptxt>
Remove contact coil assembly. 
<intxreftitleoff1 refid = "AENLSB0A6206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Check the following points.
</ptxt>
<ptxt>
<emph etype = "bold">
2P connector with 2 pins:
</emph>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Measure resistance between “S121-2” and “S172-2” terminals: 1 &#937; or less
</ptxt>
</item>
<item>
<ptxt>
Measure resistance between “S121-1” and “S172-1” terminals: 1 &#937; or less
</ptxt>
</item>
</list1>
<ptxt>
<emph etype = "bold">
4P connector with 2 pins:
</emph>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Measure resistance between “S121-1” and “S171-1” terminals: 1 &#937; or less
</ptxt>
</item>
<item>
<ptxt>
Measure resistance between “S121-2” and “S171-2” terminals: 1 &#937; or less
</ptxt>
<servicetool>
<servicetoolitem id = "L8B0121">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IHSB0A822009.swf" width = "90.000mm" height = "73.738mm" ver = "01" gw = "239" gh = "193"/>
</testfigure>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace contact coil assembly. 
<intxreftitleoff1 refid = "AENLSB0A6206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204054006">
<title>
Contact coil circuit (horn circuit) check
</title>
<test1>
<ptxt>
Check the following point.
</ptxt>
<ptxt>
<emph etype = "bold">
Without steering switch:
</emph>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Measure resistance between “S61-1” and “S173-1” terminals: 1 &#937; or less
</ptxt>
</item>
</list1>
<ptxt>
<emph etype = "bold">
With steering switch without lane keeping assist system:
</emph>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Measure resistance between “S62-4” and “S174-4” terminals: 1 &#937; or less
</ptxt>
</item>
</list1>
<ptxt>
<emph etype = "bold">
With lane keeping assist system:
</emph>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Measure resistance between “S63-6” and “S175-6” terminals: 1 &#937; or less
</ptxt>
<servicetool>
<servicetoolitem id = "L8B0122">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IHSB0A822010.swf" width = "90.000mm" height = "116.669mm" ver = "02" gw = "239" gh = "314"/>
</testfigure>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace contact coil assembly. 
<intxreftitleoff1 refid = "AENLSB0A6206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204054007">
<title>
Contact coil circuit check
</title>
<test1>
<ptxt>
Measure resistance between each terminal of contact coil and other terminals.
</ptxt>
</test1>
<question>
Is each measured resistance infinite?
</question>
<result type = "yes"/>
<action>
<ptxt>
Contact coil and its circuit are in good condition.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace contact coil assembly. 
<intxreftitleoff1 refid = "AENLSB0A6206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
