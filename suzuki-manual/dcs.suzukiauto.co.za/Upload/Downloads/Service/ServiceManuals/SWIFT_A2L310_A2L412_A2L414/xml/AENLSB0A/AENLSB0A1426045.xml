<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1426045" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Valve Spring Inspection
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1426041">Valve and Cylinder Head Disassembly and Reassembly:K14D</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1426045001">
<title>
Valve Spring Free Length and Preload
</title>
<list1 type = "unordered">
<item>
<ptxt>
Check each valve spring for breakage or weakening.
</ptxt>
</item>
<item>
<ptxt>
Measure valve spring free length and preload.
</ptxt>
<ptxt>
If measured value is less than limit, replace valve spring.
</ptxt>
<attention3>
<ptxt>
Weakened valve spring can cause chatter, not to mention possibility of reducing power output due to gas leakage caused by decreased seating pressure.
</ptxt>
</attention3>
<spec>
<title>
Valve spring free length “a”
</title>
<ptxt>
Standard
</ptxt>
<ptxt>
IN: 44.83 mm (1.765 in.)
</ptxt>
<ptxt>
EX: 50.56 mm (1.990 in.)
</ptxt>
</spec>
<spec>
<title>
Intake valve spring preload when compressed to 33.9 mm (1.335 in.)
</title>
<ptxt>
Standard: 126 – 146 N (12.8 – 14.9 kgf, 28.3 – 32.8 lbf)
</ptxt>
<ptxt>
Limit: 113 N (11.5 kgf, 25.4 lbf)
</ptxt>
</spec>
<spec>
<title>
Exhaust valve spring preload when compressed to 33.9 mm (1.335 in.)
</title>
<ptxt>
Standard: 186 – 214 N (19.0 – 21.8 kgf, 41.8 – 48.1 lbf)
</ptxt>
<ptxt>
Limit: 170 N (17.3 kgf, 38.2 lbf)
</ptxt>
</spec>
<figure>
<graphic graphicname = "I9T401142034.swf" width = "88.000mm" height = "38.039mm" ver = "01" gw = "158" gh = "91"/>
</figure>
<figure>
<graphic graphicname = "I9T401142035.swf" width = "88.000mm" height = "47.013mm" ver = "01" gw = "41" gh = "117"/>
</figure>
</item>
</list1>
</servinfosub>
<servinfosub id = "AENLSB0A1426045002">
<title>
Spring Squareness
</title>
<ptxt>
Use a square and surface plate to check each spring for squareness in terms of clearance between the third turn from top of valve spring and the square as shown. If clearance exceeds limit, replace valve spring.
</ptxt>
<spec>
<title>
Intake valve spring squareness “a”
</title>
<ptxt>
Limit: 1.57 mm (0.0618 in.)
</ptxt>
</spec>
<spec>
<title>
Exhaust valve spring squareness “a”
</title>
<ptxt>
Limit: 2.20 mm (0.0866 in.)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IELA0A142093.swf" width = "88.000mm" height = "42.963mm" ver = "01" gw = "137" gh = "105"/>
</figure>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
