<ptxt>
DTC detecting condition
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Trouble area
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P13D1: Brake Stroke Sensor Circuit High
</emph>
</ptxt>
<ptxt>
Voltage of brake stroke sensor signal circuit is higher than 4.7 V for more than specified time.
</ptxt>
</entry>
<entry colname = "2" morerows = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
Brake stroke sensor and/or its circuit
</ptxt>
</item>
<item>
<ptxt>
ECM
</ptxt>
</item>
</list1>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P13D2: Brake Stroke Sensor Circuit Low
</emph>
</ptxt>
<ptxt>
Voltage of brake stroke sensor signal circuit is lower than 0.3 V for more than specified time.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
