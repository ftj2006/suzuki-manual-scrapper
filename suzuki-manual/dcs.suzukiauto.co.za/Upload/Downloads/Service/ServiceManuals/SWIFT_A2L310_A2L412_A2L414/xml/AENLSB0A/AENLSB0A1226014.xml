<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1B">
<servcat sctnbr = "01" scnbr = "02">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1226014" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
EGR Valve Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1226013">EGR System Components:K14D</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1226014001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove air cleaner assembly. 
<intxreftitleoff1 refid = "AENLSB0A1426004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector from EGR valve.
</ptxt>
</s1>
<s1>
<ptxt>
Remove EGR cooler bolts (1).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A122005.jpg" width = "88.000mm" height = "51.720mm" ver = "01" gw = "185" gh = "130"/>
</figure>
</s1>
<s1>
<ptxt>
Remove EGR valve bolts (1) and then remove EGR valve (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove EGR valve gasket (3) and EGR cooler gasket (4).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A122006.jpg" width = "88.000mm" height = "50.535mm" ver = "01" gw = "185" gh = "127"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1226014002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1226015">EGR Valve Inspection:K14D</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Fit new EGR cooler gasket and new EGR valve gasket.
</ptxt>
</s1>
<s1>
<ptxt>
Fit EGR valve (1) to intake manifold and tighten EGR valve bolts (2) temporarily.
</ptxt>
</s1>
<s1>
<ptxt>
Tighten EGR valve bolts to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1B201">
<t-part>
EGR valve bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
</s1>
<s1>
<ptxt>
Tighten EGR cooler bolts (3) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1B202">
<t-part>
EGR cooler bolt
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
25
</t-value1>
<t-value2>
2.5
</t-value2>
<t-value3>
18.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "ILSB0A122007.jpg" width = "88.000mm" height = "51.551mm" ver = "02" gw = "185" gh = "130"/>
</figure>
</s1>
<s1>
<ptxt>
Connect connector to EGR valve.
</ptxt>
</s1>
<s1>
<ptxt>
Install air cleaner assembly. 
<intxreftitleoff1 refid = "AENLSB0A1426004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Connect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Run engine and check for exhaust gas leakage.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
