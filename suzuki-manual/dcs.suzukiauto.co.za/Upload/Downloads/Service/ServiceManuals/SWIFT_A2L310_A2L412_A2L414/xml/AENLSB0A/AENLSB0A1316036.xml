<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1316036" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
OCV Inspection
</title>
<s1>
<ptxt>
Remove OCV. 
<intxreftitleoff1 refid = "AENLSB0A1416029"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check OCV as follows.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Check resistance between terminals of OCV connector (1).
</ptxt>
<ptxt>
If measured resistance is out of specified range, replace OCV.
</ptxt>
<spec>
<title>
OCV resistance
</title>
<ptxt>
6.7 to 7.7 &#937; at 20 &#176;C (68 &#176;F)
</ptxt>
</spec>
<figure>
<graphic graphicname = "I9T401132006.swf" width = "88.000mm" height = "59.819mm" ver = "02" gw = "180" gh = "153"/>
</figure>
</item>
<item>
<ptxt>
Connect battery to OCV connector (1) as shown in figure, and check operating sound caused by movement of spool valve (2).
</ptxt>
<ptxt>
If check result is not as specified, replace OCV. 
<intxreftitleoff1 refid = "AENLSB0A1416029"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<figure>
<graphic graphicname = "I9T401132007.swf" width = "88.000mm" height = "59.819mm" ver = "02" gw = "193" gh = "153"/>
</figure>
</item>
<item>
<ptxt>
Check OCV O-ring (1) for damage and deterioration.
</ptxt>
<ptxt>
If check result is not as specified, replace OCV. 
<intxreftitleoff1 refid = "AENLSB0A1416029"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<figure>
<graphic graphicname = "IBK80P130014.swf" width = "88.000mm" height = "29.948mm" ver = "01" gw = "153" gh = "68"/>
</figure>
</item>
</list1>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
