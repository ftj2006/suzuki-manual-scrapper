<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1326040" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Intake VVT Actuator On-Vehicle Inspection
</title>
<s1>
<ptxt>
With ignition “OFF”, connect SUZUKI scan tool to DLC.
</ptxt>
<servicetool>
<servicetoolitem id = "L1C215">
<s-part>
(A)
</s-part>
<s-number num = "NNNNN-00035">
SUZUKI scan tool (Suzuki SDT-II)
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IGSB0A131015.swf" width = "88.000mm" height = "87.737mm" ver = "01" gw = "205" gh = "232"/>
</figure>
</s1>
<s1>
<ptxt>
Set ignition “ON”.
</ptxt>
</s1>
<s1>
<ptxt>
Check intake VVT actuator (motor part) for operation by using “VVT Control B1 IN” function in “Active Test” mode on SUZUKI scan tool.
</ptxt>
</s1>
<s1>
<ptxt>
If faulty condition is found, check intake VVT actuator (sprocket part) referring to “Intake VVT actuator” under 
<intxref refid = "AENLSB0A1426037">Camshaft and VVT Actuator Inspection:K14D</intxref>
.
</ptxt>
</s1>
<s1>
<ptxt>
If OK, replace intake VVT actuator (motor part). 
<intxreftitleoff1 refid = "AENLSB0A1426059"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
