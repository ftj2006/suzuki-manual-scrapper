<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1E">
<servcat sctnbr = "01" scnbr = "05">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1526013" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Oil Pressure and Temperature Sensor Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1526012">Oil Pressure and Temperature Sensor On-Vehicle Inspection:K14D</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1526013001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove cable protector bolt (1).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect oil pressure and temperature sensor connector.
</ptxt>
</s1>
<s1>
<ptxt>
Remove oil pressure and temperature sensor (2) from oil pump assembly.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A152005.jpg" width = "88.000mm" height = "49.942mm" ver = "01" gw = "185" gh = "125"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1526013002">
<title>
Installation
</title>
<attention4>
<ptxt>
Reinstallation of oil pressure and temperature sensor may cause oil leakage.
</ptxt>
<ptxt>
Once the sensor is removed, replace it with a new one.
</ptxt>
</attention4>
<s1>
<ptxt>
Tighten new oil pressure and temperature sensor (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1E217">
<t-part>
Oil pressure and temperature sensor
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
16
</t-value1>
<t-value2>
1.6
</t-value2>
<t-value3>
12.0
</t-value3>
</torqueitem>
</torque>
</s1>
<s1>
<ptxt>
Connect oil pressure and temperature sensor connector.
</ptxt>
</s1>
<s1>
<ptxt>
Install cable protector bolt (2).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A152006.jpg" width = "88.000mm" height = "49.942mm" ver = "01" gw = "185" gh = "125"/>
</figure>
</s1>
<s1>
<ptxt>
Connect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Start engine and check oil pressure and temperature sensor for oil leakage.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
