<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1426039" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Valve and Cylinder Head Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1426038">Valve and Cylinder Head Components:K14D</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1426039001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove timing chain. 
<intxreftitleoff1 refid = "AENLSB0A1426033"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove spark plugs. 
<intxreftitleoff1 refid = "AENLSB0A1826001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove intake and exhaust camshafts. 
<intxreftitleoff1 refid = "AENLSB0A1426036"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove water inlet pipe. 
<intxreftitleoff1 refid = "AENLSB0A1626017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove turbocharger. 
<intxreftitleoff1 refid = "AENLSB0A1426015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove valve rocker arms (1) from cylinder head.
</ptxt>
<figure>
<graphic graphicname = "IFAE0A140223.swf" width = "88.000mm" height = "58.539mm" ver = "01" gw = "214" gh = "149"/>
</figure>
</s1>
<s1>
<ptxt>
Remove valve lash adjusters (1) from cylinder head.
</ptxt>
<attention3>
<ptxt>
Immerse removed valve lash adjusters in clean engine oil and keep them as they are until their reinstallation to prevent entering of air in the adjusters.
</ptxt>
</attention3>
<figure>
<graphic graphicname = "IFAE0A140224.swf" width = "88.000mm" height = "57.428mm" ver = "01" gw = "214" gh = "146"/>
</figure>
</s1>
<s1>
<ptxt>
Remove cylinder head bolts in numerical order (“1” – “10”) evenly and gradually.
</ptxt>
<figure>
<graphic graphicname = "IFAE0A140225.swf" width = "88.000mm" height = "53.708mm" ver = "01" gw = "214" gh = "136"/>
</figure>
</s1>
<s1>
<ptxt>
Check all around cylinder head for any other parts required to be removed or disconnected and remove or disconnect them if any.
</ptxt>
</s1>
<s1>
<ptxt>
Remove cylinder head (1) from cylinder block.
</ptxt>
</s1>
<s1>
<ptxt>
Remove dowel pins (2) from cylinder block, if necessary.
</ptxt>
</s1>
<s1>
<ptxt>
Remove cylinder head gasket (3) from cylinder block.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142100.jpg" width = "88.000mm" height = "59.509mm" ver = "01" gw = "185" gh = "152"/>
</figure>
</s1>
<s1>
<ptxt>
Remove the following components from cylinder head, if necessary.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Exhaust CMP sensor: 
<intxreftitleoff1 refid = "AENLSB0A1326022"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Fuel delivery pipe and fuel injectors: 
<intxreftitleoff1 refid = "AENLSB0A1726013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1426039002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1426041">Valve and Cylinder Head Disassembly and Reassembly:K14D</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Clean mating surfaces of cylinder head and cylinder block. Remove oil, old gasket and dust from mating surfaces.
</ptxt>
</s1>
<s1>
<ptxt>
Install dowel pins (1) to cylinder block, if removed.
</ptxt>
</s1>
<s1>
<ptxt>
Set new cylinder head gasket (2) to cylinder block.
</ptxt>
<figure>
<graphic graphicname = "IFAE0A140227.swf" width = "88.000mm" height = "38.850mm" ver = "02" gw = "184" gh = "94"/>
</figure>
</s1>
<s1>
<ptxt>
Install cylinder head to cylinder block according to the following procedure.
</ptxt>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
Before installing the cylinder head to the cylinder block, turn crankshaft counterclockwise and position the key (1) within an angle of 30&#176; – 90&#176; from TDC as shown in figure and keep the valves from coming in contact with the piston.
</ptxt>
<figure>
<graphic graphicname = "I7V20A141058.swf" width = "88.000mm" height = "37.283mm" ver = "01" gw = "129" gh = "89"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
“a”:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
30&#176;
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
“b”:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
90&#176;
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</item>
<item>
<ptxt>
If cylinder head bolt is reused, check bolt for deformation. 
<intxreftitleoff1 refid = "AENLSB0A1426044"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
For accurate angle tightening of the bolt, use commercially available tightening angle gauge.
</ptxt>
<figure>
<graphic graphicname = "IJHA0A140061.swf" width = "88.000mm" height = "53.411mm" ver = "01" gw = "151" gh = "135"/>
</figure>
</item>
</list1>
</attention3>
<s2>
<ptxt>
Apply engine oil to thread for 4 mm (0.15 in.) from lower end of cylinder head bolts.
</ptxt>
</s2>
<s2>
<ptxt>
Tighten cylinder head bolts to 15 N&#183;m (1.5 kgf-m, 11.0 lbf-ft) in numerical order (“1” – “10”) as shown using a 12-point socket wrench.
</ptxt>
</s2>
<s2>
<ptxt>
In the same manner as in Step b), tighten them to 30 N&#183;m (3.1 kgf-m, 22.5 lbf-ft).
</ptxt>
</s2>
<s2>
<ptxt>
Retighten all cylinder head bolts 70&#176; in numerical order as shown in figure.
</ptxt>
</s2>
<s2>
<ptxt>
Retighten all cylinder head bolts 65&#176; in numerical order as shown in figure.
</ptxt>
<torque>
<torqueitem id = "T1D267">
<t-part>
Cylinder head bolt*
</t-part>
<t-part1>
a
</t-part1>
<t-note>
15 N&#183;m &#8594; 30 N&#183;m &#8594; +70&#176; &#8594; +65&#176; (1.5 kgf-m &#8594; 3.1 kgf-m &#8594; +70&#176; &#8594; +65&#176;, 11.0 lbf-ft &#8594; 22.5 lbf-ft &#8594; +70&#176; &#8594; +65&#176;)
</t-note>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IFAE0A140228.swf" width = "88.000mm" height = "53.708mm" ver = "01" gw = "214" gh = "136"/>
</figure>
</s2>
</s1>
<s1>
<ptxt>
Install fuel injectors and fuel delivery pipe, if removed. 
<intxreftitleoff1 refid = "AENLSB0A1726013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install exhaust CMP sensor, if removed. 
<intxreftitleoff1 refid = "AENLSB0A1326022"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install turbocharger. 
<intxreftitleoff1 refid = "AENLSB0A1426015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install water inlet pipe. 
<intxreftitleoff1 refid = "AENLSB0A1626001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Apply engine oil to valve lash adjusters (1), and then install them to cylinder head.
</ptxt>
<figure>
<graphic graphicname = "IFAE0A140224.swf" width = "88.000mm" height = "57.428mm" ver = "01" gw = "214" gh = "146"/>
</figure>
</s1>
<s1>
<ptxt>
Apply engine oil to each of valve rocker arm body (1) and the roller (2) sufficiently, and then put the valve rocker arms (3) to cylinder head.
</ptxt>
<figure>
<graphic graphicname = "IFAE0A140229.swf" width = "88.000mm" height = "57.376mm" ver = "01" gw = "239" gh = "146"/>
</figure>
</s1>
<s1>
<ptxt>
Install intake and exhaust camshafts. 
<intxreftitleoff1 refid = "AENLSB0A1426036"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install spark plugs. 
<intxreftitleoff1 refid = "AENLSB0A1826001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install timing chain. 
<intxreftitleoff1 refid = "AENLSB0A1426033"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
