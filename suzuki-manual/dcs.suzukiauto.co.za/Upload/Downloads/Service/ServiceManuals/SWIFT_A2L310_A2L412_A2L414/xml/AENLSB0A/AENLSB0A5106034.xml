]>
<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106034" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
A/T Oil Strainer Assembly Removal and Installation
</title>
<servinfosub id = "AENLSB0A5106034001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove oil pump assembly. 
<intxreftitleoff1 refid = "AENLSB0A5106030"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove oil strainer from oil pump body. 
<intxreftitleoff1 refid = "AENLSB0A5106032"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5106034002">
<title>
Installation 
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106035">A/T Oil Strainer Assembly Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
