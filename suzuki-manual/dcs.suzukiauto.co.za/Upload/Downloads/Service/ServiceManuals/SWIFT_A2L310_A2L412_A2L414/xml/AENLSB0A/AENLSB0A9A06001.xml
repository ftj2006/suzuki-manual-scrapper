<suzuki><manual>
<section sectnbr = "9J">
<servcat sctnbr = "09" scnbr = "10">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9A06001" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Hood Removal and Installation
</title>
<servinfosub id = "AENLSB0A9A06001001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove 4 hood hinge bolts (1) to detach hood (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove hood hinge after removing front fender, if necessary. 
<intxreftitleoff1 refid = "AENLSB0A9A06005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9A0001.swf" width = "88.000mm" height = "82.034mm" ver = "01" gw = "196" gh = "216"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9A06001002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9A06002">Hood Inspection and Adjustment</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Adjust hood lock position if necessary. 
<intxreftitleoff1 refid = "AENLSB0A9A06002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
