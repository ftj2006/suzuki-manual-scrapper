<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106017" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Solenoid Valve On-Vehicle Inspection
</title>
<servinfosub id = "AENLSB0A5106017001">
<title>
Resistance Check
</title>
<s1>
<ptxt>
Remove TCM. 
<intxreftitleoff1 refid = "AENLSB0A5106020"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check for proper terminal connection to solenoid harness connector (1).
</ptxt>
</s1>
<s1>
<ptxt>
Using service wire, check resistance of each solenoid valve circuit as follows.
</ptxt>
<spec>
<title>
Shift solenoid valve “A” resistance
</title>
<ptxt>
Between terminal “23” and transaxle: 11 – 15 &#937; at 20 &#176;C (68 &#176;F)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IEL10C510078.swf" width = "88.000mm" height = "68.974mm" ver = "02" gw = "198" gh = "179"/>
</figure>
<spec>
<title>
Shift solenoid valve “B” resistance
</title>
<ptxt>
Between terminal “28” and transaxle: 11 – 15 &#937; at 20 &#176;C (68 &#176;F)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IEL10C510079.swf" width = "88.000mm" height = "68.974mm" ver = "02" gw = "170" gh = "179"/>
</figure>
<spec>
<title>
Pressure control solenoid valve “A” resistance
</title>
<ptxt>
Between terminal “13” and “14”: 5.0 – 5.6 &#937; at 20 &#176;C (68 &#176;F)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IEL10C510080.swf" width = "88.000mm" height = "58.257mm" ver = "02" gw = "186" gh = "149"/>
</figure>
<spec>
<title>
Pressure control solenoid valve “B” resistance
</title>
<ptxt>
Between terminal “8” and “9”: 5.0 – 5.6 &#937; at 20 &#176;C (68 &#176;F)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IEL10C510081.swf" width = "88.000mm" height = "58.433mm" ver = "02" gw = "172" gh = "149"/>
</figure>
<spec>
<title>
Pressure control solenoid valve “C” resistance
</title>
<ptxt>
Between terminal “5” and “12”: 5.0 – 5.6 &#937; at 20 &#176;C (68 &#176;F)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IEL10C510083.swf" width = "88.000mm" height = "58.433mm" ver = "02" gw = "168" gh = "149"/>
</figure>
<spec>
<title>
Pressure control solenoid valve “D” resistance
</title>
<ptxt>
Between terminal “3” and “4”: 5.0 – 5.6 &#937; at 20 &#176;C (68 &#176;F)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IEL10C510082.swf" width = "88.000mm" height = "58.433mm" ver = "02" gw = "157" gh = "149"/>
</figure>
<spec>
<title>
Line pressure control solenoid valve resistance
</title>
<ptxt>
Between terminal “6” and “7”: 5.0 – 5.6 &#937; at 20 &#176;C (68 &#176;F)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IEL10C510084.swf" width = "88.000mm" height = "58.433mm" ver = "02" gw = "172" gh = "149"/>
</figure>
<spec>
<title>
TCC solenoid valve resistance
</title>
<ptxt>
Between terminals “1” and “2”: 5.0 – 5.6 &#937; at 20 &#176;C (68 &#176;F)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IEL10C510085.swf" width = "88.000mm" height = "58.433mm" ver = "02" gw = "172" gh = "149"/>
</figure>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
