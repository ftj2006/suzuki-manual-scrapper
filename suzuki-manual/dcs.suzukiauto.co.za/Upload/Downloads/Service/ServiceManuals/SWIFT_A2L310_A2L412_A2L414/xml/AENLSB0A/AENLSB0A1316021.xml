<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1316021" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
CKP Sensor Removal and Installation
</title>
<attention4>
<ptxt>
The CKP sensor bolt is pre-coated with adhesive. If the bolt is reused, it may work loose.
</ptxt>
<ptxt>
Replace the CKP sensor bolt with a new one.
</ptxt>
</attention4>
<servinfosub id = "AENLSB0A1316021001" page = "2">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove generator. 
<intxreftitleoff1 refid = "AENLSB0A1A16005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector from CKP sensor.
</ptxt>
</s1>
<s1>
<ptxt>
Remove CKP sensor (1) from cylinder block.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A134012.jpg" width = "88.000mm" height = "53.414mm" ver = "01" gw = "199" gh = "135"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1316021002" page = "2">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1316022">CKP Sensor Inspection:K14C</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Apply engine oil to O-ring of CKP sensor.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
