<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1326035" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "1">
<title>
WGV-VSV On-Vehicle Inspection
</title>
<s1>
<ptxt>
Prepare to operate WGV-VSV as follows.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
<emph>
Using SUZUKI scan tool:
</emph>
</ptxt>
</item>
<list2 type = "ordered">
<item>
<ptxt>
Connect SUZUKI scan tool to DLC (1) with ignition “OFF”.
</ptxt>
<servicetool>
<servicetoolitem id = "L1C212">
<s-part>
(A)
</s-part>
<s-number num = "NNNNN-00035">
SUZUKI scan tool (Suzuki SDT-II)
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IGSB0A131015.swf" width = "88.000mm" height = "87.737mm" ver = "01" gw = "205" gh = "232"/>
</figure>
</item>
<item>
<ptxt>
With ignition “ON”, clear DTC and select “Active Test” mode on SUZUKI scan tool.
</ptxt>
<attention3>
<ptxt>
WGV-VSV is operated using scan tool as follows.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
WGV-VSV is OFF: 0%
</ptxt>
</item>
<item>
<ptxt>
WGV-VSV is ON: 100%
</ptxt>
</item>
</list1>
</attention3>
</item>
</list2>
<item>
<ptxt>
<emph>
Without using SUZUKI scan tool:
</emph>
</ptxt>
</item>
<list2 type = "ordered">
<item>
<ptxt>
Connect service wire (1) between WGV-VSV (2) and WGV-VSV connector with ignition “OFF”.
</ptxt>
</item>
<item>
<ptxt>
Set ignition “ON”.
</ptxt>
<attention3>
<ptxt>
WGV-VSV is operated using service wire as follows.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
WGV-VSV is OFF:
</ptxt>
<ptxt>
[a]: Unground “GRN” harness side terminal of WGV-VSV.
</ptxt>
</item>
<item>
<ptxt>
WGV-VSV is ON:
</ptxt>
<ptxt>
[b]: Ground “GRN” harness side terminal of WGV-VSV.
</ptxt>
</item>
</list1>
</attention3>
<figure>
<graphic graphicname = "ILSB0A132013.jpg" width = "88.000mm" height = "59.780mm" ver = "01" gw = "196" gh = "153"/>
</figure>
</item>
</list2>
</list1>
</s1>
<s1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect vacuum hoses (1) from WGV-VSV.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect vacuum hose (2) from waste gate valve.
</ptxt>
</s1>
<s1>
<ptxt>
Connect special tool to vacuum hose and set the tool in “VACUUM” mode.
</ptxt>
<attention3>
<ptxt>
Before using special tool (vacuum pump gauge), read its Operator’s Manual to know how to use it.
</ptxt>
</attention3>
<servicetool>
<servicetoolitem id = "L1C213">
<s-part>
(A)
</s-part>
<s-number num = "09917-47020">
09917–47020
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "ILSB0A132030.jpg" width = "88.000mm" height = "56.284mm" ver = "01" gw = "210" gh = "143"/>
</figure>
</s1>
<s1>
<ptxt>
Set ignition “ON”.
</ptxt>
</s1>
<s1>
<ptxt>
Check WGV-VSV operation as follows.
</ptxt>
<s2>
<ptxt>
Close port (1) with your finger or a rubber plug and check that negative pressure of –60 kPa (–0.6 kgf/cm<sup>2</sup>, –8.7 psi, –0.6 bar) can be applied when WGV-VSV is turned off.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A132031.jpg" width = "88.000mm" height = "56.817mm" ver = "01" gw = "206" gh = "145"/>
</figure>
</s2>
<s2>
<ptxt>
Open port (1) and check that the negative pressure decreases when WGV-VSV is turned off.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A132032.jpg" width = "88.000mm" height = "52.049mm" ver = "01" gw = "206" gh = "131"/>
</figure>
</s2>
<s2>
<ptxt>
Close port (1) with your finger or a rubber plug and check that negative pressure of –60 kPa (–0.6 kgf/cm<sup>2</sup>, –8.7 psi, –0.6 bar) can be applied when WGV-VSV is turned on.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A132033.jpg" width = "88.000mm" height = "54.282mm" ver = "01" gw = "206" gh = "137"/>
</figure>
</s2>
<s2>
<ptxt>
Open port (1) and check that the negative pressure decreases when WGV-VSV is turned on.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A132034.jpg" width = "88.000mm" height = "52.065mm" ver = "01" gw = "207" gh = "131"/>
</figure>
</s2>
</s1>
<s1>
<ptxt>
If faulty condition is found, check the following items.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Wire harness and connections
</ptxt>
</item>
<item>
<ptxt>
WGV-VSV: 
<intxreftitleoff1 refid = "AENLSB0A1326036"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Vacuum hose
</ptxt>
</item>
</list1>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
