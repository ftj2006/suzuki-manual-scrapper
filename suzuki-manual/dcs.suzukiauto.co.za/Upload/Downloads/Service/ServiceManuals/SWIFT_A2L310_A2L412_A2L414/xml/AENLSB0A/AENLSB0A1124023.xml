<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "top" align = "left">
<ptxt>
<emph etype = "bold">
P0102: Mass or Volume Air Flow “A” Circuit Low
</emph>
</ptxt>
<ptxt>
MAF sensor signal circuit is open or shorted to ground.
</ptxt>
<ptxt>
(3 D/C detection logic)
</ptxt>
</entry>
<entry colname = "2" morerows = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
MAF sensor and/or its circuit
</ptxt>
</item>
<item>
<ptxt>
ECM
</ptxt>
</item>
</list1>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "top" align = "left">
<ptxt>
<emph etype = "bold">
P0103: Mass or Volume Air Flow “A” Circuit High
</emph>
</ptxt>
<ptxt>
MAF sensor signal circuit is shorted to power supply.
</ptxt>
<ptxt>
(3 D/C detection logic)
</ptxt>
</entry>
</row>
