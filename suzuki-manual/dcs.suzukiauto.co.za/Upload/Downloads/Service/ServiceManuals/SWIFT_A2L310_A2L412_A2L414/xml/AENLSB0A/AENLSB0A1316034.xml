<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1316034" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
WGV-VSV Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1316033">WGV-VSV On-Vehicle Inspection:K14C</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1316034001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine cover.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect WGV-VSV connector.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect vacuum hoses (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove WGV-VSV (2) from bracket.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A134024.jpg" width = "88.000mm" height = "64.110mm" ver = "01" gw = "199" gh = "165"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1316034002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1316035">WGV-VSV Inspection:K14C</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
