<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1426030" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Flywheel Removal and Installation
</title>
<servinfosub id = "AENLSB0A1426030001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove clutch cover and clutch disc. 
<intxreftitleoff1 refid = "AENLSB0A5306018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Lock flywheel using special tool as shown in figure.
</ptxt>
<servicetool>
<servicetoolitem id = "L1D252">
<s-part>
(A)
</s-part>
<s-number num = "09924-17811">
09924–17811
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IFAE0A140084.swf" width = "88.000mm" height = "51.169mm" ver = "01" gw = "137" gh = "128"/>
</figure>
</s1>
<s1>
<ptxt>
Remove flywheel from crankshaft.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1426030002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1426031">Flywheel Inspection:K14D</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Install flywheel according to the following procedure.
</ptxt>
<attention4>
<ptxt>
The flywheel bolts are pre-coated with adhesive. If these bolts are reused, they may work loose.
</ptxt>
<ptxt>
Replace the flywheel bolts with new ones whenever they are removed.
</ptxt>
</attention4>
<attention3>
<ptxt>
For accurate angle tightening of the bolt, use commercially available tightening angle gauge.
</ptxt>
<figure>
<graphic graphicname = "IJHA0A140061.swf" width = "88.000mm" height = "53.411mm" ver = "01" gw = "151" gh = "135"/>
</figure>
</attention3>
<s2>
<ptxt>
Install new flywheel bolts.
</ptxt>
</s2>
<s2>
<ptxt>
Lock flywheel using special tool as shown in figure.
</ptxt>
<servicetool>
<servicetoolitem id = "L1D253">
<s-part>
(A)
</s-part>
<s-number num = "09924-17811">
09924–17811
</s-number>
</servicetoolitem>
</servicetool>
</s2>
<s2>
<ptxt>
Tighten all flywheel bolts evenly and gradually to 20 N&#183;m (2.0 kgf-m, 15.0 lbf-ft).
</ptxt>
</s2>
<s2>
<ptxt>
Retighten them 34&#176;.
</ptxt>
<torque>
<torqueitem id = "T1D255">
<t-part>
Flywheel bolt*
</t-part>
<t-part1>
a
</t-part1>
<t-note>
20 N&#183;m &#8594; +34&#176; (2.0 kgf-m &#8594; +34&#176;, 15.0 lbf-ft &#8594; +34&#176;)
</t-note>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IFAE0A140086.swf" width = "88.000mm" height = "50.450mm" ver = "01" gw = "143" gh = "126"/>
</figure>
</s2>
</s1>
<s1>
<ptxt>
Install clutch cover and clutch disc. 
<intxreftitleoff1 refid = "AENLSB0A5306018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
