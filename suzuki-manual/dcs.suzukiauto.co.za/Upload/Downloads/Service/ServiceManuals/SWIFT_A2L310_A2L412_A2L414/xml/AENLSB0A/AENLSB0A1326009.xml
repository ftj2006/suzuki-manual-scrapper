<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1326009" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
MAP Sensor Removal and Installation
</title>
<servinfosub id = "AENLSB0A1326009001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove EGR cooler. 
<intxreftitleoff1 refid = "AENLSB0A1226016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove EVAP canister purge valve bracket bolt (1).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector from MAP sensor.
</ptxt>
</s1>
<s1>
<ptxt>
Remove MAP sensor (2) from intake manifold (3).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A132003.jpg" width = "88.000mm" height = "54.937mm" ver = "01" gw = "185" gh = "139"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1326009002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1326010">MAP Sensor Inspection:K14D</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Check that O-ring is free from damage.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
