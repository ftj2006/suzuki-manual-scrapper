<servinfosub id = "AENLSB0A9204010003">
<title>
DTC Confirmation Procedure
</title>
<s1>
<ptxt>
Run engine at idle speed for 10 sec. or more.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9204010004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A9204010005">
<testgroup id = "AENLSB0A9204010006">
<title>
DTC check
</title>
<test1>
<ptxt>
Clear DTC. 
<intxreftitleoff1 refid = "AENLSB0A9204003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Perform 
<intxref refid = "AENLSB0A9204010003">DTC Confirmation Procedure</intxref>
 and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A9204002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is DTC B1951 still detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
End. (Intermittent trouble.)
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A9204010007">
<title>
Headlight auto leveling control module power supply circuit and ground circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “G14” and “G271” connectors.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connections to “G14” and “G271” connectors.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “A1” and “A2” circuits: less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A1” circuit and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A1” circuit terminal and other terminal at “G14” connector: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A2” circuit terminal and other terminal at “G14” connector: infinity
</ptxt>
</item>
<item>
<ptxt>
Voltage of “A1” and “A2” circuits: approx. 0 V (When ignition is “ON”)
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A9204010008">
<title>
Headlight auto leveling control module power supply voltage check
</title>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Connect “G271” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Check “A1” circuit voltage with engine speed at 3,000 rpm.
</ptxt>
</test1>
<question>
Is voltage 12 – 15 V?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace headlight auto leveling control module and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A9206015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Check charging system.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0A1A14003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0A1A24004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
</testgroup>
</diag>
