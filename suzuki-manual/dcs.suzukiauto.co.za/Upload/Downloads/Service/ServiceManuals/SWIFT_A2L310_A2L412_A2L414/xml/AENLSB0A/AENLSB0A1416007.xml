<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1416007" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Intercooler Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1416006">Intercooler On-Vehicle Inspection and Cleaning:K14C</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A1416005">Intercooler Components:K14C</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1416007001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove front bumper. 
<intxreftitleoff1 refid = "AENLSB0A9806001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove front end upper cover, front bumper lower absorber, front end lower cover and front bumper member. 
<intxreftitleoff1 refid = "AENLSB0A9806003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect intercooler inlet hose (1) and inter cooler outlet hose No.1 (2) from intercooler (3).
</ptxt>
</s1>
<s1>
<ptxt>
Remove intercooler.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A144013.jpg" width = "88.000mm" height = "52.397mm" ver = "01" gw = "223" gh = "132"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1416007002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Use new intercooler inlet hose and new intercooler inlet hose clamps.
</ptxt>
</item>
<item>
<ptxt>
Tighten hose clamps and mounting bolts to specified torque. 
<intxreftitleoff1 refid = "AENLSB0A1416005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
