<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1416029" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
OCV Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1416026">Timing Chain Cover Components:K14C</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1416029001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect OCV connector (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove OCV (2) from timing chain cover.
</ptxt>
<figure>
<graphic graphicname = "IFAE0A140082.swf" width = "88.000mm" height = "58.417mm" ver = "01" gw = "211" gh = "149"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1416029002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1316036">OCV Inspection:K14C</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Apply engine oil to O-ring and carefully insert OCV to timing chain cover.
</ptxt>
</item>
<item>
<ptxt>
Tighten OCV bolt (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1D119">
<t-part>
OCV bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IFAE0A140083.swf" width = "88.000mm" height = "58.417mm" ver = "01" gw = "211" gh = "149"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
