<intxreftitleoff1 refid = "AENLSB0A4406008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Brake fluid level switch: 
<intxreftitleoff1 refid = "AENLSB0A4106002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Malfunctioning ESP<sup>&#174;</sup> function
</ptxt>
</ps>
<action>
<ptxt>
Perform ESP<sup>&#174;</sup> system check. 
<intxreftitleoff1 refid = "AENLSB0A4604001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
