<ptxt>
Malfunctioning ESP<sup>&#174;</sup> function
</ptxt>
</ps>
<action>
<ptxt>
Perform ESP<sup>&#174;</sup> system check. 
<intxreftitleoff1 refid = "AENLSB0A4604001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Malfunctioning ESP<sup>&#174;</sup> warning light circuit
</ptxt>
</ps>
<action>
<ptxt>
Check ESP<sup>&#174;</sup> warning light circuit. 
<intxreftitleoff1 refid = "AENLSB0A4604012"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<condition>
<ptxt>
