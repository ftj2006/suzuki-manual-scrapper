<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "10J">
<servcat sctnbr = "10" scnbr = "10">
<configtype typenbr = "2">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0AAA24023" svcinfotypenbr = "06" svcinfoqualnbr = "02" supplyoff = "1" modify = "0">
<title>
DTC B11F4-81
</title>
<servinfosub id = "AENLSB0AAA24023001">
<title>
DTC Detecting Condition and Trouble Area
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "4.764in"/>
<colspec colnum = "2" colname = "2" colwidth = "2.429in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
DTC detecting condition
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Trouble area
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
B11F4-81: CAN Invalid Data From Steering Angle Sensor
</emph>
</ptxt>
<ptxt>
Blind spot monitor control module detected abnormal condition in control data transmitted by lighting and turn signal switch through CAN communication.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Lighting and turn signal switch
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</servinfosub>
<servinfosub id = "AENLSB0AAA24023002">
<title>
DTC Confirmation Procedure
</title>
<s1>
<ptxt>
Set ignition “ON”.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AAA24023003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0AAA24023004">
<testgroup id = "AENLSB0AAA24023005">
<question>
Was “Blind Spot Monitor System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0AAA24001">Blind Spot Monitor System Check:Blind Spot Monitor</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA24023006">
<title>
DTC recheck
</title>
<test1>
<ptxt>
Clear DTC. 
<intxreftitleoff1 refid = "AENLSB0AAA24004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Perform 
<intxref refid = "AENLSB0AAA24023002">DTC Confirmation Procedure</intxref>
 and then recheck DTC.
</ptxt>
</test1>
<question>
Is DTC B11F4-81 still detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace lighting and turn signal switch and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A9206019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Check for intermittent trouble. 
<intxreftitleoff1 refid = "AENLSB0A0006002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
