<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "4A">
<servcat sctnbr = "04" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A4106023" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Brake Booster Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A4106021">Brake Booster Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A4106023001">
<title>
LHD
</title>
<topic id = "AENLSB0A4106023002">
<title>
Removal
</title>
<s1>
<ptxt>
Remove brake master cylinder assembly from brake booster. 
<intxreftitleoff1 refid = "AENLSB0A4106018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect brake booster pressure sensor connector, if equipped.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect vacuum hose from brake booster.
</ptxt>
</s1>
<s1>
<ptxt>
Remove clip (2) and clevis pin (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A410031.jpg" width = "88.000mm" height = "74.880mm" ver = "01" gw = "203" gh = "196"/>
</figure>
</s1>
<s1>
<ptxt>
Remove brake booster nuts (1) and remove brake booster from dash panel.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A410005.jpg" width = "88.000mm" height = "71.278mm" ver = "01" gw = "199" gh = "186"/>
</figure>
</s1>
<s1>
<ptxt>
Remove brake vacuum hose, if necessary.
</ptxt>
</s1>
</topic>
<topic id = "AENLSB0A4106023005">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A4106024">Brake Booster Inspection</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Install brake vacuum hose, if removed.
</ptxt>
</s1>
<s1>
<ptxt>
Loosen brake pedal bracket nut (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A410010.jpg" width = "88.000mm" height = "71.278mm" ver = "01" gw = "199" gh = "186"/>
</figure>
</s1>
<s1>
<ptxt>
Remove steering joint cover. 
<intxreftitleoff1 refid = "AENLSB0A6206001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Loosen accelerator pedal bracket nuts (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A410033.jpg" width = "88.000mm" height = "75.342mm" ver = "01" gw = "199" gh = "197"/>
</figure>
</s1>
<s1>
<ptxt>
Install brake booster to dash panel. Then connect clevis (3) to brake pedal arm with clevis pin (1) and new clip (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A410034.jpg" width = "88.000mm" height = "74.880mm" ver = "01" gw = "203" gh = "196"/>
</figure>
</s1>
<s1>
<ptxt>
Tighten brake booster nuts (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T4A006">
<t-part>
Brake booster nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A410011.jpg" width = "88.000mm" height = "71.278mm" ver = "01" gw = "199" gh = "186"/>
</figure>
</s1>
<s1>
<ptxt>
Tighten brake pedal bracket nut (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T4A007">
<t-part>
Brake pedal bracket nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A410012.jpg" width = "88.000mm" height = "71.278mm" ver = "01" gw = "199" gh = "186"/>
</figure>
</s1>
<s1>
<ptxt>
Tighten accelerator pedal bracket nuts (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T4A008">
<t-part>
Accelerator pedal bracket nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A410035.jpg" width = "88.000mm" height = "75.342mm" ver = "01" gw = "199" gh = "197"/>
</figure>
</s1>
<s1>
<ptxt>
Install steering joint cover. 
<intxreftitleoff1 refid = "AENLSB0A6206001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Connect vacuum hose to brake booster.
</ptxt>
</s1>
<s1>
<ptxt>
Connect brake booster pressure sensor connector, if removed.
</ptxt>
</s1>
<s1>
<ptxt>
Install brake master cylinder assembly to brake booster. 
<intxreftitleoff1 refid = "AENLSB0A4106018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install brake pipes, and tighten flare nuts (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T4A009">
<t-part>
Brake pipe flare nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
21
</t-value1>
<t-value2>
2.1
</t-value2>
<t-value3>
15.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A410036.jpg" width = "88.000mm" height = "57.478mm" ver = "01" gw = "199" gh = "146"/>
</figure>
</s1>
<s1>
<ptxt>
Bleed brake system. 
<intxreftitleoff1 refid = "AENLSB0A4106004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check installed parts for brake fluid leakage.
</ptxt>
</s1>
<s1>
<ptxt>
Check brake pedal for play. 
<intxreftitleoff1 refid = "AENLSB0A4106008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check that brake system operates properly without brake fluid leakage.
</ptxt>
</s1>
</topic>
</servinfosub>
<servinfosub id = "AENLSB0A4106023004">
<title>
RHD
</title>
<topic id = "AENLSB0A4106023003">
<title>
Removal
</title>
<s1>
<ptxt>
For K14D model, remove engine assembly from vehicle. 
<intxreftitleoff1 refid = "AENLSB0A1426025"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove brake master cylinder assembly from brake booster. 
<intxreftitleoff1 refid = "AENLSB0A4106018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove the following brake pipes. 
<intxreftitleoff1 refid = "AENLSB0A4106014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Pipe between master cylinder primary and ESP<sup>&#174;</sup> hydraulic unit / control module assembly
</ptxt>
</item>
<item>
<ptxt>
Pipe between master cylinder secondary and ESP<sup>&#174;</sup> hydraulic unit / control module assembly
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Disconnect brake booster pressure sensor connector, if equipped.
</ptxt>
</s1>
<s1>
<ptxt>
For K14C model, remove the following parts.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front cowl upper panel: 
<intxreftitleoff1 refid = "AENLSB0A9806006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Intake manifold: 
<intxreftitleoff1 refid = "AENLSB0A1416021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
For K14C model, remove suction pipe as follows.
</ptxt>
<s2>
<ptxt>
Recover refrigerant from A/C system using recovery and recycling equipment referring to “Recovery” in 
<intxref refid = "AENLSB0A7206001">Operation Procedure for Refrigerant Charge</intxref>
.
</ptxt>
</s2>
<s2>
<ptxt>
Remove suction pipe. 
<intxreftitleoff1 refid = "AENLSB0A7206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s2>
</s1>
<s1>
<ptxt>
Disconnect vacuum hose from brake booster.
</ptxt>
</s1>
<s1>
<ptxt>
Remove clip (2) and clevis pin (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A410032.jpg" width = "88.000mm" height = "72.058mm" ver = "01" gw = "201" gh = "188"/>
</figure>
</s1>
<s1>
<ptxt>
Remove brake booster nuts (1) and remove brake booster from dash panel.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A410006.jpg" width = "88.000mm" height = "71.109mm" ver = "01" gw = "199" gh = "185"/>
</figure>
</s1>
<s1>
<ptxt>
Remove brake vacuum hose and pipe, if necessary.
</ptxt>
</s1>
</topic>
<topic id = "AENLSB0A4106023006">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A4106024">Brake Booster Inspection</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Install brake vacuum hose and pipe and tighten vacuum pipe nut to specified torque, if removed. 
<intxreftitleoff1 refid = "AENLSB0A4106021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<torque>
<torqueitem id = "T4A010">
<t-part>
Vacuum pipe nut
</t-part>
<t-value1>
11
</t-value1>
<t-value2>
1.1
</t-value2>
<t-value3>
8.5
</t-value3>
</torqueitem>
</torque>
</s1>
<s1>
<ptxt>
Loosen brake pedal bracket nut (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A410037.jpg" width = "88.000mm" height = "71.109mm" ver = "01" gw = "199" gh = "185"/>
</figure>
</s1>
<s1>
<ptxt>
Loosen accelerator pedal assembly nut (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A410038.jpg" width = "88.000mm" height = "69.331mm" ver = "01" gw = "199" gh = "180"/>
</figure>
</s1>
<s1>
<ptxt>
Install brake booster to dash panel. Then connect clevis (3) to brake pedal arm with clevis pin (2) and new clip (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A410039.jpg" width = "88.000mm" height = "72.058mm" ver = "01" gw = "201" gh = "188"/>
</figure>
</s1>
<s1>
<ptxt>
Tighten brake booster nuts (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T4A011">
<t-part>
Brake booster nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A410040.jpg" width = "88.000mm" height = "71.109mm" ver = "01" gw = "199" gh = "185"/>
</figure>
</s1>
<s1>
<ptxt>
Tighten brake pedal bracket nut (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T4A012">
<t-part>
Brake pedal bracket nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A410041.jpg" width = "88.000mm" height = "71.109mm" ver = "01" gw = "199" gh = "185"/>
</figure>
</s1>
<s1>
<ptxt>
Tighten accelerator pedal assembly nuts (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T4A013">
<t-part>
Accelerator pedal assembly nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
13
</t-value1>
<t-value2>
1.3
</t-value2>
<t-value3>
9.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IHSB0A410007.jpg" width = "88.000mm" height = "69.331mm" ver = "01" gw = "199" gh = "180"/>
</figure>
</s1>
<s1>
<ptxt>
Connect vacuum hose to brake booster.
</ptxt>
</s1>
<s1>
<ptxt>
For K14C model, install suction pipe as follows.
</ptxt>
<s2>
<ptxt>
Apply compressor oil to new O-rings of suction pipe and suction hose.
</ptxt>
<attention3>
<ptxt>
Both ND-OIL8 and ND-OIL12 are applicable.
</ptxt>
</attention3>
<materials>
<materialitem name = "Compressor oil (ND-12)" id = "M4A001" uid = "1373352765">
<m-part>
</m-part>
<m-desc>
Compressor oil
</m-desc>
<m-number>
99000–990B7–00A
</m-number>
<m-name>
Compressor oil (ND-12)
</m-name>
</materialitem>
<materialitem name = "Compressor oil (ND-OIL8)" id = "M4A002" uid = "-495000306">
<m-part>
</m-part>
<m-desc>
Compressor oil
</m-desc>
<m-number>
95590–58D30
</m-number>
<m-name>
Compressor oil (ND-OIL8)
</m-name>
</materialitem>
</materials>
</s2>
<s2>
<ptxt>
Install suction pipe. 
<intxreftitleoff1 refid = "AENLSB0A7206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s2>
<s2>
<ptxt>
Evacuate and charge A/C system referring to “Evacuation” and “Charge” in 
<intxref refid = "AENLSB0A7206001">Operation Procedure for Refrigerant Charge</intxref>
.
</ptxt>
</s2>
</s1>
<s1>
<ptxt>
Connect brake booster pressure sensor connector, if equipped.
</ptxt>
</s1>
<s1>
<ptxt>
Install the following brake pipes, and tighten flare nuts to specified torque. 
<intxreftitleoff1 refid = "AENLSB0A4106014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Pipe between master cylinder primary and ESP<sup>&#174;</sup> hydraulic unit / control module assembly
</ptxt>
</item>
<item>
<ptxt>
Pipe between master cylinder secondary and ESP<sup>&#174;</sup> hydraulic unit / control module assembly
</ptxt>
<torque>
<torqueitem id = "T4A014">
<t-part>
Brake pipe flare nut
</t-part>
<t-value1>
21
</t-value1>
<t-value2>
2.1
</t-value2>
<t-value3>
15.5
</t-value3>
</torqueitem>
</torque>
</item>
</list1>
</s1>
<s1>
<ptxt>
Install brake master cylinder assembly to brake booster. 
<intxreftitleoff1 refid = "AENLSB0A4106018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
For K14D model, install engine assembly to vehicle. 
<intxreftitleoff1 refid = "AENLSB0A1426025"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Bleed brake system. 
<intxreftitleoff1 refid = "AENLSB0A4106004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check installed parts for brake fluid leakage.
</ptxt>
</s1>
<s1>
<ptxt>
Check brake pedal for play. 
<intxreftitleoff1 refid = "AENLSB0A4106008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check that brake system operates properly without brake fluid leakage.
</ptxt>
</s1>
<s1>
<ptxt>
For K14C model, install the following parts.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front cowl upper panel: 
<intxreftitleoff1 refid = "AENLSB0A9806006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Intake manifold: 
<intxreftitleoff1 refid = "AENLSB0A1416021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
</topic>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
