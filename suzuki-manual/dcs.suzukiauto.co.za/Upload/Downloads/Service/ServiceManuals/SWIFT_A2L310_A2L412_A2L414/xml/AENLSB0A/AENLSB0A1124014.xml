<servinfo servinfosgmlid = "AENLSB0A1124014" svcinfotypenbr = "06" svcinfoqualnbr = "02" supplyoff = "1" modify = "0">
<title>
DTC P0011
</title>
<servinfosub id = "AENLSB0A1124014001">
<title>
DTC Detecting Condition and Trouble Area
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "4.331in"/>
<colspec colnum = "2" colname = "2" colwidth = "2.862in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
DTC detecting condition
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
Trouble area
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "top" align = "left">
<ptxt>
<emph etype = "bold">
P0011: “A” Camshaft Position Timing Over Advanced or System Performance (Bank1)
</emph>
</ptxt>
<ptxt>
Measured intake CMP does not reach target CMP for specified time.
</ptxt>
<ptxt>
(3 D/C detection logic)
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "top" align = "left">
<list1 type = "unordered">
<item>
<ptxt>
CKP sensor and sensor plate
</ptxt>
</item>
<item>
<ptxt>
Intake CMP sensor and signal rotor
</ptxt>
</item>
<item>
<ptxt>
Intake VVT actuator
</ptxt>
</item>
<item>
<ptxt>
Valve timing
</ptxt>
</item>
<item>
<ptxt>
ECM
</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</servinfosub>
<servinfosub id = "AENLSB0A1124014003">
<title>
DTC Confirmation Procedure
</title>
<attention1>
<ptxt>
If you do not select a suitable route and take proper precautions when performing a road test, an accident can occur.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Select a level road with no traffic to minimize the risk of accident.
</ptxt>
</item>
<item>
<ptxt>
Perform the test extremely carefully.
</ptxt>
</item>
<item>
<ptxt>
Perform the road test with 2 persons, a driver and a tester.
</ptxt>
</item>
</list1>
</attention1>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
Limit the driving speed permissible in road conditions and regulations.
</ptxt>
</item>
<item>
<ptxt>
Check that the following DTCs are not detected in this “DTC Confirmation Procedure”.
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Intake CMP sensor (P0340)
</ptxt>
</item>
<item>
<ptxt>
CKP sensor (P0335 and P0336)
</ptxt>
</item>
<item>
<ptxt>
Intake VVT actuator (P1088, P14C4, P2614, P34AC and P34C8)
</ptxt>
</item>
</list2>
</list1>
</attention3>
<s1>
<ptxt>
Warm up engine and repeat acceleration and deceleration between 30 and 80 km/h (19 and 50 mile/h) more than 10 times.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1124014004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A1124014005">
<testgroup id = "AENLSB0A1124014006">
<question>
Was “Engine and Emission Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A1124001">Engine and Emission Control System Check:K14D</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1124014007">
<title>
DTC check
</title>
<test1>
<ptxt>
Check DTC. 
<intxreftitleoff1 refid = "AENLSB0A1124003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is there DTC(s) other than P0011?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to troubleshooting for applicable DTC.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1124014010">
<title>
CKP sensor and sensor plate check
</title>
<test1>
<ptxt>
Check CKP sensor and sensor plate.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
CKP sensor: 
<intxreftitleoff1 refid = "AENLSB0A1326024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Sensor plate: 
<intxreftitleoff1 refid = "AENLSB0A1426056"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective parts.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1124014011">
<title>
Intake CMP sensor and signal rotor check
</title>
<test1>
<ptxt>
Check intake CMP sensor and signal rotor.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Intake CMP sensor: 
<intxreftitleoff1 refid = "AENLSB0A1326021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Signal rotor: 
<intxreftitleoff1 refid = "AENLSB0A1426037"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 5.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective parts.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1124014014">
<title>
Intake VVT actuator check
</title>
<test1>
<ptxt>
Check intake VVT actuator.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Motor part: 
<intxreftitleoff1 refid = "AENLSB0A1326040"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Sprocket part: 
<intxreftitleoff1 refid = "AENLSB0A1426037"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 6. 
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective parts.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1124014015">
<title>
Valve timing check
</title>
<test1>
<ptxt>
Check parts related to timing chain and their installing condition. 
<intxreftitleoff1 refid = "AENLSB0A1426033"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A1326001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Reinstall parts related to timing chain correctly, or replace defective parts.
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
