<suzuki><manual>
<section sectnbr = "9K">
<servcat sctnbr = "09" scnbr = "11">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9B06001" svcinfotypenbr = "08" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Hood Lock Member, Lamp Support Brace and Lamp Support Outer Brace Removal and Installation
</title>
<attention3>
<ptxt>
The figure below shows condition where the following part are removed.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front fender: 
<intxreftitleoff1 refid = "AENLSB0A9A06005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</attention3>
<figure>
<graphic graphicname = "IGSB0A9B0022.jpg" width = "183.000mm" height = "85.578mm" ver = "01" gw = "332" gh = "226"/>
</figure>
<servinfosub id = "AENLSB0A9B06001001">
<title>
General Notes
</title>
<ptxt>
Welding method and number of welding points are the same on both sides. This repair instruction shows procedure for left side.
</ptxt>
</servinfosub>
<servinfosub id = "AENLSB0A9B06001002">
<title>
Removal
</title>
<s1>
<ptxt>
Unscrew 6 bolts.
</ptxt>
</s1>
<s1>
<ptxt>
Remove hood lock member.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9B0023.jpg" width = "183.000mm" height = "90.581mm" ver = "02" gw = "417" gh = "240"/>
</figure>
</s1>
<s1>
<ptxt>
Drill out welding spots and remove lamp support brace and lamp support outer brace.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9B0024.jpg" width = "183.000mm" height = "93.753mm" ver = "03" gw = "386" gh = "249"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9B06001003">
<title>
Installation
</title>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
Before conducting any weld, check installation position and condition for installation part(s). 
<intxreftitleoff1 refid = "AENLSB0A9B04004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Perform repair while taking into consideration installation of parts that affect appearance. 
<intxreftitleoff1 refid = "AENLSB0A9B04003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</attention3>
<s1>
<ptxt>
Install lamp support brace and lamp support outer brace.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld and plug weld.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9B0025.jpg" width = "183.000mm" height = "93.753mm" ver = "02" gw = "386" gh = "249"/>
</figure>
</s1>
<s1>
<ptxt>
Install hood lock member.
</ptxt>
</s1>
<s1>
<ptxt>
Tighten 6 bolts to specified torque.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9B0026.jpg" width = "183.000mm" height = "90.581mm" ver = "02" gw = "417" gh = "240"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.394in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MANOTE" width = "5.132mm" height = "3.048mm"/>
:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
This bolt is tightened first.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
