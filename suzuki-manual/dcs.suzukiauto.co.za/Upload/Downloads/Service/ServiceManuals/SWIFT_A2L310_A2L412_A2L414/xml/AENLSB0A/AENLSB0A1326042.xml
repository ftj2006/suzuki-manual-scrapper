<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1326042" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Piston Cooling Jet Valve Inspection
</title>
<s1>
<ptxt>
Remove piston cooling jet valve. 
<intxreftitleoff1 refid = "AENLSB0A1526014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check piston cooling jet valve as follows.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Check resistance between terminals of piston cooling jet valve connector (1).
</ptxt>
<ptxt>
If measured resistance is out of specified range, replace piston cooling jet valve. 
<intxreftitleoff1 refid = "AENLSB0A1526014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<spec>
<title>
Piston cooling jet valve resistance
</title>
<ptxt>
6.9 to 7.9 &#937; at 20 &#176;C (68 &#176;F)
</ptxt>
</spec>
<figure>
<graphic graphicname = "ILSB0A132027.swf" width = "88.000mm" height = "68.511mm" ver = "01" gw = "154" gh = "178"/>
</figure>
</item>
<item>
<ptxt>
Connect battery to piston cooling jet valve connector (1) as shown in figure, and check operating sound caused by movement of spool valve (2).
</ptxt>
<ptxt>
If check result is not as specified, replace piston cooling jet valve. 
<intxreftitleoff1 refid = "AENLSB0A1526014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<figure>
<graphic graphicname = "ILSB0A132028.swf" width = "88.000mm" height = "73.156mm" ver = "01" gw = "162" gh = "191"/>
</figure>
</item>
<item>
<ptxt>
Check piston cooling jet valve O-ring (1) for damage and deterioration.
</ptxt>
<ptxt>
If check result is not as specified, replace piston cooling jet valve. 
<intxreftitleoff1 refid = "AENLSB0A1526014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<figure>
<graphic graphicname = "ILSB0A132029.swf" width = "88.000mm" height = "40.201mm" ver = "01" gw = "133" gh = "97"/>
</figure>
</item>
</list1>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
