<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1G">
<servcat sctnbr = "01" scnbr = "07">
<configtype typenbr = "1">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1714008" svcinfotypenbr = "06" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
High-Pressure Fuel Supply Circuit Check
</title>
<servinfosub id = "AENLSB0A1714008001">
<title>
Troubleshooting
</title>
<attention3>
<ptxt>
Before using the following flow chart, check that battery voltage is 11 V or more.
</ptxt>
</attention3>
<diag type = "test" id = "AENLSB0A1714008002">
<testgroup id = "AENLSB0A1714008003">
<question>
Was “Low-Pressure Fuel Supply Circuit Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A1714007">Low-Pressure Fuel Supply Circuit Check:K14C</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1714008004">
<title>
Fuel line check
</title>
<test1>
<ptxt>
Check high pressure pipe, fuel delivery pipe and joint for fuel leakage, damage or deformation.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair defective part.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1714008005">
<question>
Was “High Pressure Fuel Pump and Its Circuit Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A1714005">High Pressure Fuel Pump and Its Circuit Check:K14C</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1714008006">
<question>
Was “Fuel Pressure Sensor and Its Circuit Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 5.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A1714005">High Pressure Fuel Pump and Its Circuit Check:K14C</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1714008007">
<title>
Power balance test
</title>
<test1>
<ptxt>
Check power balance. 
<intxreftitleoff1 refid = "AENLSB0A1714002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Fuel system is in good condition.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 6.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1714008008">
<title>
Fuel injector check
</title>
<test1>
<ptxt>
Check fuel injector. 
<intxreftitleoff1 refid = "AENLSB0A1716014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Check fuel injector circuit. 
<intxreftitleoff1 refid = "AENLSB0A1714003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Fuel injector is in faulty condition. Replace fuel Injector. 
<intxreftitleoff1 refid = "AENLSB0A1716013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
