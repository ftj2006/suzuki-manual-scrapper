<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1426053" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Main Bearing, Crankshaft and Cylinder Block Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1426052">Main Bearing, Crankshaft and Cylinder Block Components:K14D</intxrefpoff>
</ptxt>
<attention4>
<ptxt>
If any of the parts listed below is reinstalled into a position different from the original position, engine problems could occur.
</ptxt>
<ptxt>
If these parts are to be reused, keep them in numerical order so that they can be reinstalled in their original positions.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Main bearings
</ptxt>
</item>
<item>
<ptxt>
Thrust bearings
</ptxt>
</item>
</list1>
</attention4>
<attention3>
<ptxt>
Properly use main bearings checking their width and oil hole.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A142111.jpg" width = "88.000mm" height = "76.094mm" ver = "01" gw = "141" gh = "199"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "3.071in"/>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
“a”:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Width (wider than “b”)
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
“b”:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Width (narrower than “a”)
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
1.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Main bearing No.1 upper half with oil groove and 2 holes
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
2.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Main bearing No.1 lower half
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
3.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Main bearing No.2 – 5 upper halves with oil groove and 1 hole
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
4.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Main bearing No.2 – 5 lower halves
</ptxt>
</entry>
