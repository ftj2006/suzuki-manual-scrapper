</title>
<servinfosub id = "AENLSB0A8204051001">
<title>
DTC Detecting Condition and Trouble Area
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "5.203in"/>
<colspec colnum = "2" colname = "2" colwidth = "2.001in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
DTC detection condition
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Trouble area
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
B1095-14: Side Rear Impact Sensor Circuit Shorted to Ground (Driver Side)
</emph>
</ptxt>
<ptxt>
Driver rear side-impact G sensor circuit has been shorted to ground.
</ptxt>
</entry>
<entry colname = "2" morerows = "5" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
Driver and/or passenger rear side-impact G sensor circuit
</ptxt>
</item>
<item>
<ptxt>
Driver and/or passenger rear side-impact G sensor
</ptxt>
</item>
<item>
<ptxt>
SDM
</ptxt>
</item>
</list1>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
B1095-15: Side Rear Impact Sensor Circuit Open (Driver Side)
</emph>
</ptxt>
<ptxt>
Driver rear side-impact G sensor circuit has been shorted to power supply or opened.
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
B1095-87: Side Rear Impact Sensor Communication Data Invalid (Driver Side)
</emph>
</ptxt>
<ptxt>
Driver rear side-impact G sensor has communicated with invalid data.
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
B1096-14: Side Rear Impact Sensor Circuit Shorted to Ground (Passenger Side)
</emph>
</ptxt>
<ptxt>
Passenger rear side-impact G sensor circuit has been shorted to ground.
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
B1096-15: Side Rear Impact Sensor Circuit Open (Passenger Side)
</emph>
</ptxt>
<ptxt>
Passenger rear side-impact G sensor circuit has been shorted to power supply or opened.
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
B1096-87: Side Rear Impact Sensor Communication Data Invalid (Passenger Side)
</emph>
</ptxt>
<ptxt>
Passenger rear side-impact G sensor has communicated with invalid data.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</servinfosub>
