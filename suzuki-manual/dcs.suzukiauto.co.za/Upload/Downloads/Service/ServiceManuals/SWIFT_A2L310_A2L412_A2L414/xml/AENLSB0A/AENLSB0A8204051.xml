<servinfosub id = "AENLSB0A8204051003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A8204051004">
<testgroup id = "AENLSB0A8204051005">
<question>
Was “Air Bag Diagnostic System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204051006">
<title>
Floor harness open check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “L05” connector. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “L43” or “L44” connector. 
<intxreftitleoff1 refid = "AENLSB0A8206028"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “A1” and “A2” circuits (DTC B1095-14 / B1095-15 / B1095-87): 1 &#937; or less
</ptxt>
</item>
<item>
<ptxt>
Resistance of “A3” and “A4” circuits (DTC B1096-14 / B1096-15 / B1096-87): 1 &#937; or less
</ptxt>
<servicetool>
<servicetoolitem id = "L8B0114">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IGSB0A822089.swf" width = "90.000mm" height = "48.918mm" ver = "01" gw = "198" gh = "122"/>
</testfigure>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace floor harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204051007">
<title>
Floor harness circuit check
</title>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance between “L05-16” and “L05-17” terminals (DTC B1095-14 / B1095-15 / B1095-87): infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “L05-6” and “L05-10” terminals (DTC B1096-14 / B1096-15 / B1096-87): infinity
</ptxt>
<servicetool>
<servicetoolitem id = "L8B0115">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IGSB0A822090.swf" width = "90.000mm" height = "48.918mm" ver = "01" gw = "198" gh = "122"/>
</testfigure>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace floor harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204051008">
<title>
Floor harness circuit check
</title>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance between each of “A1” and “A2” circuits and ground (DTC B1095-14 / B1095-15 / B1095-87): infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between each of “A3” and “A4” circuits and ground (DTC B1096-14 / B1096-15 / B1096-87): infinity
</ptxt>
<servicetool>
<servicetoolitem id = "L8B0116">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IGSB0A822091.swf" width = "90.000mm" height = "46.692mm" ver = "01" gw = "199" gh = "116"/>
</testfigure>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 5.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace floor harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204051009">
<title>
Floor harness circuit check
</title>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Voltage between each of “A1” and “A2” circuits and ground (DTC B1095-14 / B1095-15 / B1095-87): 0 V
</ptxt>
</item>
<item>
<ptxt>
Voltage between each of “A3” and “A4” circuits and ground (DTC B1096-14 / B1096-15 / B1096-87): 0 V
</ptxt>
<servicetool>
<servicetoolitem id = "L8B0117">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IGSB0A822092.swf" width = "90.000mm" height = "47.209mm" ver = "01" gw = "198" gh = "117"/>
</testfigure>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 6.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace floor harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204051010">
<title>
Rear side-impact G sensor check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Replace rear side-impact G sensor. 
<intxreftitleoff1 refid = "AENLSB0A8206028"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for DTC. 
<intxreftitleoff1 refid = "AENLSB0A8204005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is DTC detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace SDM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
End.
</ptxt>
</action>
</testgroup>
</diag>
<attention3>
<ptxt>
Upon completion of inspection and repair work, perform the following items.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Reconnect all air bag system components and check that all components are properly mounted.
</ptxt>
</item>
<item>
<ptxt>
Clear DTCs, referring to 
<intxref refid = "AENLSB0A8204006">DTC Clearance</intxref>
 if any DTC is detected.
</ptxt>
</item>
<item>
<ptxt>
Repeat 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
 to check that the trouble has been solved.
</ptxt>
</item>
</list1>
</attention3>
</servinfosub>
</servinfo>
