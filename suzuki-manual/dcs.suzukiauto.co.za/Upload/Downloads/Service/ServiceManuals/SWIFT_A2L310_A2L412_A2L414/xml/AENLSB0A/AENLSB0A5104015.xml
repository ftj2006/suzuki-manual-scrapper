</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A5106018">Valve Body Assembly Removal and Installation</intxref>
</ptxt>
</action>
<condition>
<ptxt>
Lower than standard level in each range
</ptxt>
</condition>
<ps>
<ptxt>
Malfunction of pressure control solenoid valve (Low line pressure)
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A5106019">Solenoid Valve Inspection</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Faulty valve body component
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A5106018">Valve Body Assembly Removal and Installation</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Clogged oil strainer
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A5106034">A/T Oil Strainer Assembly Removal and Installation</intxref>
</ptxt>
</action>
<ps>
<ptxt>
