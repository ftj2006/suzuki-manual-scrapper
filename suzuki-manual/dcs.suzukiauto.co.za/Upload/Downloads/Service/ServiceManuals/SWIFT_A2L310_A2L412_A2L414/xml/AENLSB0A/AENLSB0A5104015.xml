<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A5104015" svcinfotypenbr = "06" svcinfoqualnbr = "01" page = "1" supplyoff = "1" modify = "0">
<title>
Line Pressure Test
</title>
<ptxt>
Purpose of this test is to check operating conditions of each part by measuring fluid pressure in fluid pressure line.
</ptxt>
<ptxt>
Line pressure test requires the following conditions.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
ATF is in proper level.
</ptxt>
</item>
<item>
<ptxt>
A/C OFF
</ptxt>
</item>
</list1>
<attention1>
<ptxt>
If you do not select a suitable route and take proper precautions when performing a road test, an accident can occur.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Select a level road with no traffic to minimize the risk of accident.
</ptxt>
</item>
<item>
<ptxt>
Perform the test extremely carefully.
</ptxt>
</item>
<item>
<ptxt>
Perform the road test with 2 persons, a driver and a tester.
</ptxt>
</item>
</list1>
</attention1>
<attention3>
<ptxt>
Limit the driving speed permissible in road conditions and regulations.
</ptxt>
</attention3>
<s1>
<ptxt>
Connect SUZUKI scan tool to DLC.
</ptxt>
</s1>
<s1>
<ptxt>
Select “Data list” mode on scan tool.
</ptxt>
</s1>
<s1>
<ptxt>
Drive vehicle so that ATF temperature reaches normal operating temperature (50 to 80 &#176;C (122 to 176 &#176;F)). 
<intxreftitleoff1 refid = "AENLSB0A5104008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<attention3>
<ptxt>
Engine coolant temperature rises when revving engine in P or N range, but ATF temperature does not rise in P or N range.
</ptxt>
<ptxt>
Drive vehicle to raise ATF temperature.
</ptxt>
</attention3>
</s1>
<s1>
<ptxt>
Hoist vehicle.
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine undercover and left side engine under side cover.
</ptxt>
</s1>
<s1>
<ptxt>
Remove applicable fluid pressure check hole bolt.
</ptxt>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
Do not remove two or more bolts at the same time.
</ptxt>
</item>
<item>
<ptxt>
Before removing fluid check hole bolt, protect vehicle from dripping oil.
</ptxt>
</item>
</list1>
</attention3>
<figure>
<graphic graphicname = "IFRA0B510007.jpg" width = "183.000mm" height = "83.891mm" ver = "01" gw = "458" gh = "221"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "6" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.968in"/>
<colspec colnum = "5" colname = "5" colwidth = "0.315in"/>
<colspec colnum = "6" colname = "6" colwidth = "1.968in"/>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
1.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Forward clutch (C1)
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
3.
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Reverse clutch (C3)
</ptxt>
</entry>
<entry colname = "5" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
5.
</ptxt>
</entry>
<entry colname = "6" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
1st and reverse brake (B2)
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
2.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Direct clutch (C2)
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
4.
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
B1 brake (B1)
</ptxt>
</entry>
<entry colname = "5" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
</ptxt>
</entry>
<entry colname = "6" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Attach oil pressure gauge to applicable fluid pressure check hole (1).
</ptxt>
<attention3>
<ptxt>
After attaching oil pressure gauge, check that no fluid leakage exists.
</ptxt>
</attention3>
<servicetool>
<servicetoolitem id = "L5A003">
<s-part>
(A)
</s-part>
<s-number num = "09925-37811-001">
09925–37811–001
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IFRA0B510008.jpg" width = "88.000mm" height = "55.699mm" ver = "01" gw = "214" gh = "141"/>
</figure>
</s1>
<s1>
<ptxt>
Start engine and run it at idle speed.
</ptxt>
</s1>
<s1>
<ptxt>
Check fluid pressure according to the following table.
</ptxt>
<attention3>
<ptxt>
Repeat test 3 times and take average of those data.
</ptxt>
</attention3>
<spec>
<title>
A/T line pressure
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "3" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "1.191in"/>
<colspec colnum = "2" colname = "2" colwidth = "3.891in"/>
<colspec colnum = "3" colname = "3" colwidth = "2.111in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
Fluid pressure check hole
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
A/T line pressure
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
Condition
</ptxt>
</entry>
</row>
</thead>
<tbody valign = "middle">
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
C1
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
180 – 420 kPa (1.9 – 4.2 kgf/cm<sup>2</sup>, 27 – 60 psi, 1.8 – 4.2 bar)
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
At idle speed in D range
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
C2
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
250 – 550 kPa (2.6 – 5.6 kgf/cm<sup>2</sup>, 37 – 79 psi, 2.5 – 5.5 bar)
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
Accelerator pedal: Released
</ptxt>
<ptxt>
Gear position: 4th
</ptxt>
<ptxt>
Select lever: D range
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
C3
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
250 – 550 kPa (2.6 – 5.6 kgf/cm<sup>2</sup>, 37 – 79 psi, 2.5 – 5.5 bar)
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
Accelerator pedal: Released
</ptxt>
<ptxt>
Gear position: 3rd
</ptxt>
<ptxt>
Select lever: D range
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
B1
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
250 – 550 kPa (2.6 – 5.6 kgf/cm<sup>2</sup>, 37 – 79 psi, 2.5 – 5.5 bar)
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
Accelerator pedal: Released
</ptxt>
<ptxt>
Gear position: 2nd
</ptxt>
<ptxt>
Select lever: D range
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
B2
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
370 – 550 kPa (3.8 – 5.6 kgf/cm<sup>2</sup>, 54 – 79 psi, 3.7 – 5.5 bar)
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
At idle speed in R range
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</s1>
<s1>
<ptxt>
Stop engine and disconnect special tool.
</ptxt>
</s1>
<s1>
<ptxt>
After applying ATF to new O-ring, fit it to fluid pressure check hole bolt (1). Then install fluid pressure check hole bolt by tightening it to specified torque.
</ptxt>
<torque>
<torqueitem id = "T5A001">
<t-part>
Fluid pressure check hole bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
7.4
</t-value1>
<t-value2>
0.75
</t-value2>
<t-value3>
5.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IFRA0B510009.jpg" width = "183.000mm" height = "83.891mm" ver = "01" gw = "458" gh = "221"/>
</figure>
</s1>
<s1>
<ptxt>
Replenish transaxle with ATF, if necessary. 
<intxreftitleoff1 refid = "AENLSB0A5106004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install engine undercover and left side engine under side cover.
</ptxt>
</s1>
<servinfosub id = "AENLSB0A5104015001" page = "1">
