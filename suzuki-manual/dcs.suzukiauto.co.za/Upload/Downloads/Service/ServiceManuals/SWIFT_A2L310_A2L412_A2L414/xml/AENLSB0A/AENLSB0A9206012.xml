<suzuki><manual>
<section sectnbr = "9B">
<servcat sctnbr = "09" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9206012" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Dome Light Removal and Installation
</title>
<servinfosub id = "AENLSB0A9206012001">
<title>
Removal
</title>
<attention3>
<ptxt>
For replacement of dome light bulb, remove dome light lens (2).
</ptxt>
</attention3>
<s1>
<ptxt>
Remove dome light (1) while releasing locks (3).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector from dome light.
</ptxt>
</s1>
<s1>
<ptxt>
Remove bulb, if necessary.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A920035.jpg" width = "88.000mm" height = "54.867mm" ver = "01" gw = "218" gh = "139"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9206012002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
