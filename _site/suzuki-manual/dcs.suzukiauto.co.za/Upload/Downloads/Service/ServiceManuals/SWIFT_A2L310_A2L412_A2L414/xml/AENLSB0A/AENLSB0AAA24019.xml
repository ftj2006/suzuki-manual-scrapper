<servinfosub id = "AENLSB0AAA24019004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0AAA24019005">
<testgroup id = "AENLSB0AAA24019006">
<question>
Was “Blind Spot Monitor System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0AAA24001">Blind Spot Monitor System Check:Blind Spot Monitor</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA24019007">
<title>
DTC check
</title>
<test1>
<ptxt>
Check DTC related to CAN communication.
</ptxt>
</test1>
<question>
Is there any CAN-DTC(s) detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to troubleshooting for applicable DTC.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA24019008">
<title>
CAN communication circuit check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “L531” and “L532” connectors.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connection to “L531” and “L532” connectors.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “A1” and “A2” circuits: less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between each of “A1” and “A2” circuits and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between each of “A1” and “A2” circuit terminals and each terminal at “L531” connector: infinity
</ptxt>
</item>
<item>
<ptxt>
Voltage of “A1” and “A2” circuits: approx. 0 V (When ignition is “ON”)
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA24019009">
<title>
Blind spot monitor control module (main) terminating resistance check
</title>
<test1>
<ptxt>
Connect “L531” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Measure resistance between “L532-4” and “L532-10” terminals of blind spot monitor control module (sub) connector.
</ptxt>
</test1>
<question>
Is resistance 114 – 134 &#937;?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace blind spot monitor control module (sub) and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0AAA26001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace blind spot monitor control module (main) and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0AAA26001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
