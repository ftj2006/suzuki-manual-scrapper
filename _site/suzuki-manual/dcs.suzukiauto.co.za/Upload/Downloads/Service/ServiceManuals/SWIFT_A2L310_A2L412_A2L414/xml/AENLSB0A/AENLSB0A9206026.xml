<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9206026" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Auto-On Headlight Sensor Inspection
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9206025">Auto-On Headlight Sensor Removal and Installation</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Connect auto-on headlight sensor connector.
</ptxt>
</s1>
<s1>
<ptxt>
Measure voltage between terminals in the following condition.
</ptxt>
<ptxt>
If measured voltage is out of specification, replace auto-on headlight sensor.
</ptxt>
<spec>
<title>
Auto-on headlight sensor voltage specifications
</title>
<ptxt>
Cover the sensor lens with hand: 0.5 V
</ptxt>
<ptxt>
Light the sensor lens with incandescent lamp 100 W: 4.1 – 4.6 V
</ptxt>
</spec>
<figure>
<graphic graphicname = "IGSB0A920057.swf" width = "88.000mm" height = "70.783mm" ver = "01" gw = "202" gh = "184"/>
</figure>
</s1>
</servinfo>
