<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9D">
<servcat sctnbr = "09" scnbr = "04">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9406003" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Windshield Wiper Motor Removal and Installation
</title>
<servinfosub id = "AENLSB0A9406003001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove wiper pivot caps (1) and wiper arm nuts (2), and remove windshield wiper arms (3).
</ptxt>
</s1>
<s1>
<ptxt>
Remove cowl top side garnishes (4) and cowl top garnish (5). 
<intxreftitleoff1 refid = "AENLSB0A9806006"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<figure>
<graphic graphicname = "IGSB0A940007.jpg" width = "88.000mm" height = "48.771mm" ver = "01" gw = "208" gh = "122"/>
</figure>
</s1>
<s1>
<ptxt>
Remove wiper motor bolts (1) and remove wiper motor (2).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect wiper motor connector (3).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A940008.jpg" width = "88.000mm" height = "45.258mm" ver = "01" gw = "214" gh = "112"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9406003002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9406004">Windshield Wiper Motor Operation Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten wiper motor bolts in numerical order (“1” – “2”) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9D002">
<t-part>
Wiper motor bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
8.3
</t-value1>
<t-value2>
0.85
</t-value2>
<t-value3>
6.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A940009.jpg" width = "88.000mm" height = "46.396mm" ver = "02" gw = "216" gh = "115"/>
</figure>
</item>
<item>
<ptxt>
Install windshield wiper arms (1) in positions shown in figure and tighten wiper arm nuts to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9D003">
<t-part>
Wiper arm nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
16
</t-value1>
<t-value2>
1.6
</t-value2>
<t-value3>
12.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A940010.swf" width = "88.000mm" height = "77.469mm" ver = "01" gw = "240" gh = "203"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "3.071in"/>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Align tip of windshield wiper blade with matchmark.
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
“a”:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
+5.0 mm (+0.20 in.)
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
2.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Matchmark
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
3.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
Windshield wiper blade
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
4.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
Wiper pivot cap
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
