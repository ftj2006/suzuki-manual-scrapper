<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1416011" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Air Bypass Valve Removal and Installation
</title>
<servinfosub id = "AENLSB0A1416011001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect air bypass valve inlet hose (1) and air bypass valve control hose No.2 (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove air bypass valve (3).
</ptxt>
<figure>
<graphic graphicname = "IFAE0A140163.swf" width = "88.000mm" height = "59.586mm" ver = "01" gw = "193" gh = "152"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1416011002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1416012">Air Bypass Valve Inspection:K14C</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
