<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1A">
<servcat sctnbr = "01" scnbr = "01">
<configtype typenbr = "1">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1114A09" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Excessive engine oil consumption – Oil leakage
</title>
<ptxt>
Perform troubleshooting referring to the following points when ECM has detected no DTC and no abnormality has been found in 
<intxref refid = "AENLSB0A1114008">Visual Inspection:K14C</intxref>
 and 
<intxref refid = "AENLSB0A1114009">Engine Basic Inspection:K14C</intxref>
.
</ptxt>
<diag type = "condition">
<condition>
<ptxt>
Excessive engine oil consumption – Oil leakage
</ptxt>
</condition>
<ps>
<ptxt>
Broken cylinder head gasket
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416043">Cylinder Head Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Leaky crankshaft pulley oil seal
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416054">Crankshaft Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Leaky crankshaft rear oil seal
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416053">Main Bearing, Crankshaft and Cylinder Block Removal and Installation:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Leaky cylinder head cover gasket
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416022">Cylinder Head Cover Components:K14C</intxref>
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
