<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106041" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
ATF Temperature Sensor Inspection
</title>
<s1>
<ptxt>
Remove solenoid harness with ATF temperature sensor. 
<intxreftitleoff1 refid = "AENLSB0A5106040"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check ATF temperature sensor resistance as follows.
</ptxt>
<s2>
<ptxt>
Warm up ATF temperature sensor (1).
</ptxt>
</s2>
<s2>
<ptxt>
Using service wire, check resistance between terminals of solenoid harness connector (2). Check that its resistance decreases as its temperature increases.
</ptxt>
<ptxt>
If measured resistance is out of specified resistance, replace solenoid harness with ATF temperature sensor.
</ptxt>
<spec>
<title>
ATF temperature sensor resistance
</title>
<ptxt>
40 &#176;C (104 &#176;F): 1.8 – 2.2 k&#937;
</ptxt>
<ptxt>
60 &#176;C (140 &#176;F): 0.9 – 1.1 k&#937;
</ptxt>
<ptxt>
80 &#176;C (176 &#176;F): 450 – 550 &#937;
</ptxt>
</spec>
<figure>
<graphic graphicname = "IEL10C510066.swf" width = "88.000mm" height = "112.512mm" ver = "03" gw = "209" gh = "302"/>
