<servinfosub id = "AENLSB0A8204037003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A8204037004">
<testgroup id = "AENLSB0A8204037005">
<question>
Was “Air Bag Diagnostic System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204037006">
<title>
Side-air bag (inflator) module check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to “Q104” or “Q105” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “Q104” or “Q105” connector. 
<intxreftitleoff1 refid = "AENLSB0A8206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Connect “STEERING WHEEL” harness (1) of special tool (C), (A) and (B) to “Q104” or “Q105” connector.
</ptxt>
<servicetool>
<servicetoolitem id = "L8B061">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
<servicetoolitem id = "L8B062">
<s-part>
(B)
</s-part>
<s-number num = "09932-78310">
09932–78310
</s-number>
</servicetoolitem>
<servicetoolitem id = "L8B063">
<s-part>
(C)
</s-part>
<s-number num = "09932-75011">
09932–75011
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IFRA0B820034.swf" width = "90.000mm" height = "70.285mm" ver = "01" gw = "209" gh = "183"/>
</testfigure>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for DTC. 
<intxreftitleoff1 refid = "AENLSB0A8204005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is DTC B1068-1B or DTC B1069-1B detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace side-air bag (inflator) module. 
<intxreftitleoff1 refid = "AENLSB0A8206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204037007">
<title>
Side-air bag (inflator) module circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to “L05” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “L05” connector. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Release shorting bar in SDM connector. 
<intxreftitleoff1 refid = "AENLSB0A8206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance between “L05-13” and “Q104-1” terminals (DTC B1068-1B): 1 &#937; or less
</ptxt>
</item>
<item>
<ptxt>
Resistance between “L05-14” and “Q104-2” terminals (DTC B1068-1B): 1 &#937; or less
</ptxt>
</item>
<item>
<ptxt>
Resistance between “L05-20” and “Q105-1” terminals (DTC B1069-1B): 1 &#937; or less
</ptxt>
</item>
<item>
<ptxt>
Resistance between “L05-19” and “Q105-2” terminals (DTC B1069-1B): 1 &#937; or less
</ptxt>
<servicetool>
<servicetoolitem id = "L8B064">
<s-part>
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace SDM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204037008">
<title>
Floor harness circuit check
</title>
<test1>
<ptxt>
Check for proper connection to “L384” or “L385” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “L384” or “L385” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Release shorting bar in SDM connector. 
<intxreftitleoff1 refid = "AENLSB0A8206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “A1” and “A2” circuits (DTC B1068-1B): 1 &#937; or less
</ptxt>
</item>
<item>
<ptxt>
Resistance of “A3” and “A4” circuits (DTC B1069-1B): 1 &#937; or less
</ptxt>
<servicetool>
<servicetoolitem id = "L8B065">
<s-part>
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace seat harness.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace floor harness. 
</ptxt>
</action>
</testgroup>
</diag>
<attention3>
<ptxt>
Upon completion of inspection and repair work, perform the following items.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Reconnect all air bag system components and check that all components are properly mounted.
</ptxt>
</item>
<item>
<ptxt>
Clear DTCs, referring to 
<intxref refid = "AENLSB0A8204006">DTC Clearance</intxref>
 if any DTC is detected.
</ptxt>
</item>
<item>
<ptxt>
Repeat 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
 to check that the trouble has been solved.
</ptxt>
</item>
</list1>
</attention3>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
