<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5B">
<servcat sctnbr = "05" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5206006" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Gear Select Control Cable Adjustment
</title>
<s1>
<ptxt>
Remove floor console box. 
<intxreftitleoff1 refid = "AENLSB0A9806020"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Move gear shift control lever (1) in neutral position of 5th – 6th gear side.
</ptxt>
</s1>
<s1>
<ptxt>
Hold gear shift control lever using gear shift control lever holding pin (2).
</ptxt>
<attention3>
<ptxt>
Use the following pin for gear shift control lever holding pin.
</ptxt>
<ptxt>
Outside diameter: 3.0 – 3.4 mm (0.12 – 0.13 in.)
</ptxt>
<ptxt>
Length: More than 70 mm (2.8 in.)
</ptxt>
</attention3>
<figure>
<graphic graphicname = "IAW101520007.swf" width = "88.000mm" height = "74.437mm" ver = "01" gw = "152" gh = "194"/>
</figure>
</s1>
<s1>
<ptxt>
Remove battery and battery tray.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0A1A16002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0A1A26002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Insert special tool between shift cable lever (1) and guide case (2).
</ptxt>
<servicetool>
<servicetoolitem id = "L5B006">
<s-part>
(A)
</s-part>
<s-number num = "09928-45710">
09928–45710
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IHSB0A523004.swf" width = "88.000mm" height = "65.344mm" ver = "02" gw = "224" gh = "169"/>
</figure>
</s1>
<s1>
<ptxt>
Shift gear shift control lever to 5th or 6th position.
</ptxt>
</s1>
<s1>
<ptxt>
Release lock plate (1) which restricts moving of cable end holder (2).
</ptxt>
</s1>
<s1>
<ptxt>
Push out cable end holder from adjuster (4) using appropriate tool (3) to disengage cable.
</ptxt>
<figure>
<graphic graphicname = "I4RS0A520004.swf" width = "88.000mm" height = "100.361mm" ver = "01" gw = "193" gh = "267"/>
</figure>
</s1>
<s1>
<ptxt>
Apply grease to pin (5) of gear shift control lever, and then install adjuster (1) into pin of gear shift control lever securely.
</ptxt>
<materials>
<materialitem name = "ECSTAR Grease A" id = "M5B003" uid = "1545785286">
<m-part>
“A”
</m-part>
<m-desc>
Grease
</m-desc>
<m-number>
99000–25480
</m-number>
<m-name>
ECSTAR Grease A
</m-name>
</materialitem>
</materials>
</s1>
<s1>
<ptxt>
Push cable end holder (2) in the direction of [a].
</ptxt>
<attention3>
<ptxt>
At this time, do not apply force to adjuster and cable end in the direction of [b].
</ptxt>
</attention3>
</s1>
<s1>
<ptxt>
Slide lock plate (3) in the direction of [c], until it is locked with the claw (4) of cable end holder.
</ptxt>
<figure>
<graphic graphicname = "IBP70A520004.swf" width = "88.000mm" height = "91.355mm" ver = "01" gw = "225" gh = "242"/>
</figure>
</s1>
<s1>
<ptxt>
Remove special tool from between shift cable lever and guide case.
</ptxt>
</s1>
<s1>
<ptxt>
Remove gear shift control lever holding pin from gear shift control lever assembly.
</ptxt>
</s1>
<s1>
<ptxt>
Install floor console box. 
<intxreftitleoff1 refid = "AENLSB0A9806020"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install battery tray and battery.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0A1A16002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0A1A26002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
