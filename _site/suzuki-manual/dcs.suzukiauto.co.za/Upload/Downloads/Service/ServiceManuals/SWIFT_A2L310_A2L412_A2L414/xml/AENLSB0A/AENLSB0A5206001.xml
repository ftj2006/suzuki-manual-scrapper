<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5B">
<servcat sctnbr = "05" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5206001" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Manual Transaxle Oil Level Check
</title>
<s1>
<ptxt>
Hoist vehicle horizontally.
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine undercover and left side engine under side cover.
</ptxt>
</s1>
<s1>
<ptxt>
Check manual transaxle for oil leakage. Repair leaky point, if any.
</ptxt>
</s1>
<s1>
<ptxt>
Remove oil level / filler plug (1) and gasket (2). Check oil contamination and check that oil level (3) reaches lower end of oil level / filler plug hole using special tool.
</ptxt>
<ptxt>
If oil is excessively dirty or insufficient, change oil or add specified oil up to plug hole.
</ptxt>
<servicetool>
<servicetoolitem id = "L5B001">
<s-part>
(A)
</s-part>
<s-number num = "09922-36310">
09922–36310
</s-number>
</servicetoolitem>
</servicetool>
</s1>
<s1>
<ptxt>
Install oil level / filler plug with new gasket, and then tighten it to specified torque.
</ptxt>
<torque>
<torqueitem id = "T5B001">
<t-part>
Transaxle oil level / filler plug
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
27
</t-value1>
<t-value2>
2.8
</t-value2>
<t-value3>
20.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IKAA0A520001.jpg" width = "88.000mm" height = "58.155mm" ver = "01" gw = "200" gh = "148"/>
</figure>
<figure>
<graphic graphicname = "IKAA0A520002.swf" width = "88.000mm" height = "40.041mm" ver = "01" gw = "131" gh = "97"/>
</figure>
</s1>
<s1>
<ptxt>
Install engine undercover and left side engine under side cover.
</ptxt>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
