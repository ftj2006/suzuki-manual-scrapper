<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9B">
<servcat sctnbr = "09" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9206006" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Rear Fog Light Removal and Installation (If Equipped)
</title>
<servinfosub id = "AENLSB0A9206006001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove screws and clips and then open lower plate (1) of rear bumper downward.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A920029.jpg" width = "88.000mm" height = "63.924mm" ver = "01" gw = "220" gh = "165"/>
</figure>
</s1>
<s1>
<ptxt>
Disconnect connector (1) and clamps (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove nuts and then remove rear fog light (3).
</ptxt>
</s1>
<s1>
<ptxt>
Turn socket (4) counterclockwise to remove bulb, if necessary.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A920030.jpg" width = "88.000mm" height = "69.344mm" ver = "01" gw = "208" gh = "180"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9206006002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
