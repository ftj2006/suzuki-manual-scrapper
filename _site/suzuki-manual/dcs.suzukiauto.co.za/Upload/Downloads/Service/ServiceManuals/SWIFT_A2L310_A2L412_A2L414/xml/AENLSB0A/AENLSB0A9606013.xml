<suzuki><manual>
<section sectnbr = "9F">
<servcat sctnbr = "09" scnbr = "06">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9606013" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Rearend Door Opener Switch On-Vehicle Inspection
</title>
<s1>
<ptxt>
Remove rearend door trim. 
<intxreftitleoff1 refid = "AENLSB0A9606010"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Detach rearend door opener switch harness clamps (1) from rearend door (2).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect rearend door opener switch connector (3).
</ptxt>
</s1>
<s1>
<ptxt>
Check continuity between terminals at each switch position.
</ptxt>
<ptxt>
If check result is not as specified, replace rearend door opener switch.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A960033.jpg" width = "88.000mm" height = "67.951mm" ver = "01" gw = "214" gh = "176"/>
</figure>
<figure>
<title>
Rearend door opener switch continuity
</title>
<graphic graphicname = "IFRA0A960023.swf" width = "88.000mm" height = "29.110mm" ver = "01" gw = "192" gh = "66"/>
</figure>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
