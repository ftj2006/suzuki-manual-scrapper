<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1316009" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
MAP Sensor Removal and Installation
</title>
<servinfosub id = "AENLSB0A1316009001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove air cleaner assembly. 
<intxreftitleoff1 refid = "AENLSB0A1416004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector from MAP sensor.
</ptxt>
</s1>
<s1>
<ptxt>
Remove MAP sensor (1) from intake manifold (2).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A134003.jpg" width = "88.000mm" height = "54.853mm" ver = "01" gw = "199" gh = "139"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1316009002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1316010">MAP Sensor Inspection:K14C</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Check that O-ring is free from damage.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
