<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1A">
<servcat sctnbr = "01" scnbr = "01">
<configtype typenbr = "1">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1114A06" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Engine noise – Crankshaft noise
</title>
<ptxt>
Perform troubleshooting referring to the following points when ECM has detected no DTC and no abnormality has been found in 
<intxref refid = "AENLSB0A1114008">Visual Inspection:K14C</intxref>
 and 
<intxref refid = "AENLSB0A1114009">Engine Basic Inspection:K14C</intxref>
.
</ptxt>
<diag type = "condition">
<condition>
<paragroup>
<ptxt>
Engine noise – Crankshaft noise
</ptxt>
<attention3>
<ptxt>
Before checking mechanical noise, check that:
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Specified spark plug is used.
</ptxt>
</item>
<item>
<ptxt>
Specified fuel is used.
</ptxt>
</item>
</list1>
</attention3>
</paragroup>
</condition>
<ps>
<ptxt>
Low oil pressure
</ptxt>
</ps>
<action>
<ptxt>
Condition “Low oil pressure”
</ptxt>
</action>
<ps>
<ptxt>
Worn main bearing
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416055">Main Bearing Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Worn crankshaft journal
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416054">Crankshaft Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Loose bearing cap bolts
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416055">Main Bearing Inspection:K14C</intxref>
</ptxt>
</action>
<ps>
<ptxt>
Excessive crankshaft thrust play
</ptxt>
</ps>
<action>
<ptxt>
<intxref refid = "AENLSB0A1416054">Crankshaft Inspection:K14C</intxref>
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
