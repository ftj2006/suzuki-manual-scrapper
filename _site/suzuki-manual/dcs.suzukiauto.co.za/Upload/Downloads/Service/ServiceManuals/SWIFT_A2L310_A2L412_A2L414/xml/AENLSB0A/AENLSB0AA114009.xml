<servinfosub id = "AENLSB0AA114009003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0AA114009004">
<testgroup id = "AENLSB0AA114009005">
<title>
Parameter check
</title>
<test1>
<ptxt>
Connect SUZUKI scan tool to DLC when ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check “Cruise CANCEL Switch”, “Cruise RES/ACC Switch”, “Cruise SET/COAST Switch” and “Cruise ON/OFF Switch” displayed on SUZUKI scan tool. 
<intxreftitleoff1 refid = "AENLSB0AA114007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Check for intermittent trouble. 
<intxreftitleoff1 refid = "AENLSB0A0006002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AA114009006">
<title>
Cruise control switch circuit check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect ECM and contact coil connectors.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connection to ECM and contact coil connectors.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “A1” and “A2” circuits: less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A1” circuit and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A1” circuit terminal and other terminals at contact coil connector: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A2” circuit terminal and other terminals at contact coil connector: infinity
</ptxt>
</item>
<item>
<ptxt>
Voltage of “A1” and “A2” circuits: approx. 0 V (When ignition is “ON”)
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AA114009007">
<title>
Contact coil circuit check
</title>
<test1>
<ptxt>
Disconnect the “S62” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance between “S62-5” terminal and “S174-5” terminal of contact coil connector: less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “S62-6” terminal and “S174-6” terminal of contact coil connector: less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “5” terminal and other terminal at “S174” connector: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “6” terminal and other terminal at “S174” connector: infinity
</ptxt>
<testfigure>
<graphic graphicname = "IGSB0AA11004.swf" width = "90.000mm" height = "63.591mm" ver = "02" gw = "214" gh = "164"/>
</testfigure>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace contact coil. 
<intxreftitleoff1 refid = "AENLSB0A6206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AA114009008">
<title>
Cruise control switch check
</title>
<test1>
<ptxt>
Check cruise control switch. 
<intxreftitleoff1 refid = "AENLSB0AA116001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck DTC.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0A1316001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0A1326001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace steering wheel. 
<intxreftitleoff1 refid = "AENLSB0A6206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
