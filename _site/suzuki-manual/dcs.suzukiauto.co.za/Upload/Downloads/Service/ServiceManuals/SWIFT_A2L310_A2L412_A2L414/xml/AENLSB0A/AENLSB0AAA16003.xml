<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "10J">
<servcat sctnbr = "10" scnbr = "10">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0AAA16003" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Print of Aiming Target
</title>
<s1>
<ptxt>
Print two sheets of aiming target to fit the size to the sample shown below.
</ptxt>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
Black part of aiming target must be tarnished.
</ptxt>
</item>
<item>
<ptxt>
Dividing line between black and white must be straight with clear contrast.
</ptxt>
</item>
<item>
<ptxt>
When printing aiming target, do not print misleading factor such as printing date etc.
</ptxt>
</item>
</list1>
</attention3>
<figure>
<title>
Aiming target
</title>
<graphic graphicname = "IGSB0AAA2048.swf" width = "88.000mm" height = "58.578mm" ver = "01" gw = "150" gh = "150"/>
</figure>
<figure>
<title>
Aiming target size
</title>
<graphic graphicname = "IGSB0AAA2049.swf" width = "88.000mm" height = "65.182mm" ver = "01" gw = "171" gh = "168"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
“a”:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
205 – 215 mm (8.07 – 8.46 in.)
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
