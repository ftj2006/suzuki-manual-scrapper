<servinfosub id = "AENLSB0AB106008002">
<title>
Adjustment
</title>
<s1>
<ptxt>
Set ignition “OFF”, connect SUZUKI scan tool to DLC.
</ptxt>
<servicetool>
<servicetoolitem id = "L11A004">
<s-part>
</s-part>
<s-number num = "NNNNN-00035">
SUZUKI scan tool (Suzuki SDT-II)
</s-number>
</servicetoolitem>
</servicetool>
</s1>
<s1>
<ptxt>
Set ignition “ON” and select “Brake Stroke Sensor Voltage” in “Data List” mode of ECM.
</ptxt>
</s1>
<s1>
<ptxt>
Loosen brake stroke sensor bolts (1).
</ptxt>
</s1>
<s1>
<ptxt>
Adjust position of brake stroke sensor until output voltage is within specified range.
</ptxt>
<spec>
<title>
Brake stroke sensor output voltage
</title>
<ptxt>
Brake pedal released: 0.40 – 1.56 V
</ptxt>
</spec>
</s1>
<s1>
<ptxt>
Tighten brake stroke sensor bolts to specified torque.
</ptxt>
<torque>
<torqueitem id = "T11A008">
<t-part>
Brake stroke sensor bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
9.0
</t-value1>
<t-value2>
0.92
</t-value2>
<t-value3>
7.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IFL10A130009.jpg" width = "88.000mm" height = "49.180mm" ver = "01" gw = "130" gh = "123"/>
</figure>
</s1>
<s1>
<ptxt>
Perform 
<intxref refid = "AENLSB0AB106009">Brake Stroke Sensor Zero Point Reset</intxref>
.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
