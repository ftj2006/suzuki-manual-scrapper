<servinfosub id = "AENLSB0A1114080003">
<title>
DTC Confirmation Procedure
</title>
<attention3>
<ptxt>
Check that the following condition is met in this “DTC Confirmation Procedure”.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
9.5 V &#60; battery voltage &#60; 16.5 V
</ptxt>
</item>
</list1>
</attention3>
<s1>
<ptxt>
Set ignition “ON”.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1114080004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A1114080005">
<testgroup id = "AENLSB0A1114080006">
<question>
Was “Engine and Emission Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A1114001">Engine and Emission Control System Check:K14C</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1114080007">
<title>
Generator LIN communication circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”, disconnect “C01” and “E01” connectors from ECM and generator connector.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connection to “C01” and “E01” connectors and generator connector.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “A1” circuit: less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A1” circuit and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A1” circuit terminal and other terminal at ECM connector: infinity
</ptxt>
</item>
<item>
<ptxt>
Voltage of “A1” circuit: approx. 0 V (When ignition is “ON”)
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A1114080008">
<title>
DTC recheck
</title>
<test1>
<ptxt>
Replace stator assembly. 
<intxreftitleoff1 refid = "AENLSB0A1A16008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Perform “DTC Confirmation Procedure” and check DTC. 
<intxreftitleoff1 refid = "AENLSB0A1114003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is DTC U2001 still detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ECM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A1316001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
End.
</ptxt>
</action>
</testgroup>
