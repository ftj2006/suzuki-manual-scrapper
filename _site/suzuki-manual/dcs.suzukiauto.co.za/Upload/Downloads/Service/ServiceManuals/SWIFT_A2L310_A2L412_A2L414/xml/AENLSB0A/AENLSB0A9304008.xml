<servinfosub id = "AENLSB0A9304008003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A9304008004">
<testgroup id = "AENLSB0A9304008005">
<title>
DTC check
</title>
<test1>
<ptxt>
Clear DTC.
</ptxt>
</test1>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check DTC.
</ptxt>
</test1>
<question>
Is DTC B1810 / B1811 still detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Check for intermittent trouble. 
<intxreftitleoff1 refid = "AENLSB0A0006002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A9304008006">
<title>
Fuel level sensor check
</title>
<test1>
<ptxt>
Check fuel level sensor.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0A1716025"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0A1726025"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace fuel level sensor and recheck DTC.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0A1716022"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0A1726022"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
</testgroup>
<testgroup id = "AENLSB0A9304008007">
<title>
Fuel level sensor circuit check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect combination meter and fuel level sensor connectors.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to combination meter and fuel level sensor terminals.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, check circuit between combination meter connector and fuel level sensor for open circuit, short to ground or short to power supply.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace combination meter and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
 
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair defective wire harness and recheck DTC.
</ptxt>
</action>
</testgroup>
</diag>
