<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "10J">
<servcat sctnbr = "10" scnbr = "10">
<configtype typenbr = "3">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0AAA36008" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Parking Sensor Buzzer Removal and Installation
</title>
<servinfosub id = "AENLSB0AAA36008001">
<title>
Removal
</title>
<s1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</s1>
<s1>
<ptxt>
Remove left side quarter lower trim. 
<intxreftitleoff1 refid = "AENLSB0A9806016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect parking sensor buzzer connector (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove parking sensor buzzer (2).
</ptxt>
<figure>
<graphic graphicname = "ILSB0AAA3017.jpg" width = "88.000mm" height = "59.848mm" ver = "01" gw = "206" gh = "153"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AAA36008002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0AAA36009">Parking Sensor Buzzer Inspection:Parking Sensor</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
