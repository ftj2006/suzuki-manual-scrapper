<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "10A">
<servcat sctnbr = "10" scnbr = "01">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0AA126005" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Millimeter Wave Radar Variant Registration
</title>
<attention3>
<ptxt>
When replacing RBS control module, perform “Variant Registration”.
</ptxt>
</attention3>
<s1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</s1>
<s1>
<ptxt>
Connect SUZUKI scan tool to DLC.
</ptxt>
</s1>
<s1>
<ptxt>
Set ignition “ON”.
</ptxt>
</s1>
<s1>
<ptxt>
Check that the vehicle meets the following conditions.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
New control module has been connected.
</ptxt>
</item>
<item>
<ptxt>
Vehicle is stationary.
</ptxt>
</item>
<item>
<ptxt>
DTC C1603 is detected.
</ptxt>
</item>
<item>
<ptxt>
DTC C1600 is not detected.
</ptxt>
</item>
<item>
<ptxt>
No failure is detected in “Communication Bus Check”.
</ptxt>
</item>
<item>
<ptxt>
Battery voltage is stable at around 10.0 V to 15.5 V
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Select “Variant Registration” under “Utility” mode.
</ptxt>
</s1>
<s1>
<ptxt>
Select “Next” in SUZUKI scan tool.
</ptxt>
</s1>
<s1>
<ptxt>
The following reasons are considered if variant cannot be registered.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
DTC C1600 is detected.
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Perform variant registration again after troubleshooting of DTC C1600.
</ptxt>
</item>
</list2>
<item>
<ptxt>
DTC C1603 is not detected.
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
The variant has been already registered.
</ptxt>
</item>
</list2>
</list1>
</s1>
<s1>
<ptxt>
After that, follow instructions displayed on SUZUKI scan tool.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Error code is not detected.
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Perform 
<intxref refid = "AENLSB0AA126002">Millimeter Wave Radar Aiming Adjustment:Adaptive Cruise Control</intxref>
.
</ptxt>
</item>
</list2>
<item>
<ptxt>
Error code is detected.
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
If error code of “2” to “4” is displayed when performing “Variant Registration”, perform the item(s) applicable to the code(s) in the following table.
</ptxt>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "3" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.433in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.445in"/>
<colspec colnum = "3" colname = "3" colwidth = "1.575in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Error code
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Detecting condition
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Procedure
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
2
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
The voltage of RBS control module is out of reference value.
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
Perform troubleshooting referring to Step 2 – 4 in Diagnosis flow: [C] of DTC C1640. 
<intxreftitleoff1 refid = "AENLSB0AA124020"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
3
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
Failed to receive CAN communication.
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
Refer to “Troubleshooting for Lost communication”.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0AA814003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0AA824003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
<ptxt>
4
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
Variant Registration is not standard.
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
Perform troubleshooting for DTC C1604. 
<intxreftitleoff1 refid = "AENLSB0AA124038"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</item>
</list2>
</list1>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
