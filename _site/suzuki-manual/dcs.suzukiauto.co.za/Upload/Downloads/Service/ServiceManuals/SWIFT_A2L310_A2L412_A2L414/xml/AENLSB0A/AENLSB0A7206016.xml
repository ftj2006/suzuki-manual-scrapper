]>
<suzuki><manual>
<section sectnbr = "7B">
<servcat sctnbr = "07" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A7206016" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Evaporator Temperature Sensor Removal and Installation
</title>
<servinfosub id = "AENLSB0A7206016001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove HVAC unit from vehicle. 
<intxreftitleoff1 refid = "AENLSB0A7206009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove evaporator temperature sensor (1) from evaporator (2) by disassembling HVAC unit.
</ptxt>
<figure>
<graphic graphicname = "I7RW01721018.swf" width = "88.000mm" height = "35.209mm" ver = "01" gw = "149" gh = "83"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A7206016002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A7206017">Evaporator Temperature Sensor Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Install evaporator temperature sensor (1) onto evaporator (2) as shown.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A722021.swf" width = "88.000mm" height = "105.618mm" ver = "01" gw = "139" gh = "283"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "3.071in"/>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
3.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
30.0 mm (1.18 in.)
</ptxt>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
4.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Holding parts fixed to 5th fin from the right
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
5.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Sensor parts fixed to 7th fin from the right
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
