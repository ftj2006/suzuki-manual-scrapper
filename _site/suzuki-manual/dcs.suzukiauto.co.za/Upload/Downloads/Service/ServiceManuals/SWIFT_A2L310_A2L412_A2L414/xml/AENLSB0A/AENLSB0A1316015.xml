<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1316015" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
ECT Sensor Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1316014">ECT Sensor On-Vehicle Inspection:K14C</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A1316015001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Drain coolant. 
<intxreftitleoff1 refid = "AENLSB0A1616004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector from ECT sensor.
</ptxt>
</s1>
<s1>
<ptxt>
Remove ECT sensor (1) from thermostat case.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A134006.jpg" width = "88.000mm" height = "54.853mm" ver = "01" gw = "199" gh = "139"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1316015002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1316016">ECT Sensor Inspection:K14C</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Clean mating surfaces of ECT sensor and thermostat case.
</ptxt>
</item>
<item>
<ptxt>
Check O-ring for damage and replace, if necessary.
</ptxt>
</item>
<item>
<ptxt>
Tighten ECT sensor (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T1C104">
<t-part>
ECT sensor
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
12
</t-value1>
<t-value2>
1.2
</t-value2>
<t-value3>
9.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IHSB0A134007.jpg" width = "88.000mm" height = "54.853mm" ver = "01" gw = "199" gh = "139"/>
</figure>
</item>
<item>
<ptxt>
Refill cooling system with coolant. 
<intxreftitleoff1 refid = "AENLSB0A1616005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Check cooling system for leakage. 
<intxreftitleoff1 refid = "AENLSB0A1616003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
