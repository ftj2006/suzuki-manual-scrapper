<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5B">
<servcat sctnbr = "05" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A5204A02" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Hard shifting
</title>
<diag type = "condition">
<condition>
<ptxt>
Hard shifting
</ptxt>
</condition>
<ps>
<ptxt>
Insufficient lubricant
</ptxt>
</ps>
<action>
<ptxt>
Add manual transaxle oil. 
<intxreftitleoff1 refid = "AENLSB0A5206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Improper clutch pedal free travel
</ptxt>
</ps>
<action>
<ptxt>
Replace clutch pedal arm and/or clutch master cylinder.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
 Clutch pedal arm: 
<intxreftitleoff1 refid = "AENLSB0A5306016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Clutch master cylinder: 
<intxreftitleoff1 refid = "AENLSB0A5306011"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Distorted or broken clutch disc
</ptxt>
</ps>
<action>
<ptxt>
Replace clutch disc. 
<intxreftitleoff1 refid = "AENLSB0A5306018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Damaged clutch pressure plate
</ptxt>
</ps>
<action>
<ptxt>
Replace clutch cover. 
<intxreftitleoff1 refid = "AENLSB0A5306018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Worn synchronizer ring
</ptxt>
</ps>
<action>
<list1 type = "unordered">
<item>
<ptxt>
1st gear synchronizer outer ring and 2nd gear synchronizer outer ring: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
3rd gear synchronizer outer ring, 4th gear synchronizer ring, 5th gear synchronizer ring and 6th gear synchronizer ring: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Worn chamfered tooth on sleeve and gear
</ptxt>
</ps>
<action>
<ptxt>
Replace synchronizer sleeve and gear.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Low speed synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
High speed synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
5th &#38; 6th gear synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Countershaft 1st gear and 2nd gear: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Input shaft 3rd gear, 4th gear, 5th gear and 6th gear: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Worn select lever bushing
</ptxt>
</ps>
<action>
<ptxt>
Replace select lever bushing. 
<intxreftitleoff1 refid = "AENLSB0A5206013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Distorted shift shaft
</ptxt>
</ps>
<action>
<ptxt>
Replace shift shaft.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Low speed gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
High speed gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
5th &#38; 6th gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Broken gear shift / select control cables
</ptxt>
</ps>
<action>
<ptxt>
Replace gear shift and select cable. 
<intxreftitleoff1 refid = "AENLSB0A5206005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
