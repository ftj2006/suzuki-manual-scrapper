<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106044" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Forward Clutch Assembly Inspection
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106030">A/T Assembly Disassembly</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106062">A/T Assembly Reassembly</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Install input shaft assembly (1) to forward clutch (2).
</ptxt>
</s1>
<s1>
<ptxt>
Install special tools to upper surface of forward clutch retaining plate (3). 
</ptxt>
<ptxt>
Blow in compressed air (200 kPa, 2.0 kgf/cm<sup>2</sup>, 29.0 psi) through oil hole (4) of input shaft and measure forward clutch piston stroke.
</ptxt>
<ptxt>
If piston stroke exceeds specified value, replace forward clutch assembly.
</ptxt>
<servicetool>
<servicetoolitem id = "L5A019">
<s-part>
(A)
</s-part>
<s-number num = "09900-20607">
09900–20607
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A020">
<s-part>
(B)
</s-part>
<s-number num = "09900-20701">
09900–20701
</s-number>
</servicetoolitem>
</servicetool>
<spec>
<title>
Forward clutch piston stroke
</title>
<ptxt>
0.8 to 1.0 mm (0.032 to 0.039 in.)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IEL10C510166.swf" width = "88.000mm" height = "121.409mm" ver = "03" gw = "238" gh = "328"/>
</figure>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
