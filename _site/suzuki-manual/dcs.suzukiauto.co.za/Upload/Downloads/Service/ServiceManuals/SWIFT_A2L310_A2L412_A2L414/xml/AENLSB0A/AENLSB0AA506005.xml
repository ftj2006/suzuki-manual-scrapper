]>
<suzuki><manual>
<section sectnbr = "10E">
<servcat sctnbr = "10" scnbr = "05">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0AA506005" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Rear Outside Antenna Removal and Installation
</title>
<servinfosub id = "AENLSB0AA506005001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove rear bumper. 
<intxreftitleoff1 refid = "AENLSB0A9806005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector (1), and then remove rear outside antenna (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0AA50019.jpg" width = "88.000mm" height = "62.811mm" ver = "01" gw = "191" gh = "162"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AA506005002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0AA506009">Antenna Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
