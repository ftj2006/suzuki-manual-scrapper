<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9E">
<servcat sctnbr = "09" scnbr = "05">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9506010" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Front Window Regulator Assembly Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9506008">Front Door Window Glass Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A9506010001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove front door glass. 
<intxreftitleoff1 refid = "AENLSB0A9506009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect power window motor connector (3).
</ptxt>
</s1>
<s1>
<ptxt>
Remove front window regulator bolts (1) and remove front window regulator (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950027.jpg" width = "88.000mm" height = "66.261mm" ver = "01" gw = "214" gh = "171"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9506010002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9506011">Front Window Regulator Assembly Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Apply grease to sliding parts of front window regulator.
</ptxt>
<materials>
<materialitem name = "ECSTAR Grease A" id = "M9E001" uid = "1545785286">
<m-part>
</m-part>
<m-desc>
Grease
</m-desc>
<m-number>
99000–25480
</m-number>
<m-name>
ECSTAR Grease A
</m-name>
</materialitem>
</materials>
</item>
<item>
<ptxt>
Tighten front window regulator nuts in numerical order (“1” – “5”) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9E003">
<t-part>
Front window regulator nut*
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
8.4
</t-value1>
<t-value2>
0.86
</t-value2>
<t-value3>
6.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A950028.jpg" width = "88.000mm" height = "72.294mm" ver = "02" gw = "190" gh = "188"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
