<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P0562: System Voltage Low
</emph>
</ptxt>
<ptxt>
Main power supply circuit voltage is lower than specified value for 20 sec.
</ptxt>
<ptxt>
(1 D/C detection logic)
</ptxt>
</entry>
<entry colname = "2" morerows = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
TCM power supply circuit and/or ground circuit
</ptxt>
</item>
<item>
<ptxt>
Charging system
</ptxt>
</item>
<item>
<ptxt>
TCM
</ptxt>
</item>
</list1>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P0563: System Voltage High
</emph>
</ptxt>
<ptxt>
Main power supply circuit voltage is higher than specified value for 60 sec.
</ptxt>
<ptxt>
(1 D/C detection logic)
</ptxt>
</entry>
</row>
