<servinfosub id = "AENLSB0A5104022003">
<title>
DTC Confirmation Procedure
</title>
<attention3>
<ptxt>
Check that the following condition is met in this “DTC Confirmation Procedure”.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
DTC U0073 or U0100 is not detected.
</ptxt>
</item>
</list1>
</attention3>
<s1>
<ptxt>
Start engine at idle for 3 minute.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5104022004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A5104022005">
<testgroup id = "AENLSB0A5104022006">
<question>
Was “A/T Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A5104001">A/T Control System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A5104022007">
<title>
TCM power supply circuit and ground circuit check
</title>
<test1>
<ptxt>
Check TCM power supply and ground circuits. 
<intxreftitleoff1 refid = "AENLSB0A5104051"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A5104022008">
<title>
TCM power supply voltage check
</title>
<test1>
<ptxt>
Check power supply voltage under the following conditions.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Ignition “ON”
</ptxt>
</item>
<item>
<ptxt>
Engine running at 3,000 rpm
</ptxt>
</item>
</list1>
</test1>
<question>
Is voltage 10 to 15 V?
</question>
<result type = "yes"/>
<action>
<ptxt>
Substitute a known-good TCM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A5106020"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Check charging system. 
<intxreftitleoff1 refid = "AENLSB0A1A14003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
