<title>
DTC P1718 / P1719
</title>
<servinfosub id = "AENLSB0A5104040001">
<title>
DTC Detecting Condition and Trouble Area
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "3.987in"/>
<colspec colnum = "2" colname = "2" colwidth = "3.203in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
DTC detecting condition
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Trouble area
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P1718: Unable To Engage Gear 1 With Engine Brake
</emph>
</ptxt>
<ptxt>
Engine brake does not work at 1st gear when driving in M range.
</ptxt>
<ptxt>
(2 D/C detection logic)
</ptxt>
</entry>
<entry colname = "2" morerows = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
Line pressure control solenoid valve
</ptxt>
</item>
<item>
<ptxt>
Pressure control solenoid valve “A”, “C” and “D”
</ptxt>
</item>
<item>
<ptxt>
Shift solenoid valve “A” and “B”
</ptxt>
</item>
<item>
<ptxt>
Valve body assembly
</ptxt>
</item>
<item>
<ptxt>
A/T (forward clutch, direct clutch, reverse clutch, B1 brake and/or 1st and reverse brake)
</ptxt>
</item>
<item>
<ptxt>
TCM
</ptxt>
</item>
</list1>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P1719: Gear 1 With Engine Brake Incorrect Ratio
</emph>
</ptxt>
<ptxt>
Engine brake does not work at 1st gear when driving in M range.
</ptxt>
<ptxt>
(2 D/C detection logic)
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
