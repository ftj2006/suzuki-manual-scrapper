<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "10J">
<servcat sctnbr = "10" scnbr = "10">
<configtype typenbr = "3">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0AAA36004" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Parking Sensor OFF Switch Removal and Installation
</title>
<servinfosub id = "AENLSB0AAA36004001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove steering column hole cover. 
<intxreftitleoff1 refid = "AENLSB0A9306002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect parking sensor OFF switch connector.
</ptxt>
</s1>
<s1>
<ptxt>
Remove parking sensor OFF switch (1) from switch bezel.
</ptxt>
<figure>
<graphic graphicname = "ILSB0AAA3018.jpg" width = "88.000mm" height = "83.791mm" ver = "01" gw = "214" gh = "221"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AAA36004002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0AAA36005">Parking Sensor OFF Switch Inspection:Parking Sensor</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
