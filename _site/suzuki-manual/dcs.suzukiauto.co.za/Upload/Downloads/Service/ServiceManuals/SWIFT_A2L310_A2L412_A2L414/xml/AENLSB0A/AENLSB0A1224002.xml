<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1B">
<servcat sctnbr = "01" scnbr = "02">
<configtype typenbr = "2">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1224002" svcinfotypenbr = "06" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
EGR Valve System Inspection
</title>
<s1>
<ptxt>
With ignition “OFF”, connect SUZUKI scan tool to DLC (1).
</ptxt>
<servicetool>
<servicetoolitem id = "L1B208">
<s-part>
(A)
</s-part>
<s-number num = "NNNNN-00035">
SUZUKI scan tool (Suzuki SDT-II)
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IGSB0A122001.swf" width = "88.000mm" height = "87.737mm" ver = "01" gw = "205" gh = "232"/>
</figure>
</s1>
<s1>
<ptxt>
Set ignition “ON” and check DTC.
</ptxt>
<ptxt>
If DTC is detected, go to troubleshooting for applicable DTC.
</ptxt>
</s1>
<s1>
<ptxt>
Warm up engine to normal operating temperature.
</ptxt>
</s1>
<s1>
<ptxt>
Select “Stepping EGR” under “Active Test” mode on SUZUKI scan tool.
</ptxt>
</s1>
<s1>
<ptxt>
Check that engine idling becomes unsteady with increasing of EGR valve open command.
</ptxt>
<ptxt>
If faulty condition is found, check the following items.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Wire harness and connections
</ptxt>
</item>
<item>
<ptxt>
EGR valve: 
<intxreftitleoff1 refid = "AENLSB0A1226015"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
EGR passage (EGR pipe and EGR cooler): 
<intxreftitleoff1 refid = "AENLSB0A1226013"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
