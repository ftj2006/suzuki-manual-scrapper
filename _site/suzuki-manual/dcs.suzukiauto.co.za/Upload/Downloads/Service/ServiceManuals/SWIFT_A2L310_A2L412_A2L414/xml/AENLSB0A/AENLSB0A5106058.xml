<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106058" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Differential Assembly Inspection
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106030">A/T Assembly Disassembly</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Hold differential assembly with soft jawed vise and set special tools as shown.
</ptxt>
<servicetool>
<servicetoolitem id = "L5A025">
<s-part>
(A)
</s-part>
<s-number num = "09900-20607">
09900–20607
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A026">
<s-part>
(B)
</s-part>
<s-number num = "09900-20701">
09900–20701
</s-number>
</servicetoolitem>
</servicetool>
</s1>
<s1>
<ptxt>
Measure differential side gear thrust play.
</ptxt>
<spec>
<title>
Differential side gear thrust play
</title>
<ptxt>
Standard: 0.05 – 0.20 mm (0.0020 – 0.0078 in.)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IEL10C510207.swf" width = "88.000mm" height = "64.888mm" ver = "01" gw = "227" gh = "167"/>
</figure>
</s1>
<s1>
<ptxt>
If check result is not as specified, replace differential assembly.
</ptxt>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
