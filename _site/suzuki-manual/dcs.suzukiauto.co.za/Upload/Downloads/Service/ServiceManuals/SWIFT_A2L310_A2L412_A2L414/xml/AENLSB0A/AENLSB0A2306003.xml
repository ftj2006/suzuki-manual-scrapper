<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "2C">
<servcat sctnbr = "02" scnbr = "03">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A2306003" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "1">
<title>
Rear Shock Absorber Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A2306002">Rear Suspension Components</intxrefpoff>
</ptxt>
<attention4>
<list1 type = "unordered">
<item>
<ptxt>
The shock absorber upper nut is self-locking nut. If the nut is reused, it may work loose.
</ptxt>
<ptxt>
Never reuse the shock absorber upper nut.
</ptxt>
</item>
<item>
<ptxt>
The shock absorber lower bolt is pre-coated with friction stabilizer. If the bolt is reused, it may work loose.
</ptxt>
<ptxt>
Never reuse the shock absorber lower bolt.
</ptxt>
</item>
</list1>
</attention4>
<servinfosub id = "AENLSB0A2306003001">
<title>
Removal
</title>
<s1>
<ptxt>
Hoist vehicle and remove rear wheel. 
<intxreftitleoff1 refid = "AENLSB0A2406001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove quarter lower trim cap (left side) and/or jack lid (right side). 
<intxreftitleoff1 refid = "AENLSB0A9806016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Support rear axle using floor jack to prevent it from lowering.
</ptxt>
</s1>
<s1>
<ptxt>
Remove rear shock absorber lower bolt (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove upper nut (2), shock absorber (3) and shock absorber upper washer (4).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A230003.jpg" width = "88.000mm" height = "97.362mm" ver = "01" gw = "171" gh = "259"/>
</figure>
</s1>
<s1>
<ptxt>
Remove shock absorber upper bushings (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A230004.jpg" width = "88.000mm" height = "83.442mm" ver = "01" gw = "199" gh = "220"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A2306003002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A2306004">Rear Shock Absorber Inspection</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Install shock absorber upper bushings (1), shock absorber (2) and shock absorber upper washer (3) as shown in figure.
</ptxt>
<ptxt>
Tighten new shock absorber upper nut (4) and new lower bolt (5) temporarily.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A230005.jpg" width = "88.000mm" height = "52.333mm" ver = "01" gw = "215" gh = "132"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" valign = "top" align = "right">
<ptxt>
6.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" valign = "top" align = "left">
<ptxt>
Body panel
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Remove floor jack from rear axle.
</ptxt>
</s1>
<s1>
<ptxt>
Install rear wheel. 
<intxreftitleoff1 refid = "AENLSB0A2406001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Lower hoist. With vehicle in unloaded condition, tighten rear shock absorber upper nut (1) and lower bolt (2) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T2C001">
<t-part>
Rear shock absorber upper nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
28
</t-value1>
<t-value2>
2.9
</t-value2>
<t-value3>
21.0
</t-value3>
</torqueitem>
<torqueitem id = "T2C002">
<t-part>
Rear shock absorber lower bolt
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
90
</t-value1>
<t-value2>
9.2
</t-value2>
<t-value3>
66.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A230006.jpg" width = "88.000mm" height = "83.504mm" ver = "01" gw = "199" gh = "220"/>
</figure>
</s1>
<s1>
<ptxt>
Check rear wheel alignment. 
<intxreftitleoff1 refid = "AENLSB0A2306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install quarter lower trim cap (left side) and/or jack lid (right side). 
<intxreftitleoff1 refid = "AENLSB0A9806016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
