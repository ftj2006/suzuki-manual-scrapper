</ptxt>
</s1>
<s1>
<ptxt>
Connect battery positive (+) terminal to terminal “4” and its negative (–) terminal to terminal “6”.
</ptxt>
</s1>
<s1>
<ptxt>
Connect voltmeter positive lead to terminal “3” and its negative lead to terminal “6”.
</ptxt>
</s1>
<s1>
<ptxt>
Connect battery negative (–) terminal to terminal “5”.
</ptxt>
</s1>
<s1>
<ptxt>
