</title>
<servinfosub id = "AENLSB0A5104035001">
<title>
DTC Detecting Condition and Trouble Area
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "4.715in"/>
<colspec colnum = "2" colname = "2" colwidth = "2.484in"/>
<thead>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
DTC detecting condition
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
Trouble area
</ptxt>
</entry>
</row>
</thead>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P0965: Pressure Control Solenoid “B” Control Circuit Range / Performance
</emph>
</ptxt>
<ptxt>
Difference between measured circuit current of pressure control solenoid valve “B” and commanded circuit current is higher than specified value.
</ptxt>
<ptxt>
(1 D/C detection logic)
</ptxt>
</entry>
<entry colname = "2" morerows = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<list1 type = "unordered">
<item>
<ptxt>
Pressure control solenoid valve “B”
</ptxt>
</item>
<item>
<ptxt>
Solenoid harness with ATF temperature sensor
</ptxt>
</item>
<item>
<ptxt>
TCM
</ptxt>
</item>
</list1>
</entry>
</row>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P0966: Pressure Control Solenoid “B” Control Circuit Low
</emph>
</ptxt>
<ptxt>
Pressure control solenoid valve “B” drive circuit is open or shorted to ground.
</ptxt>
<ptxt>
(1 D/C detection logic)
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1">
<ptxt>
<emph etype = "bold">
P0967: Pressure Control Solenoid “B” Control Circuit High
</emph>
</ptxt>
<ptxt>
Pressure control solenoid valve “B” drive circuit is shorted to power supply.
</ptxt>
<ptxt>
(1 D/C detection logic)
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</servinfosub>
