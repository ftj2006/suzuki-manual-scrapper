<suzuki><manual>
<section sectnbr = "9O">
<servcat sctnbr = "09" scnbr = "15">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9F06003" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Tweeter Removal and Installation
</title>
<servinfosub id = "AENLSB0A9F06003001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove sash bracket inner garnish (1).
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect tweeter connector (2).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A9F0008.jpg" width = "88.000mm" height = "76.193mm" ver = "01" gw = "214" gh = "199"/>
</figure>
</s1>
<s1>
<ptxt>
Remove 2 screws and remove tweeter (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9F0007.jpg" width = "88.000mm" height = "76.104mm" ver = "01" gw = "214" gh = "199"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9F06003002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
