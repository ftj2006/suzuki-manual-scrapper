<servinfosub id = "AENLSB0A8204047003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A8204047004">
<testgroup id = "AENLSB0A8204047005">
<question>
Was “Air Bag Diagnostic System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204047006">
<title>
Forward impact sensor circuit check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “G12” connector. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “G333” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Release shorting bar in SDM connector. 
<intxreftitleoff1 refid = "AENLSB0A8206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Check the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “A3” and “A4” circuits: 1 &#937; or less
</ptxt>
<servicetool>
<servicetoolitem id = "L8B090">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IGSB0A822065.swf" width = "90.000mm" height = "59.909mm" ver = "01" gw = "190" gh = "153"/>
</testfigure>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace instrument panel harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204047007">
<title>
