<suzuki><manual>
<section sectnbr = "9H">
<servcat sctnbr = "09" scnbr = "08">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9806001" svcinfotypenbr = "08" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Front Bumper Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9A06004">Front Fender Components</intxrefpoff>
</ptxt>
<attention3>
<ptxt>
After any of the following services, aim fog lights. 
<intxreftitleoff1 refid = "AENLSB0A9206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front fog light bulb replacement
</ptxt>
</item>
<item>
<ptxt>
Front fog light removal and installation
</ptxt>
</item>
</list1>
</attention3>
<servinfosub id = "AENLSB0A9806001001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove front bumper (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove front bumper front holder (6) and front bumper side holder (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove front fog light (4) if necessary (if equipped). 
<intxreftitleoff1 refid = "AENLSB0A9206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove hood lock member cover (5) if necessary.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A980001.jpg" width = "183.000mm" height = "133.218mm" ver = "03" gw = "477" gh = "354"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
3.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Front fender lining
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9806001002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9806002">Front Bumper Disassembly and Reassembly</intxrefpoff>
</ptxt>
<ptxt>
Reverse remove procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
