<suzuki><manual>
<section sectnbr = "9K">
<servcat sctnbr = "09" scnbr = "11">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9B06005" svcinfotypenbr = "08" svcinfoqualnbr = "01" supplyoff = "1" modify = "0">
<title>
Fender Apron Extension Removal and Installation (Left Side)
</title>
<attention3>
<ptxt>
The figure below shows condition where the following parts are removed.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Front fender: 
<intxreftitleoff1 refid = "AENLSB0A9A06005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Front fender bracket, front fender upper front bracket, front fender lower bracket and front fender lower bracket extension: 
<intxreftitleoff1 refid = "AENLSB0A9B06002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Cowl side outer member: 
<intxreftitleoff1 refid = "AENLSB0A9B06003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Dash side front panel: 
<intxreftitleoff1 refid = "AENLSB0A9B06004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</attention3>
<figure>
<graphic graphicname = "ILSB0A9B0008.jpg" width = "183.000mm" height = "101.166mm" ver = "01" gw = "362" gh = "270"/>
</figure>
<servinfosub id = "AENLSB0A9B06005001">
<title>
General Notes
</title>
<ptxt>
Welding method and number of welding points are the same on both sides. This repair instruction shows procedure for left side.
</ptxt>
</servinfosub>
<servinfosub id = "AENLSB0A9B06005002">
<title>
Removal
</title>
<s1>
<ptxt>
Drill out welding spots and remove apron front extension member and fender apron member.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9B0059.jpg" width = "183.000mm" height = "113.019mm" ver = "03" gw = "380" gh = "304"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Vehicle outside
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Drill out welding spots and remove apron front extension.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9B0061.jpg" width = "183.000mm" height = "175.984mm" ver = "01" gw = "380" gh = "482"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Vehicle outside
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9B06005003">
<title>
Installation
</title>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
Before conducting any weld, check installation position and condition for installation part(s). 
<intxreftitleoff1 refid = "AENLSB0A9B04004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Perform repair while taking into consideration installation of parts that affect appearance. 
<intxreftitleoff1 refid = "AENLSB0A9B04003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</attention3>
<s1>
<ptxt>
Install apron front extension patch to apron front extension.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A9B0009.jpg" width = "88.000mm" height = "74.664mm" ver = "01" gw = "158" gh = "195"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Vehicle outside
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Install apron front extension patch and apron front extension to fender apron panel.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld or plug weld.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A9B0010.jpg" width = "88.000mm" height = "57.393mm" ver = "01" gw = "183" gh = "146"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.394in"/>
<colspec colnum = "4" colname = "4" colwidth = "3.346in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Vehicle outside
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MANOTE" width = "5.132mm" height = "3.048mm"/>
:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Weld these points first before fender apron member covers the points.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Install apron front extension patch, apron front extension, apron front extension member and fender apron member to vehicle body.
</ptxt>
</s1>
<s1>
<ptxt>
Conduct resistance spot weld or plug weld.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A9B0056.jpg" width = "183.000mm" height = "175.984mm" ver = "02" gw = "380" gh = "482"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Vehicle outside
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
