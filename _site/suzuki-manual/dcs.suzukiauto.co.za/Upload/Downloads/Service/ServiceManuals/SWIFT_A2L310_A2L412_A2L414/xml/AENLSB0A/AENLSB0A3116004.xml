<graphic graphicname = "IHSB0A311014.swf" width = "88.000mm" height = "84.816mm" ver = "02" gw = "213" gh = "224"/>
</figure>
<figure>
<graphic graphicname = "IDL10A311007.swf" width = "88.000mm" height = "33.630mm" ver = "01" gw = "152" gh = "79"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
