<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106042" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Reverse Clutch Assembly Inspection
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106030">A/T Assembly Disassembly</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106062">A/T Assembly Reassembly</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Install reverse clutch assembly (1) to oil pump assembly (2).
</ptxt>
</s1>
<s1>
<ptxt>
Install special tools to upper surface of reverse clutch piston (3). Blow in air (200 kPa, 2.0 kgf/cm<sup>2</sup>, 29.0 psi) through oil hole (4) of oil pump assembly, and measure piston stroke of reverse clutch.
</ptxt>
<ptxt>
If piston stroke exceeds specified value, replace reverse clutch assembly.
</ptxt>
<servicetool>
<servicetoolitem id = "L5A015">
<s-part>
(A)
</s-part>
<s-number num = "09900-20607">
09900–20607
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5A016">
<s-part>
(B)
</s-part>
<s-number num = "09900-20701">
09900–20701
</s-number>
</servicetoolitem>
</servicetool>
<spec>
<title>
Reverse clutch piston stroke
</title>
<ptxt>
0.54 to 0.74 mm (0.022 to 0.029 in.)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IEL10C510164.swf" width = "88.000mm" height = "117.792mm" ver = "03" gw = "212" gh = "317"/>
</figure>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
