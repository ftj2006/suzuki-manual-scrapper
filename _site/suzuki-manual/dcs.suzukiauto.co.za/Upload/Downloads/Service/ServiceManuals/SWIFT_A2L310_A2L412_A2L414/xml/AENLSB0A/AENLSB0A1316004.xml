<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1C">
<servcat sctnbr = "01" scnbr = "03">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1316004" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Electric Throttle Control System Calibration
</title>
<s1>
<ptxt>
After performing any one of the following services, it is necessary to calibrate electric throttle control system.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Replacement of ECM
</ptxt>
</item>
<item>
<ptxt>
Clearance of DTC related to ECM
</ptxt>
</item>
<item>
<ptxt>
Removal and installation of electric throttle body assembly (cleaning or replacement)
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Check that the following conditions are satisfied when performing this calibration procedure.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
DTC is not detected.
</ptxt>
</item>
<item>
<ptxt>
Vehicle: Stop
</ptxt>
</item>
<item>
<ptxt>
Engine: Stationary
</ptxt>
</item>
<item>
<ptxt>
6 &#176;C (43 &#176;F) &#60; ECT &#60; 100 &#176;C (212 &#176;F)
</ptxt>
</item>
<item>
<ptxt>
IAT &#62; 6 &#176;C (43 &#176;F)
</ptxt>
</item>
<item>
<ptxt>
Accelerator pedal position: Idle position
</ptxt>
</item>
<item>
<ptxt>
Battery voltage &#62; 10 V
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Perform this calibration procedure as follows.
</ptxt>
<s2>
<ptxt>
Clear DTC. 
<intxreftitleoff1 refid = "AENLSB0A1114004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<attention3>
<ptxt>
Perform “DTC clear” although DTC is not detected.
</ptxt>
</attention3>
</s2>
<s2>
<ptxt>
Set ignition “ON” and leave it for 40 sec. or more.
</ptxt>
</s2>
<s2>
<ptxt>
Set ignition “OFF” and leave it for 10 sec. or more.
</ptxt>
</s2>
</s1>
<s1>
<ptxt>
Perform 
<intxref refid = "AENLSB0A1316005">ECM Learning Procedure of Engine Torque:K14C</intxref>
.
</ptxt>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
