<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9H">
<servcat sctnbr = "09" scnbr = "08">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9806012" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Rear Spoiler Removal and Installation
</title>
<attention3>
<ptxt>
If rear spoiler is removed once, do not reuse it.
</ptxt>
<ptxt>
Always install a new one.
</ptxt>
</attention3>
<servinfosub id = "AENLSB0A9806012001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove high mount stop light. 
<intxreftitleoff1 refid = "AENLSB0A9206011"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove rear washer nozzle with hose. 
<intxreftitleoff1 refid = "AENLSB0A9406007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove bolts (1) and nut (2).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A980007.jpg" width = "88.000mm" height = "48.587mm" ver = "01" gw = "237" gh = "121"/>
</figure>
</s1>
<s1>
<ptxt>
Remove rear spoiler (1).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A980008.jpg" width = "88.000mm" height = "85.201mm" ver = "01" gw = "239" gh = "225"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
2.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Rear spoiler pad
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
3.
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Double-stick tape
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9806012002">
<title>
Installation
</title>
<s1>
<ptxt>
Stick new rear spoiler pad (1) on rearend door panel aligning notches (2) on the pad with embosses on the door panel.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A980009.jpg" width = "88.000mm" height = "70.093mm" ver = "02" gw = "220" gh = "182"/>
</figure>
</s1>
<s1>
<ptxt>
Fix associated parts to new rear spoiler as follows.
</ptxt>
<s2>
<ptxt>
Install rear washer nozzle with hose. 
<intxreftitleoff1 refid = "AENLSB0A9406007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s2>
<s2>
<ptxt>
Install high mount stop light. 
<intxreftitleoff1 refid = "AENLSB0A9206011"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s2>
<s2>
<ptxt>
Wrap washer hose (3) and high mount stop light harness (2) at end of the protective tube with adhesive sealer (1) and press them against high mount stop light side to position the sealer as shown in figure.
</ptxt>
<figure>
<graphic graphicname = "IGSA0P920073.jpg" width = "88.000mm" height = "57.323mm" ver = "01" gw = "170" gh = "146"/>
</figure>
</s2>
<s2>
<ptxt>
Stick two pieces of adhesive sealer (1) tightly on adhesive sealer (2) as shown without making any opening.
</ptxt>
<figure>
<graphic graphicname = "IGSA0P980039.jpg" width = "88.000mm" height = "75.431mm" ver = "02" gw = "233" gh = "197"/>
</figure>
</s2>
<s2>
<ptxt>
Stick two pieces of caulking foam (1) tightly on adhesive sealer (2).
</ptxt>
<figure>
<graphic graphicname = "IGSA0P980040.jpg" width = "88.000mm" height = "61.504mm" ver = "02" gw = "228" gh = "158"/>
</figure>
</s2>
<s2>
<ptxt>
Fit rear spoiler on back door and tighten rear spoiler nut (1) and new rear spoiler bolts (2) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9H002">
<t-part>
Rear spoiler nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
5.5
</t-value1>
<t-value2>
0.56
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
<torqueitem id = "T9H003">
<t-part>
Rear spoiler bolt
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
5.0
</t-value1>
<t-value2>
0.51
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSA0P980013.jpg" width = "88.000mm" height = "48.555mm" ver = "01" gw = "237" gh = "121"/>
</figure>
</s2>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
