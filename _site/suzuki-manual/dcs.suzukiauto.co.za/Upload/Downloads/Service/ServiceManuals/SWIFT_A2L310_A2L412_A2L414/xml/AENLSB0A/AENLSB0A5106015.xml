<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106015" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Select Cable Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106014">Select Cable Components</intxrefpoff>
</ptxt>
<attention2>
<ptxt>
Touching a hot exhaust system component will cause a burn.
</ptxt>
<ptxt>
Do not perform any service work on the select cable until the exhaust system is cool.
</ptxt>
</attention2>
<servinfosub id = "AENLSB0A5106015001">
<title>
Removal
</title>
<s1>
<ptxt>
Disable air bag system. 
<intxreftitleoff1 refid = "AENLSB0A8206001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove floor console box. 
<intxreftitleoff1 refid = "AENLSB0A9806020"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove SDM. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect select cable from select lever assembly. 
<intxreftitleoff1 refid = "AENLSB0A5106008"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove clip (1) from manual select lever pin (2) and then remove casing cap (3) from select cable bracket (4).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A510039.jpg" width = "88.000mm" height = "54.937mm" ver = "01" gw = "199" gh = "139"/>
</figure>
</s1>
<s1>
<ptxt>
Remove select cable from floor tunnel.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5106015002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Apply grease to pin and cable joint. 
<intxreftitleoff1 refid = "AENLSB0A5106014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Tighten bolts and nuts to specified torque. 
<intxreftitleoff1 refid = "AENLSB0A5106014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Adjust select cable. 
<intxreftitleoff1 refid = "AENLSB0A5106016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Enable air bag system. 
<intxreftitleoff1 refid = "AENLSB0A8206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
