<suzuki><manual>
<section sectnbr = "4A">
<servcat sctnbr = "04" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A4106020" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Brake Master Cylinder Assembly Inspection
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A4106018">Brake Master Cylinder Assembly Removal and Installation</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A4106020001">
<title>
No-Load Inspection
</title>
<s1>
<ptxt>
Fit special tools to primary port (1) as shown below.
</ptxt>
<servicetool>
<servicetoolitem id = "L4A005">
<s-part>
(A)
</s-part>
<s-number num = "09918-78230">
09918–78230
</s-number>
</servicetoolitem>
<servicetoolitem id = "L4A006">
<s-part>
(B)
</s-part>
<s-number num = "09952-48010">
09952–48010
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IGSB0A410027.swf" width = "88.000mm" height = "120.483mm" ver = "01" gw = "229" gh = "325"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.181in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.575in"/>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
LHD
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
2.
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Secondary port
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[B]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
RHD
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
3.
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
Brake master cylinder assembly
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Apply pressure to brake master cylinder assembly with special tool (A) and check that pressure does not build up in cylinder.
</ptxt>
<ptxt>
If pressure builds up, brake master cylinder assembly is defective and must be replaced.
</ptxt>
</s1>
<s1>
<ptxt>
Repeat Step 1) – 2) for secondary port as well.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A4106020002">
<title>
Air Tightness Inspection
</title>
<s1>
<ptxt>
With brake master cylinder assembly (1) fixed in vise (2) as shown below, fit special tools to primary port.
</ptxt>
<attention3>
<ptxt>
When using vise, put clean cloth between brake master cylinder and vise so as not to cause damage to brake master cylinder.
</ptxt>
</attention3>
<servicetool>
<servicetoolitem id = "L4A007">
<s-part>
(A)
</s-part>
<s-number num = "09918-78230">
09918–78230
</s-number>
</servicetoolitem>
<servicetoolitem id = "L4A008">
<s-part>
(B)
</s-part>
<s-number num = "09952-48010">
09952–48010
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IGSB0A410028.swf" width = "88.000mm" height = "139.523mm" ver = "01" gw = "217" gh = "379"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.378in"/>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
LHD
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
“a”:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
50 mm (2.0 in.)
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[B]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
RHD
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Using special tool, apply pressure of 50 kPa (0.5 kgf/cm<sup>2</sup>, 7.25 psi, 0.5 bar) to brake master cylinder assembly.
</ptxt>
<ptxt>
If above pressure does not build up, brake master cylinder assembly is defective and must be replaced.
</ptxt>
</s1>
<s1>
<ptxt>
Repeat Step 1) – 2) for secondary port.
</ptxt>
</s1>
</servinfosub>
</servinfo>
</servinfotype>
