<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1D">
<servcat sctnbr = "01" scnbr = "04">
<configtype typenbr = "1">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A1414003" svcinfotypenbr = "06" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Turbocharger On-Vehicle Inspection
</title>
<s1>
<ptxt>
Warm up engine to normal operating temperature.
</ptxt>
</s1>
<s1>
<ptxt>
Stop engine after warming up.
</ptxt>
</s1>
<s1>
<ptxt>
For M/T model, place gear shift lever in “Neutral”, apply parking brake and block drive wheels.
</ptxt>
<ptxt>
For A/T model, place select lever in “P”, apply parking brake and block drive wheels.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect air bypass valve control hose No.4 (1) from check valve.
</ptxt>
</s1>
<s1>
<ptxt>
Connect special tools and a suitable hose (2) as shown in figure.
</ptxt>
<servicetool>
<servicetoolitem id = "L1D106">
<s-part>
(A)
</s-part>
<s-number num = "09915-67311">
09915–67311
</s-number>
</servicetoolitem>
<servicetoolitem id = "L1D107">
<s-part>
(B)
</s-part>
<s-number num = "09367-06002">
09367–06002
</s-number>
</servicetoolitem>
<servicetoolitem id = "L1D108">
<s-part>
(C)
</s-part>
<s-number num = "09918-08210">
09918–08210
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IHSB0A144004.swf" width = "88.000mm" height = "58.729mm" ver = "01" gw = "234" gh = "150"/>
</figure>
</s1>
<s1>
<ptxt>
Measure negative pressure under the following conditions.
</ptxt>
<ptxt>
Accelerator pedal: Depress fully for 5 seconds and release
</ptxt>
<ptxt>
Engine speed: 2,500 – 4,000 rpm or more
</ptxt>
<spec>
<title>
Negative pressure specification
</title>
<ptxt>
–76 to –70 kPa (–0.8 to –0.7 kgf/cm<sup>2</sup>, –11.0 to –10.1 psi, –0.76 to –0.70 bar)
</ptxt>
</spec>
<ptxt>
If negative pressure is out of specified range, the following causes are suspected.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Fault of waste gate valve
</ptxt>
</item>
<item>
<ptxt>
Leakage of air
</ptxt>
</item>
<item>
<ptxt>
Malfunction of turbocharger
</ptxt>
</item>
</list1>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
