<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "6A">
<servcat sctnbr = "06" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A6104A04" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Steering noise (Rattle or chuckle)
</title>
<diag type = "condition">
<condition>
<ptxt>
Steering noise (Rattle or chuckle)
</ptxt>
</condition>
<ps>
<ptxt>
Broken or damaged wheel bearing(s)
</ptxt>
</ps>
<action>
<ptxt>
Replace wheel bearing(s). 
<intxreftitleoff1 refid = "AENLSB0A3116007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Worn tie-rod end or tie-rod ball joint
</ptxt>
</ps>
<action>
<ptxt>
Replace tie-rod end or tie-rod.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tie-rod end: 
<intxreftitleoff1 refid = "AENLSB0A6206022"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Tie-rod: 
<intxreftitleoff1 refid = "AENLSB0A6206027"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Loose steering gear case bolt
</ptxt>
</ps>
<action>
<ptxt>
Tighten steering gear case bolt. 
<intxreftitleoff1 refid = "AENLSB0A6206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Improper tooth contact between rack and pinion
</ptxt>
</ps>
<action>
<ptxt>
Check pinion shaft rotation torque or replace steering gear case assembly.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Pinion shaft rotation torque: 
<intxreftitleoff1 refid = "AENLSB0A6206029"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Steering gear case assembly: 
<intxreftitleoff1 refid = "AENLSB0A6206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Faulty steering column
</ptxt>
</ps>
<action>
<ptxt>
Replace steering column assembly. 
<intxreftitleoff1 refid = "AENLSB0A6206009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Faulty steering gear case assembly
</ptxt>
</ps>
<action>
<ptxt>
Replace steering gear case assembly. 
<intxreftitleoff1 refid = "AENLSB0A6206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
