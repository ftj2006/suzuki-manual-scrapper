<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "6B">
<servcat sctnbr = "06" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A6206029" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Pinion Shaft Rotation Torque Inspection
</title>
<s1>
<ptxt>
Remove steering gear case assembly. 
<intxreftitleoff1 refid = "AENLSB0A6206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check pinion shaft rotation torque with rack position centered using special tool.
</ptxt>
<ptxt>
Check that rack as a whole moves smoothly.
</ptxt>
<ptxt>
If check result is not as specified, adjust pinion shaft rotation torque. 
<intxreftitleoff1 refid = "AENLSB0A6206030"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<servicetool>
<servicetoolitem id = "L6B007">
<s-part>
(A)
</s-part>
<s-number num = "09944-16810">
09944–16810
</s-number>
</servicetoolitem>
</servicetool>
<spec>
<title>
Rotation torque specification
</title>
<ptxt>
Average value: 0.85 – 1.35 N&#183;m (0.09 – 0.14 kgf-m, 0.65 – 1.00 lbf-ft)
</ptxt>
<ptxt>
Maximum: 2.9 N&#183;m (0.30 kgf-m, 2.5 lbf-ft)
</ptxt>
</spec>
<figure>
<graphic graphicname = "IGSB0A620022.swf" width = "88.000mm" height = "61.888mm" ver = "01" gw = "138" gh = "159"/>
</figure>
</s1>
<s1>
<ptxt>
Install steering gear case assembly. 
<intxreftitleoff1 refid = "AENLSB0A6206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
