<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1H">
<servcat sctnbr = "01" scnbr = "08">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1816003" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Ignition Coil Assembly Removal and Installation
</title>
<servinfosub id = "AENLSB0A1816003001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove air cleaner assembly. 
<intxreftitleoff1 refid = "AENLSB0A1416004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect ignition coil connectors.
</ptxt>
</s1>
<s1>
<ptxt>
Remove ignition coil bolts (1) and then pull out ignition coil assemblies (2).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A184004.jpg" width = "88.000mm" height = "56.715mm" ver = "01" gw = "199" gh = "144"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A1816003002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A1816004">Ignition Coil Assembly Inspection:K14C</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
