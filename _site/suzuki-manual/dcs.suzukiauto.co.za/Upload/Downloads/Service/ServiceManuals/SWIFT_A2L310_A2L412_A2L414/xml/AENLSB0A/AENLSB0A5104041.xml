<servinfosub id = "AENLSB0A5104041003">
<title>
DTC Confirmation Procedure
</title>
<attention3>
<ptxt>
Check that the following condition is met in this “DTC Confirmation Procedure”.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
DTC U0073 or U0100 is not detected.
</ptxt>
</item>
</list1>
</attention3>
<s1>
<ptxt>
Set ignition “ON”.
</ptxt>
</s1>
<s1>
<ptxt>
Shift select lever to R range and wait for 10 sec.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5104041004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A5104041005">
<testgroup id = "AENLSB0A5104041006">
<question>
Was “A/T Control System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A5104001">A/T Control System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A5104041007">
<title>
Back up light relay power supply circuit (coil side) check
</title>
<test1>
<ptxt>
With ignition “OFF”, remove back up light relay.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connection to back up light relay connector.
</ptxt>
</test1>
<test1>
<ptxt>
If connection is OK, set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check that voltage between “A1” and ground is battery voltage.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A5104041008">
<title>
Back up light relay check
</title>
<test1>
<ptxt>
Check back up light relay. 
<intxreftitleoff1 refid = "AENLSB0A5106021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace back up light relay.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A5104041009">
<title>
Back up light relay drive circuit check
</title>
<test1>
<ptxt>
Disconnect TCM connector.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connection to TCM connector.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “B1” circuit: less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “B1” circuit and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “B1” circuit terminal and other terminal at TCM connector: infinity
</ptxt>
</item>
<item>
<ptxt>
Voltage of “B1” circuit: approx. 0 V (When ignition is “ON”)
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Substitute a known-good TCM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A5106020"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
</diag>
