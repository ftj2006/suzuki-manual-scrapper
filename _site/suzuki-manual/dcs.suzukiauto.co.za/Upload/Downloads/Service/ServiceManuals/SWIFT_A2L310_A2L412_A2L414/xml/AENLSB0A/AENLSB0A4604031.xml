<servinfosub id = "AENLSB0A4604031003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A4604031004">
<testgroup id = "AENLSB0A4604031005">
<question>
Was “ESP<sup>&#174;</sup> System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A4604001">ESP&#174; System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A4604031006">
<title>
Pump motor power supply circuit and ESP&#174; control module ground circuit check
</title>
<test1>
<ptxt>
Check pump motor power supply circuit and ESP<sup>&#174;</sup> control module ground circuits. 
<intxreftitleoff1 refid = "AENLSB0A4604051"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace ESP<sup>&#174;</sup> hydraulic unit / control module assembly and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A4606005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
</diag>
