<suzuki><manual>
<section sectnbr = "11A">
<servcat sctnbr = "11" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0AB104003" svcinfotypenbr = "06" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
ENG A-STOP Warning Light Check
</title>
<s1 page = "2">
<ptxt>
Set ignition “ON”.
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Check that ENG A-STOP warning light lights for about 2 sec. and then goes OFF. If anything faulty is found, refer to 
<intxref refid = "AENLSB0AB104010">ENG A-STOP Warning Light Does Not Come ON with Ignition “ON” and Engine Stopped (but Engine Can Be Started)</intxref>
 or 
<intxref refid = "AENLSB0AB104011">ENG A-STOP Warning Light Remains ON or Blinking with Ignition “ON”</intxref>
.
</ptxt>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
