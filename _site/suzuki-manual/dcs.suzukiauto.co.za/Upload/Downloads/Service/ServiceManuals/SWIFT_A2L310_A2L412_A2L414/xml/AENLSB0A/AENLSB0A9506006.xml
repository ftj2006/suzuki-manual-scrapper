<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9E">
<servcat sctnbr = "09" scnbr = "05">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9506006" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Rear Defogger Switch Inspection
</title>
<s1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</s1>
<s1>
<ptxt>
Connect SUZUKI scan tool to DLC (1).
</ptxt>
<servicetool>
<servicetoolitem id = "L9E001">
<s-part>
(A)
</s-part>
<s-number num = "NNNNN-00035">
SUZUKI scan tool (Suzuki SDT-II)
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IGSB0A460024.swf" width = "88.000mm" height = "87.737mm" ver = "01" gw = "205" gh = "232"/>
</figure>
</s1>
<s1>
<ptxt>
Set ignition “ON”, and select “Data List” on SUZUKI scan tool.
</ptxt>
</s1>
<s1>
<ptxt>
Check that “Rear defogger” displayed on SUZUKI scan tool is switched between ON and OFF as rear defogger switch is pressed.
</ptxt>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
