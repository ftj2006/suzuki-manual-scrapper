<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5A">
<servcat sctnbr = "05" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5106038" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Input Shaft Speed Sensor Removal and Installation
</title>
<servinfosub id = "AENLSB0A5106038001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove valve body assembly. 
<intxreftitleoff1 refid = "AENLSB0A5106018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect input shaft speed sensor connector (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove input shaft speed sensor (2).
</ptxt>
<figure>
<graphic graphicname = "IEL10C510309.swf" width = "88.000mm" height = "59.533mm" ver = "02" gw = "145" gh = "152"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5106038002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5106039">Input Shaft Speed Sensor Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten input shaft speed sensor bolt (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T5A020">
<t-part>
Input shaft speed sensor bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
5.4
</t-value1>
<t-value2>
0.55
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IEL10C510310.swf" width = "88.000mm" height = "59.532mm" ver = "02" gw = "145" gh = "152"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
