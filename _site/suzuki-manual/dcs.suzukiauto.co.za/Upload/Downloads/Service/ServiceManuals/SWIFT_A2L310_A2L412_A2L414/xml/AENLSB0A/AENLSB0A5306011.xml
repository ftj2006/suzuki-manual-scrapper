<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5C">
<servcat sctnbr = "05" scnbr = "03">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5306011" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Clutch Master Cylinder Removal and Installation
</title>
<servinfosub id = "AENLSB0A5306011001" page = "2">
<title>
Removal
</title>
<s1 page = "2">
<ptxt>
Clean around brake master cylinder reservoir cap and take out fluid from brake master cylinder reservoir with syringe or the like.
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Disconnect clutch fluid pipe from clutch master cylinder. 
<intxreftitleoff1 refid = "AENLSB0A5306009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1 page = "2">
<ptxt>
Disconnect clutch reservoir hose (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A530011.jpg" width = "88.000mm" height = "49.858mm" ver = "01" gw = "199" gh = "125"/>
</figure>
</s1>
<s1>
<ptxt>
Remove clutch pedal assembly. 
<intxreftitleoff1 refid = "AENLSB0A5306016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove clutch master cylinder.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5306011002" page = "2">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5306012">Clutch Master Cylinder Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Apply grease to push rod tip.
</ptxt>
<materials>
<materialitem name = "SUZUKI Silicone Grease" id = "M5C001" uid = "21">
<m-part>
“A”
</m-part>
<m-desc>
Grease
</m-desc>
<m-number>
99000–25100
</m-number>
<m-name>
SUZUKI Silicone Grease
</m-name>
</materialitem>
</materials>
<figure>
<graphic graphicname = "IGSB0A530019.jpg" width = "88.000mm" height = "44.100mm" ver = "01" gw = "180" gh = "108"/>
</figure>
</item>
<item>
<ptxt>
Connect clutch reservoir hose (1) aligning matchmark (2) on the hose end with matchmark (4) on brake reservoir tank (3).
</ptxt>
</item>
<item>
<ptxt>
For RHD model, connect clutch reservoir hose aligning matchmarks (5) on the hose ends with matchmarks (6) on clutch master cylinder (7).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A530007.jpg" width = "88.000mm" height = "81.726mm" ver = "03" gw = "199" gh = "245"/>
</figure>
</item>
<item>
<ptxt>
Set each clamp securely.
</ptxt>
</item>
<item>
<ptxt>
After installation, bleed air from clutch system. 
<intxreftitleoff1 refid = "AENLSB0A5306007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
After installation, check clutch pedal free travel. 
<intxreftitleoff1 refid = "AENLSB0A5306005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
