<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "1F">
<servcat sctnbr = "01" scnbr = "06">
<configtype typenbr = "1">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1616004" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Cooling System Draining
</title>
<ptxt>
Before performing the following procedure, observe 
<intxref refid = "AENLSB0A1610001">Precautions for Cooling System:K14C</intxref>
.
</ptxt>
<s1>
<ptxt>
Remove radiator cap.
</ptxt>
</s1>
<s1>
<ptxt>
Hoist vehicle and remove engine undercover.
</ptxt>
</s1>
<s1>
<ptxt>
Drain coolant from drain plug (1).
</ptxt>
</s1>
<s1>
<ptxt>
Tighten drain plug securely.
</ptxt>
<attention4>
<ptxt>
If drain plug is tightened excessively, the plug could be damaged.
</ptxt>
<ptxt>
Do not tighten the drain plug too much.
</ptxt>
</attention4>
<torque>
<torqueitem id = "T1F101">
<t-part>
Drain plug (reference torque)
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
1.0
</t-value1>
<t-value2>
0.10
</t-value2>
<t-value3>
1.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IHSB0A164007.jpg" width = "88.000mm" height = "53.837mm" ver = "02" gw = "199" gh = "136"/>
</figure>
</s1>
<s1>
<ptxt>
Install engine undercover.
</ptxt>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
