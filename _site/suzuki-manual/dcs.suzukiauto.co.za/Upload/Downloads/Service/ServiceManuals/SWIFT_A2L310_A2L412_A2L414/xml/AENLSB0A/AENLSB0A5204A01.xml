<?xml version="1.0" encoding="utf-8" ?>
<?xml-stylesheet type="text/xsl" href="..\config8\suzuki.xsl" ?>
<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5B">
<servcat sctnbr = "05" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "4">
<servinfo servinfosgmlid = "AENLSB0A5204A01" svcinfotypenbr = "06" svcinfoqualnbr = "03">
<title>
Gears slipping out of mesh
</title>
<diag type = "condition">
<condition>
<ptxt>
Gears slipping out of mesh
</ptxt>
</condition>
<ps>
<ptxt>
Worn shift shaft
</ptxt>
</ps>
<action>
<ptxt>
Replace shift shaft.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Low speed gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
High speed gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
5th &#38; 6th gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Worn shift fork or synchronizer sleeve
</ptxt>
</ps>
<action>
<ptxt>
Replace shift fork (shift shaft) or synchronizer sleeve.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Low speed gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
High speed gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
5th &#38; 6th gear shift shaft: 
<intxreftitleoff1 refid = "AENLSB0A5206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Low speed synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
High speed synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
5th &#38; 6th gear synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</action>
<ps>
<ptxt>
Weak or damaged gear locating spring
</ptxt>
</ps>
<action>
<ptxt>
Replace gear locating spring. 
<intxreftitleoff1 refid = "AENLSB0A5206014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<ps>
<ptxt>
Worn bearings on input shaft or countershaft
</ptxt>
</ps>
<action>
<ptxt>
Replace input shaft bearing or countershaft bearing.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Input shaft left bearing and right bearing: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Countershaft left bearing
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Inner race: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Outer race: 
<intxreftitleoff1 refid = "AENLSB0A5206019"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
<item>
<ptxt>
Countershaft right bearing
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Inner race: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Outer race: 
<intxreftitleoff1 refid = "AENLSB0A5206018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list2>
</list1>
</action>
<ps>
<ptxt>
Worn chamfered tooth on sleeve and gear
</ptxt>
</ps>
<action>
<ptxt>
Replace synchronizer sleeve and gear.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Low speed synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
High speed synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
 
</ptxt>
</item>
<item>
<ptxt>
5th &#38; 6th gear synchronizer sleeve &#38; hub: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
 
</ptxt>
</item>
<item>
<ptxt>
Countershaft 1st gear and 2nd gear: 
<intxreftitleoff1 refid = "AENLSB0A5206024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Input shaft 3rd gear, 4th gear, 5th gear and 6th gear: 
<intxreftitleoff1 refid = "AENLSB0A5206021"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
 
</ptxt>
</item>
</list1>
</action>
</diag>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
