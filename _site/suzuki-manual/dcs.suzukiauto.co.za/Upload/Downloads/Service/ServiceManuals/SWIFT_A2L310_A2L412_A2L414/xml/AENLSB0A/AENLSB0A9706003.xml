<suzuki><manual>
<section sectnbr = "9G">
<servcat sctnbr = "09" scnbr = "07">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9706003" svcinfotypenbr = "08" svcinfoqualnbr = "02" supplyoff = "1" modify = "0">
<title>
Front Seatback and Front Seat Cushion Disassembly and Reassembly
</title>
<servinfosub id = "AENLSB0A9706003001">
<title>
Disassembly
</title>
<s1>
<ptxt>
Remove front seat. 
<intxreftitleoff1 refid = "AENLSB0A9706002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove side-air bag outer bracket (6).
</ptxt>
</s1>
<s1>
<ptxt>
Remove front seatback pad (1) and front seatback trim (2) from front seatback frame (3) if necessary.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect side-air bag (inflator) module connector (8). 
<intxreftitleoff1 refid = "AENLSB0A8206017"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove side-air bag (inflator) module (7) from front seatback frame. 
<intxreftitleoff1 refid = "AENLSB0A8206016"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove seatback heater (5).
</ptxt>
<figure>
<graphic graphicname = "ILSB0A970003.jpg" width = "183.000mm" height = "68.919mm" ver = "01" gw = "466" gh = "179"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.968in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.394in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.968in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
4.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Trim ring
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MADONOT" width = "5.132mm" height = "3.048mm"/>
:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Do not reuse.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Remove front seat cushion pad (1) and front seat cushion trim (2) from front seat cushion frame (3).
</ptxt>
</s1>
<s1>
<ptxt>
Remove seat cushion heater (9) (if equipped) from front seat cushion pad.
</ptxt>
</s1>
<s1>
<ptxt>
Remove front seat adjuster handle (4) from front seat cushion frame as follows.
</ptxt>
<s2>
<ptxt>
Release lock (10) by pushing it using a flat-bladed screwdriver (11) in arrow direction at each of inside and outside adjusters.
</ptxt>
</s2>
<s2>
<ptxt>
Pull out front seat adjuster handle.
</ptxt>
</s2>
</s1>
<s1>
<ptxt>
Remove riser nuts (8), and remove front inside adjuster (5) and front outside adjuster (6) from front seat cushion frame.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A970004.jpg" width = "183.000mm" height = "145.459mm" ver = "02" gw = "360" gh = "396"/>
<callout-l>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.772in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.394in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.772in"/>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
Right side
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
7.
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
Trim ring
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[B]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
Left side
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
<symbol name = "MADONOT" width = "5.132mm" height = "3.048mm"/>
:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1">
<ptxt>
Do not reuse.
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout-l>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9706003002" page = "2">
<title>
Reassembly
</title>
<ptxt>
Reverse disassembly procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten side-sir bag outer bracket nut and side-air bag (inflator) module nuts to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9G002">
<t-part>
Side-air bag outer bracket nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
5.5
</t-value1>
<t-value2>
0.56
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
<torqueitem id = "T9G003">
<t-part>
Side-air bag (inflator) module nut
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
5.5
</t-value1>
<t-value2>
0.56
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "ILSB0A970005.jpg" width = "88.000mm" height = "65.250mm" ver = "01" gw = "153" gh = "168"/>
</figure>
</item>
<item>
<ptxt>
Tighten riser nuts in numerical order (“1” – “4”) as shown in figure.
</ptxt>
</item>
<item>
<ptxt>
Tighten riser nuts to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9G004">
<t-part>
Riser nut
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
28
</t-value1>
<t-value2>
2.9
</t-value2>
<t-value3>
21.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A970017.jpg" width = "88.000mm" height = "96.140mm" ver = "01" gw = "215" gh = "256"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[A]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Right side
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[B]:
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Left side
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
