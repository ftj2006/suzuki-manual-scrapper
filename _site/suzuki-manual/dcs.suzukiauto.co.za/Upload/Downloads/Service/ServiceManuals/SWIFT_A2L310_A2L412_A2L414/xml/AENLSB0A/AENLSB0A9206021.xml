<suzuki><manual>
<section sectnbr = "9B">
<servcat sctnbr = "09" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9206021" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Hazard Warning Switch Removal and Installation
</title>
<servinfosub id = "AENLSB0A9206021001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove instrument panel upper garnish. 
<intxreftitleoff1 refid = "AENLSB0A9306003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove hazard warning switch (2) from instrument panel upper garnish (1) while releasing locks (3).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A920055.jpg" width = "88.000mm" height = "66.663mm" ver = "01" gw = "221" gh = "172"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9206021002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9206022">Hazard Warning Switch Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
