</ptxt>
</item>
<item>
<ptxt>
TCM (including transmission range sensor) (A/T model)
</ptxt>
</item>
<item>
<ptxt>
BCM
</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
