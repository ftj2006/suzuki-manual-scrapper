]>
<suzuki><manual>
<section sectnbr = "7B">
<servcat sctnbr = "07" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A7206026" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Air Intake Control Actuator Removal and Installation
</title>
<servinfosub id = "AENLSB0A7206026001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove glove box.
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect air intake control actuator connector.
</ptxt>
</s1>
<s1>
<ptxt>
Remove air intake control actuator (1) by removing screws (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A723019.jpg" width = "88.000mm" height = "57.393mm" ver = "01" gw = "185" gh = "146"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A7206026002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A7206027">Air Intake Control Actuator Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Check that protrusion (1) on air intake control actuator fits into corresponding hole (2) on HVAC unit respectively.
</ptxt>
</item>
<item>
<ptxt>
Check that protrusion (3) on HVAC unit fits into hole (4) on air intake control actuator.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A723020.swf" width = "88.000mm" height = "62.476mm" ver = "01" gw = "190" gh = "161"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
