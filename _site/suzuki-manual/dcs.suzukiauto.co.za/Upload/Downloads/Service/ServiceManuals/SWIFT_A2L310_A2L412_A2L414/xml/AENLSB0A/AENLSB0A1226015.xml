<suzuki><manual>
<section sectnbr = "1B">
<servcat sctnbr = "01" scnbr = "02">
<configtype typenbr = "2">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A1226015" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
EGR Valve Inspection
</title>
<s1>
<ptxt>
Remove EGR valve. 
<intxreftitleoff1 refid = "AENLSB0A1226014"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Check the following points.
</ptxt>
<ptxt>
If faulty condition is found, replace EGR valve (1).
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Check EGR passage (2) for clogging.
</ptxt>
</item>
<item>
<ptxt>
Measure resistance between terminals of EGR valve connector (3) shown in the following table.
</ptxt>
<spec>
<title>
EGR valve resistance
</title>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
