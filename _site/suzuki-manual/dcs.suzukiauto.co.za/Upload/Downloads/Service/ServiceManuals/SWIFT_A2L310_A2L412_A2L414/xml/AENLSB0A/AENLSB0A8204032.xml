<servinfosub id = "AENLSB0A8204032003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0A8204032004">
<testgroup id = "AENLSB0A8204032005">
<question>
Was “Air Bag Diagnostic System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204032006">
<title>
Seat belt pretensioner check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “L283” or “L285” connector. 
<intxreftitleoff1 refid = "AENLSB0A8206011"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Connect “STEERING WHEEL” harness (1) of special tool (C), (A) and (B) to “L283” or “L285” connector.
</ptxt>
<servicetool>
<servicetoolitem id = "L8B044">
<s-part>
(A)
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
<servicetoolitem id = "L8B045">
<s-part>
(B)
</s-part>
<s-number num = "09932-78310">
09932–78310
</s-number>
</servicetoolitem>
<servicetoolitem id = "L8B046">
<s-part>
(C)
</s-part>
<s-number num = "09932-75011">
09932–75011
</s-number>
</servicetoolitem>
</servicetool>
<testfigure>
<graphic graphicname = "IGSB0A822042.jpg" width = "90.000mm" height = "66.224mm" ver = "01" gw = "185" gh = "171"/>
</testfigure>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for DTC. 
<intxreftitleoff1 refid = "AENLSB0A8204005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is DTC B1064-1A or DTC B1065-1A detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace front seat belt pretensioner. 
<intxreftitleoff1 refid = "AENLSB0A8106002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0A8204032007">
<title>
Seat belt pretensioner circuit check
</title>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper connection to “L05” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “L05” connector. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Release shorting bar in SDM connector. 
<intxreftitleoff1 refid = "AENLSB0A8206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance between “L05-11” and “L05-12” terminals (DTC B1064-1A): infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “L05-2” and “L05-3” terminals (DTC B1065-1A): infinity
</ptxt>
<servicetool>
<servicetoolitem id = "L8B047">
<s-part>
</s-part>
<s-number num = "09932-76010">
09932–76010
</s-number>
</servicetoolitem>
</servicetool>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace SDM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0A8206004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace floor harness.
</ptxt>
</action>
</testgroup>
</diag>
<attention3>
<ptxt>
Upon completion of inspection and repair work, perform the following items.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Reconnect all air bag system components and check that all components are properly mounted.
</ptxt>
</item>
<item>
<ptxt>
Clear DTCs, referring to 
<intxref refid = "AENLSB0A8204006">DTC Clearance</intxref>
 if any DTC is detected.
</ptxt>
</item>
<item>
<ptxt>
Repeat 
<intxref refid = "AENLSB0A8204001">Air Bag Diagnostic System Check</intxref>
 to check that the trouble has been solved.
</ptxt>
</item>
</list1>
</attention3>
</servinfosub>
