]>
<suzuki><manual>
<section sectnbr = "9E">
<servcat sctnbr = "09" scnbr = "05">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9506013" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Rear Door Glass Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9506012">Rear Door Window Glass Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A9506013001">
<title>
Removal
</title>
<s1>
<ptxt>
Lower rear door glass fully.
</ptxt>
</s1>
<s1>
<ptxt>
For rear power window type, disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
Remove inside handle cap (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove rear door inner garnish (4).
</ptxt>
</s1>
<s1>
<ptxt>
Remove side door inside pull case cap (5) and screws (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove door trim (3) by pulling it in arrow direction.
</ptxt>
</s1>
<s1>
<ptxt>
For power window type, disconnect door harness connectors.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950033.jpg" width = "88.000mm" height = "90.435mm" ver = "01" gw = "183" gh = "240"/>
</figure>
</s1>
<s1>
<ptxt>
Remove rear door outer weather-strip (1) by moving it in arrow directions in numerical order (“1” – “2”) as shown in figure.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950034.jpg" width = "88.000mm" height = "114.318mm" ver = "01" gw = "196" gh = "308"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.378in"/>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" valign = "top" align = "right">
<ptxt>
2.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" valign = "top" align = "left">
<ptxt>
Claw
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" valign = "top" align = "right">
<ptxt>
4.
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" valign = "top" align = "left">
<ptxt>
Hole
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" valign = "top" align = "right">
<ptxt>
3.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" valign = "top" align = "left">
<ptxt>
Rear door outer panel
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" valign = "top" align = "right">
<ptxt>
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" valign = "top" align = "left">
<ptxt>
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Remove rear door inner weather-strip (1) by pulling it in arrow direction in numerical order (“1” – “2”) as shown in figure.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950035.jpg" width = "88.000mm" height = "76.782mm" ver = "01" gw = "178" gh = "201"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" valign = "top" align = "right">
<ptxt>
2.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" valign = "top" align = "left">
<ptxt>
Rear door inner panel
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Remove door trim bracket (1) and door sealing cover No.1 (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove door sealing cover No.2 (3).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950037.jpg" width = "88.000mm" height = "75.173mm" ver = "01" gw = "171" gh = "197"/>
</figure>
</s1>
<s1>
<ptxt>
Remove glass run (1).
</ptxt>
</s1>
<s1>
<ptxt>
Remove rear door sash bolts (2) and remove rear door sash (3).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950038.jpg" width = "88.000mm" height = "74.580mm" ver = "01" gw = "195" gh = "195"/>
</figure>
</s1>
<s1>
<ptxt>
Turn rear door glass (1) with glass bottom channel (3) in arrow direction “1” to disconnect the bottom channel from rear window regulator (2) and then remove rear door glass in arrow direction “2”.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950039.jpg" width = "88.000mm" height = "92.330mm" ver = "01" gw = "164" gh = "245"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9506013002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Insert rear door glass (1) with glass bottom channel (3) in arrow direction “1”, turn them in arrow direction “2”, move glass bottom channel in arrow direction “3” and connect the bottom channel to rear window regulator (2).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950040.jpg" width = "88.000mm" height = "92.765mm" ver = "01" gw = "182" gh = "246"/>
</figure>
</item>
<item>
<ptxt>
Tighten rear door sash bolts in numerical order (“1” – “3”) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9E004">
<t-part>
Rear door sash bolt*
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
5.5
</t-value1>
<t-value2>
0.56
</t-value2>
<t-value3>
4.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A950041.jpg" width = "88.000mm" height = "74.580mm" ver = "01" gw = "194" gh = "195"/>
</figure>
</item>
<item>
<ptxt>
If glass run is deformed, replace it with new one.
</ptxt>
</item>
<item>
<ptxt>
Fix door sealing cover No.1 (1) and door sealing cover (2) with butyl tape (3).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A950043.jpg" width = "88.000mm" height = "77.137mm" ver = "01" gw = "166" gh = "202"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
