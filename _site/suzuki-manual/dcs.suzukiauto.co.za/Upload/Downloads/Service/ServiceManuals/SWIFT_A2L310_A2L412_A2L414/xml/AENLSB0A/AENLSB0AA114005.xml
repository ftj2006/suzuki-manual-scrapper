<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
Cruise Control Input Circuit
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle">
<ptxt>
This DTC is detected if any one of the following conditions is met.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Signal voltage of cruise control switch signal circuit is higher than specified voltage for specified time continuously.
</ptxt>
</item>
<item>
<ptxt>
ON signals of any or all of the following switches of cruise control system are detected for longer than specified time.
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
CRUISE (main) switch
</ptxt>
</item>
<item>
<ptxt>
CANCEL switch
</ptxt>
</item>
<item>
<ptxt>
RES/+ switch
</ptxt>
</item>
<item>
<ptxt>
SET/– switch
</ptxt>
</item>
</list2>
</list1>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "1" valign = "middle" align = "center">
