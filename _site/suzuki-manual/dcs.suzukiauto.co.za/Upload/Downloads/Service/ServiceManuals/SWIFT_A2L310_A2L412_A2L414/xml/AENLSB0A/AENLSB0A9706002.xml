<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9G">
<servcat sctnbr = "09" scnbr = "07">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9706002" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Front Seat Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9706001">Front Seat Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A9706002001">
<title>
Removal
</title>
<s1>
<ptxt>
Disable air bag system. 
<intxreftitleoff1 refid = "AENLSB0A8206001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect connector from front seat.
</ptxt>
</s1>
<s1>
<ptxt>
Remove 4 mounting bolts (2), and remove front seat assembly (1).
</ptxt>
<figure>
<graphic graphicname = "IGSB0A970005.jpg" width = "88.000mm" height = "70.950mm" ver = "01" gw = "214" gh = "185"/>
</figure>
</s1>
<s1>
<ptxt>
Disassemble and repair parts if necessary. 
<intxreftitleoff1 refid = "AENLSB0A9706001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<ptxt>
For removal of reclining knob (1), perform the following steps.
</ptxt>
<s2>
<ptxt>
Hold the knob at a distance of 10 mm (0.39 in.) from the tip and hold the rear of the knob by hand.
</ptxt>
</s2>
<s2>
<ptxt>
Approach the knob from the front side as shown in the figure.
</ptxt>
<figure>
<graphic graphicname = "IGJC0A970014.jpg" width = "88.000mm" height = "46.650mm" ver = "01" gw = "206" gh = "116"/>
</figure>
</s2>
<s2>
<ptxt>
Pull the tip of the knob slowly for 10 sec in the outward direction and take off the front side fixed portion.
</ptxt>
</s2>
<s2>
<ptxt>
After take off from front side fixed portion, pull rear end of the lever and take off rear side fixed portion as shown in figure.
</ptxt>
<figure>
<graphic graphicname = "IGJC0A970016.jpg" width = "88.000mm" height = "49.932mm" ver = "01" gw = "165" gh = "125"/>
</figure>
</s2>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9706002002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten front seat mounting bolts in numerical order (“1” – “4”) as shown in figure.
</ptxt>
</item>
<item>
<ptxt>
Tighten front seat mounting bolts to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9G001">
<t-part>
Front seat mounting bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
23
</t-value1>
<t-value2>
2.3
</t-value2>
<t-value3>
17.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A970006.jpg" width = "88.000mm" height = "67.637mm" ver = "01" gw = "214" gh = "175"/>
</figure>
</item>
<item>
<ptxt>
Put the reclining knob fixed portion in bracket (1).
</ptxt>
<figure>
<graphic graphicname = "IGJC0A970017.jpg" width = "88.000mm" height = "64.461mm" ver = "01" gw = "234" gh = "166"/>
</figure>
</item>
<item>
<ptxt>
Push around rear and front side fixed portion until click.
</ptxt>
<figure>
<graphic graphicname = "IGJC0A970018.jpg" width = "88.000mm" height = "68.591mm" ver = "01" gw = "237" gh = "178"/>
</figure>
</item>
<item>
<ptxt>
Shake the knob 5 times and check.
</ptxt>
</item>
<item>
<ptxt>
Enable air bag system. 
<intxreftitleoff1 refid = "AENLSB0A8206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
