<suzuki><manual>
<section sectnbr = "7B">
<servcat sctnbr = "07" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A7206038" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
HVAC Air Filter Removal and Installation
</title>
<servinfosub id = "AENLSB0A7206038001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove glove box.
</ptxt>
</s1>
<s1>
<ptxt>
Remove HVAC air filter cover (1) from HVAC unit.
</ptxt>
</s1>
<s1>
<ptxt>
Remove air filter (2) from HVAC unit.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A721025.swf" width = "88.000mm" height = "37.602mm" ver = "01" gw = "172" gh = "90"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A7206038002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A7206039">HVAC Air Filter Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure noting the following point.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Position air filter (1) and HVAC air filter cover (2) directing its arrow mark (3) upward.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A721026.swf" width = "88.000mm" height = "40.111mm" ver = "01" gw = "172" gh = "97"/>
</figure>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
