<servinfosub id = "AENLSB0AB104033002">
<title>
DTC Confirmation Procedure
</title>
<s1>
<ptxt>
Set ignition “ON” for 10 sec.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AB104033003">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0AB104033004">
<testgroup id = "AENLSB0AB104033005">
<title>
DC/DC converter check
</title>
<test1>
<ptxt>
Check DC/DC converter for proper installation referring to 
<intxref refid = "AENLSB0AB106012">DC/DC Converter Removal and Installation</intxref>
.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective parts, then go to Step 2.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AB104033006">
<title>
Terminal voltage check
</title>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check terminal voltage between”12V+” terminal and “GND” terminal. 
<intxreftitleoff1 refid = "AENLSB0AB106012"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is voltage between 6 and 16 V?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AB104033007">
<title>
DTC recheck
</title>
<test1>
<ptxt>
Clear DTC. 
<intxreftitleoff1 refid = "AENLSB0AB104005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Perform “DTC Confirmation Procedure”, and check DTC. 
<intxreftitleoff1 refid = "AENLSB0AB104004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is DTC P0D33, P0E33, P0E34, P0E38, P0E39, P0E53, P0E54, P0E98 or P0E99 still detected?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace DC/DC converter and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0AB106012"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Intermittent trouble.
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
