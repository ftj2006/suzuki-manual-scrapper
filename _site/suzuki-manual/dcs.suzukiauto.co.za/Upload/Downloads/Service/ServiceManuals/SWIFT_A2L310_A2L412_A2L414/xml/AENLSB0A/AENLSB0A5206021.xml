<servcat sctnbr = "05" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5206021" svcinfotypenbr = "08" svcinfoqualnbr = "02" page = "2" supplyoff = "1" modify = "0">
<title>
Input Shaft Disassembly and Reassembly
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5206017">Manual Transaxle Assembly Disassembly and Reassembly</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A5206020">Input Shaft Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A5206021001">
<title>
Disassembly
</title>
<s1>
<ptxt>
Remove circlip (1) using special tool.
</ptxt>
<servicetool>
<servicetoolitem id = "L5B028">
<s-part>
(A)
</s-part>
<s-number num = "09900-06107">
09900–06107
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IHSB0A523026.swf" width = "88.000mm" height = "50.058mm" ver = "01" gw = "85" gh = "125"/>
</figure>
</s1>
<s1>
<ptxt>
Remove input shaft right bearing (2) and left bearing (4) from input shaft (1) using bearing puller (3) and hydraulic press.
</ptxt>
<figure>
<graphic graphicname = "I5RW0B520041.swf" width = "88.000mm" height = "43.187mm" ver = "02" gw = "167" gh = "106"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
5.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Metal stick
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Remove 6th gear spacer (1), 6th gear needle bearing and 6th gear (2) from input shaft (4) using bearing puller (3) and hydraulic press.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A523027.swf" width = "88.000mm" height = "60.360mm" ver = "01" gw = "219" gh = "155"/>
</figure>
</s1>
<s1>
<ptxt>
Remove 5th &#38; 6th synchronizer sleeve &#38; hub assembly (1) and 5th gear (2) using bearing puller (3) and hydraulic press.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A523028.swf" width = "88.000mm" height = "63.671mm" ver = "01" gw = "224" gh = "164"/>
</figure>
</s1>
<s1>
<ptxt>
Remove 5th gear needle bearing from input shaft.
</ptxt>
</s1>
<s1>
<ptxt>
Remove 5th gear spacer according to the following procedure.
</ptxt>
<s2>
<ptxt>
Engage high speed synchronizer sleeve to 4th gear.
</ptxt>
</s2>
<s2>
<ptxt>
Push down input shaft (1) a little using bearing puller (2) and hydraulic press.
</ptxt>
<figure>
<graphic graphicname = "IAY301520039.swf" width = "88.000mm" height = "75.029mm" ver = "01" gw = "185" gh = "196"/>
</figure>
</s2>
<s2>
<ptxt>
Remove 5th gear spacer (1) using bearing puller (2) and hydraulic press.
</ptxt>
<figure>
<graphic graphicname = "IAY301520040.swf" width = "88.000mm" height = "60.304mm" ver = "01" gw = "185" gh = "154"/>
</figure>
</s2>
</s1>
<s1>
<ptxt>
Remove 4th gear, 4th gear synchronizer ring and 4th gear needle bearing from input shaft.
</ptxt>
</s1>
<s1>
<ptxt>
Remove circlip (1) using special tool.
</ptxt>
<servicetool>
<servicetoolitem id = "L5B029">
<s-part>
(A)
</s-part>
<s-number num = "09900-06107">
09900–06107
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IAY301520041.swf" width = "88.000mm" height = "67.848mm" ver = "01" gw = "143" gh = "176"/>
</figure>
</s1>
<s1>
<ptxt>
Remove high speed synchronizer sleeve &#38; hub assembly (1) and 3rd gear (2) from input shaft (4) using bearing puller (3) and hydraulic press.
</ptxt>
<figure>
<graphic graphicname = "IAY301520042.swf" width = "88.000mm" height = "70.214mm" ver = "03" gw = "185" gh = "183"/>
</figure>
</s1>
<s1>
<ptxt>
Remove 3rd gear needle bearing from input shaft.
</ptxt>
</s1>
<s1>
<ptxt>
Disassemble synchronizer sleeve &#38; hub assembly.
</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5206021002">
<title>
Reassembly
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5206022">Input Shaft Inspection</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A5206029">Gear Shift Shaft and Fork Inspection</intxrefpoff>
</ptxt>
<s1>
<ptxt>
Install right bearing (1) to input shaft (2) using special tool and hydraulic press.
</ptxt>
<servicetool>
<servicetoolitem id = "L5B030">
<s-part>
(A)
</s-part>
<s-number num = "09941-74910">
09941–74910
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IHSB0A523029.swf" width = "88.000mm" height = "61.909mm" ver = "01" gw = "115" gh = "159"/>
</figure>
</s1>
<s1>
<ptxt>
Fit high speed synchronizer sleeve (1) to hub (2) and 3 keys (3) as shown in figure.
</ptxt>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
No specific direction is assigned to each key but it is assigned as sleeve &#38; hub assembly.
</ptxt>
</item>
<item>
<ptxt>
Inside diameter of high speed synchronizer hub is larger than that of 5th &#38; 6th gear synchronizer hub.
</ptxt>
</item>
</list1>
</attention3>
<figure>
<title>
Synchronizer key installation position
</title>
<graphic graphicname = "IHSB0A523030.swf" width = "88.000mm" height = "79.111mm" ver = "01" gw = "153" gh = "208"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" valign = "top" align = "right">
<ptxt>
[a]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" valign = "top" align = "left">
<ptxt>
3rd gear side
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" valign = "top" align = "right">
<ptxt>
[b]: 
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" valign = "top" align = "left">
<ptxt>
Key way
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Install 3rd gear needle bearing and apply transaxle oil to it, and then install 3rd gear synchronizer inner ring (2), 3rd gear synchronizer center cone (3), 3rd gear synchronizer outer ring (4) and 3rd gear (1) to input shaft.
</ptxt>
<attention3>
<ptxt>
Make sure claws on 3rd gear synchronizer center cone fit into the holes on 3rd gear.
</ptxt>
</attention3>
<figure>
<graphic graphicname = "IAW101520025.swf" width = "88.000mm" height = "58.219mm" ver = "01" gw = "143" gh = "149"/>
</figure>
</s1>
<s1>
<ptxt>
Put high speed sleeve &#38; hub assembly (3) on input shaft with its long flange [c] toward 3th gear side [a] as shown in figure.
</ptxt>
</s1>
<s1>
<ptxt>
Install high speed sleeve &#38; hub assembly using special tool and hydraulic press.
</ptxt>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
While press-fitting sleeve &#38; hub, check that keys (5) of synchronizer outer ring (2) are aligned with key slots [b] in sleeve &#38; hub assembly.
</ptxt>
</item>
<item>
<ptxt>
Check free rotation of 3rd gear (1) after press-fitting sleeve &#38; hub assembly.
</ptxt>
</item>
</list1>
</attention3>
<servicetool>
<servicetoolitem id = "L5B031">
<s-part>
(A)
</s-part>
<s-number num = "09944-77030">
09944–77030
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IGAA0A522001.swf" width = "88.000mm" height = "97.726mm" ver = "01" gw = "170" gh = "261"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" valign = "top" align = "right">
<ptxt>
4.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" valign = "top" align = "left">
<ptxt>
3rd gear needle bearing
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Install new circlip.
</ptxt>
</s1>
<s1>
<ptxt>
Install 4th gear needle bearing (2) and apply transaxle oil to it, and then install synchronizer ring (4) and 4th gear (3).
</ptxt>
</s1>
<s1>
<ptxt>
Install 5th gear spacer (1) using special tools and hydraulic press.
</ptxt>
<attention2>
<ptxt>
Using an inappropriate hydraulic press or bearing puller could cause personal injury.
</ptxt>
<ptxt>
Check that both the hydraulic press and bearing puller are capable of safely bearing a load of at least 5 tons (11,000 lbs).
</ptxt>
</attention2>
<servicetool>
<servicetoolitem id = "L5B032">
<s-part>
(A)
</s-part>
<s-number num = "09940-54910">
09940–54910
</s-number>
</servicetoolitem>
<servicetoolitem id = "L5B033">
<s-part>
(B)
</s-part>
<s-number num = "09913-85210">
09913–85210
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IAY301520066.swf" width = "88.000mm" height = "54.010mm" ver = "01" gw = "88" gh = "137"/>
</figure>
</s1>
<s1>
<ptxt>
Install 5th gear needle bearing and apply transaxle oil to it, and then install 5th gear and synchronizer ring.
</ptxt>
</s1>
<s1>
<ptxt>
Fit 5th &#38; 6th gear synchronizer sleeve (1) to hub (2) and 3 keys (3) as shown in figure.
</ptxt>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
No specific direction is assigned to 5th &#38; 6th gear synchronizer hub or each key but it is assigned as assembly.
</ptxt>
</item>
<item>
<ptxt>
Inside diameter at 5th &#38; 6th gear synchronizer hub is smaller than that of high speed synchronizer hub.
</ptxt>
</item>
</list1>
</attention3>
<figure>
<title>
Synchronizer key installation position
</title>
<graphic graphicname = "IBP70A520009.swf" width = "88.000mm" height = "74.208mm" ver = "01" gw = "162" gh = "194"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
