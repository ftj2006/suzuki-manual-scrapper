</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Install 5th &#38; 6th gear synchronizer sleeve &#38; hub assembly (1) using special tool and hydraulic press.
</ptxt>
<servicetool>
<servicetoolitem id = "L5B034">
<s-part>
(A)
</s-part>
<s-number num = "09913-85210">
09913–85210
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IAY301520046.swf" width = "88.000mm" height = "74.320mm" ver = "01" gw = "102" gh = "194"/>
