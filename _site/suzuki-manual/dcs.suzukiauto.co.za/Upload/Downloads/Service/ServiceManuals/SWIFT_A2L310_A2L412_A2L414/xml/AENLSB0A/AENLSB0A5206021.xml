</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
6th gear side
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</s1>
<s1>
<ptxt>
Install 6th gear needle bearing (1) and apply transaxle oil to it, and then install synchronizer ring (3) and 6th gear (2).
</ptxt>
</s1>
<s1>
<ptxt>
Install 6th gear spacer (4) using special tool and hydraulic press.
</ptxt>
<servicetool>
<servicetoolitem id = "L5B035">
<s-part>
(A)
</s-part>
<s-number num = "09913-85210">
09913–85210
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IAW101520029.swf" width = "88.000mm" height = "50.393mm" ver = "01" gw = "87" gh = "126"/>
</figure>
</s1>
<s1>
<ptxt>
Press-fit left bearing (1) using special tool and hydraulic press.
</ptxt>
<servicetool>
<servicetoolitem id = "L5B036">
<s-part>
(A)
</s-part>
<s-number num = "09913-85210">
