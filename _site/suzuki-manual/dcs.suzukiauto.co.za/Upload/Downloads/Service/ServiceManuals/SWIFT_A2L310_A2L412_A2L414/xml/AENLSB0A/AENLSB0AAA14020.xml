<servinfosub id = "AENLSB0AAA14020004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0AAA14020005">
<testgroup id = "AENLSB0AAA14020006">
<question>
Was “Dual Sensor Brake Support System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0AAA14001">Dual Sensor Brake Support System Check:Dual Sensor Brake Support</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA14020007">
<title>
Dual sensor brake support OFF switch signal circuit check
</title>
<test1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect dual sensor brake support OFF switch and “G04” connectors.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connection to dual sensor brake support OFF switch and “G04” connectors.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance between “A1” circuit and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A1” circuit terminal and other terminal at “G04” connector: infinity
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA14020008">
<title>
Dual sensor brake support OFF switch check
</title>
<test1>
<ptxt>
Check dual sensor brake support OFF switch. 
<intxreftitleoff1 refid = "AENLSB0AAA16005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace BCM and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0AA206003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Replace dual sensor brake support OFF switch. 
<intxreftitleoff1 refid = "AENLSB0AAA16004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
</testgroup>
</diag>
