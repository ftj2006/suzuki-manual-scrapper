<suzuki><manual>
<section sectnbr = "8A">
<servcat sctnbr = "08" scnbr = "01">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A8106010" svcinfotypenbr = "08" svcinfoqualnbr = "03" page = "2" supplyoff = "1" modify = "0">
<title>
Rear Seat Belt Buckle Inspection
</title>
<servinfosub id = "AENLSB0A8106010001">
<title>
Belt Latch
</title>
<list1 type = "unordered">
<item>
<ptxt>
Check that torque plate (2) is latched securely.
</ptxt>
</item>
<item>
<ptxt>
Check that lock is released by pressing release button (3) when tongue plate is latched to buckle (1).
</ptxt>
<figure>
<graphic graphicname = "IAW101810007.swf" width = "88.000mm" height = "45.864mm" ver = "01" gw = "117" gh = "114"/>
</figure>
</item>
</list1>
</servinfosub>
<servinfosub id = "AENLSB0A8106010002">
<title>
Seat Belt Buckle Switch (If Equipped)
</title>
<s1>
<ptxt>
Remove rear seat cushion. 
<intxreftitleoff1 refid = "AENLSB0A9706007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect left-side seat belt buckle switch connector (1) and right-side and center seat belt buckle switch connector (2).
</ptxt>
</s1>
<s1>
<ptxt>
Check continuity between seat belt buckle switch connectors terminals “1” and “2” or “3” and “4”.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A810010.jpg" width = "88.000mm" height = "127.752mm" ver = "01" gw = "185" gh = "346"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "4" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<colspec colnum = "3" colname = "3" colwidth = "0.315in"/>
<colspec colnum = "4" colname = "4" colwidth = "1.378in"/>
<tbody>
<row rowsep = "1">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
3.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Left-side seat belt buckle switch
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
5.
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Center seat belt buckle switch
</ptxt>
</entry>
</row>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
4.
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Right-side seat belt buckle switch
</ptxt>
</entry>
<entry colname = "3" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
6.
</ptxt>
</entry>
<entry colname = "4" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
BCM
</ptxt>
</entry>
