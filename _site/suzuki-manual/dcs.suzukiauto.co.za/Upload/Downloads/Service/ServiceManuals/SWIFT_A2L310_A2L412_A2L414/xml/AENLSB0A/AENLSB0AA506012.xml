<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "10E">
<servcat sctnbr = "10" scnbr = "05">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0AA506012" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Engine Switch Removal and Installation
</title>
<servinfosub id = "AENLSB0AA506012001">
<title>
Removal
</title>
<s1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</s1>
<s1>
<ptxt>
For LHD, remove instrument panel driver inside garnish. 
<intxreftitleoff1 refid = "AENLSB0A9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
<ptxt>
For RHD, remove instrument panel driver outside garnish. 
<intxreftitleoff1 refid = "AENLSB0A9306001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine switch (1) from the garnish.
</ptxt>
<figure>
<graphic graphicname = "IGSB0AA50023.jpg" width = "88.000mm" height = "57.832mm" ver = "01" gw = "168" gh = "147"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AA506012002">
<title>
Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0AA506013">Engine Switch Inspection</intxrefpoff>
</ptxt>
<ptxt>
Reverse removal procedure.
</ptxt>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
