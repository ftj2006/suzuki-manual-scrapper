<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5B">
<servcat sctnbr = "05" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5206002" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Manual Transaxle Oil Change
</title>
<s1>
<ptxt>
Before changing oil, stop engine and hoist vehicle horizontally.
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine undercover and left side engine under side cover.
</ptxt>
</s1>
<s1>
<ptxt>
Check manual transaxle for oil leakage. Repair leaky point, if any.
</ptxt>
</s1>
<s1>
<ptxt>
Remove oil level / filler plug (1) and gasket (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove drain plug (3) and drain oil.
</ptxt>
</s1>
<s1>
<ptxt>
Apply sealant to thread of drain plug, and tighten it to specified torque.
</ptxt>
<materials>
<materialitem name = "SUZUKI Bond No.1217G" id = "M5B001" uid = "-491504098">
<m-part>
“A”
</m-part>
<m-desc>
Sealant
</m-desc>
<m-number>
99000–31260
</m-number>
<m-name>
SUZUKI Bond No.1217G
</m-name>
</materialitem>
</materials>
<torque>
<torqueitem id = "T5B002">
<t-part>
Transaxle oil drain plug
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
23
</t-value1>
<t-value2>
2.3
</t-value2>
<t-value3>
17.0
</t-value3>
</torqueitem>
</torque>
</s1>
<s1>
<ptxt>
Add new specified oil until oil level reaches lower end of oil level / filler plug hole.
</ptxt>
<attention3>
<ptxt>
It is highly recommended to use “SUZUKI GEAR OIL 75W”.
</ptxt>
</attention3>
<spec-sdm>
<sdm-title>
Manual transaxle oil specification
</sdm-title>
<sdm1>
<sdm-condition>
</sdm-condition>
<sdm-value>
SUZUKI GEAR OIL 99000–22B27–036
</sdm-value>
</sdm1>
<sdm1>
<sdm-condition>
</sdm-condition>
<sdm-value>
API GL-4
</sdm-value>
<sdm-ptxt>
(For SAE classification, refer to viscosity chart.)
</sdm-ptxt>
</sdm1>
</spec-sdm>
<spec-sdm>
<sdm-title>
Manual transaxle oil capacity
</sdm-title>
<sdm1>
<sdm-condition>
Reference
</sdm-condition>
<sdm-value>
1.5 liters (3.17/2.64 US/Imp. pt.)
</sdm-value>
</sdm1>
</spec-sdm>
<spec>
<title>
Viscosity chart
</title>
<figure>
<graphic graphicname = "IFFA0B521002.swf" width = "88.000mm" height = "23.678mm" ver = "01" gw = "190" gh = "51"/>
<callout>
<table frame = "all" colsep = "1" rowsep = "1">
<tgroup cols = "2" colsep = "1" rowsep = "1">
<colspec colnum = "1" colname = "1" colwidth = "0.315in"/>
<colspec colnum = "2" colname = "2" colwidth = "1.378in"/>
<tbody>
<row rowsep = "0">
<entry colname = "1" border-top = "1" border-bottom = "1" border-left = "1" border-right = "0" align = "right">
<ptxt>
[a]:
</ptxt>
</entry>
<entry colname = "2" border-top = "1" border-bottom = "1" border-left = "0" border-right = "1" align = "left">
<ptxt>
Temperature
</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</callout>
</figure>
</spec>
</s1>
<s1>
<ptxt>
Check oil level. 
<intxreftitleoff1 refid = "AENLSB0A5206001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Install oil level / filler plug and new gasket, and then tighten it to specified torque.
</ptxt>
<torque>
<torqueitem id = "T5B003">
<t-part>
Transaxle oil level / filler plug
</t-part>
<t-part1>
b
</t-part1>
<t-value1>
27
</t-value1>
<t-value2>
2.8
</t-value2>
<t-value3>
20.0
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IKAA0A520003.jpg" width = "88.000mm" height = "57.647mm" ver = "02" gw = "201" gh = "147"/>
</figure>
</s1>
<s1>
<ptxt>
Install engine undercover and left side engine under side cover.
</ptxt>
</s1>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
