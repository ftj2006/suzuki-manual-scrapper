<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "9F">
<servcat sctnbr = "09" scnbr = "06">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A9606012" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "0">
<title>
Rearend Door Lock Removal and Installation
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A9606010">Rearend Door Lock Components</intxrefpoff>
</ptxt>
<ptxt>
<intxrefpoff refid = "AENLSB0A9606011">Rearend Door Latch On-Vehicle Inspection</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A9606012001">
<title>
Removal
</title>
<s1>
<ptxt>
Remove rearend door trim. 
<intxreftitleoff1 refid = "AENLSB0A9606010"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Disconnect rearend door lock connector (1) from rearend door lock assembly (2).
</ptxt>
</s1>
<s1>
<ptxt>
Remove rearend door lock bolts (3) and remove rearend door lock assembly.
</ptxt>
<figure>
<graphic graphicname = "IGSB0A960027.jpg" width = "88.000mm" height = "77.538mm" ver = "01" gw = "214" gh = "203"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A9606012002">
<title>
Installation
</title>
<ptxt>
Reverse removal procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Tighten rearend door lock bolts to specified torque in numerical order (“1” – “3”).
</ptxt>
<torque>
<torqueitem id = "T9F003">
<t-part>
Rearend door lock bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
10
</t-value1>
<t-value2>
1.0
</t-value2>
<t-value3>
7.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A960030.jpg" width = "88.000mm" height = "67.637mm" ver = "01" gw = "214" gh = "175"/>
</figure>
</item>
<item>
<ptxt>
Adjust rearend door latch striker as follows if necessary.
</ptxt>
</item>
<list2 type = "ordered">
<item>
<ptxt>
Loosen rearend door latch striker screws (1)
</ptxt>
</item>
<item>
<ptxt>
Adjust rearend door latch striker (2) position so that rearend door can be opened and closed smoothly.
</ptxt>
</item>
<item>
<ptxt>
Tighten rearend door latch striker screws to specified torque.
</ptxt>
<torque>
<torqueitem id = "T9F004">
<t-part>
Rearend door latch striker screw
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
26
</t-value1>
<t-value2>
2.7
</t-value2>
<t-value3>
19.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IGSB0A960032.jpg" width = "88.000mm" height = "50.922mm" ver = "01" gw = "214" gh = "128"/>
</figure>
</item>
</list2>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
