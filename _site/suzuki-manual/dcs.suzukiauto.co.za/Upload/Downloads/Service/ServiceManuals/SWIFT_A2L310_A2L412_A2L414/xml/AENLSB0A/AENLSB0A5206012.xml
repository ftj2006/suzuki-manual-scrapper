<!DOCTYPE suzuki [
<!ENTITY % sdatacharaents SYSTEM "..\config8\sdatacharaents.txt">
%sdatacharaents;
]>
<suzuki><manual>
<section sectnbr = "5B">
<servcat sctnbr = "05" scnbr = "02">
<configtype typenbr = "0">
<servinfotype sitcode = "6">
<servinfo servinfosgmlid = "AENLSB0A5206012" svcinfotypenbr = "08" svcinfoqualnbr = "01" page = "2" supplyoff = "1" modify = "1">
<title>
Manual Transaxle Unit Dismounting and Remounting
</title>
<ptxt>
<intxrefpoff refid = "AENLSB0A5206011">Manual Transaxle Unit Components</intxrefpoff>
</ptxt>
<servinfosub id = "AENLSB0A5206012001">
<title>
Dismounting
</title>
<s1>
<ptxt>
Remove battery and battery tray.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0A1A16002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0A1A26002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Disconnect gear shift and gear select control cables from transaxle. 
<intxreftitleoff1 refid = "AENLSB0A5206005"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine undercover and left side engine under side cover.
</ptxt>
</s1>
<s1>
<ptxt>
Drain transaxle oil. 
<intxreftitleoff1 refid = "AENLSB0A5206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove exhaust pipe.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0A1B16004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0A1B26004"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Remove front drive shaft assembly. 
<intxreftitleoff1 refid = "AENLSB0A3116003"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Remove starting motor.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0A1916002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0A1926002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list1>
</s1>
<s1>
<ptxt>
Disconnect wiring harness clamps (1).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A523009.swf" width = "88.000mm" height = "64.739mm" ver = "01" gw = "224" gh = "167"/>
</figure>
</s1>
<s1>
<ptxt>
Disconnect ground terminal bolt (1), engine harness clamp (2) and neutral position switch connector (if equipped) (3). 
</ptxt>
<figure>
<graphic graphicname = "IHSB0A523010.swf" width = "88.000mm" height = "64.056mm" ver = "01" gw = "222" gh = "165"/>
</figure>
</s1>
<s1>
<ptxt>
Disconnect back up light switch connector (1) and release wiring harness clamps (2).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A523011.swf" width = "88.000mm" height = "63.588mm" ver = "01" gw = "223" gh = "164"/>
</figure>
</s1>
<s1>
<ptxt>
Remove clutch fluid pipe from clutch pipe joint. 
<intxreftitleoff1 refid = "AENLSB0A5306009"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</s1>
<s1>
<ptxt>
Loosen bolts (1) and nut (2) fastening engine.
</ptxt>
<figure>
<graphic graphicname = "IHSB0A523012.jpg" width = "88.000mm" height = "55.699mm" ver = "01" gw = "214" gh = "141"/>
</figure>
<figure>
<graphic graphicname = "IHSB0A523013.jpg" width = "88.000mm" height = "55.699mm" ver = "01" gw = "214" gh = "141"/>
</figure>
</s1>
<s1>
<ptxt>
Open hood as wide as possible and hold it using rope.
</ptxt>
</s1>
<s1>
<ptxt>
Install special tool on cylinder head as shown, and then using special tool support engine assembly.
</ptxt>
<servicetool>
<servicetoolitem id = "L5B007">
<s-part>
(A)
</s-part>
<s-number num = "09910-66820">
09910–66820
</s-number>
</servicetoolitem>
</servicetool>
<figure>
<graphic graphicname = "IHSB0A523014.jpg" width = "88.000mm" height = "57.213mm" ver = "01" gw = "214" gh = "146"/>
</figure>
</s1>
<s1>
<ptxt>
Support transaxle with transmission jack.
</ptxt>
</s1>
<s1>
<ptxt>
Remove engine left mounting bolt (1) and nuts (2).
</ptxt>
<figure>
<graphic graphicname = "IHSB0A523015.jpg" width = "88.000mm" height = "55.699mm" ver = "01" gw = "214" gh = "141"/>
</figure>
</s1>
<s1>
<ptxt>
Remove bolts and nut fastening engine and transaxle and then detach transaxle from engine.
</ptxt>
</s1>
<s1>
<ptxt>
Remove transaxle insulator undercover (1), if necessary.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A520001.jpg" width = "88.000mm" height = "52.905mm" ver = "01" gw = "185" gh = "133"/>
</figure>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0A5206012002">
<title>
Remounting
</title>
<ptxt>
Reverse dismounting procedure noting the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Install manual transaxle assembly to engine assembly according to the following procedure.
</ptxt>
</item>
<list2 type = "ordered">
<item>
<ptxt>
Apply grease to input shaft, if necessary. 
<intxreftitleoff1 refid = "AENLSB0A5306018"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Check that the dowel pins (1) are installed on the engine assembly as shown in figure.
</ptxt>
<figure>
<graphic graphicname = "ILSB0A520003.jpg" width = "88.000mm" height = "60.356mm" ver = "01" gw = "200" gh = "155"/>
</figure>
</item>
<item>
<ptxt>
Align manual transaxle assembly with engine assembly horizontally using transmission jack.
</ptxt>
</item>
<item>
<ptxt>
Align the spline of input shaft with the spline hole of clutch disc.
</ptxt>
</item>
<item>
<ptxt>
Install manual transaxle assembly to engine assembly.
</ptxt>
<attention4>
<ptxt>
Follow the following points when installing manual transaxle assembly to engine assembly.
</ptxt>
<ptxt>
Otherwise, clutch disc may be damaged and clutch may not disengage normally.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Do not excessively shake manual transaxle assembly when installing it to engine assembly.
</ptxt>
</item>
<item>
<ptxt>
Do not strongly contact input shaft to the spline hole of clutch disc.
</ptxt>
</item>
</list1>
</attention4>
<attention3>
<list1 type = "unordered">
<item>
<ptxt>
In case of hard fitting, rotate input shaft slightly to align spline of input shaft with the spline hole of clutch disc.
</ptxt>
</item>
<item>
<ptxt>
Confirm that there is not gap between engine assembly and manual transaxle assembly.
</ptxt>
</item>
</list1>
</attention3>
</item>
</list2>
<item>
<ptxt>
Tighten the following bolts and nuts to specified torque.
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
Transaxle to engine bolts and nut: 
<intxreftitleoff1 refid = "AENLSB0A5206011"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Engine left mounting bolt and nuts: 
<intxreftitleoff1 refid = "AENLSB0A1416024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<list3 type = "unordered">
<item>
<ptxt>
K14C model: 
<intxreftitleoff1 refid = "AENLSB0A1416024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
K14D model: 
<intxreftitleoff1 refid = "AENLSB0A1426024"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
</list3>
</list2>
<item>
<ptxt>
Tighten engine harness ground bolt (1) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T5B006">
<t-part>
Engine harness ground bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
25
</t-value1>
<t-value2>
2.5
</t-value2>
<t-value3>
18.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "IHSB0A523016.swf" width = "88.000mm" height = "63.338mm" ver = "01" gw = "222" gh = "163"/>
</figure>
</item>
<item>
<ptxt>
Install transaxle insulator undercover (1), if removed, and then tighten transaxle insulator undercover bolts (2) to specified torque.
</ptxt>
<torque>
<torqueitem id = "T5B007">
<t-part>
Transaxle insulator undercover bolt
</t-part>
<t-part1>
a
</t-part1>
<t-value1>
21
</t-value1>
<t-value2>
2.1
</t-value2>
<t-value3>
15.5
</t-value3>
</torqueitem>
</torque>
<figure>
<graphic graphicname = "ILSB0A520002.jpg" width = "88.000mm" height = "52.905mm" ver = "01" gw = "185" gh = "133"/>
</figure>
</item>
<item>
<ptxt>
Set each clamp for wiring securely.
</ptxt>
</item>
<item>
<ptxt>
Add transaxle oil. 
<intxreftitleoff1 refid = "AENLSB0A5206002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Bleed clutch system. 
<intxreftitleoff1 refid = "AENLSB0A5306007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</item>
<item>
<ptxt>
Check function of engine, clutch and transaxle.
</ptxt>
</item>
<item>
<ptxt>
Check that there is no oil leakage and fluid leakage at each connection.
</ptxt>
</item>
</list1>
</servinfosub>
</servinfo>
</servinfotype>
</configtype>
</servcat>
</section></manual></suzuki>
