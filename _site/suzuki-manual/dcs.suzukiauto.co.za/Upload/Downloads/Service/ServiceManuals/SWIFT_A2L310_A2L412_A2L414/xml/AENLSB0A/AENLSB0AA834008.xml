<servinfosub id = "AENLSB0AA834008004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0AA834008005">
<testgroup id = "AENLSB0AA834008006">
<title>
Battery and charging system check
</title>
<test1>
<ptxt>
Check battery and charging system.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model:
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
<intxref refid = "AENLSB0A1A14001">Battery Inspection:K14C</intxref>
</ptxt>
</item>
<item>
<ptxt>
<intxref refid = "AENLSB0A1A14003">Generator Test:K14C</intxref>
</ptxt>
</item>
</list2>
<item>
<ptxt>
K14D model:
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
<intxref refid = "AENLSB0A1A24001">Battery Inspection:K14D</intxref>
</ptxt>
</item>
<item>
<ptxt>
<intxref refid = "AENLSB0A1A24004">Generator Test:K14D</intxref>
</ptxt>
</item>
</list2>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective part and recheck DTC.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AA834008007">
<title>
Central gateway control module power supply circuit check
</title>
<test1>
<ptxt>
Disconnect negative (–) cable at battery.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “G60” connector.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connection to “G60” connector.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “A1” circuit: less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A1” circuit and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A1” circuit terminal and each terminal at “G60” connector: infinity
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AA834008008">
<title>
Central gateway control module ground circuit check
</title>
<test1>
<ptxt>
Check that resistance between each of “B1” and “B2” circuits and ground is less than 1 &#937;.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace central gateway control module and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0AA836001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
