</ptxt>
</s1>
</servinfosub>
<servinfosub id = "AENLSB0AAA24013004">
<title>
DTC Troubleshooting
</title>
<diag type = "test" id = "AENLSB0AAA24013005">
<testgroup id = "AENLSB0AAA24013006">
<question>
Was “Blind Spot Monitor System Check” performed?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 2.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to 
<intxref refid = "AENLSB0AAA24001">Blind Spot Monitor System Check:Blind Spot Monitor</intxref>
.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA24013007">
<title>
Parameter check
</title>
<test1>
<ptxt>
Connect SUZUKI scan tool to DLC when ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Set ignition “ON”.
</ptxt>
</test1>
<test1>
<ptxt>
Check “ECU Power Supply Voltage (Main)” and “ECU Power Supply Voltage (Sub)” displayed on SUZUKI scan tool. 
<intxreftitleoff1 refid = "AENLSB0AAA24007"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</test1>
<question>
Is voltage 9 – 16 V?
</question>
<result type = "yes"/>
<action>
<ptxt>
Check for intermittent trouble. 
<intxreftitleoff1 refid = "AENLSB0A0006002"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Go to Step 3.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA24013008">
<title>
Battery and charging system check
</title>
<test1>
<ptxt>
Check battery and charging system.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
K14C model:
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
<intxref refid = "AENLSB0A1A14001">Battery Inspection:K14C</intxref>
</ptxt>
</item>
<item>
<ptxt>
<intxref refid = "AENLSB0A1A14003">Generator Test:K14C</intxref>
</ptxt>
</item>
</list2>
<item>
<ptxt>
K14D model:
</ptxt>
</item>
<list2 type = "unordered">
<item>
<ptxt>
<intxref refid = "AENLSB0A1A24001">Battery Inspection:K14D</intxref>
</ptxt>
</item>
<item>
<ptxt>
<intxref refid = "AENLSB0A1A24004">Generator Test:K14D</intxref>
</ptxt>
</item>
</list2>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 4.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective part and recheck DTC.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA24013009">
<title>
Blind spot monitor control module power supply circuit check
</title>
<test1>
<ptxt>
Check that ignition is “OFF”.
</ptxt>
</test1>
<test1>
<ptxt>
Disconnect “L531” and “L532” connectors.
</ptxt>
</test1>
<test1>
<ptxt>
Check for proper terminal connection to “L531” and “L532” connectors.
</ptxt>
</test1>
<test1>
<ptxt>
If connections are OK, check the following points.
</ptxt>
<list1 type = "unordered">
<item>
<ptxt>
Resistance of “A1” and “A2” circuits: less than 1 &#937;
</ptxt>
</item>
<item>
<ptxt>
Resistance between each of “A1” and “A2” circuits and ground: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A1” circuit terminal and each terminal at “L531” connector: infinity
</ptxt>
</item>
<item>
<ptxt>
Resistance between “A2” circuit terminal and each terminal at “L532” connector: infinity
</ptxt>
</item>
</list1>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Go to Step 5.
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
<testgroup id = "AENLSB0AAA24013010">
<title>
Blind spot monitor control module ground circuit check
</title>
<test1>
<ptxt>
Check that resistance between each of “B1” and “B2” circuits and ground is less than 1 &#937;.
</ptxt>
</test1>
<question>
Is check result OK?
</question>
<result type = "yes"/>
<action>
<ptxt>
Replace defective blind spot monitor control module and recheck DTC. 
<intxreftitleoff1 refid = "AENLSB0AAA26001"><img src = "..\icon\intxreftitleoff.gif"/></intxreftitleoff1>
</ptxt>
</action>
<result type = "no"/>
<action>
<ptxt>
Repair or replace defective wire harness.
</ptxt>
</action>
</testgroup>
</diag>
</servinfosub>
